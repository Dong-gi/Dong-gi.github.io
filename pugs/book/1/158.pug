include ../../../source/skeleton.pug

+post({
    title: '진화의 배신',
    description: '개인적으로 마음에 든 『진화의 배신』 문구',
})

    h1 도서 정보
    +bookInfo({
        imgSrc: 'https://contents.kyobobook.co.kr/sih/fit-in/458x0/pdt/9788960516915.jpg',
        title: '진화의 배신',
        author: '리 골드먼',
        publisher: '부·키',
        isbn: '978-89-6051-691-5 (03100)',
        date: '2019.01.25',
    })

    h1 독서 기록
    ul 
        li 0.1%가 가진 유전적 돌연변이가 10세대 만에 인구 전체에 퍼지려면 생존에 엄청나게 유익한 돌연변이여야 한다. 어느 정도냐 하면 그 유전자를 지니지 않은 사람보다 자손을 가질 확률이 30배 이상이어야 가능한 일이다. 그러나 미국인의 98% 이상이 이미 자녀를 낳은 연령까지 살기 때문에 어떤 상대적 우위를 가진 유전적 돌연변이도 현대에는 그렇게 신속하고 널리 퍼질 수가 없다
        li 같은 양의 M&amp;M 초콜릿을 사람들에게 나눠 주면서 한 집단은 다양한 색상을, 한 집단은 덜 다양한 색상을 주었다. 그 결과 다양한 색상을 받은 집단은 그렇지 않은 집단보다 40%를 더 먹었다
