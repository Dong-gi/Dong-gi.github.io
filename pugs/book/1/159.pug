include ../../../source/skeleton.pug

+post({
    title: '한낮의 방문객',
    description: '개인적으로 마음에 든 『한낮의 방문객』 문구',
})

    h1 도서 정보
    +bookInfo({
        imgSrc: 'https://contents.kyobobook.co.kr/sih/fit-in/458x0/pdt/9788979190144.jpg',
        title: '한낮의 방문객',
        author: '마에카와 유타카',
        publisher: '창해',
        isbn: '978-89-7919-014-4 (03830)',
        date: '2018.02.27',
    })

    h1 독서 기록
    ul 
        li (정수기) 판매 목적임을 알리지 않고 수질검사를 해주는 것 자체가 특정 상거래법 위반 ... 하루코는 수질검사를 허락했다. 첫번째이자 결정적으로 중요한 관문이 통과된 이상, 그 다음 발생하는 필연적인 결과를 막기는 현실적으로 어렵다
        li 원자력 발전소 사고 이후 정수기 사기꾼들이 너무 많아
        li 한 사람이 '사모님, 죽고 싶습니까?'라고 몇 번이나 말했거든. 물론 표면적으론 방사능에 오염돼 병에 걸릴지도 모른다는 의미였지만, 중의적으로 느껴졌어
        li '엉덩이를 씻다'란 말은 경찰의 은어로, A형사가 조사한 사항을 B형사가 다시 조사하는 것을 의미한다
        li 체포영장이 발부되지 않았으므로 다쿠마는 아직 용의자가 아니다. 따라서 범인은닉죄도 성립하지 않는다
        li 가장 중요한 말을 맨 마지막에 한 뒤 상대가 대답할 기회를 주지 않는다. 상대방의 불안을 극대화시키는 방법이다
