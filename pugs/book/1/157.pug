include ../../../source/skeleton.pug

+post({
    title: '머니랩',
})

    h1 도서 정보
    +bookInfo({
        imgSrc: 'https://contents.kyobobook.co.kr/sih/fit-in/458x0/pdt/9788963899206.jpg',
        title: '머니랩',
        author: '케이윳 첸 외',
        publisher: '타임비즈',
        isbn: '978-89-6389-920-6 (03320)',
        date: '2010.11.01',
    })

    h1 독서 기록
    ul
        li '주말 할증'보다는 '주중 할인'
        li 10만 달러 연봉 대신 5만 달러 연봉을 받길 원하는 경우가 있다?
            ul
                li 내 연봉 5만 달러 &amp 동료 연봉 2만 5천 달러
                li 내 연봉 10만 달러 &amp 동료 연봉 25만 달러
        li 50달러 얻는 것이 70달러 얻는 것보다 좋다고 생각하는 경우가 있다?
            ul
                li 상대방이 자신의 100달러 중 몇 달러는 내게 나눠줄 지 결정하는 독재자 게임에서 50달러를 받는 경우
                li 상대방이 내 100달러 중 몇 달러를 가져갈 지 결정하는 독재자 게임에서 30달러를 뺏기는 경우
        li 실험실 연구에서 오염을 줄이기 위해 컴퓨터를 통해 의사소통하도록 하는 경우가 있는데, '직접 대면'을 없애는 것으로 현실과 동떨어진 결과를 얻을 수 있다
