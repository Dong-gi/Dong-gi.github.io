+post({
    title: 'Jakarta EE',
    description: 'Jakarta EE 정리',
})

    p.version-note Jakarta EE 11(2025-06-26) 기준으로 정리했습니다. Java EE 8 시절 내용은 문서 하단에 접어두었습니다.

    h1 Java EE 에서 Jakarta EE 로
    ol
        li 2017-09, Oracle 이 Java EE 를 Eclipse Foundation 으로 이관하겠다고 발표하고 EE4J 프로젝트가 개설됐다
        li 2018-02, 커뮤니티 투표로 새 이름이 #[strong Jakarta EE] 로 정해졌다 (약 7,000명 참여, 64.4%)
        li 2019-05, Oracle 과의 협상이 결렬됐다. #[strong javax.* 네임스페이스를 Jakarta EE 커뮤니티가 진화시킬 수 없고], EJB·JPA·JAX-RS 처럼 "Java" 상표가 든 사양명도 쓸 수 없게 됐다
        li 2020-12, Jakarta EE 9 에서 #[strong javax.* 를 jakarta.* 로 한 번에 전부 바꿨다]. 점진적 이관 대신 big bang 을 택한 이유는, 리플렉션으로 패키지명을 참조하는 라이브러리들 때문에 중간 상태가 더 위험했기 때문이다
        li: +asA('https://eclipse-foundation.blog/2019/05/03/jakarta-ee-java-trademarks/', '상표권 결정 원문')

    h1 버전 이력
    +table()
        +ths('버전', '출시', '필요 Java', '네임스페이스', '핵심')
        +tds('Jakarta EE 8', '2019-09', 'SE 8', 'javax.*', 'Java EE 8과 기술적으로 동일')
        +tds('Jakarta EE 9', '2020-12', 'SE 8', 'jakarta.*', '네임스페이스 전환만. 기능 추가 없음')
        +tds('Jakarta EE 9.1', '2021-05', 'SE 8 / 11', 'jakarta.*', 'JDK 11 인증 허용이 유일한 목적')
        +tds('Jakarta EE 10', '2022-09', 'SE 11+', 'jakarta.*', 'Core Profile 신설, CDI 4.0, Servlet 6.0')
        +tds('Jakarta EE 11', '2025-06', 'SE 17+', 'jakarta.*', 'Jakarta Data 신설, Persistence 3.2, 선택 사양 전부 제거')
    p Jakarta EE 12 는 JDK 21 을 최소로 잡고 개발 중이다. 2026-08 기준 아직 정식 출시되지 않았다
    ul
        li #[strong Jakarta EE 9 는 기능이 하나도 늘지 않았다.] 오직 네임스페이스만 바꾼 릴리스이므로, Java EE 8 에서 올라올 때 코드 변경은 임포트 치환이 대부분이다
        li 다만 #[strong javax 로 시작한다고 다 Jakarta EE 는 아니다]. 아래는 JDK 소속이라 그대로 두어야 한다
        +asCode('java').
            javax.sql            java.sql 모듈 (DataSource)
            javax.crypto         java.base 모듈
            javax.naming         java.naming 모듈 (JNDI)
            javax.annotation.processing / javax.lang.model / javax.tools
                                 java.compiler 모듈

    h1 Jakarta EE 11 사양 버전
    +table()
        +ths('사양', '버전', '사양', '버전')
        +tds('Servlet', '6.1', 'Persistence (구 JPA)', '3.2')
        +tds('CDI', '4.1', 'Validation', '3.1')
        +tds('RESTful Web Services (구 JAX-RS)', '4.0', 'WebSocket', '2.2')
        +tds('Faces (구 JSF)', '4.1', 'Pages (구 JSP)', '4.0')
        +tds('JSON-P / JSON-B', '2.1 / 3.0', 'Concurrency', '3.1')
        +tds('Security', '4.0', 'Data (신규)', '1.0')

    h1 개발자가 체감하는 변화
    div
        h2 Servlet 6.0 / 6.1
        ul
            li #[strong 6.0 에서 5.0 이전에 deprecated 였던 API 를 전부 제거했다]. #[+asInlineCode('SingleThreadModel', 'java')], #[+asInlineCode('HttpSessionContext', 'java')], #[+asInlineCode('HttpUtils', 'java')], #[+asInlineCode('HttpSession.getValue/putValue/removeValue', 'java')] 등
            li URI 디코딩·정규화가 엄격해졌다. 경로 탐색으로 보이는 시퀀스를 거부한다
            li 6.1 에서 HTTP/2 Server Push (#[+asInlineCode('newPushBuilder()', 'java')]) 가 deprecated 됐다. 103 Early Hints 로 대체를 권한다
            li 6.1 에서 #[+asInlineCode('SecurityManager', 'java')] 참조가 제거됐다 (JEP 411 대응)
    div
        h2 Persistence 3.2
        ul
            li #[+asInlineCode('getSingleResultOrNull()', 'java')] 추가. #[+asInlineCode('NoResultException', 'java')] 을 catch 하지 않아도 된다
            li #[strong Java Record 를 @Embeddable / @IdClass 로 쓸 수 있다]
            li #[+asInlineCode('java.time.Instant', 'java')], #[+asInlineCode('java.time.Year', 'java')] 가 기본 타입으로 자동 매핑된다
            li #[strong @Temporal 과 java.util / java.sql 의 Date·Time·Timestamp·Calendar 가 deprecated 됐다.] #[+asInlineCode('java.time', 'java')] 을 쓴다
            li #[+asInlineCode('@PersistenceContext', 'java')] 대신 CDI #[+asInlineCode('@Inject', 'java')] 로 #[+asInlineCode('EntityManager', 'java')] 주입이 가능하다
            li JPQL/Criteria 에 #[+asInlineCode('union', 'sql')], #[+asInlineCode('intersect', 'sql')], #[+asInlineCode('except', 'sql')], #[+asInlineCode('cast', 'sql')], #[+asInlineCode('||', 'sql')] 등이 추가됐다
            li #[+asInlineCode('persistence.xml', 'xml')] 없이 Java 코드로 퍼시스턴스 유닛을 구성할 수 있다
    div
        h2 CDI 4.0 — 가장 파괴적인 변경
        ul
            li #[strong 빈 beans.xml 의 의미가 바뀌었다.] 종전에는 explicit bean archive(discovery mode #[+asInlineCode('all', 'xml')])였으나 4.0 부터 implicit bean archive(#[+asInlineCode('annotated', 'xml')])로 취급한다
            li 즉 #[strong 빈 정의 애너테이션이 없는 클래스는 더 이상 빈으로 등록되지 않는다.] Java EE 8 앱을 올릴 때 "주입되던 것이 갑자기 안 된다"면 대개 이 문제다
            li CDI Full 제품은 구 동작으로 되돌리는 호환 스위치를 제공하게 되어 있다
            li 4.1 에서 프로듀서에 #[+asInlineCode('@Priority', 'java')] 를 지정할 수 있게 됐다

    h1 web.xml 스키마
    p Jakarta EE 9 이상은 모든 배포 서술자가 #[strong 네임스페이스 하나를 공유]하고 구분은 #[+asInlineCode('version', 'xml')] 속성으로만 한다
    +asCode('xml', 'Jakarta Servlet 6.1 (EE 11 / Tomcat 11)').
        &lt;?xml version="1.0" encoding="UTF-8"?&gt;
        &lt;web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                                     https://jakarta.ee/xml/ns/jakartaee/web-app_6_1.xsd"
                 version="6.1"&gt;
        &lt;/web-app&gt;
    +asCode('xml', '대조 — Java EE 8 / Servlet 4.0').
        &lt;web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
                 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                 xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                                     http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
                 version="4.0"&gt;
    p 스키마 네임스페이스는 #[strong https] 다. jakarta.ee 안내 페이지 본문에는 http 로 적힌 곳이 있으나 실제 XSD 의 #[+asInlineCode('targetNamespace', 'xml')] 는 https 다

    h1 구현체
    +table()
        +ths('런타임', 'Java EE 8 (javax)', 'Jakarta EE 10', 'Jakarta EE 11')
        +tds('Tomcat', '9.0.x', '10.1.x (Java 11+)', '11.0.x (Java 17+)')
        +tds('Jetty', '9.x / 10.x', '12.0.x (ee10)', '12.1.x (ee11)')
        +tds('GlassFish', '5.1', '7.x', '8.0 (2026-02)')
        +tds('WildFly', '18 이하', '27 ~ 39', '40 (2026-05) 이상')
        +tds('Payara', '5.x', '6.x', '7')
    ul
        li #[strong Tomcat 9 가 javax 를 지원하는 마지막 메이저다.] Jakarta 로 올리면 Tomcat 10.1 이상이 필요하고, Servlet 6.1 을 쓰려면 11 이 필요하다
        li Tomcat 은 애플리케이션 서버가 아니라 서블릿 컨테이너이므로 Jakarta EE 프로필 인증 대상이 아니다. Servlet / Pages / EL / WebSocket / Authentication 만 구현한다

    h1 JSP 는 지금 어떤 위치인가
    ul
        li 사양은 #[strong 유지되지만 유지보수 모드]다. Jakarta EE 11 Web Profile 에 Pages 4.0 으로 들어 있고 Tomcat 11 도 구현하지만, 사양의 방침은 "예기치 못한 문제 수정과 Servlet·EL 변경에 맞춘 적응"이며 새 기능 개발은 없다
        li #[strong Jakarta Faces 4.0(EE 10)에서 JSP 가 뷰 기술로서 완전히 제거됐다.] Faces 의 뷰 선언 언어는 이제 Facelets 하나뿐이다
        li 신규 개발에는 권장되지 않는다. 서버 사이드 렌더링이 필요하면 Faces + Facelets, 아니면 Core Profile(REST + JSON-B) + 프런트엔드 프레임워크 조합을 쓴다

    h1 제거·폐기
    div
        h2 Jakarta EE 9
        ul
            li XML Registries(JAXR), XML RPC(JAX-RPC), Deployment(JSR-88), Management(JSR-77) 제거
            li EJB 분산 상호운용성(CORBA 기반) 제거
    div
        h2 Jakarta EE 10
        ul
            li Faces 4.0 에서 JSP 뷰 기술 제거
            li Servlet 6.0 에서 구 deprecated API 일괄 제거
    div
        h2 Jakarta EE 11
        ul
            li #[strong SOAP with Attachments(SAAJ), XML Binding(JAXB), XML Web Services(JAX-WS) 제거.] SOAP 를 계속 쓰려면 Metro 같은 외부 의존성이 필요하다
            li #[strong Managed Beans 사양 전체 제거] — CDI 로 대체
            li 선택(optional) 사양 전부 제거, CORBA 상호운용성 요구 폐지
            li 전 사양에서 #[+asInlineCode('SecurityManager', 'java')] 참조 제거
            li deprecated : #[+asInlineCode('@ManagedBean', 'java')], REST 4.0 의 #[+asInlineCode('@Context', 'java')](CDI #[+asInlineCode('@Inject', 'java')] 로 이행)

    +legacy('Java EE 8 / javax.*', 'Tomcat 9 이하 기준. Jakarta EE 9 부터 네임스페이스가 바뀌었습니다')

        p.version-note 본문은 Spring 5.x / javax.* 기준입니다. 연결된 예제 코드는 Spring 7 / Jakarta EE(jakarta.*)로 이관되어 본문과 차이가 있습니다. 본문 최신화는 진행 중입니다.

        h1 JavaEE
        ol
            li Java Enterprise Edition은 동적 웹 애플리케이션 개발을 위한 자바 플랫폼이다
            p JavaSE와는 문서 페이지가 다르다. 
                +asA('https://javaee.github.io/javaee-spec/javadocs/')
            li WAR(Web Application Archive) : JavaEE 웹 애플리케이션을 위한 압축 파일
            p 전형적인 war 파일 구조 ↓
            +asCode().
                웹앱 루트
                ㄴ META-INF
                    ㄴ MANIFEST.MF
                    ㄴ 컨테이너 리소스
                ㄴ WEB-INF : 웹에서 접근 불가
                    ㄴ classes
                        ㄴ META-INF
                            ㄴ 애플리케이션 리소스
                        ㄴ 자바 .class 파일 및 리소스
                    ㄴ i18n
                        ㄴ 국제화 파일
                    ㄴ lib
                        ㄴ 번들 jar 파일
                    ㄴ tags
                        ㄴ JSP 태그 파일
                    ㄴ tld
                        ㄴ JSP 태그 라이브러리 설명자
                ㄴ 기타 웹에서 접근 가능한 파일
            li 서블릿
            p 자바로 구현된 CGI(Common Gateway Interface; 웹 서버와 프로그램 사이의 통신 규약).
                |  JCP(Java Community Process)에서 제정한 Servlet Specification을 따라야 한다
            li 서블릿 컨테이너
            p 서블릿의 생애를 관리하는 프로그램(예. 톰캣)
            li JSP
            p 전용 태그 "&lt;% %>"를 이용해 HTML 문서에 자바 코드를 삽입
                |  컨테이너가 자동으로 컴파일 하며, 서블릿 클래스와 달리 수정사항이 있어도 다시 빌드할 필요가 없다

        h1 톰캣 배포 프로젝트
        div
            h2 개발 환경
            ol
                li
                    +asA('https://sdkman.io/jdks', 'JDK')
                    |  설치
                li
                    +asA('https://tomcat.apache.org/', '톰캣')
                    |  설치
                li IDE(이클립스, STS 등) 설치
                ul
                    li 이클립스에 톰캣 추가
                    +asCode() Windows » Preferences » Server » Runtime Environments » Add » Apache
                    li 이클립스 프로젝트에 톰캣 구성 추가
                    +asCode() 프로젝트 Server 속성에 추가
                    li IntelliJ에 톰캣 추가
                    +asCode() Settings » Application Servers » + » 톰캣 홈 디렉터리 추가
                    li IntelliJ 프로젝트에 톰캣 구성 추가
                    +asCode().
                        도구 모음에서 Run/Debug Configurations 아이콘(아래방향 화살표)을 누른 다음 Edit Configurations 클릭

                        대화상자가 열리면 + 버튼 클릭 후 Tomcat Server를 Local로 추가

                        배포할 아티팩트를 선택하지 않았다는 경고가 표시되면 Deployment 탭을 누르고 "Deploy at the server setup" 머리글 아래의 + 버튼 클릭
                        Artifact를 누르고 확장된 war 파일 아티팩트를 누른 다음 OK. 배포를 위한 "Application context"이름을 서버를 기준으로 한 상대 주소로 변경(예. /my-app)

            h2 Hello World 프로젝트
            div
                h3 이클립스 Dynamic Web Project
                ol
                    li New Project » Web » Dynamic Web Project » Target runtime에 톰캣 설정
                    li 코드 작성
                    +w3img('/imgs/202008/20200808_184623.png', '프로젝트 구조')
                    +codeBtn('/Repositories/STS/app1/src/io/github/donggi/app1/controller/HelloController.java', 'java', [11], true)
                    +codeBtn('/Repositories/STS/app1/webapp/WEB-INF/web.xml', 'xml', null, true)
                    li web.xml
                    p web.xml은 배포 설명자로, 서블릿 및 서블릿 매핑, 필터 등을 정의한다
                        |  이클립스 프로젝트 생성 마법사로 web.xml을 생성하면 자동으로 welcome-file-list를 구성해주는데, welcome-file-list에 정의된 welcome-file을 순서대로 찾아 기본 페이지로 보여준다
                    li 실행
                    +w3img('/imgs/202008/20200808_184839.png', 'Debug on Server')
                    +w3img('/imgs/202008/20200808_185012.png', '브라우저 화면')
                    p 또는 Export » WAR file를 선택하여, 톰캣 webapps 디렉터리에 옮긴 후 배치되기를 기다린 뒤 브라우저에서 확인
                    li 이클립스 내부에서 실행하는 경우 웹 애플리케이션 배포 위치
                    p ${PROJECT_ROOT}\.metadata\.plugins\org.eclipse.wst.server.core\tmp0\wtpwebapps

                h3 톰캣에 직접 배치
                ol
                    li 위와 동일하게 HelloController.java 작성 
                        +codeBtn('/Repositories/STS/app1/src/io/github/donggi/app1/controller/HelloController.java', 'java', [11], true)
                    li 컴파일
                    ul
                        li 톰캣 lib를 클래스패스로 넘기는 경우
                        +asCode('shell') javac -encoding UTF-8 -cp "C:\apache-tomcat-8.0.52\lib\servlet-api.jar" HelloController.java
                        li JDK의 jre/lib/ext에 servlet-api.jar를 붙여넣은 경우
                        +asCode('shell') javac -encoding UTF-8 HelloController.java
                    li 컴파일된 클래스 파일을 webapps/${웹모듈명}/WEB-INF/classes/${패키지 경로}/ 에 저장
                    li 동일한 배포 설명자 web.xml을 WEB-INF에 작성하고 실행 
                        +codeBtn('/Repositories/STS/app1/webapp/WEB-INF/web.xml', 'xml', null, true)

                h3 이클립스 Maven 프로젝트
                ol
                    li New Project » Maven » Maven Project » maven-archetype-webapp
                    p webapp 아티팩트로 프로젝트를 만들면 Hello World를 출력하는 index.jsp가 생성된다
                    li Maven Install, 빌드하여 war 파일이 생성되면 톰캣 webapps 디렉터리에 붙여넣고 배치되기를 기다린 뒤 브라우저에서 실행
                    p maven이 pom.xml에 정의된 라이브러리를 /users/유저이름/.m2 폴더에 다운로드한다

                h3 이클립스 Gradle 프로젝트
                ol
                    li New Project » Gradle Project 
                        +codeBtn('/Repositories/STS/mvc-xml1/build.gradle', 'gradle', null, true)
                    li 코드 작성
                    +w3img('/imgs/202008/20200808_185701.png', '프로젝트 구조')
                    +codeBtn('/Repositories/STS/mvc-xml1/src/main/java/io/github/donggi/mvc1/controller/HelloController.java', 'java', [11], true)
                    +codeBtn('/Repositories/STS/mvc-xml1/src/main/webapp/WEB-INF/web.xml', 'xml', null, true)
                    li 실행
                    +w3img('/imgs/202008/20200808_185608.png', '브라우저 화면')

            h2 서블릿 생애 주기
            ol
                li 서블릿 컨테이너에 의해 최초로 로드되어 인스턴스 생성
                li init()
                li 각 요청마다 service() 호출
                li destroy()
                +codeBtn('/Repositories/Eclipse/app1/src/main/java/io/github/donggi/servlet/LifeCycle.java', 'java', [17])

            h2 web.xml 대신 애너테이션으로 서블릿 기술
            ol
                li WebServlet 애너테이션으로 배포설명자 web.xml 대신 간결하게 서블릿을 기술할 수 있다
                +codeBtn('/Repositories/Eclipse/app1/src/main/java/io/github/donggi/servlet/Hello2.java', 'java', [11]) value
