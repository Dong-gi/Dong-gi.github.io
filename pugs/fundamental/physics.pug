    p 관계식만 모으면 이렇다.
    +table()
        +ths('상황', '결과', '조건')
        +tds('굴절', 'n₁ sin θ₁ = n₂ sin θ₂', '두 매질의 평평한 경계')
        +tds('전반사', 'sin θ(c) = n₂/n₁', 'n₁ > n₂ 인 쪽에서 볼 때만')
        +tds('결상', '1/p + 1/q = 1/f,  m = −q/p', '거울·얇은 렌즈, 근축 근사')
