    +table()
        +ths('상황', '결과', '조건')
        +tds('용수철 진동', 'ω = √(k/m),  T = 2π√(m/k)', '탄성 한계 안')
        +tds('진자', 'ω = √(g/L),  T = 2π√(L/g)', '작은 진폭 (sin θ ≈ θ)')
