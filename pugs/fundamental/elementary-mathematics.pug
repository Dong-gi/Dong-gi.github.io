        +tds('정수 식[\\mathbb{Z}]식', '식[3x = 2]식', '분수 — 유리수 식[\\mathbb{Q}]식')
        +tds('유리수 식[\\mathbb{Q}]식', '식[x^2 = 2]식', '무리수 — 실수 식[\\mathbb{R}]식')
