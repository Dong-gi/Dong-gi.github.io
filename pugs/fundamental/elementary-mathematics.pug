    h2 온라인 자료
    ul
        li: +asA('https://openstax.org/details/books/precalculus-2e', 'OpenStax Precalculus 2e — 3~8장에 대응하는 무료 교재')
        li: +asA('https://openstax.org/details/books/calculus-volume-1', 'OpenStax Calculus Volume 1 — 9~11장에 대응')
        li: +asA('https://ocw.mit.edu/courses/18-01-single-variable-calculus-fall-2006/', 'MIT OCW 18.01 Single Variable Calculus — 9~11장 심화')
