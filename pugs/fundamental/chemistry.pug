    p 판정 절차는 이렇게 정리된다.
    +table()
        +ths('묻는 것', '방법', '메모')
        +tds('결합의 종류', '전기음성도 차이', '경계는 편의상의 눈금이다')
        +tds('전자의 배치', '루이스 구조', '바깥부터 채우고 모자라면 결합을 늘린다')
        +tds('구조가 그럴듯한가', '형식전하', '0에 가까울수록 좋다')
