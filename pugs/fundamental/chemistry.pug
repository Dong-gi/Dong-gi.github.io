        +tds('ΔH(용해)', '용해 엔탈피', 'kJ/mol', '≈ 격자 에너지 + 수화 엔탈피. 부호가 갈린다')
        +tds('용해도', 'solubility', 'g/100 g 물, mol/L', '포화 용액의 농도')
        +tds('k(H)', '헨리 상수', 'mol/(L·kPa)', 'c = k(H) P. P 는 그 기체의 분압')
        +tds('b', '몰랄농도', 'mol/kg', '분모는 용매의 질량. 온도에 무관')
        +tds('ppm', '백만분율', '없음', '묽은 수용액에서 1 ppm ≈ 1 mg/L')
