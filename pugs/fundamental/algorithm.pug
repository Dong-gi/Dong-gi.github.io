            while len(힙) &gt; 1:
                왼쪽 = 힙.꺼내기()          # 가장 가벼운 것
                오른쪽 = 힙.꺼내기()        # 그다음
                힙.넣기((왼쪽.빈도 + 오른쪽.빈도, 새_내부노드(왼쪽, 오른쪽)))
