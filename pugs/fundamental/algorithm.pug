    +asCode('python').
        def 이진탐색(a, 값):
            낮은쪽, 높은쪽 = 0, len(a) - 1
            while 낮은쪽 &lt;= 높은쪽:
                가운데 = 낮은쪽 + (높은쪽 - 낮은쪽) // 2
                if a[가운데] == 값:      return 가운데
                if a[가운데] &lt; 값:       낮은쪽 = 가운데 + 1
                else:                     높은쪽 = 가운데 - 1
            return -1
