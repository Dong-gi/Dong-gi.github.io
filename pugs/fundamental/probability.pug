        +tds('모평균', '식[\\sigma]식 를 알면 식[\\bar x \\pm z_{\\alpha/2}\\sigma/\\sqrt n]식, 모르면 식[\\bar x \\pm t_{\\alpha/2}(n-1)s/\\sqrt n]식')
