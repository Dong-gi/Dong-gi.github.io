<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      웹 브라우저라 인터넷을 쓴다. 파일 관리자(iroiro-viewer)와 **다른 앱**으로 둔 까닭이 이것이다 — 인터넷 권한은 앱(UID) 단위라,
      같은 앱이면 모든 파일 권한을 가진 쪽도 네트워크에 닿는다. 이 앱은 저장소 권한을 갖지 않는다(받은 파일은 MediaStore 의 '내려받기').
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      내려받기의 진행·완료 알림(13 이상은 실행 중에 묻는다)과 받는 동안 앱이 죽지 않게 하는 포그라운드 서비스 — 내려받기(DownloadService)·
      녹화·가로채기(CaptureService)·토렌트(TorrentService) 모두 dataSync 다. 서비스의 foregroundServiceType 과 이 권한이 짝이 맞아야 한다(어긋나면
      startForeground 가 예외로 앱을 죽인다).
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!--
      망의 상태 읽기(보통 권한 — 설치 때 주어진다): 광고 목록의 'Wi-Fi 에서만 갱신' 이 지금 망이 요금제인지 보고, 망 조건이 붙은 JobScheduler
      일감은 targetSdk 34 부터 이 권한이 있어야 걸린다.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      토렌트를 화면이 꺼진 채 받는다(사용자 결정, 2026-10-09 — 보통 권한, 설치 때 주어진다): 받는 동안만 부분 wake lock 과(기본 망이 Wi-Fi 면)
      Wi-Fi 잠금을 쥔다(TorrentService). 10분 동안 받은 것이 늘지 않으면 놓는다.
    -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--
      뒤에서 재생 잇기(2026-10-11 사용자 요청 — 유튜브를 앱이 뒤에 있거나 화면이 꺼진 동안 이어 튼다. CLAUDE.md '뒤에서 재생 잇기'): 그 동안의
      포그라운드 서비스(BackgroundPlayService)는 mediaPlayback 이다(보통 권한 — 설치 때 주어진다). 재생 중에는 위의 wake lock 도 쥔다.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!--
      테더링(2026-10-10 — usb-tether 를 합침, CLAUDE.md '테더링'): 폰이 Wi-Fi Direct 그룹 오너가 되고 붙은 기기의 트래픽을 이 폰의 회선으로
      중계한다(프록시를 거치지 않는다 — 이 앱의 '바로 나감' 예외 둘째). 서비스는 specialUse 의 포그라운드 서비스다(아래 TetherService 의
      서브타입 property). Wi-Fi Direct 그룹을 만드는 데 Wi-Fi 상태 읽기·바꾸기와 — 13 이상은 근처 기기(neverForLocation — 위치를 얻는 데 쓰지
      않는다), 12 이하는 **정확한 위치**가 든다. targetSdk 31 이상이 FINE 만 청하면 안드로이드 12 가 그 요청을 무시하므로 COARSE 도 선언하고
      함께 청한다(둘 다 13 부터는 필요 없다 — maxSdkVersion 32). 위치·근처 기기는 테더 화면에서 테더링을 켤 때만 묻는다. 웹 페이지에는 위치를
      주지 않는다(WebViews 의 setGeolocationEnabled(false)·PageChrome 의 거절).
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="33" />

    <!--
      네트워크 보안 설정은 빌드마다 다르다(app/build.gradle.kts 의 자리표시자): 릴리스는 시스템 인증서만 믿고 평문 http 쪽을 허락한다
      (사용자 결정 — 프록시까지는 TLS 다), 디버그는 실험 인증 기관을 lab.test 아래 이름에만 더 믿는다.
    -->
    <application
        android:name=".WebApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="${networkSecurityConfig}"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Web">

        <!-- 세이프 브라우징은 쓰지 않는다(사용자 결정, 2026-10-04 — Play 서비스가 프록시 밖에서 묻는다). WebView 의 사용 통계도 보내지 않는다. -->
        <meta-data
            android:name="android.webkit.WebView.EnableSafeBrowsing"
            android:value="false" />
        <meta-data
            android:name="android.webkit.WebView.MetricsOptOut"
            android:value="true" />

        <!-- 화면을 다시 만들지 않는다(돌리기·밤 모드) — 다시 만들면 탭의 WebView 가 모두 죽는다. -->
        <activity
            android:name=".browser.BrowserActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".settings.SettingsActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".library.LibraryActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".sites.SiteDataActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".download.DownloadsActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false" />

        <activity
            android:name=".adblock.AdBlockActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- 하루 한 번 광고 목록의 만료를 확인한다(JobScheduler). 시스템만 묶을 수 있다. -->
        <service
            android:name=".adblock.AdBlockUpdateJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />

        <service
            android:name=".download.DownloadService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- 녹화·가로채기 동안 앱이 정리되지 않게(알림의 저장·취소). 내보내지 않는다 — 다른 앱이 저장·취소를 부르지 못하게. -->
        <service
            android:name=".browser.CaptureService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          뒤에서 재생 잇기(유튜브) — 알림·잠금 화면·이어폰 단추(미디어 세션). 내보내지 않는다(다른 앱이 단추를 부르지 못하게). 작업이 지워지면(최근
          앱에서 밀기) 함께 멈춘다 — 탭이 사라졌다.
        -->
        <service
            android:name=".browser.BackgroundPlayService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback"
            android:stopWithTask="true" />

        <!--
          토렌트를 받는 동안·다 받은 파일을 '내려받기' 로 옮기는 동안 앱이 정리되지 않게(알림의 일시 정지·이어받기). 내보내지 않는다 — 다른 앱이
          토렌트를 멈추거나 이어받게 하지 못하게. 다른 앱이 건네는 마그넷·.torrent(VIEW 인텐트)는 받지 않는다(사용자 결정 ㉑ — 인텐트 필터 없음).
        -->
        <service
            android:name=".download.TorrentService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          테더링(CLAUDE.md '테더링') — 구성 요소 다섯 모두 따로 된 프로세스 :tether 다. 테더의 상태가 그 프로세스의 정적 필드라(TetherState) 화면·
          타일·트램폴린도 서비스와 같은 프로세스여야 하고, 그 프로세스에는 브라우저의 WebView·중계·프록시 계정이 올라오지 않는다(WebApp.onCreate·
          WebApp.of). 앱의 시험 TetherIsolationTest 가 이 다섯의 프로세스와 내보냄을 본다.

          화면은 내보내지 않는다(브라우저의 메뉴·알림, 그리고 타일을 길게 누를 때 시스템 UI 가 띄우는 작은 화면에서만 연다). 자기 작업
          (taskAffinity)을 따로 둔다 — 알림과 그 작은 화면은 새 작업으로 여는데(NEW_TASK), 브라우저와 같은 작업이면 브라우저의 작업을 앞으로
          가져와 그 위에 열어 뒤로 가면 브라우저가 선다. 메뉴로 열면 브라우저의 작업 위에 열린다(뒤로 가면 브라우저).
        -->
        <activity
            android:name=".tether.TetherActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false"
            android:label="@string/tether_title"
            android:process=":tether"
            android:taskAffinity="io.github.donggi.iroirobrowser.tether"
            android:windowSoftInputMode="adjustResize" />
        <!--
          타일이 테더링을 켤 때 거쳐 가는 보이지 않는 트램폴린(이 앱의 화면이 앞에 있어야 Wi-Fi Direct 그룹이 만들어진다). 내보내지 않는다 —
          다른 앱이 사용자 모르게 핫스팟을 켜지 못하게(HotspotStartActivity 의 머리말).
        -->
        <activity
            android:name=".tether.HotspotStartActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:noHistory="true"
            android:process=":tether"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!--
          퀵 설정 타일을 길게 누르면 시스템 UI 가 여는 화면(QS_TILE_PREFERENCES, API 24) — 테더 화면을 열고 곧바로 끝난다. 시스템 UI 가 자기 uid 로
          띄우므로 내보내야 한다(내보내지 않으면 앱 정보 화면이 열린다). 받은 인텐트를 읽지 않고 핫스팟·서버를 건드리지 않는다 — 누가 띄우든 테더
          화면을 열 뿐이다(TilePreferencesActivity 의 머리말). 테더 화면 자신은 내보내지 않은 채 둔다.
        -->
        <activity
            android:name=".tether.TilePreferencesActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:noHistory="true"
            android:process=":tether"
            android:taskAffinity=""
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE_PREFERENCES" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!--
          서버 셋과 핫스팟 — 떠 있는 것이 곧 테더링이 켜진 것이다(켜기·끄기는 하나 — 사용자 결정 2026-10-10). SOCKS5 1080 은 고정(차 있으면
          옮기지 않는다), HTTP 8282·파일 8080 은 차 있으면 다음 포트로(8291·8089 까지). 최근 앱에서 밀어 없애도 멈추지 않는다(stopWithTask=false —
          usb-tether 그대로). specialUse 의 서브타입은 심사에 내는 자유 글이다 — 손님의 IP 패킷을 넘기지 않고(VpnService 도 쓰지 않는다) 프록시가
          내용만 옮긴다.
        -->
        <service
            android:name=".tether.TetherService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:process=":tether"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="userspace_socks5_and_http_proxy_for_wifi_direct_tethering" />
        </service>
        <!--
          퀵 설정 타일 '테더링' — 누르면 테더링을 통째로 켜고 끈다, 길게 누르면 시스템 UI 가 위의 TilePreferencesActivity 를 연다. 시스템만 묶을 수
          있다(BIND_QUICK_SETTINGS_TILE).
        -->
        <service
            android:name=".tether.HotspotTileService"
            android:exported="true"
            android:icon="@drawable/ic_tether"
            android:label="@string/tether_tile"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:process=":tether">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data
                android:name="android.service.quicksettings.TOGGLEABLE_TILE"
                android:value="true" />
        </service>
    </application>
</manifest>
