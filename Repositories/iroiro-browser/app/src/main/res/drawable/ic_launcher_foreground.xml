<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!--
      지구본 하나 — 웹 브라우저의 가장 흔한 표지(사용자 지정: '웹 브라우저 느낌'). 테두리 원, 가운데 경선 하나와 타원 경선, 적도와
      위선 둘을 흰 선으로 그린다.

      크기는 iroiro-viewer 의 아이콘과 같은 기준으로 잡았다 — 적응형 아이콘의 화폭은 108×108 이지만 런처는 가운데 72×72 의 원만
      보여 준다. 구글 앱들은 그 원의 약 34% 를 그림으로 채운다(viewer 가 서랍에서 재서 맞춘 값). 바깥 지름 43(선 굵기 포함)이면
      (43/72)² = 35.7% 다.
    -->
    <!-- 테두리. 반지름 20 + 선 3 의 절반 → 바깥 21.5. -->
    <path
        android:pathData="M34,54a20,20 0,1 0,40 0a20,20 0,1 0,-40 0"
        android:strokeWidth="3"
        android:strokeColor="#FFFFFF" />
    <!-- 타원 경선. -->
    <path
        android:pathData="M45.5,54a8.5,20 0,1 0,17 0a8.5,20 0,1 0,-17 0"
        android:strokeWidth="2.4"
        android:strokeColor="#FFFFFF" />
    <!-- 가운데 경선·적도. -->
    <path
        android:pathData="M54,34V74M34,54H74"
        android:strokeWidth="2.4"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />
    <!-- 위선 둘 — 적도에서 11 떨어진 자리의 현(반지름 20 원 안에서 반폭 √(400-121) ≈ 16.7). -->
    <path
        android:pathData="M37.3,43H70.7M37.3,65H70.7"
        android:strokeWidth="2.4"
        android:strokeColor="#FFFFFF"
        android:strokeLineCap="round" />
</vector>
