<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      편집기 화면의 이름(최근 앱 따위)은
      '편집기' 다. 문구의 이름은 모두 editor_ 로 시작한다(Files 의 다른 모듈과 겹치지 않게).
    -->
    <string name="editor_app_name">편집기</string>

    <!-- 여는 동안·못 열 때 -->
    <string name="editor_opening">여는 중…</string>
    <string name="editor_error_caller">파일 화면에서 연 문서만 열 수 있습니다.</string>
    <string name="editor_error_no_document">열 문서가 없습니다.</string>
    <string name="editor_error_read">문서를 읽지 못했습니다.</string>
    <string name="editor_error_too_large">문서가 너무 큽니다(%1$s까지 엽니다).</string>
    <string name="editor_error_no_engine">이 빌드에는 이 형식을 여는 편집기가 들어 있지 않습니다.</string>
    <!--
      렌더러가 죽었을 때(고치던 것이 있었을 때만 잃었을 수 있다고 말한다. 보기 모드에는 잃을 것이 없다). 화면에 '다시 열기' 와
      '다른 앱으로 열기' 가 함께 선다(EditorRules.actions).
    -->
    <string name="editor_error_renderer">편집기가 멈췄습니다.</string>
    <string name="editor_error_renderer_unsaved">편집기가 멈췄습니다. 저장하지 않은 고침은 잃었을 수 있습니다.</string>
    <string name="editor_error_webview">이 기기의 WebView가 필요한 기능을 지원하지 않습니다. Android System WebView를 업데이트하세요.</string>
    <string name="editor_close">닫기</string>
    <!-- 같은 문서를 다시 떠 와 새 편집기로 연다 - 렌더러가 죽었을 때·읽지 못했을 때·암호 물음을 닫았을 때. -->
    <string name="editor_reopen">다시 열기</string>
    <!-- 쪽(엔진)이 띄운 alert·confirm 의 확인 단추 - 기기 언어를 따르는 android.R.string.ok 대신(이 앱 화면은 늘 한국어다). -->
    <string name="editor_ok">확인</string>

    <!-- 보기 모드의 '편집' 단추 - 같은 문서를 편집 모드로 다시 연다. 파일 쪽이 저장 자리를 줬을 때만 보인다. -->
    <string name="editor_switch_to_edit">편집</string>
    <!--
      보기 -> 편집은 원본을 다시 읽어 연 때의 사본과 견준다. 바뀌었으면 지금 파일로 열고 그렇다고 말한다. 읽지 못하면(지워졌다·옮겨졌다)
      보기 그대로 두고 말한다.
    -->
    <string name="editor_reloaded_changed">보던 사이 파일이 바뀌어 지금 파일로 엽니다.</string>
    <string name="editor_switch_unreadable">원본 파일을 읽지 못해 편집으로 바꾸지 못했습니다.</string>

    <!--
      보기 모드·열지 못한 문서의 더보기 - 메뉴의 머리에 파일 이름, 줄에 '다른 앱으로 열기'. 그 문구와 고르는 창의 제목은 core:io 의
      한 벌(io_open_with 따위 - CLAUDE.md '다른 앱으로 열기' R5)을 쓴다.
    -->
    <string name="editor_more">더보기</string>

    <!-- 닫을 때 -->
    <string name="editor_unsaved_title">저장하지 않은 고침이 있습니다</string>
    <string name="editor_unsaved_message">닫기 전에 저장할까요?</string>
    <string name="editor_save">저장</string>
    <string name="editor_discard">버리기</string>
    <string name="editor_cancel">취소</string>
    <string name="editor_save_failed">저장하지 못했습니다.</string>

    <!-- 저장 자리에 반영하지 못했을 때(까닭은 파일 쪽이 보낸다 - app 의 EditorSlots) -->
    <string name="editor_error_slot">저장 자리를 확인하지 못했습니다.</string>
    <string name="editor_save_failed_gone">원본 파일을 찾지 못해 저장하지 못했습니다. 다른 이름으로 저장해 보세요.</string>
    <!-- 파일 쪽이 이 편집 창의 세션을 모른다 - 다른 이름으로 저장해도 같은 까닭으로 실패하므로 내보내기를 권한다. -->
    <string name="editor_save_failed_session">원본 파일과의 연결이 끊겨 저장하지 못했습니다. 고친 것은 내보내기로 남긴 뒤 문서를 다시 여세요.</string>
    <string name="editor_save_failed_space">저장 공간이 모자라 저장하지 못했습니다.</string>
    <string name="editor_save_failed_previous">고치기 전 문서를 휴지통에 남기지 못해 저장하지 않았습니다. 저장 공간을 확인하세요.</string>
    <string name="editor_save_failed_invalid">편집기가 만든 파일의 형식이 맞지 않아 저장하지 않았습니다.</string>
    <string name="editor_save_failed_busy">다른 파일 작업을 하는 중이라 저장하지 못했습니다. 잠시 뒤 다시 저장하세요.</string>
    <string name="editor_save_failed_files">파일에 저장하지 못했습니다.</string>
    <!-- 형식·이름을 바꿔 저장했다 - 원본 곁에 만든 새 파일. %1$s 는 그 이름. -->
    <string name="editor_saved_new_file">새 파일로 저장했습니다: %1$s</string>

    <!-- 인쇄(안드로이드 인쇄 창 — 'PDF로 저장' 포함) -->
    <string name="editor_print_preparing">인쇄할 문서를 준비하는 중…</string>
    <string name="editor_print_failed">인쇄 창을 열지 못했습니다.</string>

    <!-- 내보내기(HTML·Word 문서 — 사용자가 고른 곳에) -->
    <string name="editor_export_done">내보냈습니다: %1$s</string>
    <string name="editor_export_failed">내보내지 못했습니다.</string>
    <string name="editor_export_no_picker">저장할 곳을 고르는 화면을 열지 못했습니다.</string>

    <!-- 문서의 링크 — 첫 줄은 호스트(속는 것을 막으려 따로 보인다), 그다음 주소 전체 -->
    <string name="editor_link_title">링크를 열까요?</string>
    <string name="editor_link_message">%1$s\n\n%2$s\n\n브라우저 앱에서 엽니다.</string>
    <string name="editor_link_open">열기</string>
</resources>
