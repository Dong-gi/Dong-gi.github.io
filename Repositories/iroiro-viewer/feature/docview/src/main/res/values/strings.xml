<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      문서 뷰어. 화면에 나가는 글자는 예외 없이 여기 둔다(저장소 규칙).

      실패 문구가 `OpenFailure` 의 갈래를 그대로 따른다. 그쪽이 sealed 라 갈래가 늘면
      화면의 `when` 이 컴파일 오류로 알려 주고, 그때 여기 한 줄이 함께 는다.
      **`OpenFailure.detail` 은 절대 쓰지 않는다** — 절대경로와 공격자가 심은 문자열이
      거기 들어 있다.
    -->

    <string name="doc_close">닫기</string>
    <!--
      위쪽 막대의 ⋮ (화면 낭독기가 읽는 이름). 그 안의 '다른 앱으로 열기' 는 여기 두지 않는다 — 문구는 그것을 만드는
      `core:io` 의 ExternalOpen 곁에 한 벌만 있다(io_open_with).
    -->
    <string name="doc_more">더보기</string>
    <string name="doc_page_of">%1$d / %2$d</string>

    <string name="doc_jump">쪽으로 가기</string>
    <string name="doc_jump_hint">쪽 번호</string>
    <string name="doc_done">확인</string>
    <string name="doc_cancel">취소</string>

    <string name="doc_resumed">%d쪽부터 이어서 봅니다</string>
    <string name="doc_resumed_chapter">%d장부터 이어서 봅니다</string>
    <string name="doc_restart">처음부터</string>
    <!-- 첫 장 안에서 이어 볼 때. '1장부터' 는 틀린 말이 아니지만 사용자가 본 것은 장이 아니라 자리다. -->
    <string name="doc_resumed_here">읽던 자리부터 이어서 봅니다</string>

    <string name="doc_page_failed">이 쪽을 그릴 수 없습니다</string>

    <!-- EPUB. 쪽이 아니라 '장' 으로 센다 — 장을 화면 크기로 잘라 쪽을 만들면
         글자 크기를 바꿀 때마다 이어보기가 가리키는 자리가 움직인다. -->
    <string name="doc_chapter_of">%1$d / %2$d 장</string>
    <string name="doc_previous_chapter">이전 장</string>
    <string name="doc_next_chapter">다음 장</string>
    <string name="doc_no_toc">목차가 없습니다</string>
    <string name="doc_untitled_chapter">이름 없는 장</string>
    <!--
      고정 레이아웃 쪽이 있는 EPUB 을 처음 열 때 한 번. 글자 크기·여백·바탕이 그 쪽에 걸리지 않는 까닭을 함께 말한다.
      흐름 장이 섞인 책도 있어(흐름 장에는 모양이 걸린다) '책 전체' 가 아니라 '그런 쪽' 이라고 말한다.
    -->
    <string name="doc_fixed_layout_notice">쪽 모양이 고정된 책이라 그런 쪽에는 글자 크기·여백·바탕이 걸리지 않습니다</string>

