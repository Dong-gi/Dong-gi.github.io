    -->
    <string name="doc_failed_unreadable">이 파일을 읽을 수 없습니다</string>
    <!-- PDF 글 고르기. '복사했습니다' 는 안드로이드 12 이하에서만 띄운다(13 부터는 시스템이 보여 준다). -->
