    <!-- %s 는 '같은 이름의 항목 3개' 꼴이다 - 그 뒤에 조사를 붙이지 않고 쌍점 뒤에 둔다(받침에 맞출 수 없다). -->
    <string name="doc_warn_duplicate">같은 이름을 쓰는 항목은 먼저 나온 것을 보여 줍니다: %s</string>
    <string name="doc_warn_obfuscated">내장 글꼴 일부를 풀 수 없어 기본 글꼴로 대신 보입니다</string>
    <string name="doc_warn_other">명세와 다른 곳이 있지만 읽는 데는 지장이 없습니다</string>

    <!--
      암호. 잠근 방식이 공개 명세면(PDF 표준 보안 처리기) 암호를 물어 연다. 공개되지 않은
      방식이나 암호가 아닌 열쇠(인증서)를 요구하는 것은 물어도 소용이 없으므로
      doc_failed_encrypted 로 끝낸다. 둘을 한 문구로 뭉뚱그리면 사용자가 암호를 알면서도
      열 수 없다고 읽거나, 모르는 열쇠를 찾아 헤맨다.
    -->
    <string name="doc_password_title">암호가 걸린 문서</string>
    <string name="doc_password_body">이 문서를 열려면 암호가 필요합니다.</string>
    <string name="doc_password_enter">암호 넣기</string>

    <string name="doc_failed_corrupt">이 문서를 열 수 없습니다</string>
    <string name="doc_failed_password">암호를 넣어야 열 수 있는 문서입니다</string>
    <string name="doc_failed_encrypted">암호로는 열 수 없는 방식으로 잠긴 문서입니다</string>
    <string name="doc_failed_no_permission">읽을 권한이 없습니다</string>
