<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      파일 작업이 도는 동안 프로세스를 붙잡는다. API 34 부터는 선언한
      foregroundServiceType 마다 대응 권한이 **따로** 필요하다 — dataSync 에는
      FOREGROUND_SERVICE_DATA_SYNC 가 있어야 하고, 없으면 startForeground 가
      SecurityException 으로 즉사한다.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <service
            android:name=".FileOpService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!--
          다른 앱으로 파일을 보낼 때만 쓴다. exported=false 이고 권한은 인텐트마다
          읽기 전용으로만 준다(ShareHelper 참고).
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/iro_file_paths" />
        </provider>
    </application>
</manifest>
