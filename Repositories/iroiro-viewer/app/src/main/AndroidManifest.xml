        <!--
          편집기(feature:editor - 따로 된 프로세스 :editor)의 저장 자리(EditorSlotProvider - EditorSlots). 주 프로세스에서 돈다. 내보내지
          않는다 - 이 앱만 닿는다. 편집기가 쓴 것을 반영하라고 부르면 파일 작업 큐로 원본을 바꿔 쓴다(첫 저장이면 고치기 전 판을
          휴지통에). 편집기는 원본에 직접 쓰지 않는다.
          URI 권한도 주지 않는다(grantUriPermissions=false) - 같은 앱(UID)은 권한 없이 닿고, 남에게 열 일이 없다.
        -->
        <provider
            android:name=".EditorSlotProvider"
            android:authorities="${applicationId}.editorslot"
            android:exported="false"
            android:grantUriPermissions="false" />
    </application>
</manifest>
