<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      이 앱은 네트워크를 쓰지 않는다. 선언하지 않는 것으로 끝내지 않고 tools:node="remove"
      까지 두는 것은, 나중에 붙는 라이브러리가 제 매니페스트에서 INTERNET 을 병합해
      들여오는 것을 막기 위해서다. 이 한 줄이 EPUB 의 추적 픽셀, 문서의 외부 참조,
      모든 서드파티의 소켓을 OS 수준에서 동시에 막는다.
      2026-10-05 에 네트워크 저장소(SFTP) 때문에 선언했다가 2026-10-09 에 사용자가 이 앱의 네트워크 기능을 걷기로 해 되돌렸다
      (CLAUDE.md 의 'INTERNET 을 다시 걷었다'). 그동안 세운 겹(잠긴 WebView 의 blockNetworkLoads 명시, 재생기의
      LocalOnlyDataSource, 스크립트 쪽의 CSP)은 그대로 둔다 - 방어는 겹쳐 두어야 한 겹이 무너져도 남는다.
      같은 권한을 uses-permission-sdk-23(API 23 부터만 청하는 모양)으로 들여오는 라이브러리도 있다 - 병합기는 그것을 다른 요소로 보아
      위 줄의 remove 가 닿지 않으므로 그 모양으로도 한 줄 둔다. 병합된 매니페스트에 INTERNET 이 남지 않았는지는
      빌드가 본다(app/build.gradle.kts 의 verify…NoInternet - assemble 이 기다린다).
    -->
    <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
    <uses-permission-sdk-23 android:name="android.permission.INTERNET" tools:node="remove" />

    <!-- 파일 관리자의 본체. 특별 접근 권한이라 설정 화면에서만 켤 수 있다. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />

    <!--
      APK 를 누르면 시스템 설치 관리자에 넘긴다(core:io 의 ExternalOpen). 설치 관리자는 보낸 앱의 targetSdk 가 26
      이상이면 이 권한을 **선언했는지** 보고, 선언하지 않았으면 아무 화면도 없이 닫힌다(RESULT_CANCELED). 우리 쪽
      startActivity 는 성공으로 끝나므로 선언이 빠진 것을 앱이 알아챌 길이 없다. 이 줄을 지우지 마라.
      선언한다고 설치가 되는 것은 아니다. 처음에는 설치 관리자가 '출처를 알 수 없는 앱' 안내(설정으로 가는 단추)를
      띄우고, 사용자가 이 앱을 허용한 뒤에도 설치할 때마다 설치 관리자의 확인 화면을 거친다.
      확인한 범위: API 31 에뮬레이터 이미지의 설치 관리자(com.google.android.packageinstaller, 판 12)를 바이트코드와
      매니페스트로 읽었다. InstallStart.onCreate 의 선언 검사, PackageInstallerActivity.handleUnknownSources 의 허용
      처리, InstallStart 의 VIEW 필터(content 스킴 + application/vnd.android.package-archive)가 그것이다.
      API 35 이미지는 압축된 EROFS 라 읽지 못했고, 거동은 에뮬레이터에서 쟀다(릴리스): 눌러 열면(VIEW) InstallStart 에서
      InstallStaging 을 거쳐 출처 안내가 뜨고(API 31 도 안내까지 같다), 선택 메뉴의 다른 앱으로 열기(CHOOSE)는 받는 앱이
      하나라 고르는 창이 곧바로 넘기는데 설치 관리자가 그것을 우리가 보낸 것으로 받는다.
      이 앱은 스스로 무엇도 설치하지 않는다(PackageInstaller 세션을 열지 않는다).
      2026-10-11 에 Play 프로텍트가 이 앱의 설치를 '유해한 앱' 으로 막아 이 줄을 걷어 보았지만 막힘이 풀리지 않아 되살렸다(사용자 -
      CLAUDE.md 의 '14단계 뒤 - Play 프로텍트의 설치 차단').
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      병합된 매니페스트에는 이 파일에 없는 선언이 하나 더 있다 - core:io 의 queries(패키지 공개 범위). 다른 앱으로 열기가
      '이 형식을 받을 앱이 있는가' 를 물으려면 content URI 를 VIEW 로 받는 앱이 우리에게 보여야 한다. 없으면 모든 앱에서
      고르는 창으로 넓힌다(ExternalOpen 의 ALL_APPS). 그 선언과, 무엇이 보이게 되는지와, 사생활에 대한 판단은 core:io 의
      매니페스트 주석에 있다. 여기에는 적지 않는다 - 묻는 코드가 그 모듈에 있다.
    -->

    <application
        android:name=".IroiroApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.IroiroViewer">

        <!--
          WebView 가 밖으로 보낼 수 있는 것 둘을 끈다. 사용 통계(구글로 가는 WebView 의 기록)와 안전 브라우징(쪽의 주소를 구글에
          묻는다 - 우리 쪽은 기기 안의 파일이고, 모든 WebView 가 설정으로도 끈다). INTERNET 이 없어도 그대로 둔다 - 둘은 이 앱이 아니라
          WebView 꾸러미·구글 플레이 서비스 쪽에서 보낼 수 있다고 보았다(확인하지 않았다 - 끄는 쪽이 안전하다).
        -->
        <meta-data android:name="android.webkit.WebView.MetricsOptOut" android:value="true" />
        <meta-data android:name="android.webkit.WebView.EnableSafeBrowsing" android:value="false" />

        <!--
          회전으로 액티비티를 다시 만들지 않는다. 다시 만들면 뷰어에 넘긴 **메모리 참조**
          목록이 사라져 사진을 보다 화면을 돌리면 한 장짜리로 떨어지고, 갤러리·휴지통을
          보다 돌리면 파일 목록으로 튕긴다. 재생 화면(PlayerActivity)과 같은 값이다.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!--
          다른 앱이 넘긴 파일을 연다(OpenActivity 의 KDoc). 보낸 앱의 태스크에 쌓이고 닫으면 보낸 앱으로 돌아간다 - taskAffinity 를
          비워 두면 보낸 쪽이 새 태스크로 띄워도 우리 파일 목록 위에 얹히지 않는다. 끝나면 최근 앱에서도 사라진다.
          회전으로 다시 만들지 않는 것은 MainActivity 와 같은 까닭이다(뷰어의 메모리 참조). singleTop 인 까닭: 보낸 쪽이 새 태스크로
          띄우면 시스템이 이 화면을 뿌리로 가진 옛 태스크를 다시 쓰는데, 그 맨 위에 새 화면을 쌓지 않고 맨 위의 화면이 새 파일을 받게
          한다(OpenActivity.onNewIntent).

          받는 형식: 그림·소리·영상·글의 계열 전체와, 이 앱이 여는 문서·압축·만화의 형식, application/octet-stream.
          문서에는 편집기의 보기 모드가 보이는 이전 오피스 형식(doc·xls·ppt)과 ODF(odt·ods·odp)도 든다(받은 뒤의 길은
          OpenActivity 의 IncomingRoute 가 정한다).
          시험(ReceiveFiltersTest)이 목록의 문서 확장자와 이 필터를 견준다.
          형식은 소문자로만 적는다 - 안드로이드의 대조는 대소문자를 가리고(CLAUDE.md 함정 표) lint 가 대문자를 오류로 본다
          (AppLinkUrlError). 등록된 이름이 대문자를 쓰는 오피스의 macroEnabled 도 소문자다 - 플랫폼 표가 그렇게 준다.
          APK(application/vnd.android.package-archive)와 글꼴은 적지 않는다 - 이 앱에 뷰어가 없고, 적으면 이 앱의 '다른 앱으로
          열기' 가 이 앱을 다시 고르는 고리가 된다(core:io 의 ExternalOpen KDoc '우리 자신'). 스킴은 content 와 file 둘이다 -
          http(s) 는 받지 않는다(BROWSABLE 도 없다). file 은 저장 볼륨 아래만 연다(IncomingFiles).
        -->
        <activity
            android:name=".OpenActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:autoRemoveFromRecents="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
