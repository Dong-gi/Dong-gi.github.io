# =============================================================================
# squid.conf — 평문 포워드 프록시 (TLS 종단은 stunnel 이 담당)
#
# squid 바이너리가 --with-openssl 없이 빌드된 경우 setup-squid.sh 가 이 템플릿을
# 선택한다. Squid 는 루프백에서만 듣고 외부 노출은 stunnel 이 담당하므로
# 평문 Basic 인증이 네트워크에 노출되지 않는다.
#
# 차이점 요약 (squid-native-tls.conf.tmpl 대비)
#   * https_port → http_port 127.0.0.1:@PORT@
#   * 클라이언트 IP 가 항상 127.0.0.1 로 보인다 (stunnel 이 TCP 를 재생성하므로)
# =============================================================================

# -----------------------------------------------------------------------------
# 수신 포트 — 루프백 전용. 절대 0.0.0.0 으로 바꾸지 말 것.
# -----------------------------------------------------------------------------
http_port 127.0.0.1:@PORT@

# -----------------------------------------------------------------------------
# 인증 — Basic. 외부 구간은 stunnel 의 TLS 로 보호된다.
# -----------------------------------------------------------------------------
auth_param basic program @NCSA_AUTH@ @PASSWD_FILE@
auth_param basic children 8 startup=2 idle=1
auth_param basic realm proxy
auth_param basic credentialsttl 12 hours
auth_param basic casesensitive on

acl authenticated proxy_auth REQUIRED

# -----------------------------------------------------------------------------
# 접근 제어
# -----------------------------------------------------------------------------
acl SSL_ports port 443 8443
acl Safe_ports port 80
acl Safe_ports port 21
acl Safe_ports port 443 8443
acl Safe_ports port 70
acl Safe_ports port 210
acl Safe_ports port 1025-65535
acl Safe_ports port 280
acl Safe_ports port 488
acl Safe_ports port 591
acl Safe_ports port 777
acl CONNECT method CONNECT

http_access deny !Safe_ports
http_access deny CONNECT !SSL_ports
http_access allow localhost manager
http_access deny manager
http_access allow authenticated
http_access deny all

# -----------------------------------------------------------------------------
# 프라이버시
# -----------------------------------------------------------------------------
via off
forwarded_for delete
httpd_suppress_version_string on
request_header_access X-Forwarded-For deny all
request_header_access Via deny all
request_header_access Cache-Control allow all
reply_header_access Via deny all
reply_header_access X-Cache deny all
reply_header_access X-Cache-Lookup deny all
visible_hostname @VISIBLE_HOSTNAME@

# -----------------------------------------------------------------------------
# 캐시 / 로그
# -----------------------------------------------------------------------------
cache deny all
cache_mem 16 MB
access_log none
cache_store_log none
cache_log /var/log/squid/cache.log
logfile_rotate 3

# -----------------------------------------------------------------------------
# DNS / 타임아웃
# -----------------------------------------------------------------------------
dns_nameservers 1.1.1.1 8.8.8.8
positive_dns_ttl 5 minutes
negative_dns_ttl 30 seconds

connect_timeout 20 seconds
read_timeout 5 minutes
request_timeout 2 minutes
client_idle_pconn_timeout 2 minutes
server_idle_pconn_timeout 2 minutes
half_closed_clients off
shutdown_lifetime 5 seconds
request_body_max_size 0 KB

pid_filename /run/squid.pid
coredump_dir /var/spool/squid
