# 정서조절이 끼어들 수 있는 자리들 — 심리학 16장.
#
# 무엇을 읽어야 하나: 조절이 한 가지가 아니라 정서가 만들어지는 과정의
# 여러 지점에 끼어든다는 것, 그리고 이른 지점과 늦은 지점의 대가가 다르다는 것.
#
# 배치: 2칸 × 5줄. 첫 칸에 정서가 만들어지는 네 단계를 위에서 아래로 두고,
# 둘째 칸의 조절 전략이 같은 줄의 단계로 화살표를 보낸다. 상황 고르기와 상황 바꾸기는
# 둘 다 ‘상황’ 에 끼어들므로 한 칸에 겹쳐 두었다(테두리 없는 묶음).
grid-rows: 5
grid-columns: 2
horizontal-gap: 80
vertical-gap: 60

s1: { label: "상황"; style.bold: true }
상황쪽: {
  label: ""
  style.stroke: transparent
  style.fill: transparent
  grid-columns: 1
  grid-gap: 20
  r1: { label: "상황 고르기\n그 상황에 들어갈지 말지를 미리 정한다" }
  r2: { label: "상황 바꾸기\n들어가되 조건을 바꾼다" }
}
s2: { label: "주의"; style.bold: true }
r3: { label: "주의 옮기기\n무엇을 볼지 바꾼다" }
s3: { label: "뜻매김\n그 상황을 무엇으로 보는가"; style.bold: true }
r4: { label: "달리 보기\n그 상황이 무엇인지를 다시 뜻매김한다"; style.bold: true }
s4: { label: "반응\n몸 · 표정 · 행동"; style.bold: true }
r5: { label: "반응 누르기\n이미 일어난 반응을 겉으로 안 나오게 한다"; style.bold: true }

비교: {
  label: "　\n달리 보기와 반응 누르기를 견준 연구가 많다.\n대체로 앞쪽이 더 나은 결과와 관련되고,\n뒤쪽은 겉으로 드러나는 것은 줄이면서\n몸의 각성은 줄이지 못한다는 보고가 있다.\n\n다만 이 비교의 자료 상당수가\n상관 연구이거나 실험실의 짧은 과제다.\n그리고 맥락이 정한다 — 지금 이 자리에서\n표정을 누르는 것이 맞는 상황이 있다"
  shape: text
}

s1 -> s2 -> s3 -> s4

상황쪽.r1 -> s1
상황쪽.r2 -> s1
r3 -> s2
r4 -> s3
r5 -> s4

s4 -> 비교: { style.stroke-dash: 3 }
