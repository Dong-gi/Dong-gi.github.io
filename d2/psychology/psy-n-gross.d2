# 정서조절이 끼어들 수 있는 자리들 — 심리학 16장.
#
# 무엇을 읽어야 하나: 조절이 한 가지가 아니라 정서가 만들어지는 과정의
# 여러 지점에 끼어든다는 것, 그리고 이른 지점과 늦은 지점의 대가가 다르다는 것.
direction: right

s1: { label: "상황"; style.bold: true }
s2: { label: "주의"; style.bold: true }
s3: { label: "뜻매김\n그 상황을 무엇으로 보는가"; style.bold: true }
s4: { label: "반응\n몸 · 표정 · 행동"; style.bold: true }

s1 -> s2 -> s3 -> s4

r1: { label: "상황 고르기\n그 상황에 들어갈지 말지를 미리 정한다" }
r2: { label: "상황 바꾸기\n들어가되 조건을 바꾼다" }
r3: { label: "주의 옮기기\n무엇을 볼지 바꾼다" }
r4: { label: "달리 보기\n그 상황이 무엇인지를 다시 뜻매김한다"; style.bold: true }
r5: { label: "반응 누르기\n이미 일어난 반응을 겉으로 안 나오게 한다"; style.bold: true }

r1 -> s1
r2 -> s1
r3 -> s2
r4 -> s3
r5 -> s4

비교: {
  label: "　\n달리 보기와 반응 누르기를 견준 연구가 많다. 대체로 앞쪽이 더 나은 결과와 관련되고,\n뒤쪽은 겉으로 드러나는 것은 줄이면서 몸의 각성은 줄이지 못한다는 보고가 있다.\n\n다만 이 비교의 자료 상당수가 상관 연구이거나 실험실의 짧은 과제다.\n그리고 맥락이 정한다 — 지금 이 자리에서 표정을 누르는 것이 맞는 상황이 있다"
  shape: text
}
s4 -> 비교: { style.stroke-dash: 3 }
