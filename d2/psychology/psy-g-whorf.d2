# 워프 가설 — 강한 판본과 약한 판본을 갈라야 한다. 심리학 11장.
#
# 무엇을 읽어야 하나: 두 판본이 서로 다른 주장이고 판정도 다르다는 것.
# 이 둘을 뭉뚱그리면 틀린 것을 가르치게 된다.
#
# 배치: 폭을 줄이려고 긴 글을 여러 줄로 나눴고, 높이를 줄이려고 두 판본 묶음 안을
# 격자(grid-columns: 1)로 촘촘히 쌓았다.
direction: down

가설: {
  label: "언어 상대성 —\n쓰는 언어가 생각에 영향을 준다"
  shape: oval
  style.bold: true
}

강: {
  label: "강한 판본 — 언어 결정론"
  grid-columns: 1
  grid-gap: 40
  s1: { label: "주장 — 언어가 사고를 결정한다.\n언어에 구별이 없으면\n그 구별을 생각할 수 없다"; style.bold: true }
  s2: { label: "판정 — 지지되지 않는다"; style.bold: true }
  s3: { label: "왜 — 낱말이 없는 구별도 배울 수 있고,\n필요하면 새 낱말을 만들거나 풀어서 말한다.\n말을 배우기 전의 아기와\n말이 없는 동물도 범주를 만든다.\n번역이 어려울 수는 있어도 불가능하지 않다" }
  s1 -> s2 -> s3
}

약: {
  label: "약한 판본"
  grid-columns: 1
  grid-gap: 40
  w1: { label: "주장 — 언어가 어떤 과제를\n어떻게 푸는지에 영향을 준다.\n언어가 준 구별이 그 과제에서 도구로 쓰인다"; style.bold: true }
  w2: { label: "판정 — 일부 지지된다.\n다만 효과는 대개 작고 조건이 붙는다"; style.bold: true }
  w3: { label: "지지하는 결과 —\n색을 두 이름으로 갈라 부르는 언어의 화자가\n그 경계를 넘는 색 짝을\n조금 더 빨리 가려낸다는 보고.\n방향을 늘 동서남북으로 말하는 언어의 화자가\n방향 과제를 다르게 푼다는 보고.\n정확한 수 낱말이 없는 언어에서\n큰 수의 정확한 대응 과제가 어려워진다는 보고" }
  w4: { label: "결정적인 단서 — 그런 이점은\n말로 하는 일을 함께 시켜 막으면 대개 사라진다.\n이것은 언어가 사고 자체를 바꾼 것이 아니라\n‘과제를 푸는 도구로 쓰였다’ 는 쪽을 가리킨다"; style.bold: true }
  w1 -> w2 -> w3 -> w4
}

가설 -> 강
가설 -> 약

정리: {
  label: "정확히 적으면"
  direction: down
  a: { label: "말할 수 있는 것 — ‘언어가 어떤 과제에서\n무엇을 쓰기 쉽게 만든다.’\n효과는 작고, 과제와 조건에 딸려 있다"; style.bold: true }
  b: { label: "말할 수 없는 것 — ‘그 언어를 쓰는 사람은\n그렇게 생각할 수밖에 없다.’\n이것은 자료가 지지하지 않는다"; style.bold: true }
  c: { label: "그리고 이 논쟁은 진행 중이다.\n어느 결과가 어디까지 버티는지는 항목마다 다르고,\n문법적 성처럼 결과가 갈리는 자리도 있다" }
  a -> c
  b -> c
}
강 -> 정리
약 -> 정리
