# 이중과정 — 무엇이 쓸모 있고 무엇이 흔들렸나. 심리학 10장.
#
# 무엇을 읽어야 하나: 틀로서의 쓸모와 흔들린 자리의 판정이 다르다는 것.
# 틀이 쓸모 있다는 것과 그 틀로 얻은 결과들이 버틴다는 것은 다른 이야기다.
direction: down

틀: {
  label: "널리 쓰이는 구분"
  direction: right
  a: { label: "빠르고 저절로 일어나는 처리\n애쓰지 않아도 일어나고, 여러 가지가 한꺼번에 진행되며,\n결과만 의식에 떠오른다\n보기 — 익은 얼굴을 알아보는 일, 모국어 문장을 알아듣는 일"; style.bold: true }
  b: { label: "느리고 애써서 하는 처리\n주의를 잡아먹고, 한 번에 하나씩 가며,\n중간 단계를 스스로 따라갈 수 있다\n보기 — 처음 보는 규칙을 따라 계산하는 일"; style.bold: true }
}

쓸모: {
  label: "이 구분이 하는 일 — 다수설"
  direction: down
  u1: { label: "서로 다른 과제들을 하나로 묶어 준다.\n주의를 다른 데 쓰게 하거나 시간을 촉박하게 하면 판단이 한쪽으로 기운다는 결과가\n여러 절차에서 되풀이되었다"; style.bold: true }
  u2: { label: "그래서 연구를 조직하는 틀로는 널리 쓰인다.\n무엇을 조작해 볼지, 무엇과 무엇을 견줄지를 정해 준다" }
  u1 -> u2
}

비판: {
  label: "그런데 크게 흔들렸다"
  direction: down
  k1: { label: "1. 성질들이 함께 가지 않는다\n빠름 · 저절로 일어남 · 의식되지 않음 · 여럿을 한꺼번에 — 이 성질들이\n한 묶음으로 붙어 다닌다는 근거가 약하다는 지적이 이어졌다"; style.bold: true }
  k2: { label: "2. 순환에 빠지기 쉽다\n어느 쪽 처리였는지를 결과를 보고 정하면, 이 틀은 어떤 결과든 뒤에서 설명하게 되고\n미리 무엇을 금지하지 못한다. 금지하지 못하는 틀은 검사할 수 없다"; style.bold: true }
  k3: { label: "3. 이 틀로 얻은 개별 결과 다수가 재현에 실패했다\n자아 고갈, 사회적 점화가 대표적이다. 이 문서 6장이 그 사례를 다뤘다"; style.bold: true }
  k4: { label: "가장 강한 형태의 반론(이 틀을 지지하는 쪽) —\n‘두 체계’ 를 실재하는 기관으로 읽는 것이 애초에 잘못이고,\n이것은 처리의 두 성격을 가리키는 이름일 뿐이며,\n그 성격 차이를 조작하는 실험 자체는 잘 되풀이된다는 것" }
  k1 -> k4
  k2 -> k4
  k3 -> k4
}

쓰는법: {
  label: "이 문서가 쓰는 방식"
  direction: down
  w1: { label: "쓴다 — ‘애쓰지 않고 나오는 판단’ 과 ‘따져서 나오는 판단’ 을 나누는 말로"; style.bold: true }
  w2: { label: "쓰지 않는다 — 머릿속에 두 개의 체계가 확정된 사실처럼.\n‘체계 1이 그렇게 시켰다’ 는 설명이 아니라 이름 붙이기다"; style.bold: true }
  w3: { label: "그리고 이 틀에 기대어 소개되는 개별 결과는 그 결과의 재현 상태를 따로 확인한다.\n틀이 유용하다는 것이 그 아래 결과들을 보증하지 않는다" }
  w1 -> w3
  w2 -> w3
}

틀 -> 쓸모
틀 -> 비판
쓸모 -> 쓰는법
비판 -> 쓰는법
