# 이중과정 — 무엇이 쓸모 있고 무엇이 흔들렸나. 심리학 10장.
#
# 무엇을 읽어야 하나: 틀로서의 쓸모와 흔들린 자리의 판정이 다르다는 것.
# 틀이 쓸모 있다는 것과 그 틀로 얻은 결과들이 버틴다는 것은 다른 이야기다.
#
# 배치(2026-11 폭을 줄이려 2×2 격자에서 바꿨다): 구분을 맨 위에, 쓸모와 흔들린 자리를 나란히, 쓰는 방식을 맨 아래에 둔다.
direction: down

틀: {
  label: "널리 쓰이는 구분"
  grid-rows: 1
  grid-columns: 2
  grid-gap: 40
  a: { label: "빠르고 저절로 일어나는 처리\n애쓰지 않아도 일어나고,\n여러 가지가\n한꺼번에 진행되며,\n결과만 의식에 떠오른다\n보기 — 익은 얼굴을\n알아보는 일,\n모국어 문장을 알아듣는 일"; style.bold: true }
  b: { label: "느리고 애써서 하는 처리\n주의를 잡아먹고,\n한 번에 하나씩 가며,\n중간 단계를\n스스로 따라갈 수 있다\n보기 — 처음 보는 규칙을\n따라 계산하는 일"; style.bold: true }
}

쓸모: {
  label: "이 구분이 하는 일 — 다수설"
  grid-columns: 1
  grid-gap: 50
  u1: { label: "서로 다른 과제들을\n하나로 묶어 준다.\n주의를 다른 데\n쓰게 하거나\n시간을 촉박하게 하면\n판단이 한쪽으로\n기운다는 결과가\n여러 절차에서\n되풀이되었다"; style.bold: true }
  u2: { label: "그래서 연구를 조직하는\n틀로는 널리 쓰인다.\n무엇을 조작해 볼지,\n무엇과 무엇을\n견줄지를 정해 준다" }
  u1 -> u2
}

비판: {
  label: "그런데 크게 흔들렸다"
  grid-rows: 2
  grid-columns: 2
  grid-gap: 50
  k1: { label: "1. 성질들이\n함께 가지 않는다\n빠름 ·\n저절로 일어남 ·\n의식되지 않음 ·\n여럿을 한꺼번에 —\n이 성질들이\n한 묶음으로\n붙어 다닌다는\n근거가 약하다는\n지적이 이어졌다"; style.bold: true }
  k2: { label: "2. 순환에 빠지기 쉽다\n어느 쪽 처리였는지를\n결과를 보고 정하면,\n이 틀은 어떤 결과든\n뒤에서 설명하게 되고\n미리 무엇을\n금지하지 못한다.\n금지하지 못하는 틀은\n검사할 수 없다"; style.bold: true }
  k3: { label: "3. 이 틀로 얻은\n개별 결과 여럿이\n재현에 실패했다\n자아 고갈,\n사회적 점화가\n대표적이다.\n이 문서 6장이\n그 사례를 다뤘다"; style.bold: true }
  k4: { label: "가장 강한 형태의\n반론(이 틀을\n지지하는 쪽) —\n‘두 체계’ 를\n실재하는 기관으로\n읽는 것이\n애초에 잘못이고,\n이것은 처리의\n두 성격을\n가리키는 이름일\n뿐이며,\n그 성격 차이를\n조작하는\n실험 자체는\n잘 되풀이된다는 것" }
  k1 -> k4
  k2 -> k4
  k3 -> k4
}

쓰는법: {
  label: "이 문서가 쓰는 방식"
  # w3 을 w1 과 w2 사이에 두어 두 화살표가 다른 칸을 가로지르지 않게 했다(2026-11 세로 한 줄에서 가로 한 줄로).
  grid-rows: 1
  grid-columns: 3
  grid-gap: 50
  w1: { label: "쓴다 — ‘애쓰지 않고\n나오는 판단’ 과\n‘따져서 나오는 판단’ 을\n나누는 말로"; style.bold: true }
  w3: { label: "그리고 이 틀에 기대어\n소개되는 개별 결과는\n그 결과의 재현 상태를\n따로 확인한다.\n틀이 유용하다는 것이\n그 아래 결과들을\n보증하지 않는다" }
  w2: { label: "쓰지 않는다 — 머릿속에\n두 개의 체계가\n확정된 사실처럼.\n‘체계 1이 그렇게 시켰다’ 는\n설명이 아니라\n이름 붙이기다"; style.bold: true }
  w1 -> w3
  w2 -> w3
}

틀 -> 쓸모
틀 -> 비판
쓸모 -> 쓰는법
비판 -> 쓰는법
