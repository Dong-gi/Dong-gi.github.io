# 언어의 층위 — 심리학 11장.
#
# 무엇을 읽어야 하나: 아래에서 위로 갈수록 ‘무엇을 세는가’ 가 달라진다는 것.
# 그리고 층마다 다른 종류의 규칙이 있어서, 한 층을 다 안다고 위층이 따라오지 않는다.
direction: up

음소: {
  label: "음소\n뜻을 갈라 주는 가장 작은 소리 단위.\n어떤 두 소리가 다른 음소인지는 언어마다 다르다 —\n한 언어에서 다른 낱말을 만드는 소리 차이가\n다른 언어에서는 같은 소리의 변이일 뿐이다"
  style.bold: true
}
형태소: {
  label: "형태소\n뜻을 가진 가장 작은 단위.\n낱말과 같지 않다. ‘먹었다’ 는 한 낱말이지만\n뜻을 가진 조각이 여럿 들어 있다"
  style.bold: true
}
낱말: {
  label: "낱말\n형태소가 모여 이룬 단위.\n무엇을 한 낱말로 셀지가 언어마다 다르고,\n이 점이 11장 뒤쪽에서 다시 중요해진다"
  style.bold: true
}
통사: {
  label: "통사\n낱말을 배열해 문장을 만드는 규칙.\n같은 낱말을 다르게 배열하면 다른 뜻이 되고,\n어떤 배열은 아예 문장이 되지 않는다"
  style.bold: true
}
의미: {
  label: "의미\n문장이 무엇을 말하는가.\n낱말의 뜻을 다 알아도 문장의 뜻이 저절로 나오지 않는다"
  style.bold: true
}
화용: {
  label: "화용\n그 상황에서 그 말이 무엇을 하는가.\n‘소금 있어요’ 는 형태로는 물음이지만 하는 일은 부탁이다.\n뜻을 다 알아도 이것을 놓칠 수 있다"
  style.bold: true
}

음소 -> 형태소 -> 낱말 -> 통사 -> 의미 -> 화용

성질: {
  label: "이 층 구조가 주는 것"
  direction: down
  a: { label: "적은 수의 소리 단위로 수많은 낱말을 만들고,\n그 낱말들로 ‘이제까지 아무도 말한 적 없는 문장’ 을 만든다.\n이것을 생산성이라 부른다"; style.bold: true }
  b: { label: "소리와 뜻 사이에 필연적인 연결이 없다.\n같은 것을 언어마다 전혀 다른 소리로 부른다" }
  a -> b
}
화용 -> 성질: { style.stroke-dash: 3 }
