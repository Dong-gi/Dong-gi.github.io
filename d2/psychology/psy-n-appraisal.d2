# 평가 — 같은 사건이 다른 반응을 내는 자리. 심리학 16장.
#
# 무엇을 읽어야 하나: 사건에서 반응으로 곧장 가는 화살표가 없다는 것.
# 사이에 두 번의 평가가 있고, 사람마다 다른 곳이 거기다.
direction: right

사건: {
  label: "같은 사건\n예 — 다음 주에 여러 사람 앞에서 발표를 해야 한다"
  shape: oval
  style.bold: true
}

일차: {
  label: "1차 평가\n이것이 나에게 무엇인가"
  direction: down
  a: { label: "무관하다" }
  b: { label: "좋은 일이다" }
  c: { label: "위협이거나 도전이다"; style.bold: true }
}

이차: {
  label: "2차 평가\n내가 무엇을 할 수 있는가"
  direction: down
  d: { label: "쓸 수 있는 것이 있다 — 시간 · 준비 · 도와줄 사람 · 해 본 경험" }
  e: { label: "쓸 수 있는 것이 별로 없다" }
}

대처: {
  label: "대처"
  direction: down
  f: { label: "문제중심 — 상황 자체를 바꾸려 한다.\n준비를 나눠 하고 자료를 구하고 도움을 청한다" }
  g: { label: "정서중심 — 상황에 대한 내 반응 쪽을 다룬다.\n달리 보기, 잠시 떼어 놓기, 이야기하기" }
  h: { label: "어느 쪽이 낫다는 순서가 있는 것이 아니다.\n바꿀 수 있는 상황에서는 앞쪽이, 바꿀 수 없는 상황에서는 뒤쪽이 대체로 맞는다"; style.bold: true }
  f -> h
  g -> h
}

사건 -> 일차 -> 이차 -> 대처

요점: {
  label: "　\n이 그림의 요점 — 사건의 크기가 반응의 크기를 정하지 않는다.\n그래서 ‘무엇이 스트레스를 주는가’ 는 사건 목록으로 답할 수 없는 물음이다"
  shape: text
}
대처 -> 요점: { style.stroke-dash: 3 }
