# 주의 — 무엇이 걸러지고 무엇이 남는가. 심리학 12장.
#
# 무엇을 읽어야 하나: 변화맹과 부주의맹이 별난 실패가 아니라 이 구조에서
# 따라 나온다는 것. 그리고 그 실험들이 실제로 보인 것과 보이지 않은 것.
#
# 배치: 폭을 줄이려고 ‘무엇이 고르기를 정하는가’ 의 세 항목을 세로로 쌓고(grid-columns: 1),
# 긴 글은 여러 줄로 나눴다. 셋째 단은 ‘무엇이 고르기를 정하는가’ · 골라지지 않은 것 · 골라진 것 차례다.
direction: down

입력: {
  label: "감각 표면에 닿은 것\n지금 눈에 들어오는 모든 것"
  shape: oval
  style.bold: true
}

고르기: {
  label: "고르기 (선택적 주의)"
  style.bold: true
}
입력 -> 고르기

무엇이: {
  label: "무엇이 고르기를 정하는가"
  grid-columns: 1
  grid-gap: 16
  n1: { label: "지금 하고 있는 과제" }
  n2: { label: "갑자기 나타나거나 움직인 것" }
  n3: { label: "자기 이름처럼 특별히 다뤄지는 것" }
}
고르기 -> 무엇이: { style.stroke-dash: 3 }

버린것: {
  label: "골라지지 않은 것 —\n아주 거칠게만 남거나 남지 않는다"
  style.bold: true
}
남은것: {
  label: "골라진 것 —\n자세히 표상되고\n나중에 보고할 수 있다"
  style.bold: true
}
# 버린것을 가운데 두려고 먼저 적고 먼저 잇는다 — 그 아래 부주의맹·변화맹이 그림 가운데로 와서 폭이 준다.
고르기 -> 버린것
고르기 -> 남은것

부주의맹: {
  label: "부주의맹\n다른 것을 세고 있는 동안\n화면 가운데를 지나간 뚜렷한 물체를\n상당수의 사람이 보고하지 못한다"
}
변화맹: {
  label: "변화맹\n장면이 잠깐 끊긴 사이에 큰 것이 바뀌어도\n바뀐 곳을 주의해 보고 있지 않으면\n알아채지 못한다"
}
버린것 -> 부주의맹
버린것 -> 변화맹

과장: {
  label: "　\n여기서 넘어가면 안 되는 선 —\n\n이 결과들은 ‘사람은 거의 아무것도 보지 못한다’ 를\n뜻하지 않는다. 보인 것은 ‘주의하지 않은 것의 변화를\n알아채지 못한다’ 는 좁은 주장이다.\n\n그리고 이 결과들 자체가 네 물음에 다르게 답한다 —\n효과는 여러 연구실에서 되풀이 나왔고\n표본도 넓은 편이지만, 실험실 과제 밖의\n어떤 행동에 대응하는지는 과제마다 따로 보여야 한다"
  shape: text
}
부주의맹 -> 과장: { style.stroke-dash: 3 }
변화맹 -> 과장: { style.stroke-dash: 3 }

덧: {
  label: "　\n덧붙일 것 하나 — 사람들은 자기가\n그런 변화를 알아챌 것이라고 실제보다 크게 예상한다.\n이것에도 이름이 붙어 있다(변화맹 맹시).\n지각의 한계를 지각이 알려 주지 않는다는 뜻이다"
  shape: text
}
과장 -> 덧: { style.stroke-dash: 3 }
