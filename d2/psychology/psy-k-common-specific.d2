# 무엇이 효과를 내는가 — 공통요인과 특정성분. 심리학 19장.
#
# 무엇을 읽어야 하나: 위의 문장은 정설이고 아래의 갈림은 미결이라는 것.
# 두 층을 섞으면 ‘효과가 있는지’ 와 ‘무엇 때문인지’ 가 한 물음이 되어 버린다.
#
# 배치(2026-11 폭과 높이를 줄이려 묶음 안을 격자로 접었다): 두 쪽은 각각 2칸 × 2줄로, 첫 줄 왼쪽에서 오른쪽,
# 둘째 줄 왼쪽에서 오른쪽으로 읽는다. 도도새 판결은 세 칸을 가로 한 줄로 놓았다.
vars: { d2-config: { layout-engine: elk } }
direction: down

정설: {
  label: "정설 — 심리치료는 효과가 있다\n무처치나 대기자와 견준\n무선배정 시험이 많고,\n종합에서 이득이 되풀이 보고되었다"
  shape: oval
  style.bold: true
}

미결: {
  label: "미결 — 그러면 무엇이\n그 효과를 내는가"
  shape: oval
  style.bold: true
}
정설 -> 미결

공통: {
  label: "공통요인 쪽"
  grid-rows: 2
  grid-columns: 2
  grid-gap: 40
  a: { label: "주장 — 계열이 달라도\n함께 들어 있는\n것들이 효과의\n큰 몫을 낸다" }
  b: { label: "후보 — 치료 동맹,\n나아질 것이라는\n기대, 무슨 일이\n왜 일어나는지\n설명해 주는 틀,\n치료자 개인의 차이"; style.bold: true }
  c: { label: "근거 — 계열끼리\n견준 시험에서\n차이가 대체로 작다.\n그리고 동맹의 질이\n결과와 관련된다는\n보고가 되풀이 나왔다" }
  d: { label: "약한 자리 —\n동맹과 결과의\n관계는 대부분\n상관이다.\n좋아지고 있어서\n동맹이 좋아졌을\n수도 있다. 방향이\n확인되지 않았다"; style.bold: true }
  a -> b -> c -> d
}

특정: {
  label: "특정성분 쪽"
  grid-rows: 2
  grid-columns: 2
  grid-gap: 40
  e: { label: "주장 —\n어떤 문제에는\n특정한 절차가\n실제로 더 낫다" }
  f: { label: "근거 — 성분을 빼고\n나머지를 그대로\n두는 해체 설계에서\n결과가 달라지는\n경우가 있고,\n어떤 비교 시험에서는\n계열 사이에\n차이가 나온다"; style.bold: true }
  g: { label: "약한 자리 —\n해체 설계는 표본이\n커야 하는데\n실제로는 작다.\n작은 차이를 잡을\n검정력이 모자라면\n‘차이가 없다’ 가\n아니라\n‘못 잡았다’ 이다"; style.bold: true }
  e -> f -> g
}

미결 -> 공통
미결 -> 특정

도도새: {
  label: "이른바 도도새 판결"
  grid-rows: 1
  grid-columns: 3
  grid-gap: 50
  h: { label: "이름의 유래 — 동화에서\n도도새가 경주를 끝내며\n‘모두가 이겼고\n모두 상을 받아야 한다’ 고\n말한다.\n계열끼리 견주면\n승자가 없다는 관찰에\n이 이름이 붙었다" }
  i: { label: "정확한 지위 —\n‘모두 같다’ 가 아니다.\n‘차이가 있어도 대체로 작고,\n있는 차이가\n설계와 얽혀 있다’ 가\n자료에 맞는 요약이다"; style.bold: true }
  j: { label: "얽힌 것 하나 —\n연구자 충성도.\n비교 시험의 결과가\n연구자가 어느 계열에\n속하는가와 관련된다는\n보고가 되풀이 나왔다.\n4장의 실험자 기대가\n시험 수준에서 나타난 것이다"; style.bold: true }
  h -> i -> j
}
공통 -> 도도새: { style.stroke-dash: 3 }
특정 -> 도도새: { style.stroke-dash: 3 }

정리: {
  label: "　\n이 문서가 적는 방식 —\n‘효과가 있다’ 는 그냥 적고,\n‘무엇 때문인가’ 는 입장을 나란히 놓는다.\n저자가 고르지 않는다"
  shape: text
}
도도새 -> 정리
