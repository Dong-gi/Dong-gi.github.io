# 무엇이 효과를 내는가 — 공통요인과 특정성분. 심리학 19장.
#
# 무엇을 읽어야 하나: 위의 문장은 정설이고 아래의 갈림은 미결이라는 것.
# 두 층을 섞으면 ‘효과가 있는지’ 와 ‘무엇 때문인지’ 가 한 물음이 되어 버린다.
direction: down

정설: {
  label: "정설 — 심리치료는 효과가 있다\n무처치나 대기자와 견준 무선배정 시험이 많고, 종합에서 이득이 되풀이 보고되었다"
  shape: oval
  style.bold: true
}

미결: {
  label: "미결 — 그러면 무엇이 그 효과를 내는가"
  shape: oval
  style.bold: true
}
정설 -> 미결

공통: {
  label: "공통요인 쪽"
  direction: down
  a: { label: "주장 — 계열이 달라도 함께 들어 있는 것들이 효과의 큰 몫을 낸다" }
  b: { label: "후보 — 치료 동맹, 나아질 것이라는 기대,\n무슨 일이 왜 일어나는지 설명해 주는 틀, 치료자 개인의 차이"; style.bold: true }
  c: { label: "근거 — 계열끼리 견준 시험에서 차이가 대체로 작다.\n그리고 동맹의 질이 결과와 관련된다는 보고가 되풀이 나왔다" }
  d: { label: "약한 자리 — 동맹과 결과의 관계는 대부분 상관이다.\n좋아지고 있어서 동맹이 좋아졌을 수도 있다. 방향이 확인되지 않았다"; style.bold: true }
  a -> b -> c -> d
}

특정: {
  label: "특정성분 쪽"
  direction: down
  e: { label: "주장 — 어떤 문제에는 특정한 절차가 실제로 더 낫다" }
  f: { label: "근거 — 성분을 빼고 나머지를 그대로 두는 해체 설계에서\n결과가 달라지는 경우가 있고, 어떤 비교 시험에서는 계열 사이에 차이가 나온다"; style.bold: true }
  g: { label: "약한 자리 — 해체 설계는 표본이 커야 하는데 실제로는 작다.\n작은 차이를 잡을 검정력이 모자라면 ‘차이가 없다’ 가 아니라 ‘못 잡았다’ 이다"; style.bold: true }
  e -> f -> g
}

미결 -> 공통
미결 -> 특정

도도새: {
  label: "이른바 도도새 판결"
  direction: down
  h: { label: "이름의 유래 — 동화에서 도도새가 경주를 끝내며 ‘모두가 이겼고 모두 상을 받아야 한다’ 고 말한다.\n계열끼리 견주면 승자가 없다는 관찰에 이 이름이 붙었다" }
  i: { label: "정확한 지위 — ‘모두 같다’ 가 아니다.\n‘차이가 있어도 대체로 작고, 있는 차이가 설계와 얽혀 있다’ 가 자료에 맞는 요약이다"; style.bold: true }
  j: { label: "얽힌 것 하나 — 연구자 충성도.\n비교 시험의 결과가 연구자가 어느 계열에 속하는가와 관련된다는 보고가 되풀이 나왔다.\n4장의 실험자 기대가 시험 수준에서 나타난 것이다"; style.bold: true }
  h -> i -> j
}
공통 -> 도도새: { style.stroke-dash: 3 }
특정 -> 도도새: { style.stroke-dash: 3 }

정리: {
  label: "　\n이 문서가 적는 방식 — ‘효과가 있다’ 는 그냥 적고,\n‘무엇 때문인가’ 는 입장을 나란히 놓는다. 저자가 고르지 않는다"
  shape: text
}
도도새 -> 정리
