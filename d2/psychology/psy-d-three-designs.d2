# 발달을 재는 세 설계 — 심리학 15장.
#
# 무엇을 읽어야 하나: 설계마다 나이와 붙어 다니는 것이 다르다는 것.
# 어느 설계도 셋(나이 · 출생 연도 · 측정 연도)을 한꺼번에 갈라내지 못한다.
direction: down

물음: {
  label: "물음 — 나이가 들면 무엇이 달라지는가"
  shape: oval
  style.bold: true
}

횡단: {
  label: "횡단 설계"
  direction: down
  방법: { label: "한 시점에 나이가 다른 사람들을 한꺼번에 잰다.\n20세 · 40세 · 60세 집단을 올해 같이 검사한다" }
  값: { label: "싸고 빠르다. 한 번만 재면 된다" }
  혼입: { label: "나이와 출생 연도가 붙어 다닌다.\n60세와 20세는 나이만 다른 것이 아니라\n다른 시대에 다른 교육을 받고 자랐다"; style.bold: true }
  이름: { label: "이 혼입에 이름이 있다 — 동시대집단 효과" }
  방법 -> 값
  방법 -> 혼입 -> 이름
}

종단: {
  label: "종단 설계"
  direction: down
  방법: { label: "같은 사람을 여러 해에 걸쳐 되풀이해 잰다.\n같은 사람의 20세 · 40세 · 60세를 본다" }
  값: { label: "개인 안의 변화를 볼 수 있다.\n집단 평균이 그대로여도 사람마다 다르게 움직이는 것이 보인다" }
  혼입1: { label: "나이와 측정 연도가 붙어 다닌다.\n그 사이에 세상이 달라진 몫과 나이가 든 몫을 가를 수 없다"; style.bold: true }
  혼입2: { label: "탈락 — 중간에 빠지는 사람이 무선이 아니다.\n남은 사람만 보면 표본이 바뀐 것이지 사람이 변한 것이 아니다"; style.bold: true }
  혼입3: { label: "연습 — 같은 검사를 되풀이하면 그 검사에 익숙해진다" }
  방법 -> 값
  방법 -> 혼입1
  방법 -> 혼입2
  방법 -> 혼입3
}

계열: {
  label: "계열 설계"
  direction: down
  방법: { label: "여러 출생 연도의 집단을 각각 여러 해에 걸쳐 잰다.\n횡단과 종단을 겹쳐 놓은 것이다" }
  값: { label: "같은 나이가 다른 출생 연도 · 다른 측정 연도에 나온다.\n그 칸들을 견주면 나이 몫과 시대 몫을 어느 정도 갈라낼 수 있다"; style.bold: true }
  대가: { label: "비용과 시간이 가장 크다. 그리고 셋을 완전히 갈라내지는 못한다 —\n나이 = 측정 연도 빼기 출생 연도라서 둘을 정하면 나머지 하나가 정해진다" }
  방법 -> 값 -> 대가
}

물음 -> 횡단
물음 -> 종단
물음 -> 계열

읽는법: {
  label: "　\n설계를 고르는 일은 ‘무엇을 혼입으로 받아들일지’ 를 고르는 일이다.\n어느 설계에서 나온 결과인지 모르면 그 결과가 나이 이야기인지 시대 이야기인지 알 수 없다"
  shape: text
}
횡단 -> 읽는법: { style.stroke-dash: 3 }
종단 -> 읽는법: { style.stroke-dash: 3 }
계열 -> 읽는법: { style.stroke-dash: 3 }
