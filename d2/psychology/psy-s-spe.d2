# 스탠퍼드 감옥 실험 — 왜 연구가 아니고, 왜 그토록 인용되었는가. 심리학 18장.
#
# 무엇을 읽어야 하나: 왼쪽은 설계의 문제이고 오른쪽은 그럼에도 널리 퍼진 경로다.
# 이 그림에서 배울 것은 이 사례의 내용이 아니라 두 번째 물음이다.
direction: down

무엇: {
  label: "1971년에 무엇이 있었나"
  shape: oval
  style.bold: true
}
설명: {
  label: "대학생 지원자를 모아 한쪽에 간수 역할, 다른 쪽에 수감자 역할을 맡기고\n지하실에 만든 모의 감옥에서 지내게 했다. 예정보다 일찍 중단되었다.\n‘상황이 사람을 바꾼다’ 는 결론이 널리 퍼졌다"
  shape: text
}
무엇 -> 설명: { style.stroke-dash: 3 }

성립: {
  label: "왜 연구로 성립하지 않는가"
  direction: down
  a: { label: "비교 조건이 없다\n조건이 하나뿐이므로 ‘상황 때문’ 이라고 말할 자료 구조가 아니다.\n무엇과 견주어 달라졌다고 하는지가 없다"; style.bold: true }
  b: { label: "모집 광고가 표본을 골랐다\n‘감옥 생활 연구’ 라고 밝히고 모집했다. 뒷날 한 연구가 같은 문구와\n중립적인 문구로 각각 모집해, 모이는 사람이 다르다는 것을 보였다"; style.bold: true }
  c: { label: "연구자가 참여자였다\n연구를 이끈 사람이 교도소장 역할을 맡았다. 관찰자와 개입자가 같은 사람이면\n실험자 기대가 결과와 구별되지 않는다 — 6장에서 본 문제다"; style.bold: true }
  d: { label: "간수에게 지시가 있었다\n공개된 기록에서 연구진이 간수 역할에게 어떻게 행동하라고 이르는 것이 확인되었다.\n그러면 ‘역할이 저절로 사람을 바꾸었다’ 는 서술이 성립하지 않는다"; style.bold: true }
  e: { label: "자료가 체계적으로 기록되지 않았다\n무엇을 언제 어떤 규칙으로 셌는지가 남아 있지 않다.\n지금의 기준으로는 자료라고 부를 수 있는 것이 없다"; style.bold: true }
  f: { label: "일부 참가자가 뒷날 연기였다고 말했다" }
}

인용: {
  label: "그런데 왜 그토록 널리 인용되었나"
  direction: down
  g1: { label: "이야기가 강하다. 줄거리가 있고 장면이 그려지고 결말이 있다.\n표와 구간이 있는 연구는 이렇게 옮겨지지 않는다"; style.bold: true }
  g2: { label: "결론이 쓸모 있어 보였다. 현실에서 벌어진 일을 설명하는 데 계속 불려 나왔다" }
  g3: { label: "검사할 수 있는 예측을 내놓지 않았다. 그래서 반증되지도 않았다.\n무엇이 나와도 ‘상황의 힘’ 으로 설명된다"; style.bold: true }
  g4: { label: "교과서와 대중매체가 서로를 인용했다. 원 자료로 돌아간 사람이 오래 없었다"; style.bold: true }
  g5: { label: "재현할 필요를 아무도 느끼지 않았다. 이미 아는 사실처럼 다루어졌기 때문이다"; style.bold: true }
}

무엇 -> 성립
무엇 -> 인용

대비: {
  label: "견줄 것이 하나 있다"
  direction: down
  h: { label: "2000년대 초에 방송사와 함께 이루어진 다른 모의 감옥 연구가 있다.\n절차와 자료가 공개되었고 결과가 달랐다 — 역할이 저절로 사람을 바꾸지 않았다.\n같은 설정에서 다른 결과가 나왔다는 것 자체가 첫 사례의 결론을 흔든다"; style.bold: true }
}
성립 -> 대비: { style.stroke-dash: 3 }

결론: {
  label: "　\n이 장이 이것을 다루는 이유 — 결과를 소개하기 위해서가 아니라\n‘검사받지 않은 이야기가 어떻게 사실이 되는가’ 를 보이기 위해서다.\n이 사례에서 배울 것은 감옥에 대한 것이 아니라 인용에 대한 것이다"
  shape: text
}
인용 -> 결론
대비 -> 결론
