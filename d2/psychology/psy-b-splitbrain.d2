# 분리뇌 연구가 무엇을 보였나 — 절차의 논리. 심리학 13장.
#
# 이 그림은 해부도가 아니라 ‘정보가 어디로 가서 어디서 나오는가’의 흐름이다.
# 무엇을 읽어야 하나: 결과가 놀라운 이유가 ‘두 반구가 다르다’ 가 아니라
# ‘한쪽만 아는 것이 생긴다’ 라는 데 있다는 것. 그리고 표본이 아주 작다는 것.
direction: right

절차: {
  label: "절차"
  direction: down
  p1: { label: "두 반구를 잇는 큰 다발이 잘린 사람에게" }
  p2: { label: "한쪽 시야에만 아주 짧게 그림을 보인다.\n눈을 움직이면 양쪽에 다 들어가므로 시간을 아주 짧게 준다"; style.bold: true }
  p1 -> p2
}

왼시야: {
  label: "왼쪽 시야에 보이면"
  direction: down
  l1: { label: "오른쪽 반구로 간다" }
  l2: { label: "말로는 무엇을 보았는지 답하지 못한다" ; style.bold: true }
  l3: { label: "그런데 왼손으로는 그 물건을 골라낸다" ; style.bold: true }
  l1 -> l2
  l1 -> l3
}

오른시야: {
  label: "오른쪽 시야에 보이면"
  direction: down
  r1: { label: "왼쪽 반구로 간다" }
  r2: { label: "말로 답한다" }
  r1 -> r2
}

절차 -> 왼시야
절차 -> 오른시야

결론: {
  label: "여기서 따라 나오는 것"
  direction: down
  c1: { label: "‘무엇을 보았는지 아는 것’ 과 ‘그것을 말하는 것’ 이 갈릴 수 있다"; style.bold: true }
  c2: { label: "말하는 쪽은 반대편이 아는 것에 닿지 못한다" }
  c3: { label: "그런데도 이유를 물으면 그럴듯한 설명이 나온다.\n말하는 쪽이 자기가 모르는 행동에 대해 이야기를 지어낸다" ; style.bold: true }
}
왼시야 -> 결론
오른시야 -> 결론

주의: {
  label: "여기서 반드시 붙일 단서"
  direction: down
  n1: { label: "표본이 아주 작다. 이 절차를 받은 사람은 애초에 소수이고,\n자세히 검사된 사람은 그보다도 훨씬 적다"; style.bold: true }
  n2: { label: "그리고 그들은 모두 오래 심한 발작을 겪은 사람들이다.\n수술 전부터 뇌가 이미 달랐을 수 있다"; style.bold: true }
  n3: { label: "‘두 사람이 한 머리에 있다’ 는 읽기는 다투어진다.\n뒤의 연구 가운데는 한쪽 시야의 자극도 어느 정도는\n하나로 통합되어 보고된다고 보고한 것이 있다" }
  n4: { label: "이 연구에서 ‘좌뇌형 · 우뇌형 성격’ 은 따라 나오지 않는다.\n그것은 이 자료와 아무 관계가 없는 별개의 주장이며 지지되지 않는다"; style.bold: true }
}
결론 -> 주의: { style.stroke-dash: 3 }
