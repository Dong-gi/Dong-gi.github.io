# 조건형성으로 어디까지 가는가 — 심리학 7장.
#
# 무엇을 읽어야 하나: 첫 칸이 무너진 것이 아니라는 것. 무너진 것은 그 아래로
# 넘어가는 화살표, 즉 ‘이것만으로 사람의 행동 전부를 설명한다’ 는 주장이다.
direction: down

버팀: {
  label: "튼튼하게 남은 것"
  direction: down
  a1: { label: "조건형성의 기본 현상\n획득 · 소거 · 자발적 회복 · 일반화 · 변별.\n여러 종, 여러 연구실에서 되풀이해 관찰된다"; style.bold: true }
  a2: { label: "강화가 행동의 빈도를 바꾼다는 것\n계획에 따라 반응의 모양이 달라진다는 것까지" }
  a3: { label: "응용에서의 성과\n행동을 조금씩 다듬어 나가는 절차,\n피하던 자극에 단계적으로 다시 노출하는 절차" }
  a1 -> a2 -> a3
}

무너짐: {
  label: "무너진 큰 주장"
  direction: down
  b1: { label: "‘어떤 자극이든 어떤 결과와도 똑같이 붙는다’\n무너뜨린 것 — 맛 혐오 학습과 준비성"; style.bold: true }
  b2: { label: "‘두 사건이 가까이 붙어 있으면 연합이 생긴다’\n무너뜨린 것 — 짝지음을 고정하고 예측력만 바꾼 설계,\n그리고 이미 예측되는 것에는 더 배우지 않는 현상" }
  b3: { label: "‘밖에서 보이는 것만으로 충분하다’\n무너뜨린 것 — 강화 없이 돌아다닌 뒤 강화가 붙자\n곧바로 드러난 학습, 그리고 남을 보는 것만으로 생긴 학습" }
  b4: { label: "‘같은 원리로 언어까지 설명된다’\n무너뜨린 것 — 아이가 들어 본 적 없는 문장을 만들어 낸다는 지적.\n11장이 이 논쟁을 다룬다" }
  b1 -> b2 -> b3 -> b4
}

정확: {
  label: "정확한 요약"
  direction: down
  c1: { label: "‘조건형성이 틀렸다’ 가 아니다.\n‘조건형성이 전부는 아니다’ 다"; style.bold: true }
  c2: { label: "이 분야가 무너진 것이 아니라\n‘무엇이 무엇과 붙는가’ 를 정하는 것이\n무엇인지가 다시 쓰였다" }
  c1 -> c2
}

버팀 -> 정확: "이대로 쓴다"
무너짐 -> 정확: "이 주장은 버린다"
