# 감각기억 · 단기 저장 · 장기기억 — 심리학 8장.
#
# 무엇을 읽어야 하나: 세 칸이 서로 다른 세 가지 성질(용량 · 지속 · 무엇으로 담기는가)
# 로 갈린다는 것, 그리고 칸 사이를 잇는 것이 주의와 되뇌기라는 것.
direction: down

입력: {
  label: "들어오는 것"
  shape: oval
}

감각: {
  label: "감각기억\n용량 — 크다. 눈앞의 것이 거의 그대로 들어온다\n지속 — 아주 짧다. 시각 쪽은 1초 안쪽\n담기는 꼴 — 감각 그대로\n확인한 방법 — 전부 말하게 하지 않고 신호로 한 줄만 지목해\n말하게 하면, 지목하기 전까지는 전체가 있었다는 것이 드러난다"
  style.bold: true
}

단기: {
  label: "단기 저장\n용량 — 적다\n지속 — 짧다. 되뇌지 않으면 사라진다\n담기는 꼴 — 대개 소리로. 그래서 모양이 아니라\n소리가 비슷한 항목끼리 헷갈린다"
  style.bold: true
}

장기: {
  label: "장기기억\n용량 — 알려진 한계가 없다\n지속 — 아주 길다\n담기는 꼴 — 대개 뜻으로. 그래서 그대로가 아니라\n뜻이 남고, 뜻이 같으면 헷갈린다"
  style.bold: true
}

사라짐1: { label: "주의를 받지 못한 것은\n곧 사라진다"; shape: text }
사라짐2: { label: "되뇌지 않으면\n밀려 나간다"; shape: text }

입력 -> 감각
감각 -> 단기: "주의"
감각 -> 사라짐1: { style.stroke-dash: 3 }
단기 -> 장기: "되뇌기 · 뜻 붙이기"
장기 -> 단기: "인출"
단기 -> 사라짐2: { style.stroke-dash: 3 }

주의사항: {
  label: "　\n이 그림은 1960년대에 세워진 ‘다중저장 모형’ 이고, 지금도 뼈대로 쓰인다.\n다만 가운데 칸을 ‘저장고’ 로만 보는 그림은 그 뒤에 바뀌었다.\n무엇이 바뀌었는지는 다음 그림에서 다룬다"
  shape: text
}
단기 -> 주의사항: { style.stroke-dash: 3 }
