# 지각은 추론이다 — 심리학 12장.
#
# 무엇을 읽어야 하나: 망막에 맺힌 상 하나에 들어맞는 바깥 세상이 여럿이라는 것,
# 그래서 지각은 ‘읽어 들이는 일’ 이 아니라 ‘고르는 일’ 이라는 것.
# 착시는 이 고르기가 기대는 전제를 드러내 보이는 자극이다.
direction: down

세상: {
  label: "바깥 세상\n(우리가 직접 닿을 수 없는 것)"
  shape: oval
  style.bold: true
}

상: {
  label: "감각 표면에 맺힌 것\n망막의 2차원 상 · 두 귀에 닿은 압력 변화 · 피부에 눌린 자국"
  style.bold: true
}

세상 -> 상: "빛 · 소리 · 압력"

잃음: {
  label: "여기서 정보가 줄어든다.\n3차원이 2차원으로 눌리고, 물체의 색과 조명의 색이 한 값으로 섞이고,\n여러 소리가 하나의 파형으로 합쳐진다"
  shape: text
}
상 -> 잃음: { style.stroke-dash: 3 }

후보: {
  label: "같은 감각 입력을 낼 수 있는 바깥 세상"
  direction: right
  h1: { label: "가까이 있는 작은 것" }
  h2: { label: "멀리 있는 큰 것" }
  h3: { label: "기울어진 어떤 것" }
  h4: { label: "…무한히 많다" ; style.stroke-dash: 3 }
}
상 -> 후보: "하나로 정해지지 않는다"

전제: {
  label: "고르기를 정하는 전제"
  direction: down
  a: { label: "빛은 대개 위에서 온다" }
  b: { label: "물체는 대개 단단하고 모양이 변하지 않는다" }
  c: { label: "가까운 것이 먼 것을 가린다" }
  d: { label: "같은 결은 멀수록 촘촘해 보인다" }
  e: { label: "이 전제들은 배워서 아는 것도 있고 아닌 것도 있다.\n어느 쪽인지는 사안마다 다르고 다 정해지지 않았다"; shape: text }
}
후보 -> 전제: "무엇으로 고르는가"

지각: {
  label: "지각 — 하나로 정해진 결과"
  shape: oval
  style.bold: true
}
전제 -> 지각

상향: {
  label: "상향 처리\n감각 입력에서 올라오는 것"
  style.bold: true
}
하향: {
  label: "하향 처리\n전제 · 맥락 · 아는 것에서 내려오는 것"
  style.bold: true
}
상향 -> 지각: { style.stroke-dash: 3 }
하향 -> 지각: { style.stroke-dash: 3 }

착시: {
  label: "　\n착시가 하는 일 — 전제가 틀리도록 짜 놓은 자극이다.\n\n그래서 착시는 지각 체계의 고장이 아니라 이 그림이 맞다는 증거다.\n전제 없이 고르는 체계라면 애초에 어긋날 자리가 없다.\n\n그리고 착시는 알고 나서도 사라지지 않는다. 이 고르기가\n우리가 믿는 것과 따로 돌아간다는 뜻이다"
  shape: text
}
지각 -> 착시: { style.stroke-dash: 3 }
