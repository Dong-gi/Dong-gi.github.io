# 표정 인식 연구에서 방법이 결과를 만드는 자리 — 심리학 16장.
#
# 무엇을 읽어야 하나: 두 절차가 참가자에게 요구하는 일이 다르다는 것.
# 왼쪽은 ‘고르기’ 이고 오른쪽은 ‘떠올리기’ 다. 일치율이 다른 것이 당연하다.
direction: right

자극: {
  label: "같은 사진 한 장"
  shape: oval
  style.bold: true
}

강제: {
  label: "강제선택형"
  direction: down
  절차: { label: "사진을 보여 주고 낱말 여섯 개를 함께 준다.\n‘기쁨 · 슬픔 · 분노 · 두려움 · 놀람 · 혐오’ 가운데 하나를 고르게 한다" }
  일: { label: "참가자가 하는 일 — 주어진 목록에서 가장 덜 어색한 것 고르기"; style.bold: true }
  결과: { label: "여러 나라의 표본에서 일치율이 높게 나온다" }
  비판: { label: "그런데 목록 자체가 답의 후보를 정해 주었다.\n목록에 없는 답은 나올 수 없고, 소거법만으로도 맞힐 수 있다"; style.bold: true }
  절차 -> 일 -> 결과 -> 비판
}

자유: {
  label: "자유 응답형"
  direction: down
  절차2: { label: "사진을 보여 주고 낱말을 주지 않는다.\n이 사람이 어떤 상태인지 자기 말로 적게 한다" }
  일2: { label: "참가자가 하는 일 — 자기 말로 떠올려 적기"; style.bold: true }
  결과2: { label: "일치율이 크게 떨어지고, 문화에 따른 차이가 커진다" }
  비판2: { label: "그런데 이 절차에도 문제가 있다.\n말이 다르면 다르게 적힌다. 낮은 일치율이 ‘다르게 느낀다’ 는 뜻인지\n‘다르게 부른다’ 는 뜻인지 이것만으로 갈리지 않는다"; style.bold: true }
  절차2 -> 일2 -> 결과2 -> 비판2
}

자극 -> 강제
자극 -> 자유

교훈: {
  label: "　\n읽어야 할 것 — 어느 쪽이 옳은 절차라는 결론이 아니다.\n같은 자극에 대해 두 절차가 다른 답을 낸다면, 그 자료로 뒷받침되는 주장은\n‘사람은 표정을 보편적으로 읽는다’ 가 아니라 ‘이 절차에서 이만큼 일치한다’ 까지다"
  shape: text
}
강제 -> 교훈: { style.stroke-dash: 3 }
자유 -> 교훈: { style.stroke-dash: 3 }
