# 파워 포즈 — 갈라 적어야 하는 두 갈래. 심리학 18장.
#
# 무엇을 읽어야 하나: 하나의 이름 아래 서로 처지가 다른 두 주장이 있다는 것,
# 그리고 ‘철회’ 와 ‘재현 실패’ 와 ‘저자의 입장 변경’ 이 서로 다른 사건이라는 것.
direction: down

주장: {
  label: "원 주장 — 몸을 크게 벌린 자세를 잠깐 취하면\n호르몬 수준과 위험을 감수하는 행동이 달라지고, 스스로도 힘이 난다고 느낀다"
  shape: oval
  style.bold: true
}

호르몬: {
  label: "호르몬과 행동 쪽"
  direction: down
  a: { label: "2015년에 훨씬 큰 표본으로 이루어진 재현에서\n호르몬 수준과 위험 감수 행동의 차이가 나오지 않았다"; style.bold: true }
  b: { label: "이 문서의 판정 — 재현되지 않았다. 이 주장을 사실로 적으면 안 된다"; style.bold: true }
  a -> b
}

주관: {
  label: "주관적 보고 쪽"
  direction: down
  c: { label: "같은 재현에서 ‘힘이 난다고 느낀다’ 는 자기보고 쪽은 되풀이 나왔다"; style.bold: true }
  d: { label: "이 문서의 판정 — 이 부분은 재현되었다.\n다만 그것이 무엇을 뜻하는지는 따로 물을 일이다 —\n자세를 취하라고 지시받은 사람이 그 지시를 알고 답한 것이므로 요구특성이 걸린다" }
  c -> d
}

주장 -> 호르몬
주장 -> 주관

사실: {
  label: "사실관계를 정확히 적어 둘 것"
  direction: down
  e: { label: "원 논문이 철회된 것이 아니다. 철회와 재현 실패는 다른 사건이다"; style.bold: true }
  f: { label: "원 논문의 제1저자가 2016년에 이 효과를 더는 믿지 않는다는 입장을 공개했다.\n저자가 스스로 그렇게 적은 사례는 드물고, 그 자체가 이 분야에서 일어난 변화의 한 장면이다"; style.bold: true }
  g: { label: "다른 저자들은 여전히 이 효과를 지지한다. 이 사안은 저자들 사이에서도 갈려 있다" }
}
호르몬 -> 사실: { style.stroke-dash: 3 }
주관 -> 사실: { style.stroke-dash: 3 }

규칙: {
  label: "　\n이 사례가 이 문서에 남기는 규칙 — 하나의 이름 아래 여러 주장이 있으면 갈라 적는다.\n‘파워 포즈는 효과가 없다’ 도 ‘파워 포즈는 효과가 있다’ 도 자료를 뭉갠 문장이다"
  shape: text
}
사실 -> 규칙
