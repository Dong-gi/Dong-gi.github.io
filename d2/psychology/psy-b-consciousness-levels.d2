# ‘의식’ 이라는 말이 가리키는 서로 다른 것들. 심리학 14장.
#
# 무엇을 읽어야 하나: 세 갈래가 서로 다른 물음이고 각각 재는 방법도 다르다는 것.
# 하나에 대한 자료를 다른 하나에 대한 답으로 쓰면 논의가 엉킨다.
direction: down

말: {
  label: "‘의식이 있다’ 는 말"
  shape: oval
  style.bold: true
}

수준: {
  label: "1. 수준 — 얼마나 깨어 있는가"
  direction: down
  a1: { label: "깊은 잠 · 얕은 잠 · 멍한 상태 · 또렷하게 깬 상태" }
  a2: { label: "재는 법 — 뇌파, 눈 움직임, 자극에 대한 반응, 행동 관찰.\n‘바깥에서 잴 수 있는 쪽’이다"; style.bold: true }
  a1 -> a2
}

내용: {
  label: "2. 내용 — 무엇을 의식하고 있는가"
  direction: down
  b1: { label: "지금 눈앞의 이것은 의식되고 저것은 의식되지 않는다.\n12장의 주의와 곧바로 이어지는 갈래다" }
  b2: { label: "재는 법 — 본인의 보고. 그리고 보고를 대신할 만한 간접 지표.\n‘보고에 기댈 수밖에 없는 쪽’이다"; style.bold: true }
  b1 -> b2
}

자기: {
  label: "3. 자기의식 — 자기를 대상으로 삼는가"
  direction: down
  c1: { label: "지금 내가 무엇을 하고 있는지, 어떤 상태인지를 스스로 대상으로 삼는 일" }
  c2: { label: "재는 법 — 과제를 만들어 재지만, 과제가 재는 것이 정말 이것인지가\n5장의 구성 타당도 문제로 남는다" }
  c1 -> c2
}

말 -> 수준
말 -> 내용
말 -> 자기

엉킴: {
  label: "　\n섞으면 생기는 일 — ‘의식이 있다’ 는 말을 수준의 뜻으로 쓰다가\n내용의 뜻으로 옮겨 가면, 서로 다른 두 물음이 하나로 보인다.\n\n예를 들어 ‘잠든 사람에게 의식이 있는가’ 는 수준을 묻는 것 같지만,\nREM 수면 중에 꿈을 꾸는 사람은 수준은 낮고 내용은 풍부하다.\n두 갈래가 함께 움직이지 않는다는 것 자체가 자료다"
  shape: text
}
수준 -> 엉킴: { style.stroke-dash: 3 }
내용 -> 엉킴: { style.stroke-dash: 3 }

경계: {
  label: "　\n이 문서가 다루지 않는 것 — ‘의식이 무엇인가’ 라는 존재론의 물음.\n그것은 철학 문서의 몫이다. 여기서 묻는 것은 ‘어떻게 재는가’ 다"
  shape: text
}
자기 -> 경계: { style.stroke-dash: 3 }
