# 5요인 — 무엇을 말하고 무엇을 말하지 않는가. 심리학 17장.
#
# 무엇을 읽어야 하나: 다섯이 ‘사람의 종류’ 가 아니라 ‘점수를 매기는 축’ 이라는 것,
# 그리고 오른쪽 칸에 이 구조가 아직 다투는 자리가 적혀 있다는 것.
direction: right

출발: {
  label: "어휘 가설\n사람들 사이의 중요한 차이는 말에 새겨져 있을 것이다.\n그래서 사전에서 사람을 묘사하는 낱말을 모두 모아\n서로 함께 움직이는 것끼리 묶는다"
  shape: oval
  style.bold: true
}

다섯: {
  label: "되풀이 나온 다섯 축"
  direction: down
  o: { label: "개방성 — 새로운 것 · 생각 · 예술 쪽으로 얼마나 기우는가" }
  c: { label: "성실성 — 계획하고 지키고 미루지 않는 쪽으로 얼마나 기우는가" }
  e: { label: "외향성 — 사람과 자극이 있는 쪽으로 얼마나 기우는가" }
  a: { label: "우호성 — 남과 맞추고 믿는 쪽으로 얼마나 기우는가" }
  n: { label: "신경증 성향 — 부정적인 정서를 얼마나 자주 세게 겪는가" }
}

주의: {
  label: "이 다섯이 말하지 않는 것"
  direction: down
  x1: { label: "사람의 종류가 다섯이라는 뜻이 아니다.\n각 축이 연속된 점수이고 사람은 다섯 점수의 묶음으로 적힌다"; style.bold: true }
  x2: { label: "무엇이 좋은 성격인지 말하지 않는다.\n어느 쪽 끝이 유리한지는 그 사람이 놓인 자리가 정한다" }
  x3: { label: "왜 그런지 설명하지 않는다.\n요인은 함께 움직이는 것들을 묶은 요약이지 원인이 아니다"; style.bold: true }
  x4: { label: "한 상황에서의 행동을 잘 맞히지 않는다.\n여러 상황 · 여러 시점을 합쳐야 관계가 드러난다" }
}

논쟁: {
  label: "아직 다투는 자리"
  direction: down
  d1: { label: "요인이 몇 개인가.\n정직-겸손을 따로 세운 여섯 요인 모형이 대안으로 제시되어 있다" }
  d2: { label: "이 다섯이 어디에서나 나오는가.\n큰 산업사회 표본에서는 잘 재현되지만, 소규모 사회 표본에서\n다섯 구조가 나오지 않았다는 보고가 있다"; style.bold: true }
  d3: { label: "요인은 자기보고 문항들의 구조인가 사람의 구조인가.\n자료가 문항에서 나왔다는 것을 잊으면 안 된다"; style.bold: true }
}

출발 -> 다섯 -> 주의
다섯 -> 논쟁

등급: {
  label: "　\n이 문서의 등급 — 다수설이다. 성격을 재는 표준 틀로 널리 쓰이고 여러 언어에서 되풀이 나왔다.\n다만 요인 수와 문화 보편성은 논쟁 중이므로 ‘사람의 성격은 다섯 가지다’ 라고 적으면 안 된다"
  shape: text
}
주의 -> 등급: { style.stroke-dash: 3 }
논쟁 -> 등급: { style.stroke-dash: 3 }
