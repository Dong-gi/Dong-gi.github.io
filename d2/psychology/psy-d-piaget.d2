# 피아제의 단계 — 무엇이 버텼고 무엇이 수정되었나. 심리학 15장.
#
# 무엇을 읽어야 하나: 오른쪽 두 칸의 판정이 다르다는 것. 순서는 대체로 버텼고
# 시기와 이산성은 수정되었다. ‘피아제가 틀렸다’ 도 ‘맞았다’ 도 정확한 요약이 아니다.
direction: right

단계: {
  label: "피아제가 세운 네 단계"
  direction: down
  a: { label: "감각운동기\n감각과 운동으로 세계를 다룬다.\n보이지 않는 것을 다루는 힘이 이 시기에 자란다" }
  b: { label: "전조작기\n말과 상징을 쓰지만 되돌려 생각하기가 어렵다.\n겉모습이 바뀌면 양도 바뀐 것으로 여긴다" }
  c: { label: "구체적 조작기\n눈앞의 구체적인 것에 대해 논리적으로 조작한다.\n모양이 바뀌어도 양이 그대로임을 안다" }
  d: { label: "형식적 조작기\n가정과 가능성에 대해 조작한다.\n‘만약 그렇다면’ 을 체계적으로 다룬다" }
  a -> b -> c -> d
}

버팀: {
  label: "검사에서 버틴 것"
  direction: down
  s1: { label: "순서\n아이들이 이 능력들을 얻는 차례는\n여러 문화에서 대체로 같게 관찰된다"; style.bold: true }
  s2: { label: "아이의 오류가 무작위가 아니라는 것\n같은 종류의 틀린 답이 되풀이해 나온다.\n그것이 아이의 사고에 구조가 있다는 증거다"; style.bold: true }
  s3: { label: "방법\n아이에게 과제를 주고 왜 그렇게 답했는지 묻는\n임상적 면담 방식이 발달 연구에 남았다" }
}

수정: {
  label: "수정된 것"
  direction: down
  r1: { label: "시기\n피아제가 잡은 나이보다 이르게 통과하는 것이 많다.\n과제를 쉽게 바꾸거나 지표를 바꾸면 통과 연령이 내려간다"; style.bold: true }
  r2: { label: "이산성\n한 단계에서 다음 단계로 한꺼번에 건너가지 않는다.\n같은 아이가 어떤 과제에서는 통과하고 다른 과제에서는 못 한다"; style.bold: true }
  r3: { label: "전면성\n단계가 모든 영역에 동시에 걸린다는 그림은 지지되지 않았다.\n영역마다 다른 속도로 간다" }
  r4: { label: "사회의 몫\n피아제는 아이가 혼자 세계를 다루며 배운다고 보았다.\n비고츠키 쪽은 어른과 또래의 도움이 발달의 자리 자체를 만든다고 본다" }
}

단계 -> 버팀: { label: "무엇이 남았나" }
단계 -> 수정: { label: "무엇이 바뀌었나" }

요약: {
  label: "　\n정확한 요약 — ‘순서는 대체로 버텼고 시기와 이산성은 수정되었다.’\n‘피아제가 틀렸다’ 도 ‘피아제가 맞았다’ 도 자료가 지지하는 문장이 아니다"
  shape: text
}
버팀 -> 요약: { style.stroke-dash: 3 }
수정 -> 요약: { style.stroke-dash: 3 }
