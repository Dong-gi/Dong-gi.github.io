# 이론 계보 — 각 계열이 무엇을 변화의 원천으로 보는가. 심리학 19장.
#
# 무엇을 읽어야 하나: 계열이 서로 다른 것을 ‘바뀌어야 할 것’ 으로 본다는 것,
# 그리고 그 차이가 다음 절의 효과 연구에서 무엇을 재야 하는지를 정한다는 것.
#
# 배치: 3칸 × 3줄. 물음을 가운데 두고 다섯 계열을 원래 적힌 순서대로 첫 줄 왼쪽에서 오른쪽, 둘째 줄 오른쪽, 셋째 줄에 놓았다.
# ‘현장’ 은 첫 번째(정신역동)와 다섯 번째(수용전념) 계열 사이 칸에 두어 두 점선이 다른 칸을 가로지르지 않게 했다.
direction: down
grid-rows: 3
grid-columns: 3
horizontal-gap: 40
vertical-gap: 110

정신역동: {
  label: "정신역동"
  grid-columns: 1
  grid-gap: 40
  a1: { label: "출발 — 20세기 초.\n이후 크게 갈라졌고\n지금의 형태는 초기와 많이 다르다" }
  a2: { label: "변화의 원천 —\n알아차리지 못하던 것을\n알아차리게 되는 것,\n그리고 관계에서 되풀이되는\n방식을 보게 되는 것"; style.bold: true }
  a3: { label: "비판 — 초기의 여러 주장이\n검사 가능한 형태가 아니었다.\n무엇이 관찰되면 그 주장이\n틀린 것이 되는지가\n정해져 있지 않았다"; style.bold: true }
  a1 -> a2 -> a3
}

인간중심: {
  label: "인간중심"
  grid-columns: 1
  grid-gap: 40
  b1: { label: "변화의 원천 — 치료자의 태도.\n조건 없이 존중하는 것,\n상대의 자리에서 이해하는 것,\n겉과 속이 일치하는 것"; style.bold: true }
  b2: { label: "이 계열이 남긴 것 —\n관계 자체를\n변화의 원천으로 본 것.\n다음 절의 공통요인 논의가\n여기서 자란다"; style.bold: true }
  b1 -> b2
}

행동: {
  label: "행동"
  grid-columns: 1
  grid-gap: 40
  c1: { label: "변화의 원천 — 학습.\n7장의 조건형성을\n임상에 적용한 계열이다" }
  c2: { label: "이 계열이 가져온 것 —\n무엇을 재서\n나아졌다고 할지\n미리 정하는 관행.\n효과를 셀 수 있게 만든 것이\n이 계열의 몫이 크다"; style.bold: true }
  c1 -> c2
}

# 격자 칸은 물음 원만큼 높은데 글 상자는 칸 위쪽에 붙는다. 위아래에 빈 줄을 넣어 가운데로 내린다
# (그러지 않으면 아래 계열에서 오는 점선이 빈 곳을 가리킨다)
현장: {
  label: "　\n　\n　\n　\n　\n현장에서 가장 흔한 형태는\n어느 하나가 아니라\n여러 계열을 섞어 쓰는 것이다.\n조사에서 자기 방식을\n‘통합’ 또는 ‘절충’ 이라 답하는 비율이\n큰 편이라고 보고된다.\n\n그리고 이 그림에서 읽어야 할 것 하나 —\n계열마다 ‘무엇이 바뀌어야 하는가’ 가\n다르므로, 계열을 견주는 연구는\n‘무엇을 재서 나아졌다고 할지’ 부터\n정해야 한다\n　\n　\n　\n　"
  shape: text
}

물음: {
  label: "무엇이 바뀌면\n사람이 달라지는가"
  shape: oval
  style.bold: true
}

인지행동: {
  label: "인지행동"
  grid-columns: 1
  grid-gap: 40
  d1: { label: "변화의 원천 —\n생각과 행동과\n정서가 서로 물려 있고,\n그 고리의 어느 지점에\n손을 대면 나머지가\n따라 움직인다"; style.bold: true }
  d2: { label: "가장 많이 연구된 계열이다.\n그래서 근거의 양이 가장 많고,\n동시에 재현 검사를\n가장 많이 받았다" }
  d1 -> d2
}

수용전념: {
  label: "수용전념 계열"
  grid-columns: 1
  grid-gap: 40
  e1: { label: "변화의 원천 —\n생각의 내용을\n바꾸는 것이 아니라\n생각과 맺는 관계를 바꾸는 것.\n그리고 무엇이 중요한지에 따라\n행동하는 것"; style.bold: true }
  e2: { label: "이른바 3세대라 불린다.\n앞 계열과의 차이가\n얼마나 큰지는 논쟁 중이다" }
  e1 -> e2
}

물음 -> 정신역동
물음 -> 인간중심
물음 -> 행동
물음 -> 인지행동
물음 -> 수용전념

정신역동 -> 현장: { style.stroke-dash: 3 }
수용전념 -> 현장: { style.stroke-dash: 3 }
