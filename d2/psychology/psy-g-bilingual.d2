# 두 언어를 쓴다는 것 — 무엇이 확인되었고 무엇이 흔들렸나. 심리학 11장.
#
# 무엇을 읽어야 하나: 위 칸과 아래 칸의 근거 상태가 다르다는 것.
# 그리고 위 칸의 여러 오해가 ‘무엇을 단위로 세었는가’ 하나에서 나온다는 것.
direction: down

확인: {
  label: "비교적 확인된 것"
  direction: down
  a1: { label: "두 언어를 함께 배우는 것이 언어 발달을 해친다는 근거는 없다.\n두 언어의 이정표는 대체로 한 언어를 배우는 아이와 같은 순서로 온다"; style.bold: true }
  a2: { label: "한 언어의 어휘만 따로 세면 단일언어 아이보다 적게 나올 수 있다.\n두 언어를 합쳐 세면 그 차이가 사라진다 — 세는 단위의 문제다"; style.bold: true }
  a3: { label: "말하다가 언어를 바꾸는 것은 뒤섞임이 아니라 규칙을 따른다.\n어디서 바꿀 수 있고 어디서 바꿀 수 없는지에 규칙성이 있다" }
  a4: { label: "쓰지 않는 쪽 언어가 완전히 꺼져 있지 않다.\n한 언어로 말하는 동안에도 다른 언어가 함께 활성화된다는 결과가 여러 절차에서 나왔다" }
  a1 -> a2 -> a3 -> a4
}

흔들림: {
  label: "크게 흔들린 것 — 이중언어의 일반적 인지 이점"
  direction: down
  b1: { label: "주장 — 두 언어를 늘 다루느라 주의를 통제하는 힘이 길러지고,\n그 이점이 언어와 상관없는 과제에도 나타난다"; style.bold: true }
  b2: { label: "무슨 일이 있었나 — 2000년대에 널리 퍼진 뒤, 표본이 큰 연구와 사전등록 연구에서\n효과가 나오지 않는 경우가 이어졌다"; style.bold: true }
  b3: { label: "출판 편향의 흔적도 보고되었다 —\n학회에서 발표된 연구 가운데 이점을 지지한 쪽이 지지하지 않은 쪽보다\n논문으로 실린 비율이 높았다는 분석이 있다"; style.bold: true }
  b4: { label: "가장 강한 형태의 반론(이점을 지지하는 쪽) —\n효과가 있다면 특정 조건에서만 나타날 것이고(두 언어를 늘 오가며 쓰는 환경 등),\n‘집행기능’ 이라는 이름 아래 묶인 과제들이 실은 서로 다른 것을 재고 있어서\n묶어 분석하면 효과가 씻겨 나간다는 것" }
  b1 -> b2 -> b3 -> b4
}

확인 -> 흔들림: { style.stroke-dash: 3 }

정리: {
  label: "이 문서가 적는 방식"
  direction: down
  c1: { label: "‘이중언어에 일반적인 인지 이점이 있다’ 를 사실로 적지 않는다.\n크게 흔들린 주장이므로 그 사실이 서술의 주어가 된다 — 6장의 규칙"; style.bold: true }
  c2: { label: "동시에 ‘이중언어가 해롭다’ 도 적지 않는다. 그쪽 역시 근거가 없다" }
  c3: { label: "확실히 말할 수 있는 것은 위의 칸이다. 그리고 두 언어를 쓸 줄 아는 것의 값어치는\n인지 과제 점수와 별개로 이미 충분히 크다" }
  c1 -> c2 -> c3
}
흔들림 -> 정리
