# 단기기억과 작업기억은 같은 것이 아니다 — 심리학 8장.
#
# 무엇을 읽어야 하나: 두 칸이 다른 물음에 답하는 모형이라는 것. 그래서 재는
# 과제도 다르고 예측하는 것도 다르다. 이 문서는 두 말을 갈라 쓴다.
direction: down

단기: {
  label: "단기기억"
  direction: down
  s1: { label: "묻는 것\n잠깐 동안 얼마나 담아 둘 수 있는가"; style.bold: true }
  s2: { label: "그림\n칸이 하나. 정보가 들어와 머물다가\n되뇌면 다음 칸으로 넘어간다" }
  s3: { label: "재는 과제\n들려준 숫자나 낱말을 그대로 되뇌어 말하기.\n담기만 하면 되는 과제다" }
  s4: { label: "잘 설명하는 것\n비슷한 소리끼리 헷갈리는 것,\n긴 낱말이 짧은 낱말보다 적게 담기는 것" }
  s1 -> s2 -> s3 -> s4
}

작업: {
  label: "작업기억"
  direction: down
  w1: { label: "묻는 것\n담아 둔 채로 그것을 가지고 무엇을 할 수 있는가"; style.bold: true }
  w2: { label: "그림\n칸이 여럿. 소리를 담는 자리, 눈으로 본 것과 자리를 담는 자리,\n그리고 그 둘에 주의를 나눠 주고 방해를 막는 자리" }
  w3: { label: "재는 과제\n계산을 하면서 낱말을 함께 기억하기처럼,\n담기와 처리를 같이 시키는 과제" }
  w4: { label: "잘 설명하는 것\n글을 읽고 이해하는 정도, 여러 단계를 거쳐야 하는 추론의 성적.\n담기만 재는 과제보다 이런 것들과 더 강하게 이어진다" }
  w1 -> w2 -> w3 -> w4
}

용량: {
  label: "용량에 대해 무엇을 말할 수 있나"
  direction: down
  c1: { label: "정설 — 담을 수 있는 양에 제한이 있다.\n이것은 다투어지지 않는다"; style.bold: true }
  c2: { label: "다투어지는 것 — 그 수가 얼마인가.\n되뇌기와 덩이짓기를 허용하느냐 막느냐에 따라 값이 달라지고,\n무엇을 한 덩어리로 세느냐에 따라 또 달라진다" }
  c3: { label: "그래서 이 문서는 하나의 수를 적지 않는다.\n널리 인용되는 ‘일곱 언저리’ 도 확정된 값으로 다루지 않는다"; style.bold: true }
  c1 -> c2 -> c3
}

단기 -> 용량
작업 -> 용량

규칙: {
  label: "　\n이 문서의 규칙 — 두 말을 섞어 쓰지 않는다.\n‘잠깐 담아 두는 일’ 을 말할 때는 단기기억, ‘담은 채로 다루는 일’ 을 말할 때는 작업기억"
  shape: text
}
용량 -> 규칙: { style.stroke-dash: 3 }
