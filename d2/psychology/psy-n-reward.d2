# 보상이 내재 동기를 깎는 조건 — 심리학 16장.
#
# 무엇을 읽어야 하나: ‘보상은 동기를 깎는다’ 가 아니라
# ‘어떤 보상이 어떤 조건에서 깎는다’ 라는 것. 조건이 좁다.
direction: down

출발: {
  label: "이미 그 일을 좋아서 하고 있는 사람에게 보상을 준다"
  shape: oval
  style.bold: true
}

깎이는: {
  label: "깎인다는 쪽으로 무게가 실린 조건"
  direction: down
  a: { label: "물질적인 보상이다 — 돈이나 물건"; style.bold: true }
  b: { label: "미리 알려 준다 — ‘이걸 하면 이만큼 준다’" }
  c: { label: "일을 했다는 사실 자체에 딸려 나온다.\n잘했는지와 무관하게 주어진다" }
  d: { label: "그 뒤 보상을 거두었을 때, 보상 전보다 덜 하게 된다" }
  a -> d
  b -> d
  c -> d
}

안깎이는: {
  label: "깎이지 않거나 오히려 늘어나는 조건"
  direction: down
  e: { label: "말로 하는 인정과 구체적인 되먹임" }
  f: { label: "예상하지 못한 채 나중에 받은 보상" }
  g: { label: "잘한 수준에 따라 주어져서 ‘잘했다’ 는 정보를 담고 있는 보상" }
  h: { label: "애초에 하기 싫었던 일 — 깎일 내재 동기가 없다" }
}

출발 -> 깎이는
출발 -> 안깎이는

읽는법: {
  label: "　\n이 결과의 등급 — 메타분석마다 결론이 갈렸던 주제다.\n효과가 없거나 아주 작다고 본 종합도 있었고, 위 조건에서는 뚜렷하다고 본 종합도 있었다.\n그러므로 ‘보상은 언제나 동기를 해친다’ 는 문장은 자료보다 훨씬 세다"
  shape: text
}
깎이는 -> 읽는법: { style.stroke-dash: 3 }
안깎이는 -> 읽는법: { style.stroke-dash: 3 }
