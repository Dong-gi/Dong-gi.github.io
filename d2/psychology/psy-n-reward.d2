# 보상이 내재 동기를 깎는 조건 — 심리학 16장.
#
# 무엇을 읽어야 하나: ‘보상은 동기를 깎는다’ 가 아니라
# ‘어떤 보상이 어떤 조건에서 깎는다’ 라는 것. 조건이 좁다.
#
# 배치: 폭을 줄이려고 ‘종합마다 판정이 갈린 조건’ 을 가운데 위 단에 두고, 나머지 두 묶음을
# 그 아래 단 양쪽에 두었다(맨 끝의 보이지 않는 화살표). 긴 글은 여러 줄로 나눴다.
direction: down

출발: {
  label: "이미 그 일을 좋아서\n하고 있는 사람에게\n보상을 준다"
  shape: oval
  style.bold: true
}

깎이는: {
  label: "깎인다는 쪽으로 무게가 실린 조건"
  # 2칸 × 2줄 — 세 조건(a·b·c)이 넷째 칸(d)의 결과로 모인다.
  grid-rows: 2
  grid-columns: 2
  grid-gap: 50
  a: { label: "물질적인 보상이다 —\n돈이나 물건"; style.bold: true }
  b: { label: "미리 알려 준다 —\n‘이걸 하면 이만큼 준다’" }
  c: { label: "일을 했다는 사실 자체에\n딸려 나온다.\n잘했는지와 무관하게\n주어진다" }
  d: { label: "그 뒤 보상을 거두었을 때,\n보상 전보다 덜 하게 된다" }
  a -> d
  b -> d
  c -> d
}

안깎이는: {
  label: "깎이지 않거나\n오히려 늘어나는 조건"
  # 서로 잇는 화살표가 없어 direction 만으로는 한 줄로 눕는다. 세로로 쌓아 그림 폭을 줄인다.
  grid-columns: 1
  grid-gap: 16
  e: { label: "말로 하는 인정과 구체적인 되먹임" }
  f: { label: "예상하지 못한 채 나중에 받은 보상" }
  h: { label: "애초에 하기 싫었던 일 —\n깎일 내재 동기가 없다" }
}

# 두 종합의 판정이 갈린 조건은 어느 한쪽 상자에 넣지 않고 따로 둔다.
갈린: {
  label: "종합마다 판정이 갈린 조건"
  g: { label: "잘한 수준에 따라 주는 물질 보상\n깎는다고 본 종합도 있고,\n깎는다는 결과를 찾지 못한\n종합도 있다" }
}

출발 -> 깎이는
출발 -> 갈린
출발 -> 안깎이는

읽는법: {
  label: "　\n이 결과의 등급 — 메타분석마다 결론이 갈렸던 주제다.\n효과가 없거나 아주 작다고 본 종합도 있었고,\n위 조건에서는 뚜렷하다고 본 종합도 있었다.\n그러므로 ‘보상은 언제나 동기를 해친다’ 는 문장은 자료보다 훨씬 세다"
  shape: text
}
깎이는 -> 읽는법: { style.stroke-dash: 3 }
갈린 -> 읽는법: { style.stroke-dash: 3 }
안깎이는 -> 읽는법: { style.stroke-dash: 3 }

# 배치용 — 보이지 않는 화살표. ‘깎이지 않는’ 쪽을 한 단 내려 폭을 줄인다. 뜻은 없다.
갈린 -> 안깎이는: { style.opacity: 0 }
