# 심리학이 다루는 것 — 심리학 3장.
#
# 무엇을 읽어야 하나: 왼쪽 칸만 직접 볼 수 있다는 것. 가운데 칸은 언제나
# 왼쪽에서 추론된 것이며, 그 추론을 검사 가능하게 만드는 장치가 오른쪽 칸이다.
direction: down

관찰: {
  label: "직접 볼 수 있는 것\n말한 문장 · 누른 단추 · 걸린 시간 · 눈이 머문 자리\n심장박동 · 호르몬 농도 · 뇌 활동의 대리 지표"
  style.bold: true
}

정신: {
  label: "직접 볼 수 없는 것\n기억 · 주의 · 의도 · 정서 · 태도 · 성격\n‘속에서 일어나는 일’ 이라고 부르는 것 전부"
  style.bold: true
}

장치: {
  label: "둘을 잇는 장치\n조작적 정의 — 무엇을 세면 그것을 잰 것으로 칠지 미리 못 박는다.\n측정 모형 — 여러 지표가 같은 것을 가리키는지 확인한다.\n실험 설계 — 무엇이 그 값을 움직이는지 확인한다"
}

관찰 -> 정신: "추론한다"
정신 -> 관찰: "예측을 내놓는다"
장치 -> 관찰: { style.stroke-dash: 3 }
장치 -> 정신: { style.stroke-dash: 3 }

경고: {
  label: "　\n여기가 이 학문의 고비다.\n물리학도 전자를 직접 보지 않지만, 심리학은 재는 대상이 재는 일을 알아채고 그 때문에 달라진다.\n4장과 5장이 이 문제를 정면으로 다룬다"
  shape: text
}
장치 -> 경고: { style.stroke-dash: 3 }
