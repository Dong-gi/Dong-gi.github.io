# 수면 단계는 무엇을 재서 나누는가. 심리학 14장.
#
# 무엇을 읽어야 하나: 단계가 자연에 있는 칸이 아니라 <세 가지 기록의 조합에
# 대해 정한 채점 규칙>이라는 것. 규칙이 바뀌면 단계의 이름과 개수도 바뀐다.
direction: down

재는것: {
  label: "동시에 재는 세 가지"
  direction: right
  m1: { label: "뇌파 — 머리 표면에서 잰 전기 활동의 파형" }
  m2: { label: "눈 움직임 — 눈 둘레에서 잰 전기 변화" }
  m3: { label: "근육 긴장 — 턱 아래 근육에서 잰 전기 활동" }
}

규칙: {
  label: "정해 둔 채점 규칙에 따라 짧은 구간마다 한 단계를 붙인다"
  style.bold: true
}
재는것 -> 규칙

단계: {
  label: "붙는 단계들"
  direction: down
  s1: { label: "깸 — 빠르고 작은 파형. 눈을 감으면 규칙적인 파형이 나타난다" }
  s2: { label: "N1 — 얕은 잠으로 들어가는 구간. 눈이 천천히 굴러간다" }
  s3: { label: "N2 — 짧게 몰아치는 파형과 큰 파형 하나가 특징이다.\n하룻밤에서 가장 긴 시간을 차지한다"; style.bold: true }
  s4: { label: "N3 — 느리고 큰 파형이 많은 구간. 깊은 잠이라 부른다.\n깨우기 어렵고 앞쪽 주기에 몰려 있다"; style.bold: true }
  s5: { label: "REM — 뇌파는 깨어 있을 때와 비슷한데 눈이 빠르게 움직이고\n턱 근육의 긴장이 거의 사라진다. 그래서 역설수면이라고도 한다"; style.bold: true }
}
규칙 -> 단계

주의: {
  label: "　\n읽는 법 — 이 단계들은 ‘재는 방법과 채점 규칙이 함께 정의한 것’ 이다.\n\n예전 규칙은 깊은 잠을 두 단계로 나누었는데 지금 널리 쓰는 규칙은 하나로 합쳤다.\n자연의 경계가 바뀐 것이 아니라 규칙이 바뀐 것이다.\n4장과 5장의 조작적 정의 이야기가 여기에 그대로 걸린다 —\n‘다른 규칙으로 채점한 값을 그대로 견주면 안 된다’"
  shape: text
}
단계 -> 주의: { style.stroke-dash: 3 }

꿈: {
  label: "　\n흔한 오해 하나 — ‘꿈은 REM 에서만 꾼다’.\n\nREM 에서 깨우면 꿈 보고가 훨씬 자주 나오는 것은 맞다.\n그러나 REM 이 아닌 구간에서 깨워도 보고가 나온다.\n정확한 서술은 ‘REM 에서 보고가 더 자주, 더 길고 생생하게 나온다’ 이다"
  shape: text
}
단계 -> 꿈: { style.stroke-dash: 3 }
