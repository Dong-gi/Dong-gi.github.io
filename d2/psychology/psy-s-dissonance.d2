# 두 이론이 같은 것을 예측할 때 — 심리학 18장(인지부조화와 자기지각).
#
# 무엇을 읽어야 하나: 같은 결과를 두 이론이 다 예측한다면 그 결과는
# 둘을 갈라 주지 않는다는 것. 갈라내려면 두 이론이 다르게 말하는 자리를 찾아야 한다.
direction: down

관찰: {
  label: "관찰된 것\n지루한 일을 시킨 뒤 ‘재미있었다’ 고 말해 달라고 부탁한다.\n부탁의 대가로 큰 값을 받은 쪽보다 아주 적은 값을 받은 쪽이\n뒤에 그 일을 더 재미있었다고 평정한다"
  shape: oval
  style.bold: true
}

부조화: {
  label: "인지부조화 설명"
  direction: down
  a: { label: "생각과 행동이 어긋나면 불편해진다" }
  b: { label: "적은 값을 받은 사람은 자기 행동을 값으로 설명할 수 없다.\n그러면 남는 길은 생각 쪽을 바꾸는 것이다" }
  c: { label: "예측 — 불편을 느끼는 상태가 실제로 있어야 하고,\n그 불편을 다른 것으로 돌릴 수 있게 해 주면 태도 변화가 줄어야 한다"; style.bold: true }
  a -> b -> c
}

자기지각: {
  label: "자기지각 설명"
  direction: down
  d: { label: "사람은 자기 태도를 안에서 읽어내는 것이 아니라\n자기 행동을 보고 밖에서 추론한다" }
  e: { label: "‘큰 값도 안 받고 재미있었다고 말했네. 그럼 재미있었나 보다.’\n불편이라는 상태가 없어도 같은 결과가 나온다" }
  f: { label: "예측 — 불편이 없어도 태도 변화가 나와야 하고,\n남의 행동을 보고 추론할 때와 같은 규칙이 자기에게도 적용되어야 한다"; style.bold: true }
  d -> e -> f
}

관찰 -> 부조화
관찰 -> 자기지각

문제: {
  label: "　\n문제 — 원 실험의 결과는 두 설명이 다 예측한다.\n그러므로 그 결과는 두 이론 가운데 어느 쪽도 지지하지 않는다"
  shape: text
  style.bold: true
}
부조화 -> 문제
자기지각 -> 문제

가르기: {
  label: "그러면 어떻게 가르는가"
  direction: down
  g1: { label: "불편이라는 상태를 따로 잰다. 몸의 각성을 재거나,\n각성의 원인을 다른 것으로 돌릴 수 있게 해 놓고 결과가 달라지는지 본다" }
  g2: { label: "행동이 원래 태도에서 얼마나 벗어났는지를 조건으로 넣는다.\n크게 벗어난 자리와 조금 벗어난 자리에서 두 설명의 예측이 갈린다" }
  g3: { label: "지금의 자리 — 두 설명이 서로 다른 조건에서 각각 맞는 쪽으로 정리되었다는 견해가 있고,\n아직 하나로 정해지지 않았다는 견해도 있다"; style.bold: true }
}
문제 -> 가르기

교훈: {
  label: "　\n여기서 배울 것 — 어떤 실험이 ‘유명한 이론을 증명했다’ 고 소개될 때\n먼저 물어야 할 것은 ‘그 결과를 다른 이론도 예측하는가’ 이다"
  shape: text
}
가르기 -> 교훈
