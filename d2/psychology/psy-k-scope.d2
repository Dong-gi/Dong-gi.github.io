# 이 장이 하는 일과 하지 않는 일 — 심리학 19장 첫 절.
#
# 무엇을 읽어야 하나: 오른쪽 칸이 ‘아직 안 썼다’ 가 아니라
# ‘쓰지 않기로 정했다’ 라는 것, 그리고 그 이유가 아래에 있다는 것.
direction: right

이장: {
  label: "19장 — 임상과 상담의 개관"
  shape: oval
  style.bold: true
}

한다: {
  label: "이 장이 다루는 것"
  direction: down
  a: { label: "이론 계보 — 정신역동 · 인간중심 · 행동 · 인지행동 · 수용전념.\n각 계열이 무엇을 변화의 원천으로 보는가" }
  b: { label: "진단 체계가 무엇이고 무엇이 아닌가.\n분류 규약의 성질, 그리고 그 경계가 어떻게 정해지는가"; style.bold: true }
  c: { label: "효과 연구의 지형 — 공통요인과 특정성분, 그리고 그 둘을 가르는 일이 왜 어려운가" }
  d: { label: "이 분야의 연구가 방법론적으로 어려운 자리들" }
  e: { label: "이 분야가 어떻게 훈련되는가, 그리고 왜 글로는 배울 수 없는가" }
}

안한다: {
  label: "이 장이 다루지 않는 것"
  direction: down
  f: { label: "기법의 절차. 무엇을 어떻게 하는지 적지 않는다"; style.bold: true }
  g: { label: "자가 진단. 독자가 자기 상태를 재 보게 하는 척도를 싣지 않는다"; style.bold: true }
  h: { label: "증상 목록을 진단처럼 늘어놓기" }
  i: { label: "‘이럴 때는 이렇게 하라’ 형태의 조언"; style.bold: true }
}

이장 -> 한다
이장 -> 안한다

이유: {
  label: "왜 선을 긋는가"
  direction: down
  r1: { label: "상담은 수퍼비전 아래 실습으로 익히는 것이다.\n글로 옮기면 읽은 사람이 할 수 있다고 착각하게 만든다"; style.bold: true }
  r2: { label: "자습서라는 형식 자체가 독자를 자기 문제에 적용하는 쪽으로 민다.\n그래서 형식이 하는 일을 문서가 미리 막아야 한다"; style.bold: true }
  r3: { label: "판별 기준을 적는 것과 분류 체계의 성질을 설명하는 것은 다르다.\n이 장은 뒤쪽만 한다" }
}
안한다 -> 이유: { style.stroke-dash: 3 }

도움: {
  label: "　\n지금 힘든 상태에 있다면 이 문서가 도울 수 있는 것이 없다.\n자격을 갖춘 전문가나 의료기관을 찾는 것이 이 장을 읽는 것보다 먼저다"
  shape: text
  style.bold: true
}
이유 -> 도움
