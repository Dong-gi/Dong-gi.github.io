# 문제를 푼다는 것의 구조와 그것이 막히는 자리 — 심리학 10장.
#
# 무엇을 읽어야 하나: 막히는 자리가 대개 ‘어떻게 갈 것인가’ 가 아니라
# ‘무엇을 쓸 수 있다고 보는가’ 라는 것. 문제 공간을 좁게 잡으면 답이 그 밖에 있게 된다.
direction: down

구조: {
  label: "문제 공간"
  direction: down
  s1: { label: "지금 상태 — 어디에서 출발하는가"; style.bold: true }
  s2: { label: "목표 상태 — 무엇이 되면 풀린 것인가"; style.bold: true }
  s3: { label: "쓸 수 있는 수 — 상태를 바꾸는 데 쓸 수 있는 조작들"; style.bold: true }
  s4: { label: "제약 — 해서는 안 되는 것" }
  s1 -> s2: "이 사이를 잇는다"
  s3 -> s1: { style.stroke-dash: 3 }
  s4 -> s3: { style.stroke-dash: 3 }
}

방법: {
  label: "길을 고르는 두 가지 방식"
  direction: down
  m1: { label: "샅샅이 훑기\n모든 길을 다 따져 본다. 답이 있으면 반드시 찾는다.\n문제가 조금만 커져도 길의 수가 감당할 수 없이 늘어난다" }
  m2: { label: "어림법\n답에 가까워 보이는 쪽으로만 간다. 대개 빠르다.\n대신 놓칠 수 있고, 잘못된 방향으로 깊이 들어갈 수 있다"; style.bold: true }
  m3: { label: "자주 쓰이는 어림법 — 지금과 목표의 차이를 줄이는 수를 고르기,\n큰 목표를 작은 목표로 쪼개기, 목표에서 거꾸로 내려오기" }
  m2 -> m3
}

막힘: {
  label: "막히는 자리"
  direction: down
  f1: { label: "쓰임에 갇힘\n어떤 물건을 늘 쓰던 쓰임으로만 보아서, 그것을 다르게 쓰는 수가\n‘쓸 수 있는 수’ 목록에 아예 들어오지 않는다"; style.bold: true }
  f2: { label: "굳어진 방식\n앞의 몇 문제에서 통했던 방식을 계속 쓴다.\n더 짧은 길이 생겨도 그 길을 보지 않는다"; style.bold: true }
  f3: { label: "둘 다 ‘길을 잘못 고른 것’ 이 아니라 ‘공간을 좁게 잡은 것’ 이다.\n그래서 더 열심히 생각하는 것으로는 잘 풀리지 않고,\n문제를 다시 적거나 잠시 떨어졌다 오는 것이 도움이 되는 경우가 있다" }
  f1 -> f3
  f2 -> f3
}

구조 -> 방법 -> 막힘
