# 문제를 푼다는 것의 구조와 그것이 막히는 자리 — 심리학 10장.
#
# 무엇을 읽어야 하나: 막히는 자리가 대개 ‘어떻게 갈 것인가’ 가 아니라
# ‘무엇을 쓸 수 있다고 보는가’ 라는 것. 문제 공간을 좁게 잡으면 답이 그 밖에 있게 된다.
#
# 배치: 1칸 × 3줄 격자로 세 묶음을 위에서 아래로 곧게 쌓아 옆으로 밀리지 않게 했다.
# ‘문제 공간’ 안은 2칸 × 2줄로 접어 높이를 줄였다.
# 긴 글은 여러 줄로 나눴다.
grid-rows: 3
grid-columns: 1
vertical-gap: 60

구조: {
  label: "문제 공간"
  # 2칸 × 2줄 — 첫 줄은 제약 → 쓸 수 있는 수, 둘째 줄은 목표 상태 ← 지금 상태.
  # 격자는 위 줄 왼쪽부터 채우므로 s4 · s3 · s2 · s1 차례로 적는다.
  grid-rows: 2
  grid-columns: 2
  horizontal-gap: 170
  vertical-gap: 80
  s4: { label: "제약 —\n해서는\n안 되는 것" }
  s3: { label: "쓸 수 있는 수 —\n상태를 바꾸는 데\n쓸 수 있는 조작들"; style.bold: true }
  s2: { label: "목표 상태 —\n무엇이 되면\n풀린 것인가"; style.bold: true }
  s1: { label: "지금 상태 —\n어디에서\n출발하는가"; style.bold: true }
  s1 -> s2: "이 사이를 잇는다"
  s3 -> s1: { style.stroke-dash: 3 }
  s4 -> s3: { style.stroke-dash: 3 }
}

방법: {
  label: "길을 고르는 두 가지 방식"
  # 한 줄 격자. m2 → m3 이 가로로 이어진다.
  grid-rows: 1
  grid-columns: 3
  grid-gap: 40
  m1: { label: "샅샅이 훑기\n모든 길을 다 따져 본다.\n답이 있으면\n반드시 찾는다.\n문제가 조금만 커져도\n길의 수가\n감당할 수 없이\n늘어난다" }
  m2: { label: "어림법\n답에 가까워 보이는\n쪽으로만 간다.\n대개 빠르다.\n대신 놓칠 수 있고,\n잘못된 방향으로\n깊이 들어갈 수 있다"; style.bold: true }
  m3: { label: "자주 쓰이는 어림법 —\n지금과 목표의 차이를\n줄이는 수를 고르기,\n큰 목표를\n작은 목표로 쪼개기,\n목표에서\n거꾸로 내려오기" }
  m2 -> m3
}

막힘: {
  label: "막히는 자리"
  # 한 줄 격자. 가운데 f3 로 f1 은 오른쪽, f2 는 왼쪽으로 들어온다(칸 차례 f1 · f3 · f2).
  grid-rows: 1
  grid-columns: 3
  grid-gap: 40
  f1
  f3
  f2
  f1: { label: "쓰임에 갇힘\n어떤 물건을\n늘 쓰던 쓰임으로만\n보아서,\n그것을 다르게 쓰는\n수가 ‘쓸 수 있는 수’\n목록에 아예\n들어오지 않는다"; style.bold: true }
  f2: { label: "굳어진 방식\n앞의 몇 문제에서\n통했던 방식을\n계속 쓴다.\n더 짧은 길이 생겨도\n그 길을 보지 않는다"; style.bold: true }
  f3: { label: "둘 다\n‘길을 잘못 고른 것’ 이\n아니라\n‘공간을 좁게 잡은 것’ 이다.\n그래서 더 열심히\n생각하는 것으로는\n잘 풀리지 않고,\n문제를 다시 적거나\n잠시 떨어졌다 오는 것이\n도움이 되는 경우가 있다" }
  f1 -> f3
  f2 -> f3
}

구조 -> 방법 -> 막힘
