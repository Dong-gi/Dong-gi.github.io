# 꿈에서 자료까지 — 사이에 무엇이 끼어 있나. 심리학 14장.
#
# 무엇을 읽어야 하나: 꿈 연구가 다루는 자료가 꿈이 아니라 ‘꿈에 대한 보고’
# 라는 것. 13장의 뇌영상 사슬과 같은 모양의 그림이다.
direction: down

꿈: {
  label: "1. 자는 동안 실제로 일어난 것"
  shape: oval
  style.bold: true
}
꿈말: {
  label: "연구자는 여기에 직접 닿을 수 없다"
  shape: text
}
꿈 -> 꿈말: { style.stroke-dash: 3 }

깸: {
  label: "2. 깨어남"
}
깸말: {
  label: "깨우는 방식이 결과를 바꾼다. 언제 깨우는가(어느 단계에서),\n어떻게 깨우는가, 깨자마자 묻는가 아침에 묻는가"
  shape: text
}
깸 -> 깸말: { style.stroke-dash: 3 }

기억: {
  label: "3. 깨어난 뒤 남아 있는 기억"
  style.bold: true
}
기억말: {
  label: "여기가 가장 큰 관문이다. 대부분은 남지 않는다.\n그리고 남은 것도 9장이 다룬 기억의 성질을 그대로 갖는다 —\n빈자리가 메워지고, 나중에 들은 것이 섞여 들어간다"
  shape: text
}
기억 -> 기억말: { style.stroke-dash: 3 }

말하기: {
  label: "4. 말이나 글로 옮기기"
  style.bold: true
}
말하기말: {
  label: "이야기가 아니었던 것이 이야기가 된다. 앞뒤가 없던 것에 순서가 생기고,\n말로 옮기기 어려운 것은 빠진다.\n그리고 무엇을 물었느냐에 따라 무엇을 적을지가 달라진다 (4장의 요구특성)"
  shape: text
}
말하기 -> 말하기말: { style.stroke-dash: 3 }

코딩: {
  label: "5. 연구자가 항목으로 세기"
  style.bold: true
}
코딩말: {
  label: "‘위협 장면’ 이나 ‘아는 사람’ 을 무엇으로 셀지 미리 정해야 하고,\n그 정의가 결과를 정한다. 여러 사람이 따로 세어\n얼마나 일치하는지를 보고해야 한다 (5장의 평정자 간 신뢰도)"
  shape: text
}
코딩 -> 코딩말: { style.stroke-dash: 3 }

자료: {
  label: "6. 자료"
  shape: oval
  style.bold: true
}

꿈 -> 깸 -> 기억 -> 말하기 -> 코딩 -> 자료

정리: {
  label: "　\n그래서 꿈 연구의 자료는 ‘꿈이 아니라 꿈에 대한 보고’ 다.\n\n이것은 꿈 연구가 쓸모없다는 뜻이 아니다. 12장의 지각 연구도,\n16장의 정서 연구도 자기보고를 쓴다. 뜻하는 것은 이것이다 —\n‘보고에 나타난 규칙성을 꿈 자체의 성질로 곧바로 옮겨 적으면 안 된다.’\n\n그리고 이 사슬을 알면 무엇을 개선할지도 보인다 — 깨우는 시점을 통제하고,\n깨자마자 받아 적게 하고, 세는 규칙을 미리 정해 공개하고,\n여러 사람이 따로 세어 일치도를 보고하는 것이다"
  shape: text
}
자료 -> 정리: { style.stroke-dash: 3 }
