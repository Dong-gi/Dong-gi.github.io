# 신경전달물질과 심리 기능은 일대일이 아니다. 심리학 13장.
#
# 무엇을 읽어야 하나: 화살표가 여러 갈래로 갈라지고 여러 갈래에서 모인다는 것.
# ‘이 물질이 이 기분을 만든다’ 는 문장이 이 그림 어디에도 대응하지 않는다.
direction: right

물질: {
  label: "전달물질 하나"
  style.bold: true
}

회로: {
  label: "그 물질을 쓰는 회로들"
  direction: down
  c1: { label: "회로 1" }
  c2: { label: "회로 2" }
  c3: { label: "회로 3" }
  c4: { label: "…" ; style.stroke-dash: 3 }
}

기능: {
  label: "그 회로들이 관여하는 일"
  direction: down
  f1: { label: "움직임의 조절" }
  f2: { label: "무엇을 하려는 힘" }
  f3: { label: "배운 것을 갱신하는 일" }
  f4: { label: "몸 안쪽의 조절" }
}

물질 -> 회로: "같은 물질, 다른 자리"
회로 -> 기능: "회로마다 하는 일이 다르다"

수용체: {
  label: "게다가 받는 쪽도 여러 종류다.\n같은 물질이 어떤 수용체에 닿느냐에 따라\n다음 세포를 흥분시키기도 하고 억제하기도 한다"
  shape: text
}
물질 -> 수용체: { style.stroke-dash: 3 }

거꾸로: {
  label: "그리고 거꾸로도 여럿이다 —\n하나의 심리 기능에 여러 물질이 함께 관여한다.\n어느 하나를 늘리거나 줄여도 그 기능만 달라지지 않는다"
  shape: text
}
기능 -> 거꾸로: { style.stroke-dash: 3 }

결론: {
  label: "　\n그래서 ‘어떤 물질이 모자라서 어떤 상태가 된다’ 는 도식은\n이 그림과 맞지 않는다. 널리 퍼진 그 도식은 지금 지지되지 않는다.\n\n조심할 것 — 이 문단은 ‘물질이 상관없다’ 는 뜻이 아니다.\n물질에 작용하는 약이 효과를 내는 것과, 그 물질의 양이 원인이라는 것은\n서로 다른 주장이다. 앞엣것이 참이어도 뒤엣것이 따라 나오지 않는다"
  shape: text
}
거꾸로 -> 결론: { style.stroke-dash: 3 }
