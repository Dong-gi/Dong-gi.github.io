# 2011년 무렵에 무슨 일이 있었나 — 심리학 6장.
#
# 무엇을 읽어야 하나: 세 사건의 성격이 다 다르다는 것. 부정이 하나, 방법 시연이 하나,
# 그리고 ‘정상적인 절차대로 해도 이런 결론이 나온다’ 는 논문이 하나다.
# 셋째가 가장 중요하다.
direction: down

셋: {
  label: "2011년, 석 달 사이에 겹친 세 가지"
  direction: down

  뱀: {
    label: "다릴 뱀의 예지 논문\n표준적인 절차를 그대로 따라 아홉 실험을 하고, 여덟에서 유의한 결과를 얻었다.\n주장은 ‘앞으로 일어날 일이 지금의 반응에 영향을 준다’ 는 것이었다"
    style.bold: true
  }
  뱀말: {
    label: "충격은 결론이 아니라 절차에 있었다. 그 분야가 인정하는 방법을 그대로 썼는데\n아무도 믿지 않는 결론이 나왔다면, 그 방법으로 얻은 다른 결론들은 무엇인가"
    shape: text
  }
  뱀 -> 뱀말: { style.stroke-dash: 3 }

  시먼스: {
    label: "시먼스·넬슨·시몬손, ‘위양성 심리학’\n연구자가 흔히 쓰는 재량 네 가지를 실제로 써서\n‘노래를 들으면 나이가 어려진다’ 는 유의한 결과를 만들어 보였다"
    style.bold: true
  }
  시먼스말: {
    label: "논리적으로 불가능한 결론을 유의하게 만들 수 있다는 시연이다.\n이 논문이 ‘연구자 자유도’ 라는 말을 널리 퍼뜨렸다"
    shape: text
  }
  시먼스 -> 시먼스말: { style.stroke-dash: 3 }

  부정: {
    label: "한 연구자의 대규모 자료 조작이 드러났다"
  }
  부정말: {
    label: "이것은 부정이고, 부정은 규칙 위반이라 규칙을 세우면 된다.\n앞의 둘은 규칙을 지켜도 생기는 문제다. 그래서 앞의 둘이 더 무거웠다"
    shape: text
  }
  부정 -> 부정말: { style.stroke-dash: 3 }
}

재현: {
  label: "2015년 — 재현 프로젝트\nOpen Science Collaboration 이 학술지 세 곳의 2008년 논문에서 고른 연구 100편을\n원저자와 연락하며 되풀이했다. 결과가 6장 본문에 있다"
  style.bold: true
}

이후: {
  label: "그 뒤"
  direction: down
  다중: { label: "다중연구실 프로젝트 — 여러 나라의 연구실이 같은 절차로 동시에 잰다" }
  등록: { label: "사전등록과 등록보고서 — 자료를 보기 전에 계획을 묶어 둔다" }
  공개: { label: "자료·재료·분석 코드 공개가 기본 요구가 된다" }
  분야: { label: "같은 문제가 다른 분야에서도 확인된다 — 심리학만의 일이 아니었다" }
}

셋 -> 재현: "그러면 실제로 얼마나 되풀이되는지 세어 보자"
재현 -> 이후
