# 척도의 네 수준 — 심리학 5장.
#
# 무엇을 읽어야 하나: 오른쪽으로 갈수록 숫자로 할 수 있는 일이 늘어난다는 것.
# 왼쪽 척도의 값에 오른쪽 척도의 연산을 하면 뜻 없는 수가 나온다.
direction: down

명목: {
  label: "명목척도\n예 — 전공, 이용한 교통수단\n숫자는 이름표일 뿐이다"
  style.bold: true
}
명목말: { label: "할 수 있는 것 — 같다/다르다, 개수 세기, 최빈값\n할 수 없는 것 — 크기 비교, 평균"; shape: text }
명목 -> 명목말: { style.stroke-dash: 3 }

서열: {
  label: "서열척도\n예 — 등수, 매우 그렇다에서 전혀 아니다까지의 다섯 칸\n순서는 있고 간격은 뜻이 없다"
  style.bold: true
}
서열말: { label: "할 수 있는 것 — 순서 비교, 중앙값, 순위 상관\n할 수 없는 것 — 뺄셈. 1등과 2등의 차이가 2등과 3등의 차이와 같다는 보장이 없다"; shape: text }
서열 -> 서열말: { style.stroke-dash: 3 }

등간: {
  label: "등간척도\n예 — 섭씨 온도\n간격은 뜻이 있고 0 은 임의로 정한 자리다"
  style.bold: true
}
등간말: { label: "할 수 있는 것 — 덧셈과 뺄셈, 평균, 표준편차\n할 수 없는 것 — 비율로 말하기. 20 °C 는 10 °C 의 두 배로 덥지 않다"; shape: text }
등간 -> 등간말: { style.stroke-dash: 3 }

비율: {
  label: "비율척도\n예 — 반응 시간, 맞힌 문항 수\n0 이 ‘없음’ 을 뜻한다"
  style.bold: true
}
비율말: { label: "할 수 있는 것 — 나눗셈까지. ‘두 배 빠르다’ 가 뜻을 갖는다"; shape: text }
비율 -> 비율말: { style.stroke-dash: 3 }

명목 -> 서열 -> 등간 -> 비율: "할 수 있는 일이 늘어난다"

논쟁: {
  label: "　\n심리학이 가장 자주 걸리는 자리 — 설문의 다섯 칸 척도는 서열인가 등간인가.\n엄밀히는 서열이다. 실무에서는 문항을 여러 개 더해 등간처럼 다루는 일이 흔하고,\n그 처리가 언제 괜찮은지는 지금도 논쟁 중이다. 이 문서는 어느 쪽도 정설로 적지 않는다"
  shape: text
}
서열 -> 논쟁: { style.stroke-dash: 3 }
