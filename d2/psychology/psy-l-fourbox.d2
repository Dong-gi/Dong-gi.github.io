# 강화와 처벌의 네 칸 — 심리학 7장.
#
# 무엇을 읽어야 하나: 두 줄과 두 칸이 서로 다른 것을 묻는다는 것. 줄은 ‘그 뒤에
# 그 행동이 늘었나 줄었나’ 이고, 가로는 ‘무엇을 주었나 없앴나’ 다.
# 그래서 ‘부적 강화’ 는 처벌이 아니다. 강화는 늘리는 쪽 줄에 있다.
#
# 배치: 2칸 × 2줄. 둘째 줄 첫 칸이 ‘먼저 정할 것’, 둘째 칸이 네 칸 표(늘림 줄 위, 줄임 줄 아래)다.
# ‘가장 흔한 잘못’ 메모는 첫 줄 둘째 칸, 곧 늘림 줄 바로 위에 두었다 — 아래에 두면
# 늘림 줄에서 오는 점선이 줄임 줄을 가로지른다. 첫 줄 첫 칸은 비워 둔 자리다.
grid-rows: 2
grid-columns: 2
horizontal-gap: 50
vertical-gap: 40

빈칸: { label: ""; style.stroke: transparent; style.fill: transparent }
함정: {
  label: "가장 흔한 잘못 — ‘부적 강화’ 를 처벌로 읽는 것.\n부적 강화는 행동을 늘린다. 없애 준 것이 그 사람에게 치우고 싶은 것이었기 때문이다"
  shape: text
}

정의: {
  label: "먼저 정할 것"
  grid-columns: 1
  grid-gap: 60
  a: { label: "강화 · 처벌은 결과로 정한다\n그 행동이 그 뒤에 늘었으면 강화,\n줄었으면 처벌이다.\n주는 사람의 의도로 정하지 않는다"; style.bold: true }
  b: { label: "정적 · 부적은 방향으로 정한다\n무언가를 더한 것이면 정적,\n있던 것을 없앤 것이면 부적이다.\n좋다 · 나쁘다의 뜻이 아니다" }
  a -> b
}

# 네 칸 표를 묶는 테두리 없는 칸. 늘림 줄이 위, 줄임 줄이 아래다.
표: {
  label: ""
  style.stroke: transparent
  style.fill: transparent
  grid-columns: 1
  grid-gap: 40
  늘림: {
    label: "행동이 늘었다 — 강화"
    grid-columns: 2
    pr: { label: "정적 강화\n행동 뒤에 무언가를 더한다\n보기 — 문제를 풀자\n칭찬이 따라왔고,\n그 뒤로 문제를 더 자주 푼다"; style.bold: true }
    nr: { label: "부적 강화\n행동 뒤에 있던 것을 없앤다\n보기 — 안전띠를 매자\n경고음이 그쳤고,\n그 뒤로 더 빨리 매게 되었다"; style.bold: true }
  }
  줄임: {
    label: "행동이 줄었다 — 처벌"
    grid-columns: 2
    pp: { label: "정적 처벌\n행동 뒤에 무언가를 더한다\n보기 — 규칙을 어기자\n벌점이 붙었고,\n그 뒤로 그 행동이 줄었다" }
    np: { label: "부적 처벌\n행동 뒤에 있던 것을 없앤다\n보기 — 규칙을 어기자\n쓰던 권한이 사라졌고,\n그 뒤로 그 행동이 줄었다" }
  }
}

정의 -> 표.늘림
정의 -> 표.줄임

표.늘림 -> 함정: { style.stroke-dash: 3 }
