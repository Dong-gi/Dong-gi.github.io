# 강화와 처벌의 네 칸 — 심리학 7장.
#
# 무엇을 읽어야 하나: 두 줄과 두 칸이 서로 다른 것을 묻는다는 것. 줄은 ‘그 뒤에
# 그 행동이 늘었나 줄었나’ 이고, 가로는 ‘무엇을 주었나 없앴나’ 다.
# 그래서 ‘부적 강화’ 는 처벌이 아니다. 강화는 늘리는 쪽 줄에 있다.
direction: right

정의: {
  label: "먼저 정할 것"
  direction: down
  a: { label: "강화 · 처벌은 결과로 정한다\n그 행동이 그 뒤에 늘었으면 강화,\n줄었으면 처벌이다.\n주는 사람의 의도로 정하지 않는다"; style.bold: true }
  b: { label: "정적 · 부적은 방향으로 정한다\n무언가를 더한 것이면 정적,\n있던 것을 없앤 것이면 부적이다.\n좋다 · 나쁘다의 뜻이 아니다" }
  a -> b
}

늘림: {
  label: "행동이 늘었다 — 강화"
  grid-columns: 2
  pr: { label: "정적 강화\n행동 뒤에 무언가를 더한다\n보기 — 문제를 풀자 칭찬이 따라왔고,\n그 뒤로 문제를 더 자주 푼다"; style.bold: true }
  nr: { label: "부적 강화\n행동 뒤에 있던 것을 없앤다\n보기 — 안전띠를 매자 경고음이 그쳤고,\n그 뒤로 더 빨리 매게 되었다"; style.bold: true }
}

줄임: {
  label: "행동이 줄었다 — 처벌"
  grid-columns: 2
  pp: { label: "정적 처벌\n행동 뒤에 무언가를 더한다\n보기 — 규칙을 어기자 벌점이 붙었고,\n그 뒤로 그 행동이 줄었다" }
  np: { label: "부적 처벌\n행동 뒤에 있던 것을 없앤다\n보기 — 규칙을 어기자 쓰던 권한이 사라졌고,\n그 뒤로 그 행동이 줄었다" }
}

정의 -> 늘림
정의 -> 줄임

함정: {
  label: "　\n가장 흔한 잘못 — ‘부적 강화’ 를 처벌로 읽는 것.\n부적 강화는 행동을 늘린다. 없애 준 것이 그 사람에게 치우고 싶은 것이었기 때문이다"
  shape: text
}
늘림 -> 함정: { style.stroke-dash: 3 }
