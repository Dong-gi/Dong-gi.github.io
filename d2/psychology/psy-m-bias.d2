# 자기보고를 비트는 것들 — 심리학 5장.
#
# 무엇을 읽어야 하나: 왼쪽 셋은 응답자에게서, 오른쪽 둘은 상황과 연구자에게서 온다는 것.
# 그리고 대응이 ‘더 솔직하게 답해 달라고 부탁하기’ 가 아니라 설계라는 것.
direction: right

응답자: {
  label: "응답자 쪽에서 오는 것"
  direction: down
  바람직: { label: "사회적 바람직성\n좋게 보이는 쪽으로 답한다.\n투표했는지, 얼마나 운동하는지 같은 문항에서 크다"; style.bold: true }
  묵종: { label: "묵종 경향\n내용과 상관없이 ‘그렇다’ 쪽으로 답한다" }
  극단: { label: "반응 양식\n어떤 사람은 늘 양 끝을, 어떤 사람은 늘 가운데를 고른다.\n집단끼리 이 양식이 다르면 비교가 깨진다" }
}

상황: {
  label: "상황과 연구자 쪽에서 오는 것"
  direction: down
  요구: { label: "요구특성\n연구가 무엇을 바라는지 눈치채고 거기 맞춰 준다"; style.bold: true }
  문항: { label: "문항 표현과 순서\n같은 것을 묻는데 낱말과 순서만 바꿔도 답의 분포가 달라진다" }
}

대응: {
  label: "무엇으로 막는가"
  direction: down
  역문항: { label: "역채점 문항을 섞는다 — 묵종을 잡아낸다" }
  익명: { label: "익명 보장과 응답 방식 — 사회적 바람직성을 줄인다" }
  은폐: { label: "가설을 감추고 조건을 은폐한다 — 요구특성을 줄인다" }
  간접: { label: "자기보고 말고 다른 지표를 함께 잰다 — 행동 기록, 타인 평정" }
  사전: { label: "문항과 채점 규칙을 자료 보기 전에 못 박는다 — 6장의 사전등록" }
}

응답자 -> 대응
상황 -> 대응

한계: {
  label: "　\n어느 것도 없애지 못하고 줄일 뿐이다. 그래서 자기보고로 잰 값과\n행동으로 잰 값이 어긋날 때, 어느 쪽이 틀렸다고 곧장 말할 수 없다.\n둘이 서로 다른 것을 재고 있을 가능성이 늘 있다"
  shape: text
}
대응 -> 한계: { style.stroke-dash: 3 }
