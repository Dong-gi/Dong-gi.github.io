# 역추론 — 켜졌으니 그 과정이 일어났다? 심리학 13장.
#
# 무엇을 읽어야 하나: 화살표의 방향이다. 연구가 세운 것은 왼쪽 방향이고
# 흔히 하는 주장은 오른쪽 방향인데, 둘은 같은 문장이 아니다.
direction: down

세운것: {
  label: "연구가 실제로 세운 것"
  style.bold: true
}
세운말: {
  label: "그 과정을 일으키는 과제를 시키면 영역 A 가 자주 켜졌다.\n조건을 바꿔 가며 여러 번 확인했다"
  shape: text
}
세운것 -> 세운말: { style.stroke-dash: 3 }

주장: {
  label: "흔히 덧붙는 주장 — 역추론"
  style.bold: true
}
주장말: {
  label: "새 실험에서 영역 A 가 켜졌다.\n그러므로 그 심리 과정이 일어난 것이다"
  shape: text
}
주장 -> 주장말: { style.stroke-dash: 3 }

세운것 -> 주장: "방향이 뒤집혔다"

성립조건: {
  label: "이 뒤집기가 성립하려면 무엇이 필요한가"
  direction: down
  n1: { label: "영역 A 가 ‘그 과정에서만’ 켜져야 한다.\n다른 과제에서도 켜진다면 뒤집기는 무효다"; style.bold: true }
  n2: { label: "그리고 그 과정이 얼마나 흔한지(기저율)를 알아야 한다.\n드문 과정이면 켜졌다는 사실이 알려 주는 것이 거의 없다"; style.bold: true }
}
주장 -> 성립조건

현실: {
  label: "그런데 실제로는 —\n넓게 쓰이는 영역일수록 여러 과제에서 켜진다.\n어떤 영역들은 아주 많은 종류의 과제에서 켜지며,\n바로 그런 영역이 논문에서 가장 자주 인용된다"
  shape: text
}
성립조건 -> 현실: { style.stroke-dash: 3 }

계산: {
  label: "숫자로 보면 어떻게 되는가는 이 절의 그림(넓이 그림)에 있다.\n그 과정에서 70% 켜지고 아닌 과제에서도 40% 켜지며 그 과정이 30% 라면,\n켜졌다는 사실이 주는 확신은 절반에 못 미친다"
  shape: text
}
현실 -> 계산: { style.stroke-dash: 3 }

정리: {
  label: "　\n그러므로 정확한 보고는 ‘영역 A 의 신호가 조건 사이에 달랐다’ 까지다.\n\n역추론을 쓰려면 그 영역이 다른 과제에서 얼마나 켜지는지를\n따로 대야 한다. 그 자료를 모아 둔 데이터베이스가 그래서 만들어졌다"
  shape: text
}
계산 -> 정리: { style.stroke-dash: 3 }
