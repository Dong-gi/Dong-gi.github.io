# 같은 자료를 세는 두 방법 — 심리학 18장(애쉬의 선분 과제).
#
# 무엇을 읽어야 하나: 두 문장이 같은 자료에서 나왔는데 정반대의 인상을 준다는 것.
# ‘사람은 다수를 따른다’ 와 ‘사람은 대체로 버틴다’ 가 둘 다 이 자료에서 나온다.
direction: down

자료: {
  label: "하나의 자료\n참가자 여러 명이 여러 번의 임계 시행에서 각각 답했다"
  shape: oval
  style.bold: true
}

시행: {
  label: "시행을 센다"
  direction: down
  a: { label: "전체 임계 시행 가운데 동조한 답이 나온 것이 몇 번인가" }
  b: { label: "소수에 그친다. 대다수 시행에서는 참가자가 눈에 보이는 대로 답했다"; style.bold: true }
  c: { label: "여기서 나오는 문장 — ‘사람은 대체로 다수에 휘둘리지 않는다’" }
  a -> b -> c
}

사람: {
  label: "사람을 센다"
  direction: down
  d: { label: "적어도 한 번 동조한 참가자가 몇 명인가" }
  e: { label: "다수다. 끝까지 한 번도 따라가지 않은 사람은 오히려 적다"; style.bold: true }
  f: { label: "여기서 나오는 문장 — ‘사람은 다수를 따라간다’" }
  d -> e -> f
}

자료 -> 시행
자료 -> 사람

교훈: {
  label: "　\n두 문장 다 참이고 같은 자료에서 나왔다. 무엇을 세었는지가 다를 뿐이다.\n그러므로 어떤 결과를 읽을 때 ‘무엇을 단위로 세었는가’ 를 확인해야 한다.\n\n덧붙여 — 애쉬 자신이 관심을 둔 것은 따라간 사람이 아니라 버틴 사람이었다.\n실험은 ‘사람이 얼마나 잘 휘둘리는가’ 가 아니라 ‘무엇이 독립을 지키게 하는가’ 를 묻는 것이었다"
  shape: text
}
시행 -> 교훈: { style.stroke-dash: 3 }
사람 -> 교훈: { style.stroke-dash: 3 }
