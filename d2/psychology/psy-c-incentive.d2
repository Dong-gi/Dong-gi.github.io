# 왜 일어났는가 — 유인 구조의 고리. 심리학 6장.
#
# 무엇을 읽어야 하나: 고리가 닫혀 있다는 것. 어느 칸에도 ‘나쁜 사람’ 이 없는데
# 한 바퀴 돌 때마다 문헌에 위양성이 쌓인다. 개인의 성실성으로 끊을 수 없는 고리다.
direction: down

고리: {
  label: "닫힌 고리"
  direction: down

  출판: {
    label: "학술지는 새롭고 유의한 결과를 싣는다\n‘차이가 없었다’ 는 실리기 어렵다"
    style.bold: true
  }
  보상: {
    label: "채용 · 승진 · 연구비가 논문 수와 실린 곳으로 정해진다"
    style.bold: true
  }
  선택: {
    label: "유의한 결과를 내는 쪽으로 선택이 쌓인다\n분석을 여러 갈래로 해 보고, 되는 것만 보고하고,\n결과를 보고 나서 가설을 맞춘다"
    style.bold: true
  }
  작은표본: {
    label: "표본은 작게 유지된다\n같은 예산으로 논문을 여럿 내려면 연구마다 작아진다"
  }
  위양성: {
    label: "문헌에 위양성과 부풀린 효과크기가 쌓인다"
    style.bold: true
  }
  안걸림: {
    label: "걸러지지 않는다\n재현 연구는 실어 주지 않고 보상도 없다"
    style.bold: true
  }

  출판 -> 보상
  보상 -> 선택
  선택 -> 위양성
  작은표본 -> 위양성: "작은 표본은 유의할 때 효과를 부풀린다"
  보상 -> 작은표본
  위양성 -> 안걸림
  안걸림 -> 출판: "쌓인 것이 다시 ‘알려진 사실’ 이 된다"
}

요점: {
  label: "이 그림의 요점"
  direction: down
  a: { label: "고리 안 어디에도 자료를 조작하는 사람이 없다.\n각 칸은 그 자리에서는 합리적인 행동이다"; style.bold: true }
  b: { label: "그래서 ‘더 정직해지자’ 로는 끊기지 않는다.\n끊으려면 화살표 자체를 바꿔야 한다" }
  c: { label: "실제로 바뀐 것들은 전부 화살표를 겨눈다 —\n사전등록은 선택을, 등록보고서는 출판을,\n다중연구실은 작은 표본을, 재현 특집호는 마지막 화살표를" }
}
고리 -> 요점: { style.stroke-dash: 3 }
