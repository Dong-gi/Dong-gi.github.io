# 기억의 세 걸음과 각 걸음의 실패 — 심리학 8장.
#
# 무엇을 읽어야 하나: ‘기억이 안 난다’ 가 세 가지 서로 다른 사태를 가리킨다는 것.
# 어느 걸음에서 어긋났는지에 따라 고치는 방법도 다르다.
direction: down

부호화: {
  label: "부호화\n들어온 것을 남길 수 있는 꼴로 바꾼다"
  style.bold: true
}
저장: {
  label: "저장\n그 꼴을 시간이 흐르는 동안 유지한다"
  style.bold: true
}
인출: {
  label: "인출\n필요할 때 그것을 다시 꺼낸다"
  style.bold: true
}

부호화 -> 저장 -> 인출

실패1: {
  label: "여기서 어긋나면\n애초에 들어가지 않았다. 주의가 다른 데 있었거나\n뜻을 처리하지 않고 겉만 지나갔다.\n이때는 아무리 단서를 줘도 나오지 않는다"
  shape: text
}
실패2: {
  label: "여기서 어긋나면\n있던 것이 흐려지거나 다른 것에 밀린다.\n그 자리에 들어온 비슷한 자료가 원인인 경우가 많다"
  shape: text
}
실패3: {
  label: "여기서 어긋나면\n있는데 못 꺼낸다. 단서가 맞으면 그대로 나온다.\n혀끝에서 맴도는 상태가 이쪽이다"
  shape: text
}

부호화 -> 실패1: { style.stroke-dash: 3 }
저장 -> 실패2: { style.stroke-dash: 3 }
인출 -> 실패3: { style.stroke-dash: 3 }

시사: {
  label: "　\n실무에서 갈라 보는 법 — 단서를 주었을 때 나오면 인출의 문제이고,\n단서를 줘도 나오지 않으면 앞의 두 걸음 가운데 하나다.\n재인 검사와 회상 검사를 함께 쓰는 이유가 여기 있다"
  shape: text
}
실패3 -> 시사: { style.stroke-dash: 3 }
