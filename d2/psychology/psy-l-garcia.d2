# 가르시아와 쾰링의 설계 — 심리학 7장.
#
# 무엇을 읽어야 하나: 네 칸 가운데 두 칸에서만 학습이 일어났다는 것, 그리고
# 그 두 칸이 대각선으로 놓인다는 것. 어떤 짝은 붙고 어떤 짝은 붙지 않는다.
#
# 배치: 두 결과를 가로줄로, 두 자극을 세로줄로 둔 3×3 격자(첫 줄·첫 칸은 머리).
# 두 결과를 한 줄에 나란히 두면 네 칸이 한 줄이 되어 대각선이 보이지 않는다.
direction: down

# 머리 칸은 테두리 없는 상자로 둔다. 글 모양(shape: text)은 격자 칸을 채우지 않아 머리가 칸 왼쪽 위로 쏠린다.
classes: {
  머리칸: { style: { fill: transparent; stroke: transparent; bold: true } }
}

설계: {
  label: "쥐에게 두 가지를 함께 준다 — 맛이 있는 물, 그리고 마실 때 켜지는 빛과 소리.\n그 뒤에 오는 결과만 조건마다 다르게 한다"
  shape: text
}

네칸: {
  label: "네 칸 — 가로줄은 뒤에 오는 결과, 세로줄은 함께 준 자극"
  grid-rows: 3
  grid-columns: 3
  grid-gap: 16

  모서리: { label: "결과 ↓ · 자극 →"; style: { fill: transparent; stroke: transparent } }
  맛머리: { label: "맛"; class: 머리칸 }
  빛머리: { label: "빛과 소리"; class: 머리칸 }

  메스: { label: "뒤에 속이\n불편해진다"; class: 머리칸 }
  m1: { label: "배운다\n그 맛을 피하게 된다.\n한 번으로도, 몇 시간 뒤에\n불편해져도 배운다"; style.bold: true; style.stroke-width: 3 }
  m2: { label: "거의 배우지 않는다\n같은 횟수를 짝지어도\n피하게 되지 않는다" }

  통증: { label: "뒤에 발에\n짧은 자극이 온다"; class: 머리칸 }
  t1: { label: "거의 배우지 않는다" }
  t2: { label: "배운다\n그 신호를 피하게 된다"; style.bold: true; style.stroke-width: 3 }
}

설계 -> 네칸

결론: {
  label: "무엇이 무너졌나"
  direction: down
  c1: { label: "무너진 가정 — 어떤 자극이든 어떤 결과와도 똑같이 연합될 수 있다.\n이것을 등가능성 가정이라 부른다. 이 설계가 그것을 반증했다"; style.bold: true }
  c2: { label: "함께 무너진 것 — 연합은 두 사건이 거의 동시일 때만 생긴다.\n맛과 불편함은 몇 시간이 떨어져 있어도 붙는다" }
  c3: { label: "대신 세워진 것 — 준비성.\n동물마다 붙기 쉬운 짝과 붙기 어려운 짝이 미리 정해져 있다.\n그 짝은 그 종이 살아온 환경과 무관하지 않다" }
  c1 -> c2 -> c3
}

네칸 -> 결론
