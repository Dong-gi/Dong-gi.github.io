# 심리학의 짧은 계보 — 심리학 3장.
#
# 무엇을 읽어야 하나: 화살표에 붙은 말이 전부 ‘무엇을 자료로 인정할 것인가’ 에
# 대한 다툼이라는 것. 주제가 바뀐 것이 아니라 자료의 기준이 바뀌었다.
direction: down

앞: {
  label: "철학과 생리학\n마음에 대한 물음은 오래되었지만\n재는 절차가 없었다"
  shape: oval
}

구성: {
  label: "구성주의\n분트(1832–1920) · 티치너(1867–1927)\n훈련된 내성 보고로 의식 경험의 성분을 찾는다"
  style.bold: true
}

기능: {
  label: "기능주의\n제임스(1842–1910)\n성분이 아니라 ‘무엇에 쓰이는가’ 를 묻는다"
}

행동: {
  label: "행동주의\n왓슨(1878–1958) · 스키너(1904–1990)\n관찰 가능한 행동만 자료로 삼는다. 속은 묻지 않는다"
  style.bold: true
}

인지: {
  label: "인지혁명\n밀러(1920–2012) · 나이서(1928–2012)\n속의 처리 과정을 정보 처리 모형으로 세우고 반응 시간으로 검사한다"
  style.bold: true
}

지금: {
  label: "지금\n인지신경과학 · 계산 모형 · 대규모 자료\n그리고 6장의 재현 위기 이후의 방법 개혁"
  style.bold: true
}

앞 -> 구성: "재는 절차를 만든다"
구성 -> 기능: "성분보다 기능을 묻자"
구성 -> 행동: "내성 보고는 사람마다 달라 검사할 수 없다"
기능 -> 행동
행동 -> 인지: "행동만으로는 언어와 기억을 설명하지 못한다"
인지 -> 지금: "측정 수단이 늘어난다"

남은것: {
  label: "　\n행동주의가 틀려서 버려진 것이 아니다. 조건형성 연구는 지금도 튼튼하고 7장이 그것을 다룬다.\n바뀐 것은 ‘속을 묻지 않는다’ 는 금지였다.\n인지혁명은 속을 묻되 검사 가능한 형태로 묻는 방법을 찾은 것이다"
  shape: text
}
인지 -> 남은것: { style.stroke-dash: 3 }
