# 네 물음 — 심리학 6장. 이 문서가 7장부터 계속 쓰는 잣대다.
#
# 무엇을 읽어야 하나: 넷이 서로 다른 것을 묻는다는 것. 하나에 답했다고
# 나머지가 답해지지 않으며, 넷 다 통과해야 ‘알려진 사실’ 로 다룰 수 있다.
direction: down

주장: {
  label: "어떤 심리학 주장을 만났다"
  shape: oval
  style.bold: true
}

하나: {
  label: "1. 재현되었는가"
  style.bold: true
}
하나말: {
  label: "원 연구 하나뿐인가, 다른 연구실이 독립적으로 되풀이했는가.\n같은 사람들이 같은 실험실에서 여러 번 한 것은 독립적인 재현이 아니다.\n답이 ‘원 연구뿐’ 이면 그 아래 세 물음의 답은 다 잠정적이다"
  shape: text
}
하나 -> 하나말: { style.stroke-dash: 3 }

둘: {
  label: "2. 표본이 무엇인가"
  style.bold: true
}
둘말: {
  label: "누가 참가했는가. 어느 나라, 몇 살, 어떤 경로로 모였는가.\nWEIRD 표본 — 서양의 · 교육받은 · 산업화된 · 부유한 · 민주주의 국가 —\n특히 그 나라의 대학생만이라면 결론의 범위가 거기까지다"
  shape: text
}
둘 -> 둘말: { style.stroke-dash: 3 }

셋: {
  label: "3. 효과가 얼마나 큰가"
  style.bold: true
}
셋말: {
  label: "‘유의하다’ 는 크기를 말하지 않는다. 효과크기와 구간을 찾아본다.\n구간이 넓으면 그 연구는 크기에 대해 거의 아무 말도 하지 않은 것이다"
  shape: text
}
셋 -> 셋말: { style.stroke-dash: 3 }

넷: {
  label: "4. 얼마나 일반화되는가"
  style.bold: true
}
넷말: {
  label: "실험실 과제에서 잰 것이 바깥의 어떤 행동에 대응하는가.\n화면 앞에서 몇 밀리초 빨라진 것과 실제로 무엇을 하는 것 사이에\n어떤 다리가 놓였는가. 다리를 놓지 않은 채 건너뛴 주장이 가장 흔하다"
  shape: text
}
넷 -> 넷말: { style.stroke-dash: 3 }

주장 -> 하나 -> 둘 -> 셋 -> 넷

쓰는법: {
  label: "　\n이 넷은 주장을 버리기 위한 것이 아니라 어디까지 믿을지를 정하기 위한 것이다.\n네 물음에 잘 답하는 주장은 그만큼 세게 쓰고, 못 답하는 주장은 그만큼 조심해서 쓴다.\n‘심리학은 다 엉터리’ 라는 결론은 이 넷을 쓰지 않은 결론이며, 그것도 틀린 결론이다"
  shape: text
}
넷 -> 쓰는법
