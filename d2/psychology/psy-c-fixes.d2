# 무엇이 실제로 바뀌었나 — 심리학 6장.
#
# 무엇을 읽어야 하나: 왼쪽 문제 하나마다 오른쪽 대응이 붙어 있고,
# 그 대응이 사람의 마음가짐이 아니라 절차라는 것. 그리고 아직 안 풀린 것이 아래에 있다.
direction: right

문제: {
  label: "무엇이 문제였나"
  direction: down
  p1: { label: "결과를 보고 나서 가설과 분석을 정한다" }
  p2: { label: "유의한 것만 실린다" }
  p3: { label: "표본이 작아 검정력이 낮다" }
  p4: { label: "재현을 아무도 하지 않는다" }
  p5: { label: "자료와 재료를 볼 수 없어 확인이 안 된다" }
  p6: { label: "효과크기 없이 유의성만 보고한다" }
}

대응: {
  label: "무엇이 생겼나"
  direction: down
  f1: { label: "사전등록\n가설 · 표본 크기 · 제외 기준 · 분석을 자료 보기 전에 공개 저장소에 올린다"; style.bold: true }
  f2: { label: "등록보고서\n결과가 나오기 전에 설계만으로 심사하고 게재를 확정한다.\n결과가 어떻게 나오든 실린다"; style.bold: true }
  f3: { label: "다중연구실 프로젝트\n여러 나라의 연구실이 같은 절차로 동시에 재서 표본을 키운다"; style.bold: true }
  f4: { label: "재현 연구를 싣는 지면과 재현 특집호" }
  f5: { label: "자료 · 재료 · 분석 코드 공개, 그리고 그것을 표시하는 배지" }
  f6: { label: "효과크기와 구간을 함께 보고하도록 학술지가 요구한다" }
}

문제.p1 -> 대응.f1
문제.p2 -> 대응.f2
문제.p3 -> 대응.f3
문제.p4 -> 대응.f4
문제.p5 -> 대응.f5
문제.p6 -> 대응.f6

효과: {
  label: "바뀌었다는 근거"
  direction: down
  a: { label: "등록보고서로 실린 논문에서는 가설이 지지된 비율이 표준 논문보다 훨씬 낮다.\n같은 분야에서 같은 종류의 물음을 다루는데 그렇다"; style.bold: true }
  b: { label: "표본 크기가 커졌고, 다중연구실 재현이 정례가 되었다" }
  c: { label: "‘이 결과는 재현되었는가’ 가 논문을 읽을 때의 기본 물음이 되었다" }
}
대응 -> 효과: { style.stroke-dash: 3 }

남은: {
  label: "아직 남은 것"
  direction: down
  x: { label: "사전등록을 했다고 계획대로 했다는 뜻은 아니다. 벗어난 곳을 밝히지 않으면 확인할 길이 없다" }
  y: { label: "재현이 여전히 잘 보상되지 않는다. 지면은 생겼지만 채용과 승진의 셈법은 덜 바뀌었다" }
  z: { label: "2015년 이전에 쌓인 문헌은 대부분 다시 확인되지 않은 채로 남아 있다"; style.bold: true }
}
효과 -> 남은: { style.stroke-dash: 3 }
