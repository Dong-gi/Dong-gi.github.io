# 검사가 오용되는 자리들 — 심리학 17장.
#
# 무엇을 읽어야 하나: 오용이 대개 ‘검사가 나빠서’ 가 아니라
# ‘점수를 읽는 방식’ 에서 생긴다는 것. ‘역사’ 칸이 사실이고 ‘지금 자주 일어나는 오용’ 칸이 건너뛴 자리다.
#
# 배치: 칸을 두 줄로 접었다 — 역사 → 교훈 → 지금 → 물음 순으로 화살표를 따라 읽는다
# (그래서 ‘물음’ 을 ‘지금’ 보다 먼저 적었다).
direction: down
grid-rows: 2
grid-columns: 2
grid-gap: 70

역사: {
  label: "역사 — 어디까지 갔었나"
  grid-columns: 1
  grid-gap: 50
  h1: { label: "20세기 초, 지능 검사 점수가\n이민을 제한하는 정책 논의에 인용되었다.\n검사는 영어와 그 나라 생활에 대한 지식을 요구했고,\n갓 도착한 사람들의 낮은 점수가\n‘타고난 능력’ 의 증거로 읽혔다"; style.bold: true }
  h2: { label: "여러 주에 강제 불임 법이 있었고\n1927년 미국 연방대법원이 이를 인정했다.\n검사 점수와 ‘정신 능력’ 판정이 그 판단에 쓰였다"; style.bold: true }
  h3: { label: "검사를 만든 사람들 가운데 일부는 이런 쓰임에 반대했다.\n비네는 이 검사를 학교에서\n도움이 필요한 아이를 찾는 도구로 만들었고\n타고난 능력의 등급으로 쓰는 것을 경계했다" }
  h1 -> h2
}

교훈: {
  label: "여기서 배울 것"
  grid-columns: 1
  l1: { label: "타당도는 검사의 성질이 아니라 해석의 성질이다.\n같은 검사도 어떤 해석에는 타당하고\n어떤 해석에는 타당하지 않다"; style.bold: true }
  l2: { label: "그러므로 ‘이 검사가 좋은 검사인가’ 는 반쪽 물음이다.\n‘이 점수로 무엇을 하려 하는가’ 가 함께 와야 한다"; style.bold: true }
}

# 격자 칸은 ‘지금’ 묶음만큼 높은데 글 상자는 칸 위쪽에 붙고 점선은 칸 가운데로 온다.
# 빈 줄로 글을 점선 높이까지 내린다(그러지 않으면 점선이 빈 곳을 가리킨다)
물음: {
  label: "　\n　\n　\n　\n　\n　\n　\n　\n　\n　\n　\n　\n　\n　\n　\n　\n　\n　\n　\n검사를 쓰는 자리에서 물어야 할 것 —\n이 점수가 무엇과 관련 있다는 증거가 있는가 ·\n오차가 얼마인가 ·\n어느 집단에서 만들어졌는가 ·\n이 결정에 이 점수만 쓰는가"
  shape: text
}

지금: {
  label: "지금 자주 일어나는 오용"
  grid-columns: 1
  m1: { label: "준거 타당도 없이 거른다\n이 점수가 나중의 수행과 관련이 있는지 확인하지 않은 채\n채용이나 배치의 기준으로 쓴다" }
  m2: { label: "집단의 평균을 개인에게 붙인다\n두 집단의 평균이 다르다는 것에서\n앞에 있는 이 사람에 대한 결론을 낸다.\n분포가 크게 겹치면 그 결론은 거의 언제나 틀린다"; style.bold: true }
  m3: { label: "오차를 무시한 문턱\n한 점 차이로 자른다. 어떤 검사에도 오차가 있으므로\n문턱 근처의 판정은 다시 재면 뒤집힌다"; style.bold: true }
  m4: { label: "연속된 점수를 유형으로 바꿔 쓴다\n사람에게 이름표가 붙고,\n그 이름표가 배치와 기대를 정한다" }
  m5: { label: "문항이 요구하는 배경 지식\n특정 배경에서 자란 사람에게만 익숙한 것을 묻는 문항이 있으면\n그것이 재는 것에 섞인다" }
}

역사 -> 교훈 -> 지금
지금 -> 물음: { style.stroke-dash: 3 }
