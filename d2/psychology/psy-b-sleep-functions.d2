# 잠은 무엇을 위한 것인가 — 나란히 놓인 가설들. 심리학 14장.
#
# 무엇을 읽어야 하나: 어느 하나가 정답으로 정해져 있지 않다는 것,
# 그리고 가설마다 기대는 증거의 ‘종류’가 다르다는 것.
# 서로 배타적이지도 않다 — 잠이 여러 일을 함께 할 수 있다.
direction: down

물음: {
  label: "왜 자는가 — 아직 하나로 정해지지 않았다"
  shape: oval
  style.bold: true
}

회복: {
  label: "회복"
  direction: down
  a1: { label: "주장 — 깨어 있는 동안 쌓인 것을 되돌린다" }
  a2: { label: "기대는 증거 — 오래 깨어 있으면 수행이 나빠지고 잠을 자면 돌아온다" }
  a3: { label: "약한 자리 — ‘무엇이 회복되는가’ 가 정해지지 않으면\n거의 반증되지 않는 주장이 된다" }
  a1 -> a2 -> a3
}

절약: {
  label: "에너지 절약 · 활동 시간 제한"
  direction: down
  b1: { label: "주장 — 쓸모없거나 위험한 시간대에 활동을 줄이는 장치다" }
  b2: { label: "기대는 증거 — 종에 따른 수면 시간과 생태의 관계" }
  b3: { label: "약한 자리 — 종 사이의 비교는 상관 자료이고,\n잠이 왜 ‘의식을 잃는 형태’여야 하는지를 설명하지 않는다" }
  b1 -> b2 -> b3
}

기억: {
  label: "기억의 정리"
  direction: down
  c1: { label: "주장 — 낮에 얻은 것을 자는 동안 다시 처리해 자리 잡게 한다" }
  c2: { label: "기대는 증거 — 학습 뒤 잠을 잔 집단과 아닌 집단의 비교,\n자는 동안의 신경 활동 패턴 연구" }
  c3: { label: "약한 자리 — 잠을 못 자게 하는 조작은 스트레스와 각성도 함께 바꾼다.\n4장의 혼입변수 문제가 이 계열의 상수다"; style.bold: true }
  c1 -> c2 -> c3
}

연결: {
  label: "연결의 정리"
  direction: down
  d1: { label: "주장 — 깨어 있는 동안 강해진 연결을 자는 동안 전체적으로 낮춰\n다음 날 다시 배울 여지를 만든다" }
  d2: { label: "기대는 증거 — 깨어 있는 시간과 잠자는 시간에 따른\n신경 지표의 변화" }
  d3: { label: "약한 자리 — 사람에게서 직접 재기 어렵고, 간접 지표에 기댄다" }
  d1 -> d2 -> d3
}

청소: {
  label: "노폐물의 제거"
  direction: down
  e1: { label: "주장 — 자는 동안 뇌 안의 액체 흐름이 달라져 노폐물이 잘 빠져나간다" }
  e2: { label: "기대는 증거 — 동물에서 잰 흐름과 물질 농도" }
  e3: { label: "약한 자리 — 이 계열은 비교적 최근이고,\n뒤이어 반대 방향의 결과를 보고한 연구도 있다. ‘다투어지는 중’ 이다"; style.bold: true }
  e1 -> e2 -> e3
}

물음 -> 회복
물음 -> 절약
물음 -> 기억
물음 -> 연결
물음 -> 청소

정리: {
  label: "　\n이 문서의 태도 — 어느 하나를 정답처럼 쓰지 않는다.\n\n그리고 이 다섯은 서로 배타적이지 않다. 잠이 여러 일을 함께 할 수도 있고,\n단계마다 다른 일을 할 수도 있다. 지금 자료로 갈리지 않는다.\n\n대신 튼튼한 것 하나는 적어 둘 수 있다 —\n‘충분히 자지 못하면 여러 종류의 수행이 나빠진다’ 는 것은 되풀이 확인되었다.\n그것은 ‘왜 자는가’ 에 대한 답이 아니라 ‘안 자면 어떻게 되는가’ 에 대한 답이다"
  shape: text
}
회복 -> 정리: { style.stroke-dash: 3 }
청소 -> 정리: { style.stroke-dash: 3 }
