# 타당도의 갈래 — 심리학 5장.
#
# 무엇을 읽어야 하나: 갈래가 여럿이지만 묻는 것은 하나라는 것 —
# ‘이 점수로 저 결론을 내려도 되는가’. 타당도는 검사의 성질이 아니라 해석의 성질이다.
#
# 배치: 위에서 아래로 세 줄 — 물음, 갈래, [신뢰도 | 구성 타당도가 특이한 이유]. 꼬리는 보이지 않는 틀이다.
direction: down
grid-columns: 1
grid-gap: 80

물음: {
  label: "이 점수를 그 뜻으로 읽어도 되는가"
  shape: oval
  style.bold: true
}

갈래: {
  label: "무엇으로 확인하는가"
  grid-rows: 1
  grid-columns: 3
  grid-gap: 50
  내용: { label: "내용 타당도\n재려는 범위를 문항이 고루 덮는가.\n덧셈만 묻는 수학 시험은\n수학 실력을 덮지 못한다" }
  준거: { label: "준거 타당도\n바깥의 다른 지표와 맞아떨어지는가.\n지금의 다른 지표(공인)일 수도,\n나중의 결과(예언)일 수도 있다" }
  구성: { label: "구성 타당도\n재려는 구성개념의 이론이\n시키는 대로 움직이는가.\n같은 것을 잰다는 지표와는 높게,\n다른 것을 잰다는 지표와는 낮게 상관해야 한다"; style.bold: true }
}

꼬리: {
  label: ""
  style: { fill: transparent; stroke: transparent }
  grid-rows: 1
  grid-columns: 2
  grid-gap: 80

  신뢰도: {
    label: "신뢰도와의 관계\n신뢰도는 타당도의 필요조건이고\n충분조건이 아니다.\n흔들리는 자로는 아무것도 잴 수 없지만,\n안 흔들린다고 옳은 것을 재는 것은 아니다"
    style.bold: true
  }

  구성설명: {
    label: "구성 타당도가 특이한 이유"
    grid-columns: 1
    a: { label: "정답지가 없다. 지능이나 불안에는\n‘참값’ 을 알려 주는 바깥의 자가 없다" }
    b: { label: "그래서 검사와 이론을 함께 검사하게 된다.\n예측이 빗나가면 검사가 나쁜 것일 수도,\n이론이 틀린 것일 수도 있다" }
    c: { label: "한 번에 끝나지 않는다.\n증거가 쌓이면서 올라가고,\n반증이 나오면 내려간다" }
  }
}

물음 -> 갈래
갈래.구성 -> 꼬리.구성설명
갈래 -> 꼬리.신뢰도: { style.stroke-dash: 3 }
