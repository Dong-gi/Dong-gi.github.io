# 진단 분류 체계 — 무엇이고 무엇이 아닌가. 심리학 19장.
#
# 무엇을 읽어야 하나: 왼쪽과 오른쪽이 서로 반대되는 목록이 아니라는 것.
# 왼쪽의 쓸모가 진짜이기 때문에 오른쪽의 오해가 생긴다.
direction: right

체계: {
  label: "국제 분류 체계와 진단 편람"
  shape: oval
  style.bold: true
}
설명: {
  label: "세계보건기구가 만드는 국제 질병 분류는 통계 · 행정 · 보험의 국제 기준이고,\n미국정신의학회가 만드는 편람은 그 나라와 연구에서 널리 쓰인다.\n둘은 서로를 참조하며 개정되고, 개정마다 경계가 바뀐다"
  shape: text
}
체계 -> 설명: { style.stroke-dash: 3 }

이다: {
  label: "무엇인가"
  direction: down
  a: { label: "합의로 만들어진 분류 규약이다.\n같은 말을 쓰기 위한 약속이라는 것이 첫 번째 쓰임이다"; style.bold: true }
  b: { label: "임상가 사이의 소통 — 다른 곳의 기록을 읽을 수 있게 한다" }
  c: { label: "연구 표본의 정의 — 어떤 사람들을 모았는지 남이 알 수 있게 한다" }
  d: { label: "행정과 보험의 기준 — 자원이 어디로 가는지를 정한다" }
}

아니다: {
  label: "무엇이 아닌가"
  direction: down
  e: { label: "자연에서 발견한 종류의 목록이 아니다.\n경계는 자료에서 튀어나온 것이 아니라 위원회에서 정해진 것이다"; style.bold: true }
  f: { label: "원인의 이론이 아니다.\n대부분의 범주가 겉으로 관찰되는 것들의 묶음으로 정의된다"; style.bold: true }
  g: { label: "그 사람에 대한 설명이 아니다.\n이름은 왜 그런지를 말해 주지 않는다. 이름으로 이유를 대면 같은 말을 되풀이한 것이다"; style.bold: true }
  h: { label: "스스로 써 보는 도구가 아니다.\n판정에는 훈련과 면담과 맥락이 든다. 목록을 읽는 것으로 대신할 수 없다"; style.bold: true }
}

체계 -> 이다
체계 -> 아니다

미결: {
  label: "범주인가 차원인가 — 이 문서는 어느 쪽도 고르지 않는다"
  direction: down
  m1: { label: "범주 쪽의 가장 강한 형태 —\n임상의 결정은 이산적이다. 하느냐 마느냐를 정해야 하고,\n행정과 소통에도 이름이 필요하다. 그리고 이름이 없으면 연구도 모을 수 없다"; style.bold: true }
  m2: { label: "차원 쪽의 가장 강한 형태 —\n관찰된 점수의 분포에 골짜기가 없고, 한 이름 아래 서로 아주 다른 사람들이 들어오며,\n두 이름을 함께 받는 일이 예외가 아니라 규칙에 가깝다"; style.bold: true }
  m3: { label: "대안 체계가 제안되어 있다.\n연구용으로 차원과 기제를 축으로 삼자는 틀, 그리고 위계적 차원 구조를 쓰자는 틀이 있다.\n어느 것도 아직 임상 표준을 대신하지 않았다" }
}
아니다 -> 미결

신뢰: {
  label: "　\n5장의 도구로 다시 보면 — 분류 체계에는 신뢰도 물음과 타당도 물음이 따로 있다.\n두 임상가가 같은 사람을 보고 같은 이름을 붙이는가(신뢰도)와\n그 이름이 뜻하는 대로 읽어도 되는가(타당도)는 다른 물음이고, 앞이 좋아도 뒤가 따라오지 않는다"
  shape: text
}
미결 -> 신뢰
