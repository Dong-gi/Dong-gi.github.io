# 손상 연구와 영상 연구는 서로 다른 물음에 답한다. 심리학 13장.
#
# 무엇을 읽어야 하나: 두 줄기가 각각 어디까지 갈 수 있고 어디서 멈추는가.
# 그리고 둘이 같은 자리를 가리킬 때 비로소 결론이 단단해진다는 것.
direction: down

물음: {
  label: "이 영역과 이 심리 기능은 어떤 관계인가"
  shape: oval
  style.bold: true
}

손상: {
  label: "손상 연구"
  direction: down
  a1: { label: "무엇을 하는가 — 어떤 부위가 손상된 사람이 무엇을 못 하는지 본다" }
  a2: { label: "답할 수 있는 것 — 그 부위가 그 일에 ‘필요한가’"; style.bold: true }
  a3: { label: "답할 수 없는 것\n· 정상인 뇌에서 그 부위가 실제로 무슨 일을 하는가\n· 그 부위가 그 일‘만’ 하는가\n· 손상 뒤에 남은 부분이 다시 조직된 결과인지 아닌지" }
  a4: { label: "구조적 한계\n· 표본이 우연히 정해진다. 연구자가 손상 부위를 고를 수 없다\n· 손상이 해부학적 경계를 따르지 않는다. 대개 여러 부위에 걸친다\n· 사례 수가 아주 적다. 한 사람인 경우도 많다" }
  a1 -> a2 -> a3 -> a4
}

영상: {
  label: "영상 연구"
  direction: down
  b1: { label: "무엇을 하는가 — 과제를 하는 동안 어느 부위의 신호가 달라지는지 본다" }
  b2: { label: "답할 수 있는 것 — 그 과제를 할 때 그 부위의 신호가 ‘함께 달라지는가’"; style.bold: true }
  b3: { label: "답할 수 없는 것\n· 그 부위가 그 일에 필요한가 — 켜졌다고 필요한 것이 아니다\n· 그 부위가 켜졌으니 그 심리 과정이 일어났는가 — 역추론 문제\n· 그 신호가 원인인가 결과인가" }
  b4: { label: "구조적 한계\n· 재는 것은 혈류에 딸린 신호이지 신경 활동 자체가 아니다\n· 칸이 아주 많아 보정하지 않으면 우연한 색이 남는다\n· 사람 사이의 상관을 보려면 표본이 아주 커야 한다" }
  b1 -> b2 -> b3 -> b4
}

물음 -> 손상
물음 -> 영상

수렴: {
  label: "둘이 만나는 자리"
  style.bold: true
}
손상 -> 수렴
영상 -> 수렴

수렴말: {
  label: "손상 연구가 ‘필요하다’ 를 대고 영상 연구가 ‘함께 움직인다’ 를 대고,\n둘이 같은 자리를 가리킬 때 결론이 단단해진다.\n\n여기에 세 번째 줄기를 더할 수 있다 — 그 부위의 활동을 일시적으로 바꾸고\n수행이 달라지는지 보는 방법이다. 이쪽은 손상 연구와 달리 ‘무선배정’이 되므로\n4장의 실험이 갖는 힘을 얻는다. 다만 닿을 수 있는 부위가 제한된다"
  shape: text
}
수렴 -> 수렴말: { style.stroke-dash: 3 }
