# 순행 간섭과 역행 간섭 — 심리학 9장.
#
# 무엇을 읽어야 하나: 방향이 반대라는 것. 이름은 ‘무엇이 무엇을 방해하는가’ 가
# 아니라 ‘방해가 어느 쪽으로 가는가’ 를 가리킨다.
#
# 배치(2026-11 폭을 줄였다): 두 간섭은 각각 위에서 아래로 읽는다(1칸 격자 —
# 격자는 적은 차례로 칸을 채우므로 역행 쪽은 r2 를 r1 보다 먼저 적었다). 묶음 제목과 긴 글은 줄을 바꿨다.
direction: down

순행: {
  label: "순행 간섭 —\n앞의 것이\n뒤의 것을 방해한다"
  grid-columns: 1
  grid-gap: 60
  p1: { label: "먼저 배운 것\n지난 학기의 자리 배치" }
  p2: { label: "나중에 배울 것\n이번 학기의 자리 배치"; style.bold: true }
  p3: { label: "검사\n이번 학기 배치를\n떠올린다.\n지난 학기 것이\n먼저 떠오른다" }
  p1 -> p2: "방해가 이 방향으로 간다"
  p2 -> p3
}

역행: {
  label: "역행 간섭 —\n뒤의 것이\n앞의 것을 방해한다"
  grid-columns: 1
  grid-gap: 60
  r2: { label: "나중에 배운 것\n새로 바꾼 비밀번호" }
  r1: { label: "먼저 배운 것\n예전에 쓰던 비밀번호"; style.bold: true }
  r3: { label: "검사\n예전 것을 떠올린다.\n새 것에 밀려\n나오지 않는다" }
  r2 -> r1: "방해가 이 방향으로 간다"
  r1 -> r3
}

설계: {
  label: "어떻게 갈라 내나 —\n통제 집단이 필요하다"
  direction: down
  d1: { label: "순행 간섭을 재려면,\n한 집단만\n앞의 목록을 배우게 하고\n다른 집단은 그 시간에\n관계없는 일을 하게 한다.\n그러고 나서 두 집단 모두\n뒤의 목록을 배우고\n검사받는다"; style.bold: true }
  d2: { label: "역행 간섭은\n순서를 뒤집는다.\n두 집단 모두\n앞의 목록을 배우고,\n한 집단만 뒤의 목록을\n더 배운 다음,\n둘 다 앞의 목록을\n검사받는다"; style.bold: true }
  d3: { label: "두 설계 모두 ‘시간이 흐른 것’ 과\n‘다른 것이 끼어든 것’ 을 갈라 놓는다.\n통제 집단이 없으면\n그냥 시간이 지나서 잊은 것과\n구별되지 않는다" }
  d1 -> d3
  d2 -> d3
}

순행 -> 설계
역행 -> 설계

닮은점: {
  label: "　\n간섭이 크게 일어나는 조건은 대체로 같다 — 두 자료가 서로 비슷할 때다.\n그래서 완전히 다른 과목을 이어 공부하는 편이\n비슷한 두 과목을 이어 하는 것보다 낫다는 제안이 나오지만,\n이 제안이 실제 공부 상황에서 얼마나 도움이 되는지는\n따로 확인할 일이다"
  shape: text
}
설계 -> 닮은점: { style.stroke-dash: 3 }
