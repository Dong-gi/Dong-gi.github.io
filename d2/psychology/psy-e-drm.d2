# 없던 낱말을 기억해 내는 절차 — 심리학 9장.
#
# 무엇을 읽어야 하나: 이 절차에서 나오는 오기억이 실수처럼 보이지 않는다는 것.
# 참가자는 그 낱말을 들었다고 확신하고, 그 확신이 실제로 들은 낱말에 대한 확신과
# 크기가 비슷하다.
direction: down

목록: {
  label: "들려주는 목록\n침대 · 쉬다 · 깨다 · 피곤 · 꿈 · 밤 · 담요 · 졸다 · 하품 · 코골이 …\n하나하나가 어떤 낱말과 강하게 이어져 있다"
  style.bold: true
}

빠진것: {
  label: "목록에 없는 낱말\n‘잠’\n이 낱말만 들려주지 않는다"
  style.bold: true
}

검사: {
  label: "검사\n들은 낱말을 적게 하거나, 낱말을 하나씩 보이며\n들었는지 아닌지를 답하게 한다"
}

결과: {
  label: "무엇이 나오나\n‘잠’ 을 들었다고 보고하는 일이 자주 일어난다.\n게다가 실제로 들은 낱말에 대한 확신과 비슷한 정도로 확신한다"
  style.bold: true
}

목록 -> 검사 -> 결과
빠진것 -> 검사: { style.stroke-dash: 3 }

의미: {
  label: "이 절차가 좋은 소재인 이유"
  direction: down
  a: { label: "재현이 매우 잘 된다. 여러 연구실에서 되풀이해 나오고,\n독자가 스스로 해 보아도 대개 나온다"; style.bold: true }
  b: { label: "기억이 녹화기가 아니라는 것을 한 번에 보인다.\n들어온 낱말들의 공통된 뜻이 함께 활성화되고,\n그 활성화가 ‘들었다’ 는 판단으로 이어진다" }
  c: { label: "다만 여기서 실제 사건의 오기억으로 곧장 건너뛰면 안 된다.\n낱말 목록과 겪은 사건은 다른 자료이고,\n둘을 잇는 다리는 따로 놓아야 한다 — 네 물음의 넷째" }
  a -> b -> c
}

결과 -> 의미
