# 학습 유형 주장을 검사하려면 무엇이 필요한가 — 심리학 7장.
#
# 무엇을 읽어야 하나: 이 주장이 참이려면 <교차 설계의 대각선>이 이겨야 한다는 것.
# ‘사람마다 선호가 다르다’ 는 것만으로는 이 주장이 되지 않는다.
#
# 배치: 2칸 × 3줄 격자. 주장 ↓ 쪼개기 → 설계 ↓ 조건 → 결과 로 꺾어 내려가게 칸 차례를 정해
# 화살표가 모두 가로나 세로로만 가게 했다. 첫 줄 둘째 칸의 ‘빈칸’ 은 보이지 않는 자리다.
grid-rows: 3
grid-columns: 2
horizontal-gap: 50
vertical-gap: 44
주장
빈칸: {
  label: ""
  style: { fill: transparent; stroke: transparent }
}
쪼개기
설계
결과
조건

주장: {
  label: "검사할 주장\n‘사람마다 잘 배우는\n감각 양식이 있고,\n그 양식에 맞춰 가르치면\n더 잘 배운다’"
  shape: oval
  style.bold: true
}

쪼개기: {
  label: "이 주장은 세 조각이다"
  grid-columns: 1
  grid-gap: 24
  a: { label: "1. 사람마다\n선호하는 방식이 있다\n판정 — 그렇다.\n물어보면 사람들은\n자기 선호를\n일관되게 답한다.\n이 조각은\n다투어지지 않는다" }
  b: { label: "2. 그 선호가\n안정된 유형으로 묶인다\n판정 — 약하다.\n검사마다 다른\n유형 체계가 나오고,\n측정의 신뢰도와\n타당도가 확인되지\n않은 것이 많다" }
  c: { label: "3. 맞춰 가르치면\n더 잘 배운다\n판정 — 이것이 실제로\n다투어지는 조각이고,\n검증에서\n지지되지 않았다"; style.bold: true }
  a -> b -> c
}

설계: {
  label: "3번을 검사하는 설계 —\n교차 설계"
  # 2×2 로 둬야 대각선(맞춘 짝: 시각형×그림, 청각형×말)이 보인다. 한 줄로 두면 대각선이 없다.
  grid-rows: 2
  grid-columns: 2
  grid-gap: 16
  cell1: { label: "시각형이라\n분류된 학습자\n× 그림 위주 수업\n(맞춘 짝)"; style.stroke-width: 3 }
  cell2: { label: "시각형이라\n분류된 학습자\n× 말 위주 수업\n(어긋난 짝)" }
  cell3: { label: "청각형이라\n분류된 학습자\n× 그림 위주 수업\n(어긋난 짝)" }
  cell4: { label: "청각형이라\n분류된 학습자\n× 말 위주 수업\n(맞춘 짝)"; style.stroke-width: 3 }
}

조건: {
  label: "지지되려면 무엇이 나와야 하나"
  direction: down
  x: { label: "필요한 것은 상호작용이다.\n시각형은 그림 쪽에서,\n청각형은 말 쪽에서\n‘각각’ 더 나아야 한다.\n같은 시험으로, 같은 잣대로 재서"; style.bold: true }
  y: { label: "충분하지 않은 것 —\n어느 한쪽 수업이\n전체적으로 더 나은 것.\n그것은 그 수업이\n좋다는 뜻이지\n맞춤이 통한다는\n뜻이 아니다" }
  z: { label: "충분하지 않은 것 —\n학습자가 맞춘 수업을\n더 좋아하는 것.\n선호와 성적은\n다른 지표다" }
  x -> y: { style.stroke-dash: 3 }
  x -> z: { style.stroke-dash: 3 }
}

결과: {
  label: "실제로 나온 것\n이 교차 설계를 제대로 갖춘\n연구 자체가 매우 적었고,\n갖춘 연구들에서 필요한\n상호작용이 나오지 않았다.\n널리 믿기는 정도와\n근거의 양이 크게\n어긋나 있는 사례다"
  style.bold: true
}

주장 -> 쪼개기 -> 설계 -> 조건 -> 결과
