# 학습 유형 주장을 검사하려면 무엇이 필요한가 — 심리학 7장.
#
# 무엇을 읽어야 하나: 이 주장이 참이려면 <교차 설계의 대각선>이 이겨야 한다는 것.
# ‘사람마다 선호가 다르다’ 는 것만으로는 이 주장이 되지 않는다.
direction: down

주장: {
  label: "검사할 주장\n‘사람마다 잘 배우는 감각 양식이 있고, 그 양식에 맞춰 가르치면 더 잘 배운다’"
  shape: oval
  style.bold: true
}

쪼개기: {
  label: "이 주장은 세 조각이다"
  direction: down
  a: { label: "1. 사람마다 선호하는 방식이 있다\n판정 — 그렇다. 물어보면 사람들은 자기 선호를 일관되게 답한다.\n이 조각은 다투어지지 않는다" }
  b: { label: "2. 그 선호가 안정된 유형으로 묶인다\n판정 — 약하다. 검사마다 다른 유형 체계가 나오고,\n측정의 신뢰도와 타당도가 확인되지 않은 것이 많다" }
  c: { label: "3. 맞춰 가르치면 더 잘 배운다\n판정 — 이것이 실제로 다투어지는 조각이고,\n검증에서 지지되지 않았다"; style.bold: true }
  a -> b -> c
}

설계: {
  label: "3번을 검사하는 설계 — 교차 설계"
  direction: right
  cell1: { label: "시각형이라 분류된 학습자\n× 그림 위주 수업" }
  cell2: { label: "시각형이라 분류된 학습자\n× 말 위주 수업" }
  cell3: { label: "청각형이라 분류된 학습자\n× 그림 위주 수업" }
  cell4: { label: "청각형이라 분류된 학습자\n× 말 위주 수업" }
}

조건: {
  label: "지지되려면 무엇이 나와야 하나"
  direction: down
  x: { label: "필요한 것은 상호작용이다.\n시각형은 그림 쪽에서, 청각형은 말 쪽에서 ‘각각’ 더 나아야 한다.\n같은 시험으로, 같은 잣대로 재서"; style.bold: true }
  y: { label: "충분하지 않은 것 — 어느 한쪽 수업이 전체적으로 더 나은 것.\n그것은 그 수업이 좋다는 뜻이지 맞춤이 통한다는 뜻이 아니다" }
  z: { label: "충분하지 않은 것 — 학습자가 맞춘 수업을 더 좋아하는 것.\n선호와 성적은 다른 지표다" }
  x -> y: { style.stroke-dash: 3 }
  x -> z: { style.stroke-dash: 3 }
}

결과: {
  label: "실제로 나온 것\n이 교차 설계를 제대로 갖춘 연구 자체가 매우 적었고,\n갖춘 연구들에서 필요한 상호작용이 나오지 않았다.\n널리 믿기는 정도와 근거의 양이 크게 어긋나 있는 사례다"
  style.bold: true
}

주장 -> 쪼개기 -> 설계 -> 조건 -> 결과
