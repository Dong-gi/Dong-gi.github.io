# 연구 윤리가 묻는 것 — 심리학 4장.
#
# 무엇을 읽어야 하나: 다섯 물음이 연구 시작 전 · 진행 중 · 끝난 뒤로 나뉜다는 것.
# 그리고 마지막 물음이 나머지 넷을 뒤집을 수 있다는 것.
direction: down

전: {
  label: "시작하기 전"
  direction: down
  이익: { label: "1. 이 연구가 낼 수 있는 앎이 참가자가 질 부담보다 큰가\n부담이 크면 설계를 바꾸거나 하지 않는다" }
  동의: { label: "2. 참가자가 무엇을 하게 되는지 알고 스스로 들어오는가\n사전동의 — 미리, 이해할 수 있는 말로, 압력 없이"; style.bold: true }
  심사: { label: "3. 연구자 자신이 아닌 사람이 이 판단을 검토했는가\n기관생명윤리위원회 같은 외부 심사" }
}

중: {
  label: "진행하는 동안"
  direction: down
  철회: { label: "4. 참가자가 언제든 이유 없이 그만둘 수 있는가\n그만둔다고 불이익이 없어야 한다"; style.bold: true }
  보호: { label: "5. 자료가 누구의 것인지 알아볼 수 없게 다루는가" }
}

후: {
  label: "끝난 뒤"
  direction: down
  설명: { label: "6. 속임을 썼다면 끝나고 반드시 밝히는가\n사후설명 — 무엇을 왜 감췄는지, 실제 결과가 무엇인지" }
  회복: { label: "7. 참가자가 들어오기 전보다 나쁜 상태로 나가지 않는가" }
}

전 -> 중 -> 후

속임: {
  label: "속임은 언제 허락되는가"
  direction: down
  조건: { label: "속이지 않으면 그 물음을 물을 수 없고, 부담이 작고, 사후설명이 보장될 때만.\n‘그러는 편이 편해서’ 는 이유가 되지 않는다" }
}
전.동의 -> 속임: "동의와 부딪히는 자리"
속임 -> 후.설명

역사: {
  label: "　\n이 규칙들은 책상에서 만들어진 것이 아니라 실제로 사람이 해를 입은 뒤에 만들어졌다.\n20세기 중반의 몇몇 연구가 그 계기였고, 18장에서 그 가운데 둘을 다시 본다.\n규칙을 외우는 것보다 ‘무엇을 막으려고 생긴 규칙인가’ 를 아는 편이 쓸모 있다"
  shape: text
}
후 -> 역사: { style.stroke-dash: 3 }
