# 지능 검사 점수의 구조 — 심리학 17장.
#
# 무엇을 읽어야 하나: 세 층이 서로 다른 종류의 주장이라는 것.
# 맨 아래는 관찰이고, 가운데는 그 관찰을 정리한 것이며, 맨 위는 해석이다.
direction: up

관찰: {
  label: "맨 아래 — 관찰된 사실"
  direction: down
  a: { label: "서로 다른 인지 과제의 점수들이 대체로 양의 상관을 이룬다.\n어휘를 잘하는 사람이 도형 추론도 평균적으로 잘한다" }
  b: { label: "이 패턴은 여러 표본 · 여러 검사에서 되풀이 관찰되었다.\n이 자리까지는 다툼이 거의 없다"; style.bold: true }
  a -> b
}

넓은: {
  label: "가운데 — 넓은 능력들"
  direction: right
  c1: { label: "유동추론\n처음 보는 문제에서\n규칙을 찾아내는 힘" }
  c2: { label: "결정성 지식\n쌓아 온 지식과 어휘" }
  c3: { label: "작업기억" }
  c4: { label: "처리 속도" }
  c5: { label: "시공간 처리" }
  설명: { label: "함께 움직이는 과제들을 묶어 이름을 붙인 층이다.\n이 층이 실무에서 가장 많이 쓰인다 — 검사의 하위 점수가 이 층에 대응한다"; shape: text }
}

g: {
  label: "맨 위 — g\n모든 과제에 공통으로 들어가는 것"
  style.bold: true
}

해석: {
  label: "g 를 무엇으로 볼 것인가 — 여기가 논쟁이다"
  direction: down
  h1: { label: "하나의 일반 능력이 실제로 있고 그것이 상관을 만든다" }
  h2: { label: "여러 과정이 함께 발달하고 서로 돕기 때문에 상관이 생긴다.\n공통 원인이 없어도 양의 상관은 나온다"; style.bold: true }
  h3: { label: "표집과 검사 구성의 산물이다.\n어떤 과제를 넣느냐가 g 가 무엇처럼 보이는지를 바꾼다" }
}

관찰 -> 넓은: { label: "묶는다" }
넓은 -> g: { label: "다시 묶는다" }
g -> 해석: { style.stroke-dash: 3; label: "무엇의 이름인가" }

주의: {
  label: "　\n읽을 때 조심할 것 — ‘g 가 있다’ 는 관찰이고 ‘g 가 무엇인가’ 는 해석이다.\n앞의 것은 튼튼하고 뒤의 것은 다투어진다. 두 문장을 섞어 쓰면 관찰의 힘이 해석에 옮겨 붙는다"
  shape: text
}
해석 -> 주의
