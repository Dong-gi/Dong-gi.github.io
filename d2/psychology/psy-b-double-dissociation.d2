# 이중 해리 — 기능 귀속의 논리. 심리학 13장.
#
# 무엇을 읽어야 하나: 한 사람의 손상 사례만으로는 ‘이 영역이 이 일을 한다’ 가
# 나오지 않는다는 것, 그리고 두 사례를 엇갈리게 놓아야 비로소
# ‘두 능력이 서로 다른 것에 기대고 있다’ 가 따라 나온다는 것.
direction: down

물음: {
  label: "‘이 영역이 이 일을 한다’ 고 말하려면 무엇이 필요한가"
  shape: oval
  style.bold: true
}

단일: {
  label: "단일 해리 — 사례 하나"
  direction: down
  s1: { label: "영역 A 가 손상된 사람이 과제 갑을 못 한다" }
  s2: { label: "여기서 나오는 결론 — A 는 갑에 ‘필요하다’. 그 이상은 아니다"; style.bold: true }
  s3: { label: "나오지 않는 결론\n· A 가 갑‘만’ 한다 — 다른 과제도 못 하는지 재지 않았다\n· A 가 갑을 ‘하는 곳’ 이다 — 전선이 끊겨도 전구는 꺼진다\n· 갑이 A 에서 일어난다 — 필요하다는 것과 거기서 일어난다는 것은 다르다" }
  s1 -> s2 -> s3
}
물음 -> 단일

난이도: {
  label: "그리고 함정이 하나 더 있다 —\n과제 갑이 과제 을보다 ‘그냥 더 어렵다면’, 어느 영역이 손상되어도\n갑이 먼저 무너진다. 그러면 ‘A 는 갑 전용’ 이 아니라 ‘갑이 약한 고리’ 일 뿐이다"
  shape: text
}
단일 -> 난이도: { style.stroke-dash: 3 }

이중: {
  label: "이중 해리 — 엇갈리는 두 사례"
  direction: down
  e1: { label: "사례 1 — 영역 A 손상: 갑은 못 하고 을은 한다" }
  e2: { label: "사례 2 — 영역 B 손상: 을은 못 하고 갑은 한다" }
  e3: { label: "이제 따라 나오는 결론 — 갑과 을은 ‘서로 다른 것에 기대고 있다’.\n난이도만으로는 이 엇갈림이 나올 수 없다"; style.bold: true }
  e1 -> e3
  e2 -> e3
}
난이도 -> 이중: "그래서 엇갈림이 필요하다"

남는것: {
  label: "이중 해리로도 나오지 않는 것"
  direction: down
  r1: { label: "· ‘A 가 갑을 담당하는 부위’ 라는 결론.\n  A 는 갑에 필요한 여러 부분 가운데 하나일 뿐일 수 있다" }
  r2: { label: "· 정상인 뇌에서 그 둘이 실제로 어떻게 나뉘어 일하는가.\n  손상된 뇌는 남은 부분이 다시 조직된 뇌다" }
  r3: { label: "· 손상의 경계가 해부학적 경계와 맞아떨어진다는 보장.\n  손상은 연구자가 고른 것이 아니라 우연히 정해진다" }
}
이중 -> 남는것: { style.stroke-dash: 3 }

정리: {
  label: "　\n정리 — 이중 해리는 ‘기능이 나뉘어 있다’ 는 주장을 지지하고,\n‘어디에 있다’ 는 주장은 그보다 훨씬 약하게만 지지한다.\n\n이 장에서 되풀이할 문장 — ‘필요하다’ 와 ‘거기서 일어난다’ 와 ‘그것만 한다’ 는 서로 다른 세 주장이다"
  shape: text
}
남는것 -> 정리: { style.stroke-dash: 3 }
