# 무선배정을 못 할 때 — 심리학 4장.
#
# 무엇을 읽어야 하나: 위로 갈수록 인과 주장이 세진다는 것. 그리고 어느 것도
# 무선배정만큼 세지 않다는 것. 설계를 고르는 일은 얼마를 포기할지 고르는 일이다.
direction: up

일: {
  label: "사전-사후 한 집단\n처치 전에 재고 처치 뒤에 다시 잰다"
}
일말: {
  label: "가장 약하다. 성숙 · 역사 · 검사 · 평균으로의 회귀가 전부 그대로 남는다"
  shape: text
}
일 -> 일말: { style.stroke-dash: 3 }

이: {
  label: "비교 집단을 붙인다\n처치를 안 받은 비슷한 집단을 함께 잰다"
}
이말: {
  label: "성숙과 역사를 막는다. 두 집단이 처음부터 달랐을 가능성(선택)은 남는다"
  shape: text
}
이 -> 이말: { style.stroke-dash: 3 }

삼: {
  label: "짝짓기와 통제\n나이 · 사전 점수 등이 비슷한 사람끼리 짝지어 견준다"
}
삼말: {
  label: "잰 변수에 대해서만 선택을 막는다. 재지 않은 변수는 그대로 남는다"
  shape: text
}
삼 -> 삼말: { style.stroke-dash: 3 }

사: {
  label: "자연실험\n제도 변경 · 추첨 · 정원 커트라인처럼\n사람의 뜻과 무관하게 갈린 자리를 찾아 쓴다"
  style.bold: true
}
사말: {
  label: "갈림이 정말로 우연에 가까웠다면 무선배정에 가까워진다.\n그 가정 자체가 논증거리이며, 대개 그 논증이 논문의 본체다"
  shape: text
}
사 -> 사말: { style.stroke-dash: 3 }

오: {
  label: "무선배정 실험"
  style.bold: true
}
오말: {
  label: "가장 세다. 그러나 물을 수 있는 것이 가장 좁다"
  shape: text
}
오 -> 오말: { style.stroke-dash: 3 }

일 -> 이 -> 삼 -> 사 -> 오: "인과 주장이 세진다"
