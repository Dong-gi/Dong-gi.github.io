# 설명의 층위 — 심리학 3장.
#
# 무엇을 읽어야 하나: 층위끼리 경쟁하지 않는다는 것. 같은 현상에 대한
# 서로 다른 층위의 설명은 둘 다 참일 수 있고, 대개 둘 다 있어야 한다.
direction: down

물음: { label: "왜 시험 전날 잠을 설쳤는가"; shape: oval; style.bold: true }

생물: { label: "생물 층위\n각성 체계가 켜져 있고 스트레스 호르몬이 높다" }
개인: { label: "개인 층위\n결과를 통제할 수 없다고 여기고 실패 장면을 되풀이해 떠올린다" }
사회: { label: "사회·문화 층위\n이 시험 하나가 진로를 정한다고 여겨지는 제도 안에 있다" }
발달: { label: "발달 층위\n시험이라는 상황에 대해 지금까지 겪은 것이 반응을 만들어 놓았다" }

물음 -> 생물
물음 -> 개인
물음 -> 사회
물음 -> 발달

읽기: {
  label: "　\n넷 가운데 하나가 ‘진짜 원인’ 이고 나머지가 겉모습인 것이 아니다.\n호르몬 이야기가 제도 이야기를 지우지 않고 그 반대도 아니다.\n어떤 층위에서 물었는지를 밝히지 않으면 서로 다른 답이 다투는 것처럼 보인다"
  shape: text
}
생물 -> 읽기: { style.stroke-dash: 3 }
사회 -> 읽기: { style.stroke-dash: 3 }

환원: {
  label: "　\n‘결국 다 뇌의 일 아닌가’ 라는 물음은 이 문서가 답하지 않는다.\n그것은 존재론의 물음이고 철학 문서 14장이 다룬다.\n이 문서가 묻는 것은 ‘어느 층위에서 무엇을 잴 수 있는가’ 다"
  shape: text
}
읽기 -> 환원: { style.stroke-dash: 3 }
