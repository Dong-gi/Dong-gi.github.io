# 의식에 미치는 영향으로 나눈 갈래. 심리학 14장.
#
# 이 그림은 ‘분류’만 다룬다. 어떤 물질을 어떻게 쓰는지, 얼마나 쓰는지,
# 어디서 구하는지는 이 문서가 다루지 않는다. 원장 §0.3 이 그은 선과 같은 선이다.
#
# 무엇을 읽어야 하나: 이 분류가 ‘효과의 방향’에 따른 것이지 위험도나
# 법적 지위에 따른 것이 아니라는 것, 그리고 경계가 깔끔하지 않다는 것.
direction: down

기준: {
  label: "무엇을 기준으로 나누는가 — 각성 수준과 지각에 미치는 영향의 방향"
  shape: oval
  style.bold: true
}

억제: {
  label: "억제 계열"
  direction: down
  a1: { label: "방향 — 신경계의 활동을 전반적으로 낮춘다" }
  a2: { label: "겉으로 나타나는 것 — 각성 수준이 내려가고, 반응이 느려지고,\n판단과 조절이 무뎌지고, 많은 양에서는 기억이 남지 않는다" }
  a1 -> a2
}

흥분: {
  label: "흥분 계열"
  direction: down
  b1: { label: "방향 — 신경계의 활동을 높인다" }
  b2: { label: "겉으로 나타나는 것 — 각성 수준이 올라가고 졸림이 줄어든다.\n효과가 지난 뒤에 반대 방향의 상태가 오는 경우가 많다" }
  b1 -> b2
}

지각: {
  label: "지각 변화 계열"
  direction: down
  c1: { label: "방향 — 각성 수준보다 ‘지각과 사고의 내용’ 을 바꾼다" }
  c2: { label: "겉으로 나타나는 것 — 없는 것이 지각되거나 있는 것이 달리 지각된다.\n시간 감각과 자기 감각이 달라졌다는 보고가 많다" }
  c1 -> c2
}

진통: {
  label: "통증에 작용하는 계열"
  direction: down
  d1: { label: "방향 — 통증 신호의 처리에 작용하며 진정 효과도 함께 온다" }
  d2: { label: "겉으로 나타나는 것 — 통증이 줄고 각성 수준이 내려간다" }
  d1 -> d2
}

기준 -> 억제
기준 -> 흥분
기준 -> 지각
기준 -> 진통

공통: {
  label: "계열과 상관없이 나타나는 세 가지"
  direction: down
  e1: { label: "내성 — 같은 효과를 얻는 데 필요한 양이 늘어난다" }
  e2: { label: "금단 — 끊었을 때 나타나는 반대 방향의 상태" }
  e3: { label: "의존 — 쓰는 일이 다른 활동을 밀어내는 상태.\n이것은 이 문서가 다루지 않는 임상의 영역과 맞닿는다" }
}
억제 -> 공통: { style.stroke-dash: 3 }
진통 -> 공통: { style.stroke-dash: 3 }

한계: {
  label: "　\n이 분류를 읽을 때 조심할 것 —\n\n· 경계가 깔끔하지 않다. 양에 따라 다른 계열처럼 작용하는 것이 있다\n· 이 분류는 ‘효과의 방향’ 에 따른 것이지 위험도나 법적 지위에 따른 것이 아니다\n· ‘기대가 효과의 일부를 만든다.’ 무엇을 받았다고 믿는지가 나타나는 것을 바꾼다.\n  그래서 이 분야의 연구는 4장의 은폐와 위약 조건을 특히 엄격하게 다뤄야 한다\n\n이 문서는 여기까지만 다룬다. 사용법 · 양 · 구하는 방법은 적지 않는다"
  shape: text
}
공통 -> 한계: { style.stroke-dash: 3 }
