# 주의와 의식이 같은 것인가. 심리학 14장.
#
# 무엇을 읽어야 하나: 네 칸 가운데 대각선 두 칸은 다툼이 없고
# 나머지 두 칸에 대해 자료가 갈린다는 것. 이 두 칸이 다투어지는 자리다.
direction: down

물음: {
  label: "주의를 준 것만 의식되는가"
  shape: oval
  style.bold: true
}

칸1: {
  label: "주의 O · 의식 O\n지금 읽고 있는 이 줄.\n다툼 없음"
  style.bold: true
}
칸2: {
  label: "주의 X · 의식 X\n12장의 부주의맹과 변화맹이 이 칸이다.\n다툼 없음"
  style.bold: true
}
칸3: {
  label: "주의 O · 의식 X\n주의를 주었는데도 의식되지 않는 자극이 있는가.\n아주 짧게 보이고 곧바로 가리면 보고되지 않는데,\n그때 무엇까지 처리되는지가 다투어진다"
}
칸4: {
  label: "주의 X · 의식 O\n주의를 주지 않은 주변에 대해 ‘대충 무엇이 있는지’ 를\n알고 있다는 느낌이 있는데, 그 느낌이 실제 표상인지\n아니면 필요할 때 주의를 옮기면 알 수 있다는 데서 오는\n착각인지가 다투어진다"
}

물음 -> 칸1
물음 -> 칸2
물음 -> 칸3
물음 -> 칸4

문제: {
  label: "　\n이 논쟁이 어려운 이유는 ‘측정의 문제’ 다.\n\n‘의식되지 않았다’ 를 무엇으로 판정하는가. 본인이 ‘못 봤다’ 고 답한 것으로?\n그렇다면 12장의 신호탐지이론이 곧바로 걸린다 — ‘못 봤다’ 는 답은\n민감도가 0 이어서일 수도 있고 준거가 엄격해서일 수도 있다.\n\n그래서 이 분야는 강제선택 과제, 확신도 보고, 여러 문턱을 함께 쓰는 절차를\n동원한다. 그리고 어떤 절차를 쓰느냐에 따라 결론이 갈린다"
  shape: text
}
칸3 -> 문제: { style.stroke-dash: 3 }
칸4 -> 문제: { style.stroke-dash: 3 }
