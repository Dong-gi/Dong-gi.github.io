# 오정보 효과를 재는 설계 — 심리학 9장.
#
# 무엇을 읽어야 하나: 세 걸음 사이에 무엇이 끼어드는지, 그리고 마지막 검사가
# 무엇을 묻는지. 검사에서 묻는 것은 ‘본 것’ 이지 ‘들은 것’ 이 아니다.
direction: down

하나: {
  label: "1. 사건을 본다\n모든 참가자가 같은 장면을 본다. 짧은 영상이나 사진 묶음"
  style.bold: true
}
둘: {
  label: "2. 사건 뒤의 정보가 들어온다 — 여기서 조건이 갈린다"
  direction: right
  a: { label: "오정보 조건\n장면에 없던 세부가 들어간 문장을 읽거나\n그런 전제가 깔린 질문을 받는다"; style.bold: true }
  b: { label: "통제 조건\n같은 길이의 글을 읽지만\n그 세부가 들어 있지 않다" }
}
셋: {
  label: "3. 기억 검사\n‘영상에서 무엇을 보았는가’ 를 묻는다.\n읽은 글에 대해 묻는 것이 아니다"
  style.bold: true
}

하나 -> 둘 -> 셋

결과: {
  label: "무엇이 나오나\n오정보 조건에서 없던 세부를 ‘보았다’ 고 보고하는 일이 늘어난다.\n여러 절차, 여러 나라, 여러 연령대에서 되풀이 확인되었다"
  style.bold: true
}
셋 -> 결과

주의: {
  label: "이 설계가 말하는 것과 말하지 않는 것"
  direction: down
  n1: { label: "말하는 것 — 사건 뒤에 들어온 정보가 그 사건에 대한 보고를 바꾼다.\n이것이 정설이다"; style.bold: true }
  n2: { label: "말하지 않는 것 — 원래 기억이 지워졌는지.\n덮어썼다는 설명과 뒤에 들어온 것을 잘못 고른 것뿐이라는 설명이 오래 겨루었고,\n단서를 잘 주면 원래 것이 나오는 경우가 있다는 보고가 뒤의 설명 쪽에 무게를 실었다" }
  n3: { label: "그래서 실무에 옮길 때 중요한 것은 원인 논쟁이 아니라 결과다 —\n‘사건 뒤에 무엇이 들어가느냐가 나중의 진술을 바꾼다.’\n그러므로 진술을 받기 전에 정보가 새어 들어가지 않도록 절차를 짠다"; style.bold: true }
  n1 -> n2 -> n3
}
결과 -> 주의: { style.stroke-dash: 3 }
