# 내적 타당도를 위협하는 것들 — 심리학 4장.
#
# 무엇을 읽어야 하나: 여덟 가지가 전부 ‘처치가 아닌 무엇이 그 차이를 만들 수 있는가’
# 한 물음의 답이라는 것. 그리고 그 대부분을 통제 집단 하나가 막는다.
direction: down

주장: {
  label: "‘처치를 받은 뒤 점수가 올랐다. 처치가 효과가 있다’"
  shape: oval
  style.bold: true
}

위협: {
  label: "처치가 아니어도 점수를 올릴 수 있는 것들"
  direction: down
  성숙: { label: "성숙 — 시간이 지나면서 저절로 좋아진다" }
  역사: { label: "역사 — 연구 기간에 바깥에서 다른 일이 있었다" }
  검사: { label: "검사 — 사전 검사를 봤다는 것 자체가 사후 점수를 올린다" }
  도구: { label: "도구 — 재는 방법이나 채점자가 도중에 달라졌다" }
  회귀: { label: "평균으로의 회귀 — 낮은 사람만 골라 뽑았다면 저절로 올라간다"; style.bold: true }
  선택: { label: "선택 — 두 집단이 처음부터 달랐다"; style.bold: true }
  탈락: { label: "탈락 — 힘들어한 사람이 중간에 그만두었다"; style.bold: true }
  기대: { label: "기대 — 참가자도 실험자도 무엇을 노리는지 안다" }
}
주장 -> 위협: "정말 처치인가"

막기: {
  label: "무엇이 막는가"
  direction: down
  통제집단: { label: "무선배정한 통제 집단\n성숙 · 역사 · 검사 · 도구 · 회귀를 한꺼번에 막는다. 두 집단에 똑같이 걸리기 때문이다"; style.bold: true }
  은폐: { label: "이중은폐와 위약\n기대를 막는다" }
  보고: { label: "탈락자를 세어 보고하기\n탈락은 설계로 막을 수 없고 드러내 놓고 다루는 수밖에 없다" }
}
위협 -> 막기

남는것: {
  label: "　\n통제 집단을 두어도 남는 것이 있다. 탈락이 두 집단에서 다르게 일어나면\n무선배정으로 맞춰 놓은 균형이 깨진다. 그래서 탈락률은 결과와 함께 보고해야 한다"
  shape: text
}
막기 -> 남는것: { style.stroke-dash: 3 }
