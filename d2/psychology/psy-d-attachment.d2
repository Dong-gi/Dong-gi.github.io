# 애착 — 절차와 분류, 그리고 그 분류를 둘러싼 논쟁. 심리학 15장.
#
# 무엇을 읽어야 하나: 오른쪽 논쟁이 ‘애착이 있느냐’ 가 아니라
# ‘유형으로 나누는 것이 옳으냐’ 라는 것.
direction: right

절차: {
  label: "낯선 상황 절차"
  direction: down
  설명: { label: "낯선 방에서 양육자가 잠깐 나갔다 돌아오는 짧은 장면을 여러 번 만들고,\n그 사이 아이의 행동을 정해진 규칙으로 기록한다" }
  핵심: { label: "판정의 무게는 헤어질 때가 아니라 다시 만날 때에 있다.\n돌아온 양육자를 아이가 어떻게 쓰는가를 본다"; style.bold: true }
  설명 -> 핵심
}

분류: {
  label: "기록에서 붙이는 분류"
  direction: down
  안정: { label: "안정 — 재회 때 다가가 달래지고 다시 논다" }
  회피: { label: "회피 — 재회 때 다가가지 않고 장난감에 붙어 있는다" }
  저항: { label: "저항 — 다가가면서 동시에 밀어내고 오래 달래지지 않는다" }
  혼란: { label: "혼란 — 위 셋 어디에도 잘 맞지 않고 서로 어긋나는 행동이 나온다.\n뒤에 덧붙여진 범주다" }
}

논쟁: {
  label: "무엇이 다투어지는가"
  direction: down
  d1: { label: "범주인가 차원인가\n점수를 늘어놓으면 네 덩어리로 갈라지지 않고 한 덩어리로 퍼진다는 분석이 있다.\n경계 가까이의 아이는 다시 재면 유형이 바뀔 수 있다"; style.bold: true }
  d2: { label: "얼마나 안정적인가\n어린 시절의 분류와 나중의 관계 사이에 관련이 관찰되지만 그 크기가 작다.\n사이에 놓인 환경이 크게 개입한다" }
  d3: { label: "절차가 문화를 가로지르는가\n양육 관습이 다르면 같은 행동이 다른 뜻을 가질 수 있다.\n낯선 상황이 어디에서나 같은 것을 재는지가 논쟁이다" }
  d4: { label: "무엇의 원인인가\n양육자의 행동만이 아니라 아이의 기질도 이 행동에 들어온다.\n두 몫을 이 절차 하나로 가를 수 없다" }
}

절차 -> 분류: { label: "규칙에 따라 붙인다" }
분류 -> 논쟁

주의: {
  label: "　\n널리 퍼진 ‘어릴 때 애착 유형이 평생의 관계를 정한다’ 는 문장은\n자료가 지지하는 것보다 훨씬 세다. 관련은 관찰되지만 결정이라고 부를 크기가 아니다"
  shape: text
}
논쟁 -> 주의: { style.stroke-dash: 3 }
