# 이 분야는 어떻게 훈련되는가 — 심리학 19장.
#
# 무엇을 읽어야 하나: 오른쪽 칸이 글로 옮겨지지 않는 부분이라는 것.
# 이 문서가 다룰 수 있는 것은 왼쪽 칸까지다.
direction: right

경로: {
  label: "훈련의 뼈대 — 나라마다 제도가 다르므로 이름이 아니라 구조를 본다"
  direction: down
  a: { label: "학위 과정 — 이론 · 연구방법 · 심리측정 · 정신병리 · 윤리" }
  b: { label: "감독을 받는 실습 — 실제 사례를 맡고 그 기록을 놓고 지도를 받는다"; style.bold: true }
  c: { label: "수퍼비전 — 자기가 한 것을 남에게 보이고 되먹임을 받는 과정이 오래 이어진다"; style.bold: true }
  d: { label: "자격과 계속 교육 — 자격을 얻은 뒤에도 교육이 이어지고 윤리 규정을 따른다" }
  a -> b -> c -> d
}

갈래: {
  label: "가까운 직군의 구분"
  direction: down
  e: { label: "정신의학 — 의학 훈련을 받는다. 약물 처방과 신체 질환의 감별이 여기에 든다"; style.bold: true }
  f: { label: "임상심리 · 상담심리 — 심리학 훈련을 받는다.\n평가와 심리적 개입이 중심이고 나라에 따라 역할과 자격이 다르다" }
  g: { label: "이 구분은 나라마다 다르므로, 한 나라의 이름을 다른 나라에 그대로 옮기면 안 된다" }
}

글로: {
  label: "글로 옮겨지지 않는 부분"
  direction: down
  h: { label: "판단 — 지금 이 사람에게 무엇이 필요한가.\n규칙이 아니라 사례를 여러 번 겪으며 자란다"; style.bold: true }
  i: { label: "자기 반응을 다루기 — 자기 안에서 일어나는 것을 알아차리고 그것이 개입에 섞이지 않게 하는 일.\n이것은 남이 봐 주지 않으면 배울 수 없다"; style.bold: true }
  j: { label: "해를 알아보기 — 모든 개입이 무해한 것은 아니다.\n어떤 절차가 어떤 사람에게 나쁜 결과를 냈다는 보고가 있고, 그것을 알아보는 것이 훈련의 일부다"; style.bold: true }
  k: { label: "한계를 알기 — 자기가 다루면 안 되는 것을 알아보고 넘기는 일" }
}

경로 -> 갈래
갈래 -> 글로: { label: "그리고 이 부분은" }

근거: {
  label: "근거기반 실무의 세 다리"
  direction: down
  l1: { label: "최선의 연구 근거" }
  l2: { label: "임상적 전문성" }
  l3: { label: "내담자의 가치와 선호" }
  l4: { label: "셋 가운데 하나만 쓰는 것이 잘못이다.\n연구 근거만 보면 앞의 사람이 지워지고, 전문성만 믿으면 4장과 6장이 다룬 문제로 돌아간다"; style.bold: true }
  l1 -> l4
  l2 -> l4
  l3 -> l4
}
글로 -> 근거: { style.stroke-dash: 3 }

문서: {
  label: "　\n이 문서의 자리 — 왼쪽 두 칸은 설명할 수 있고 오른쪽 칸은 설명할 수 없다.\n설명할 수 없는 것을 설명한 척하면 읽은 사람이 할 수 있다고 착각하게 된다.\n그래서 이 장은 개관에서 멈춘다"
  shape: text
}
근거 -> 문서
