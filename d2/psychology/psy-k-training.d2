# 이 분야는 어떻게 훈련되는가 — 심리학 19장.
#
# 무엇을 읽어야 하나: ‘글로 옮겨지지 않는 부분’ 칸이 이 문서가 다룰 수 없는 부분이라는 것.
# 이 문서가 다룰 수 있는 것은 훈련의 뼈대와 직군의 구분까지다.
#
# 배치: 칸을 두 줄로 접었다 — 뼈대 → 직군 → 글로 옮겨지지 않는 부분 → 세 다리 → 이 문서의 자리 순으로
# 화살표를 따라 읽는다(그래서 ‘근거’ 를 ‘글로’ 보다 먼저 적었다).
# 2026-11 폭을 줄이려 글을 더 접고, 묶음마다 칸을 2칸 × 2줄로 접었다.
direction: down
grid-rows: 3
grid-columns: 2
grid-gap: 60

경로: {
  label: "훈련의 뼈대 —\n나라마다 제도가 다르므로\n이름이 아니라 구조를 본다"
  # 2칸 × 2줄 — 첫 줄 왼쪽에서 오른쪽, 둘째 줄 왼쪽에서 오른쪽으로 읽는다
  grid-rows: 2
  grid-columns: 2
  grid-gap: 40
  a: { label: "학위 과정 —\n이론 · 연구방법 ·\n심리측정 · 정신병리 ·\n윤리" }
  b: { label: "감독을 받는 실습 —\n실제 사례를 맡고\n그 기록을 놓고\n지도를 받는다"; style.bold: true }
  c: { label: "수퍼비전 —\n자기가 한 것을\n남에게 보이고\n되먹임을 받는 과정이\n오래 이어진다"; style.bold: true }
  d: { label: "자격과 계속 교육 —\n자격을 얻은 뒤에도\n교육이 이어지고\n윤리 규정을 따른다" }
  a -> b -> c -> d
}

갈래: {
  label: "가까운 직군의 구분"
  grid-rows: 2
  grid-columns: 2
  grid-gap: 40
  e: { label: "정신의학 —\n의학 훈련을 받는다.\n약물 처방과\n신체 질환의 감별이\n여기에 든다"; style.bold: true }
  f: { label: "임상심리 · 상담심리 —\n심리학 훈련을 받는다.\n평가와 심리적 개입이\n중심이고\n나라에 따라\n역할과 자격이 다르다" }
  g: { label: "이 구분은\n나라마다 다르므로,\n한 나라의 이름을\n다른 나라에\n그대로 옮기면 안 된다" }
}

근거: {
  label: "근거기반 실무의 세 다리"
  # 2칸 × 2줄 — 세 다리가 마지막 칸의 결론을 둘러싼다
  grid-rows: 2
  grid-columns: 2
  grid-gap: 40
  l1: { label: "최선의\n연구 근거" }
  l2: { label: "임상적\n전문성" }
  l3: { label: "내담자의\n가치와 선호" }
  l4: { label: "셋 가운데\n하나만 쓰는 것이\n잘못이다.\n연구 근거만 보면\n앞의 사람이 지워지고,\n전문성만 믿으면\n4장과 6장이 다룬\n문제로 돌아간다"; style.bold: true }
  l1 -> l4
  l2 -> l4
  l3 -> l4
}

글로: {
  label: "글로 옮겨지지 않는 부분"
  grid-rows: 2
  grid-columns: 2
  grid-gap: 40
  h: { label: "판단 —\n지금 이 사람에게\n무엇이 필요한가.\n규칙이 아니라\n사례를 여러 번 겪으며\n자란다"; style.bold: true }
  i: { label: "자기 반응을 다루기 —\n자기 안에서\n일어나는 것을\n알아차리고\n그것이 개입에\n섞이지 않게 하는 일.\n이것은 남이\n봐 주지 않으면\n배울 수 없다"; style.bold: true }
  j: { label: "해를 알아보기 —\n모든 개입이\n무해한 것은 아니다.\n어떤 절차가\n어떤 사람에게\n나쁜 결과를 냈다는\n보고가 있고,\n그것을 알아보는 것이\n훈련의 일부다"; style.bold: true }
  k: { label: "한계를 알기 —\n자기가 다루면\n안 되는 것을\n알아보고 넘기는 일" }
}

경로 -> 갈래
갈래 -> 글로: { label: "그리고 이 부분은" }
글로 -> 근거: { style.stroke-dash: 3 }

문서: {
  label: "　\n이 문서의 자리 —\n뼈대와 직군 구분은\n설명할 수 있고\n‘글로 옮겨지지 않는 부분’ 은\n설명할 수 없다.\n설명할 수 없는 것을\n설명한 척하면\n읽은 사람이\n할 수 있다고\n착각하게 된다.\n그래서 이 장은\n개관에서 멈춘다"
  shape: text
}
근거 -> 문서
