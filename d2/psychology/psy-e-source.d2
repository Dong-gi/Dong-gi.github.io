# 출처 혼동 — 심리학 9장.
#
# 무엇을 읽어야 하나: 내용은 남고 출처는 함께 남지 않는다는 것. 그래서 기억이
# 어긋나는 흔한 방식은 없는 내용을 지어내는 것이 아니라 있는 내용을 잘못 붙이는 것이다.
direction: down

들어옴: {
  label: "같은 내용이 여러 경로로 들어온다"
  direction: right
  a: { label: "직접 본 것" }
  b: { label: "남에게 들은 것" }
  c: { label: "글에서 읽은 것" }
  d: { label: "머릿속으로 그려 본 것" }
}

저장: {
  label: "남는 것\n내용은 비교적 잘 남는다.\n그런데 ‘이것이 어디서 왔는가’ 는 함께 남지 않고,\n필요할 때 그때그때 판단으로 채워진다"
  style.bold: true
}

판단: {
  label: "출처를 정하는 판단이 기대는 것"
  direction: down
  p1: { label: "얼마나 또렷한가 — 감각의 세부가 많으면 직접 겪은 것으로 판단하기 쉽다" }
  p2: { label: "얼마나 애쓴 흔적이 있나 — 스스로 만들어 낸 것에는 그 흔적이 남는다" }
  p3: { label: "앞뒤가 맞는가 — 다른 아는 것과 어울리면 겪은 것으로 판단하기 쉽다" }
}

어긋남: {
  label: "그래서 생기는 일"
  direction: down
  e1: { label: "들은 것을 본 것으로 옮겨 적는다 — 이것이 오정보 효과의 한 경로다"; style.bold: true }
  e2: { label: "그려 본 것을 겪은 것으로 옮겨 적는다 — 상상 팽창이 이 자리에 있다"; style.bold: true }
  e3: { label: "누구에게 들었는지를 잘못 붙인다. 내용은 맞는데 사람이 틀린다" }
  e4: { label: "출처를 잊고 내용만 남으면, 처음에 ‘믿을 수 없다’ 는 표시와 함께 들어온 정보도\n뒤에는 그 표시 없이 떠오를 수 있다" }
}

들어옴 -> 저장 -> 판단 -> 어긋남

교훈: {
  label: "　\n요점 — 기억이 어긋나는 흔한 방식은 없던 것을 지어내는 것이 아니라,\n있던 내용에 잘못된 출처가 붙는 것이다.\n그래서 본인은 거짓말을 한다는 느낌 없이 틀린 진술을 할 수 있다"
  shape: text
}
어긋남 -> 교훈: { style.stroke-dash: 3 }
