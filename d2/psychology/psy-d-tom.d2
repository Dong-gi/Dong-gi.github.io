# 마음이론을 재는 두 갈래 — 심리학 15장.
#
# 무엇을 읽어야 하나: 두 갈래가 같은 것을 재고 있다는 보장이 없다는 것,
# 그리고 재현 검사에서 둘의 처지가 갈렸다는 것.
direction: down

물음: {
  label: "물음 — 아이는 언제부터 남이 틀린 믿음을 가질 수 있음을 아는가"
  shape: oval
  style.bold: true
}

명시: {
  label: "말로 답하게 하는 과제"
  direction: down
  절차: { label: "인형이 물건을 한 곳에 두고 나간 사이에 물건을 옮긴다.\n돌아온 인형이 어디를 찾겠느냐고 아이에게 묻는다" }
  지표: { label: "지표 — 아이가 말이나 손가락으로 고른 자리" }
  결과: { label: "네 살 무렵을 지나며 통과율이 오르는 모양이\n여러 나라의 표본에서 되풀이해 관찰되었다"; style.bold: true }
  한계: { label: "말과 기억과 집행 기능이 함께 필요한 과제다.\n못 통과한 것이 ‘몰라서’ 인지 ‘말로 못 해서’ 인지 이 과제만으로는 갈리지 않는다" }
  절차 -> 지표 -> 결과 -> 한계
}

암묵: {
  label: "응시 시간으로 재는 과제"
  direction: down
  절차2: { label: "같은 장면을 아기에게 보여 주고 말은 시키지 않는다" }
  지표2: { label: "지표 — 인형이 ‘틀린’ 자리를 찾을 때보다\n‘맞는’ 자리를 찾을 때 더 오래 보는가" }
  결과2: { label: "훨씬 어린 나이에서 차이가 나온다는 보고가 2000년대에 이어졌다" }
  재현: { label: "그런데 독립적인 재현에서 이 결과가 잘 나오지 않은 것들이 있다.\n여러 연구실이 함께 검사하는 프로젝트가 진행 중이다"; style.bold: true }
  해석: { label: "더 오래 보는 것이 ‘남의 믿음을 안다’ 는 뜻인지도 다투어진다.\n장면의 물리적 새로움만으로도 응시 시간이 달라질 수 있다" }
  절차2 -> 지표2 -> 결과2 -> 재현 -> 해석
}

물음 -> 명시
물음 -> 암묵

판정: {
  label: "　\n지금 이 문서가 적을 수 있는 것 — 말로 답하는 과제의 결과는 되풀이되었고,\n응시 시간 과제의 결과는 재현 검사가 진행 중이며 판정이 갈려 있다.\n그러므로 ‘마음이론은 몇 살에 생긴다’ 는 문장을 하나로 적을 수 없다"
  shape: text
}
명시 -> 판정: { style.stroke-dash: 3 }
암묵 -> 판정: { style.stroke-dash: 3 }

교훈: {
  label: "　\n그리고 이것은 발달만의 문제가 아니다. 지표를 바꾸면 답이 달라지는 자리에서는\n‘몇 살부터인가’ 가 아니라 ‘무엇을 재고 있는가’ 가 먼저 오는 물음이다"
  shape: text
}
판정 -> 교훈
