# 개념을 무엇으로 볼 것인가 — 심리학 10장.
#
# 무엇을 읽어야 하나: 세 관점이 순서대로 서로의 문제를 받아 나왔다는 것.
# 그리고 지금은 어느 하나가 이긴 것이 아니라 셋이 각각 설명하는 자리를 나눠 가진다.
direction: down

고전: {
  label: "고전적 관점 — 개념은 정의다"
  direction: down
  a1: { label: "주장 — 어떤 범주에 들어가려면 반드시 갖춰야 할 자질의 목록이 있고,\n그것을 다 갖추면 들어가고 하나라도 빠지면 안 들어간다"; style.bold: true }
  a2: { label: "잘 맞는 자리 — 수학과 법의 개념. ‘짝수’ 나 ‘성년’ 은 실제로 이렇게 정의된다" }
  a3: { label: "걸리는 자리 — 일상 개념의 정의를 실제로 적어 보면 반례가 계속 나온다.\n그리고 정의만 따진다면 왜 어떤 사례는 빨리, 어떤 사례는 느리게 판단되는지가 설명되지 않는다" }
  a1 -> a2
  a1 -> a3
}

원형: {
  label: "원형 관점 — 개념은 평균 같은 것이다"
  direction: down
  b1: { label: "주장 — 범주마다 그 범주의 전형적인 모습이 있고,\n어떤 것이 그 범주에 드는지는 그 모습과 얼마나 닮았는가로 정해진다"; style.bold: true }
  b2: { label: "설명하는 것 — 전형성 차이, 판단 시간 차이, 먼저 떠오르는 사례,\n그리고 경계가 흐릿하다는 사실" }
  b3: { label: "걸리는 자리 — 드문 사례에 대한 앎이 사라진다.\n사람은 ‘펭귄은 새인데 특이한 새’ 라는 것을 알고 있다" }
  b1 -> b2
  b1 -> b3
}

사례: {
  label: "사례 관점 — 개념은 겪은 것들의 모음이다"
  direction: down
  c1: { label: "주장 — 평균을 따로 만들어 두지 않는다.\n겪은 개별 사례들을 기억해 두고, 새것이 오면 그것들과 견준다"; style.bold: true }
  c2: { label: "설명하는 것 — 드문 사례에 대한 앎, 그리고 사람마다 범주가 조금씩 다른 것" }
  c3: { label: "걸리는 자리 — 사례를 다 저장한다는 그림이 어디까지 그럴듯한가.\n그리고 무엇을 ‘닮았다’ 고 셀지는 여전히 정해 주어야 한다" }
  c1 -> c2
  c1 -> c3
}

이론: {
  label: "덧붙는 것 — 개념은 우리가 가진 이론에 얹혀 있다"
  direction: down
  d1: { label: "닮음만으로는 부족하다. 무엇을 닮음으로 셀지가 이미 앎에 딸려 있기 때문이다.\n같은 두 사물이 어떤 앎 아래서는 닮았고 다른 앎 아래서는 닮지 않았다"; style.bold: true }
  d2: { label: "그래서 지금의 표준적인 그림은 하나를 고르는 것이 아니라,\n어느 자리에서 어느 설명이 잘 듣는지를 나누는 쪽이다" }
  d1 -> d2
}

고전 -> 원형: "반례와 판단 시간이 밀어냈다"
원형 -> 사례: "드문 사례에 대한 앎이 밀어냈다"
사례 -> 이론: "닮음의 기준 자체를 물으면서"
