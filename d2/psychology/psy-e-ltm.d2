# 장기기억의 갈래 — 심리학 8장.
#
# 무엇을 읽어야 하나: 가장 위의 갈림이 ‘말로 꺼낼 수 있는가’ 라는 것.
# 그리고 이 갈림이 책상 위에서 그은 선이 아니라 어긋남에서 드러난 선이라는 것.
direction: down

장기: {
  label: "장기기억"
  shape: oval
  style.bold: true
}

서술: {
  label: "서술기억\n말로 꺼내 놓을 수 있다. ‘무엇’ 을 안다"
  style.bold: true
}
비서술: {
  label: "비서술기억\n말로 꺼내 놓기 어렵다. ‘어떻게’ 를 안다"
  style.bold: true
}

일화: { label: "일화기억\n내가 겪은 일. 언제 어디서가 함께 붙어 있다\n보기 — 지난주에 처음 이 길을 걸었던 일" }
의미: { label: "의미기억\n세상에 대한 앎. 언제 배웠는지는 대개 붙어 있지 않다\n보기 — 물이 얼면 얼음이 된다는 것" }

절차: { label: "절차기억\n몸으로 하는 일의 순서. 설명하기 어렵고 해 보이기는 쉽다\n보기 — 자전거를 타는 일, 자판을 치는 일" }
점화: { label: "점화\n먼저 만난 것 때문에 뒤의 처리가 빨라진다.\n본인은 그런 일이 있었다는 것을 알아채지 못해도 나타난다" }
조건: { label: "조건형성으로 붙은 것\n7장의 조건반응이 여기 들어온다" }

장기 -> 서술
장기 -> 비서술
서술 -> 일화
서술 -> 의미
비서술 -> 절차
비서술 -> 점화
비서술 -> 조건

근거: {
  label: "이 갈림을 세운 근거"
  direction: down
  g1: { label: "뇌의 특정 부위가 손상된 사람에게서 두 갈래가 ‘따로’ 무너진다.\n새로 겪은 일을 말로 꺼내지 못하게 된 사람이\n같은 기술을 날마다 연습하면 성적이 오른다 —\n연습했다는 사실 자체는 기억하지 못하면서"; style.bold: true }
  g2: { label: "다만 이런 사례는 수가 적고 한 사람마다 손상 부위가 다르다.\n사례가 보이는 것은 ‘두 갈래가 갈린다’ 까지이고,\n어느 부위가 무엇을 한다는 결론은 사례만으로 나오지 않는다" }
  g1 -> g2
}

비서술 -> 근거: { style.stroke-dash: 3 }
