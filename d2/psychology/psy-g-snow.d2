# 눈을 가리키는 낱말 이야기 — 잘못 퍼진 사례. 심리학 11장.
#
# 무엇을 읽어야 하나: 이야기가 옮겨지는 동안 수가 커졌다는 것, 그리고 수가
# 정확했더라도 결론이 따라 나오지 않는다는 것. 두 가지가 따로 잘못되었다.
direction: down

퍼짐: {
  label: "이야기가 커진 과정"
  direction: down
  a1: { label: "인류학자의 초기 기록에 눈을 가리키는 몇 개의 어근이 언급된다.\n원래 맥락은 낱말이 유난히 많다는 주장이 아니었다" }
  a2: { label: "인용되면서 ‘아주 많다’ 로 바뀐다" }
  a3: { label: "다시 인용되면서 수가 붙는다. 옮겨질 때마다 수가 커진다"; style.bold: true }
  a4: { label: "교과서와 대중 매체에 ‘상식’ 으로 자리 잡는다.\n이 확산 과정을 추적한 언어학자의 글이 1991년에 나왔다"; style.bold: true }
  a1 -> a2 -> a3 -> a4
}

잘못1: {
  label: "첫째 잘못 — 세는 단위를 정하지 않았다"
  direction: down
  b1: { label: "이 언어들은 어근에 여러 조각을 붙여 낱말을 만드는 유형이다.\n그렇게 만들어진 꼴을 각각 하나의 낱말로 세면 수는 얼마든지 커진다"; style.bold: true }
  b2: { label: "같은 방식으로 세면 한국어나 영어의 ‘눈 낱말’ 도 크게 늘어난다 —\n함박눈, 진눈깨비, 싸락눈, 첫눈, 눈보라 …\n어느 쪽 언어에서든 무엇을 한 낱말로 셀지를 먼저 정해야 수가 뜻을 갖는다"; style.bold: true }
  b1 -> b2
}

잘못2: {
  label: "둘째 잘못 — 수가 맞았다 해도 결론이 나오지 않는다"
  direction: down
  c1: { label: "낱말이 많다는 것은 그 문화가 그것에 관심을 많이 쏟는다는 뜻일 수 있다.\n관심이 낱말을 만든 것이지 낱말이 지각을 만든 것이 아닐 수 있다.\n둘의 방향을 이 관찰만으로는 가릴 수 없다"; style.bold: true }
  c2: { label: "그리고 이 이야기에는 지각이나 사고를 실제로 잰 자료가 아예 없다.\n낱말 수를 센 것과 무엇을 어떻게 구별하는지를 잰 것은 다른 자료다"; style.bold: true }
  c1 -> c2
}

퍼짐 -> 잘못1
퍼짐 -> 잘못2

교훈: {
  label: "이 사례에서 가져갈 것"
  direction: down
  d1: { label: "1. 세는 단위를 확인하라. 18장이 세운 읽기 규칙의 첫째와 같은 자리다"; style.bold: true }
  d2: { label: "2. 인상적인 사례는 옮겨지면서 커진다. 원 출처까지 거슬러 가는 것이 유일한 방어다" }
  d3: { label: "3. 워프 가설을 이 이야기로 지지하거나 반박할 수 없다.\n약한 판본의 근거는 이 이야기가 아니라 앞 그림의 과제 연구들이다"; style.bold: true }
  d1 -> d2 -> d3
}
잘못1 -> 교훈
잘못2 -> 교훈
