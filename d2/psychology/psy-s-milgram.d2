# 밀그램 — 되풀이된 것과 다투어지는 것. 심리학 18장.
#
# 무엇을 읽어야 하나: 왼쪽 칸(결과)과 오른쪽 칸(해석)의 처지가 다르다는 것.
# 결과는 되풀이되었고 그것이 무엇을 뜻하는지가 논쟁이다.
direction: right

결과: {
  label: "되풀이된 것"
  direction: down
  a: { label: "이 절차에 들어간 참가자 가운데 상당수가 실험자의 요구를 따라 계속했다" }
  b: { label: "2009년에 안전을 위해 낮은 지점에서 멈추도록 고친 판본으로 되풀이했을 때,\n계속한 사람의 비율이 원 연구와 비슷했다"; style.bold: true }
  c: { label: "다른 나라에서 이루어진 되풀이에서도 비슷한 방향의 결과가 보고되었다" }
  a -> b -> c
}

해석: {
  label: "다투어지는 것 — 참가자가 자기가 무엇을 하고 있다고 생각했는가"
  direction: down
  h1: { label: "복종 해석\n권위가 있는 자리에 있는 사람의 지시라서 따랐다.\n오랫동안 표준으로 인용된 읽기다" }
  h2: { label: "믿지 않았다는 해석\n상당수 참가자가 실제로 해를 입히고 있다고 믿지 않았다는 증거가 있다.\n참가자의 사후 진술과 실험 기록에서 그런 자료가 나왔다"; style.bold: true }
  h3: { label: "참여한 협력자 해석\n참가자가 명령을 따른 것이 아니라 가치 있어 보이는 일에 협력했다는 읽기.\n기록을 다시 분석한 연구들이 이 쪽을 밀었다"; style.bold: true }
  h4: { label: "이 셋을 가르는 자료가 있다\n실험자의 재촉은 네 단계였는데, 가장 명령에 가까운 마지막 재촉\n(‘당신은 다른 선택이 없습니다’) 뒤에는 거의 언제나 중단이 뒤따랐다.\n명령이 셀수록 덜 따랐다면 단순한 복종 해석은 어려워진다"; style.bold: true }
}

기록: {
  label: "자료와 절차의 문제"
  direction: down
  r1: { label: "조건마다 절차가 일정하지 않았고, 실험자가 대본을 벗어나 더 설득한 경우가 있었다" }
  r2: { label: "사후설명이 곧바로 이루어지지 않은 참가자들이 있었다.\n이 연구가 4장의 연구 윤리 논의를 크게 밀어 올린 계기이기도 하다" }
  r3: { label: "보고된 조건 말고도 여러 변형이 실시되었고, 어느 것을 대표로 인용하느냐가 인상을 바꾼다" }
}

결과 -> 해석: { label: "그러면 이것은 무엇인가" }
해석 -> 기록: { style.stroke-dash: 3 }

서술: {
  label: "　\n이 문서가 적는 방식 — ‘사람은 권위에 복종한다’ 가 아니라\n‘이 절차에서 다수가 끝까지 갔고, 그들이 자기가 무엇을 하고 있다고 여겼는지에 대해\n여러 설명이 경쟁하고 있다’"
  shape: text
}
기록 -> 서술
