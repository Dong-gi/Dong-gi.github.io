# 이 장을 읽는 순서 — 심리학 18장 첫 절.
#
# 무엇을 읽어야 하나: 이 장이 다른 장과 다른 순서로 쓰였다는 것.
# 결과를 먼저 소개하고 판정을 뒤에 붙이지 않는다.
direction: right

보통: {
  label: "흔한 서술 순서 — 이 문서가 쓰지 않는 방식"
  direction: down
  a: { label: "1. 유명한 실험을 소개한다" }
  b: { label: "2. 결론을 인상적으로 적는다" }
  c: { label: "3. 마지막에 ‘다만 논란이 있다’ 를 덧붙인다" }
  d: { label: "무엇이 문제인가 — 독자는 앞부분을 기억한다.\n덧붙인 한 줄은 이미 만들어진 인상을 되돌리지 못한다"; style.bold: true }
  a -> b -> c -> d
}

이장: {
  label: "이 장의 순서"
  direction: down
  e: { label: "1. 그 결과가 검사에서 어떻게 되었는지를 먼저 적는다"; style.bold: true }
  f: { label: "2. 그 다음에 원 연구가 무엇을 했는지 적는다" }
  g: { label: "3. 그리고 왜 그것이 널리 퍼졌는지를 묻는다" }
  h: { label: "재현에 실패한 결과는 그 실패가 서술의 주어가 된다.\n6장 끝에서 세운 규칙이고, 이 장이 그 규칙을 가장 많이 쓴다"; style.bold: true }
  e -> f -> g -> h
}

보통 -> 이장: { label: "바꾼다" }

주의: {
  label: "　\n그리고 반대쪽 잘못도 피해야 한다 — ‘사회심리학은 다 무너졌다’ 는 결론.\n이 장에는 여러 연구실에서 되풀이 확인된 결과도 함께 들어 있고,\n이 분야가 자기 문헌을 가장 많이 검사한 분야라는 것도 함께 적어야 한다"
  shape: text
}
이장 -> 주의: { style.stroke-dash: 3 }
