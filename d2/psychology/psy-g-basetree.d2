# 같은 문제를 두 가지로 적는다 — 심리학 10장.
#
# 무엇을 읽어야 하나: 위와 아래가 같은 정보라는 것. 그런데 개수로 적으면
# 답이 나눗셈 한 번으로 나오고, 확률로 적으면 대부분의 사람이 기저율을 빠뜨린다.
direction: down

확률꼴: {
  label: "확률로 적은 문제"
  direction: down
  p1: { label: "유통되는 지폐 가운데 위조는 0.2% 다" }
  p2: { label: "감별기는 위조를 100% 잡아낸다" }
  p3: { label: "감별기는 진짜의 2% 에 대해서도 경보를 울린다" }
  p4: { label: "물음 — 경보가 울린 지폐가 위조일 확률은?"; style.bold: true }
  p1 -> p2 -> p3 -> p4
}

빈도꼴: {
  label: "빈도로 다시 적은 같은 문제"
  direction: down
  f0: { label: "지폐 1,000장을 놓고 세어 본다"; style.bold: true }
  f1: { label: "위조 2장" }
  f2: { label: "진짜 998장" }
  f3: { label: "위조 2장 → 경보 2장" }
  f4: { label: "진짜 998장 → 경보 약 20장" }
  f5: { label: "경보는 모두 22장.\n그 가운데 위조는 2장.\n2 나누기 22 — 열에 한 번쯤이다"; style.bold: true }
  f0 -> f1 -> f3
  f0 -> f2 -> f4
  f3 -> f5
  f4 -> f5
}

확률꼴 -> 빈도꼴: "같은 정보를 다시 적었을 뿐이다"

교훈: {
  label: "무엇을 배우나"
  direction: down
  a: { label: "기저율 무시란 — 검사의 성능만 보고 ‘찾는 것이 얼마나 드문가’ 를 빠뜨리는 것이다.\n드문 것을 찾을 때는 경보의 대부분이 헛것이 된다"; style.bold: true }
  b: { label: "고치는 법 — 확률을 빈도로 바꿔 적는다.\n어떤 수를 놓고 세어 보면 두 갈래가 눈에 보인다" }
  c: { label: "이 방식이 실제로 정답률을 크게 올린다는 것이 여러 연구에서 보고되었다.\n다만 오르는 정도는 문제와 표현에 따라 다르다" }
  a -> b -> c
}

빈도꼴 -> 교훈
