# 꿈에 대한 이론들 — 무엇을 예측하는가. 심리학 14장.
#
# 무엇을 읽어야 하나: 이론마다 ‘무엇이 관찰되면 그 이론이 곤란해지는가’ 가
# 다르고, 어떤 이론은 그 물음에 답하지 못한다는 것. 이 절은 미결이다.
#
# 배치: 3칸 × 3줄. 물음을 가운데 두고 다섯 이론을 그 둘레에 놓았다. 첫 줄 왼쪽이 첫 번째 이론(소망의 충족)이고,
# 정리는 그 아래 칸에 두어 첫 번째와 다섯 번째 이론에서 오는 점선이 다른 칸을 가로지르지 않게 했다.
direction: down
grid-rows: 3
grid-columns: 3
horizontal-gap: 40
vertical-gap: 110

소망: {
  label: "소망의 충족"
  grid-columns: 1
  grid-gap: 40
  a1: { label: "주장 — 꿈은 감춰진 소망이\n모습을 바꾸어 나타난 것이다.\n20세기 초에 나왔고\n문화적으로 큰 영향을 남겼다" }
  a2: { label: "곤란한 자리 — 무엇이 관찰되면\n이 주장이 틀린 것이\n되는지가 정해져 있지 않다.\n어떤 꿈이 나와도\n‘모습을 바꾼 것’ 으로 설명된다.\n철학 문서 9장의 반증 가능성\n이야기가 여기에 걸린다"; style.bold: true }
  a1 -> a2
}

활성화: {
  label: "활성화와 종합"
  grid-columns: 1
  grid-gap: 40
  b1: { label: "주장 — 자는 동안 무작위에 가깝게 일어난\n신경 활동을 앞쪽 회로가 이야기로 엮은 것이\n꿈이다 (1970년대 후반)" }
  b2: { label: "예측 — 꿈의 내용에 특별한 뜻이 없어야 하고,\n특정 수면 단계와 강하게 묶여야 한다" }
  b3: { label: "곤란한 자리 — 꿈 내용이\n무작위 조합에 그치지 않고\n깨어 있는 삶의 관심사와\n이어진다는 자료가 있다.\n그리고 REM 이 아닌\n구간에서도 꿈 보고가 나온다" }
  b1 -> b2 -> b3
}

연속: {
  label: "깨어 있는 삶의 연속"
  grid-columns: 1
  grid-gap: 40
  c1: { label: "주장 — 꿈의 내용은 깨어 있는 동안의\n관심사와 걱정을 이어 간다" }
  c2: { label: "예측 — 꿈 보고의 내용과 낮의 관심사가\n함께 움직여야 한다" }
  c3: { label: "곤란한 자리 — 이것이 참이어도\n‘꿈이 무엇을 하는가’ 에는 답하지 않는다.\n기능이 아니라 내용에 대한 주장이다" }
  c1 -> c2 -> c3
}

# 격자 칸은 옆 묶음만큼 높은데 글 상자는 칸 위쪽에 붙는다. 위아래 빈 줄로 글을 칸 가운데에 둔다
# (그러지 않으면 아래 ‘기억 처리’ 에서 오는 점선이 빈 곳을 가리킨다)
정리: {
  label: "　\n　\n　\n　\n　\n　\n　\n이 문서의 태도 — 어느 하나를\n정답으로 쓰지 않는다. 미결이다.\n\n그리고 이 다섯을 견주는 기준을 하나 세워 둔다 —\n‘무엇이 관찰되면 그 이론이 곤란해지는가’ 에\n답할 수 있는 이론이 그렇지 못한 이론보다\n낫다. 이 기준으로 보면\n첫 번째 이론이 가장 약하다.\n그것이 ‘틀렸다’ 는 뜻은 아니고\n‘검사되지 않는다’ 는 뜻이다\n　\n　\n　\n　\n　\n　\n　"
  shape: text
}

물음: {
  label: "꿈은 무엇을 하는가 — 미결이다"
  shape: oval
  style.bold: true
}

위협: {
  label: "위협의 연습"
  grid-columns: 1
  grid-gap: 40
  d1: { label: "주장 — 위협 상황을 안전하게\n되풀이해 보는 일이고,\n그래서 진화적으로 자리 잡았다" }
  d2: { label: "예측 — 꿈에 위협 장면이 특히 많아야 하고,\n위협이 많은 환경에서 자란 사람에게\n더 많아야 한다" }
  d3: { label: "곤란한 자리 — 꿈 내용을 세는 방식에 따라\n결과가 갈린다.\n무엇을 ‘위협’ 으로 셀지부터 정해야 한다"; style.bold: true }
  d1 -> d2 -> d3
}

기억처리: {
  label: "기억 처리의 부산물"
  grid-columns: 1
  grid-gap: 40
  e1: { label: "주장 — 자는 동안 기억을\n다시 처리하는 일이 일어나고\n꿈은 그 과정에서 겉으로 드러난 것이다" }
  e2: { label: "예측 — 낮에 익힌 것과\n꿈 내용이 관계를 가져야 하고,\n꿈을 꾼 뒤 그 과제의 성적이 달라져야 한다" }
  e3: { label: "곤란한 자리 — 관계가 보고되어도\n그것이 ‘부산물’ 인지 ‘과정의 일부’ 인지가\n자료에서 갈리지 않는다" }
  e1 -> e2 -> e3
}

물음 -> 소망
물음 -> 활성화
물음 -> 연속
물음 -> 위협
물음 -> 기억처리

소망 -> 정리: { style.stroke-dash: 3 }
기억처리 -> 정리: { style.stroke-dash: 3 }
