# 귀인 — 남은 것과 무너진 것. 심리학 18장.
#
# 무엇을 읽어야 하나: 한 이름 아래 묶여 교과서에 실려 있던 것들의 처지가
# 검사에서 갈렸다는 것. 뭉뚱그린 이름이 그 차이를 가린다.
direction: right

이름: {
  label: "교과서에 함께 실려 있던 것들"
  shape: oval
  style.bold: true
}

남은: {
  label: "검사에서 남은 것"
  direction: down
  a: { label: "대응 편향\n어떤 사람이 자기 뜻으로 그 글을 쓴 것이 아니라는 것을 알려 주어도,\n읽는 사람은 그 글의 내용을 글쓴이의 생각으로 읽는 쪽으로 기운다.\n이 절차는 여러 연구실이 함께 한 재현에 포함되어 되풀이되었다"; style.bold: true }
  b: { label: "자기고양 편향\n잘된 일은 자기 쪽에, 안된 일은 바깥에 돌리는 기울기.\n여러 자료에서 되풀이 관찰되었다" }
}

무너진: {
  label: "검사에서 무너진 것"
  direction: down
  c: { label: "행위자-관찰자 비대칭\n‘내 행동은 상황으로, 남의 행동은 성향으로 설명한다’ 는 명제.\n오래 교과서에 실려 있었으나 메타분석에서 전체 효과가 거의 0 이었다"; style.bold: true }
}

논쟁: {
  label: "다투어지는 것"
  direction: down
  d: { label: "이 기울기를 ‘기본적’ 이라 부를 수 있는가\n상황 정보를 얼마나 쓰는지가 문화에 따라 다르다는 보고들이 있다.\n그 차이의 크기와 조건은 논쟁 중이다"; style.bold: true }
  e: { label: "이것이 오류인가\n사람들이 성향을 앞세우는 것이 잘못된 추론이라기보다\n실제 세계에서 대체로 쓸 만한 어림법일 수 있다는 반론이 있다" }
}

이름 -> 남은
이름 -> 무너진
이름 -> 논쟁

교훈: {
  label: "　\n읽을 때의 규칙 — ‘귀인 편향’ 처럼 큰 이름 아래 여러 결과가 묶여 있으면\n이름 단위가 아니라 결과 단위로 재현 상태를 확인해야 한다.\n하나가 무너졌다고 나머지가 무너지는 것도, 하나가 버텼다고 나머지가 버티는 것도 아니다"
  shape: text
}
남은 -> 교훈: { style.stroke-dash: 3 }
무너진 -> 교훈: { style.stroke-dash: 3 }
논쟁 -> 교훈: { style.stroke-dash: 3 }
