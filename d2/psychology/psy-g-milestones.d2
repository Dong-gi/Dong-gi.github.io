# 언어 습득의 순서 — 심리학 11장.
#
# 무엇을 읽어야 하나: 순서가 여러 언어에서 대체로 같게 관찰된다는 것,
# 그리고 나이는 사람마다 크게 다르다는 것. 이 그림에 나이를 적지 않은 이유가 그것이다.
direction: down

전: {
  label: "말이 나오기 전"
  direction: down
  a1: { label: "말소리를 다른 소리와 다르게 다룬다.\n처음에는 여러 언어의 소리 차이를 두루 가려내다가,\n첫돌 무렵으로 가면서 ‘자기가 듣는 언어의 구별’에 맞춰 좁혀진다"; style.bold: true }
  a2: { label: "옹알이. 처음에는 소리를 굴리다가 점점 주변 언어의 소리 꼴에 가까워진다" }
  a3: { label: "말을 하기 전에 이미 여러 낱말을 알아듣는다.\n알아듣는 것과 말하는 것은 늘 어긋나 있고, 알아듣는 쪽이 앞선다"; style.bold: true }
  a1 -> a2 -> a3
}

한낱말: {
  label: "한 낱말 시기\n낱말 하나로 문장 하나만큼의 일을 한다.\n‘물’ 이 요청일 수도, 가리킴일 수도 있다"
  style.bold: true
}

두낱말: {
  label: "두 낱말 시기\n낱말 둘을 붙이는데, 붙이는 순서에 이미 규칙이 있다.\n조사와 어미 같은 문법 요소는 아직 거의 빠져 있다"
  style.bold: true
}

문법: {
  label: "문법 요소가 들어온다"
  direction: down
  b1: { label: "문장이 길어지고 문법 형태가 자리를 잡는다" }
  b2: { label: "규칙을 지나치게 적용하는 시기가 온다.\n앞서 맞게 쓰던 불규칙한 꼴을 규칙대로 바꿔 말하는 일이 생긴다"; style.bold: true }
  b3: { label: "이것이 중요한 이유 — 어른에게서 들어 본 적 없는 꼴을 만들어 낸다는 것이므로,\n아이가 따라 하는 것이 아니라 규칙을 뽑아냈다는 증거가 된다"; style.bold: true }
  b1 -> b2 -> b3
}

뒤: {
  label: "그 뒤로도 오래 이어진다\n복잡한 문장 구조, 그리고 상황에 맞게 말을 고르는 힘은\n학령기를 지나서도 계속 자란다"
}

전 -> 한낱말 -> 두낱말 -> 문법 -> 뒤

주의: {
  label: "　\n나이를 적지 않은 이유 — 순서는 여러 언어에서 비슷하게 관찰되지만\n각 단계에 이르는 나이는 아이마다 크게 다르다.\n평균 나이를 적어 놓으면 그 수가 기준처럼 읽히고, 그것은 이 자료가 말하는 바가 아니다"
  shape: text
}
뒤 -> 주의: { style.stroke-dash: 3 }
