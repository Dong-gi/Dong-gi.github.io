# 심리학의 분야 지도 — 심리학 3장.
#
# 무엇을 읽어야 하나: 가운데 세로줄(방법)이 모든 분야를 관통한다는 것.
# 분야는 무엇을 묻는지로 갈리고, 방법은 갈리지 않는다.
direction: right

방법: {
  label: "연구 방법과 심리측정\n4·5·6장"
  style.bold: true
  style.multiple: true
}

기초: {
  label: "기초 — 마음이 어떻게 작동하는가"
  direction: down
  학습: { label: "학습  7장" }
  기억: { label: "기억  8·9장" }
  인지: { label: "인지·언어  10·11장" }
  지각: { label: "감각과 지각  12장" }
  생물: { label: "생물심리학·의식  13·14장" }
}

개인: {
  label: "개인과 변화"
  direction: down
  발달: { label: "발달  15장" }
  정서: { label: "정서와 동기  16장" }
  성격: { label: "성격과 지능  17장" }
}

사회: {
  label: "사람들 사이"
  direction: down
  사회심리: { label: "사회심리학  18장" }
}

응용: {
  label: "응용 — 이 문서가 얇게 다루거나 다루지 않는 것"
  direction: down
  임상: { label: "임상·상담  19장은 개관만 한다" }
  기타: { label: "산업조직 · 교육 · 건강 · 법 · 인간공학\n20장에서 갈래만 적는다" }
}

방법 -> 기초: "같은 잣대"
방법 -> 개인: "같은 잣대"
방법 -> 사회: "같은 잣대"
방법 -> 응용: "같은 잣대"

주의: {
  label: "　\n분야 이름은 물음을 나누는 편의일 뿐이다.\n기억을 다루는 사람과 사회심리를 다루는 사람이 쓰는 설계와 통계는 거의 같고,\n6장에서 볼 문제도 분야를 가리지 않고 같은 자리에서 났다"
  shape: text
}
방법 -> 주의: { style.stroke-dash: 3 }
