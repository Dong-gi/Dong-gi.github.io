# 무선표집과 무선배정 — 심리학 4장.
#
# 무엇을 읽어야 하나: 주사위를 두 번 던진다는 것. 첫 번째 던지기와 두 번째 던지기가
# 지켜 주는 것이 서로 다르고, 하나를 했다고 다른 하나가 되지 않는다.
direction: down

모집단: {
  label: "모집단\n결론을 적용하고 싶은 사람 전체"
  shape: oval
  style.bold: true
}

표집: {
  label: "1. 무선표집\n누구를 부를지 우연이 정한다"
  style.bold: true
}

표본: { label: "표본\n실제로 연구에 들어온 사람들" }

배정: {
  label: "2. 무선배정\n들어온 사람이 어느 조건에 갈지 우연이 정한다"
  style.bold: true
}

집단: {
  label: "두 집단"
  direction: down
  처치: { label: "처치 집단" }
  통제: { label: "통제 집단" }
}

모집단 -> 표집
표집 -> 표본
표본 -> 배정
배정 -> 집단

지키는것1: {
  label: "무선표집이 지켜 주는 것 — 외적 타당도\n표본에서 본 것을 모집단에 대해 말할 수 있다.\n하지 않으면 ‘이 사람들에게서는 이랬다’ 까지만 말할 수 있다"
  shape: text
}
지키는것2: {
  label: "무선배정이 지켜 주는 것 — 내적 타당도\n두 집단이 처치 말고는 평균적으로 같아진다.\n재지 못한 혼입변수까지 고르게 섞이는 것이 요점이다.\n하지 않으면 차이의 원인을 처치라고 말할 수 없다"
  shape: text
}
표집 -> 지키는것1: { style.stroke-dash: 3 }
배정 -> 지키는것2: { style.stroke-dash: 3 }

실제: {
  label: "　\n실제 연구는 대개 이렇다 — 무선표집은 하지 못하고 무선배정만 한다.\n대학생 200명을 모아 동전을 던져 두 조건에 나눈다.\n그러면 ‘이 처치가 이 사람들에게 효과가 있었다’ 는 말할 수 있고\n‘사람 일반에게 효과가 있다’ 는 말할 수 없다. 6장의 네 물음 가운데 둘이 여기서 갈린다"
  shape: text
}
집단 -> 실제: { style.stroke-dash: 3 }
