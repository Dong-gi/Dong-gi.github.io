# 갈림길의 정원 — 심리학 6장.
#
# 무엇을 읽어야 하나: 실제로 걸은 길은 하나뿐이라는 것. 그런데 유의수준 5%는
# ‘길이 하나였을 때’ 의 값이다. 걷지 않은 갈림길이 몇 개였는지는 논문에 적히지 않는다.
#
# 배치: 2칸 × 1줄 격자. 첫 칸(테두리 없는 묶음)에 자료에서 결과까지의 길을 위에서 아래로 둔다.
# 둘째 칸은 1칸 × 3줄 격자로, 맨 위에 빈자리, 가운데 사전등록 메모, 맨 아래에 ‘셈해 보면’ 이 온다 —
# ‘셈해 보면’ 을 결과와 같은 높이에 두어 결과에서 오는 점선이 갈림 마름모를 가로지르지 않게 했다.
# 그래서 ‘셈해 보면’ 에서 메모로 가는 점선은 위로 올라간다. 세로 길이와 폭을 함께 줄이려는 배치다.
grid-rows: 1
grid-columns: 2
horizontal-gap: 80

길: {
  label: ""
  style.stroke: transparent
  style.fill: transparent
  direction: down

  자료: { label: "자료를 손에 넣었다"; shape: oval; style.bold: true }

  갈림1: { label: "1. 누구를 뺄까\n반응이 너무 빠른 사람?\n너무 느린 사람?\n지시를 못 따른 사람?\n아무도 안 뺀다?"; shape: diamond }
  갈림2: { label: "2. 종속변수를 무엇으로 할까\n정확률? 반응 시간?\n둘을 합친 값?\n로그를 씌운 반응 시간?"; shape: diamond }
  갈림3: { label: "3. 무엇을 통제할까\n나이? 성별? 사전 점수?\n아무것도 넣지 않는다?"; shape: diamond }
  갈림4: { label: "4. 언제 멈출까\n미리 정한 수에서?\n유의해질 때까지?\n조금 더 모아 볼까?"; shape: diamond }
  갈림5: { label: "5. 누구에게서 효과가 나올까\n전체? 여자만?\n어린 참가자만? 첫 시행만?"; shape: diamond }

  결과: { label: "유의한 결과 하나\n논문에는 이 길만 적힌다"; style.bold: true }

  자료 -> 갈림1 -> 갈림2 -> 갈림3 -> 갈림4 -> 갈림5 -> 결과
}

뒤: {
  label: ""
  style.stroke: transparent
  style.fill: transparent
  grid-columns: 1
  vertical-gap: 40

  # 배치용 빈자리 — 메모와 ‘셈해 보면’ 을 아래로 내린다.
  빈자리: { label: ""; width: 10; height: 960; style.stroke: transparent; style.fill: transparent }

  막기: {
    label: "그래서 사전등록은 ‘정직 서약’ 이 아니라\n지도를 미리 그려 봉해 두는 일이다.\n다섯 갈림에서 어디로 갈지\n자료를 보기 전에 적어 두면 길이 하나가 되고,\n그때 비로소 5% 라는 값이 뜻을 갖는다"
    shape: text
  }

  셈: {
    label: "셈해 보면"
    grid-columns: 1
    grid-gap: 24
    a: { label: "갈림마다 선택지가 셋이라면\n길은 3 × 3 × 3 × 3 × 3 = 243 가지다" }
    b: { label: "243 갈래를 다 걸어 보고\n유의한 것 하나를 고르면\n‘20번에 한 번 우연히 유의하다’ 는\n보장은 남아 있지 않다" }
    c: { label: "여기서 무서운 것은\n다 걸어 보지 않아도\n같은 일이 벌어진다는 점이다.\n자료를 보면서 그럴듯한 쪽으로\n한 번씩 정해 나가면\n연구자 자신은 한 길만 걸었다고 느끼지만\n결과는 자료에 맞춰 골라진 것이다"; style.bold: true }
  }

  셈 -> 막기: { style.stroke-dash: 3 }
}

길.결과 -> 뒤.셈: { style.stroke-dash: 3 }
