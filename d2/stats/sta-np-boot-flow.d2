# 부트스트랩의 생각 — 통계학 15장(비모수 방법과 재표집).
#
# 무엇을 읽어야 하나: 두 칸이 같은 모양이다. '실제 세계' 칸의 모집단 자리를
# '부트스트랩 세계' 칸에서는 표본(경험분포)이 대신한다. 실제 세계의 표본분포는
# 볼 수 없고, 부트스트랩 세계의 것은 컴퓨터로 얼마든지 볼 수 있다.
direction: down

두세계: {
  label: ""
  grid-rows: 1
  grid-columns: 2
  grid-gap: 80
  style.stroke: transparent
  style.fill: transparent

실제: {
  label: "실제 세계 (볼 수 없다)"
  style.stroke-dash: 4
  direction: down

  F: { label: "모집단 분포 F\n(모른다)"; shape: oval }
  표본들: { label: "크기 n 인 표본을\n몇 번이고 다시 뽑는다면" }
  추정값들: { label: "θ̂ 가 표본마다 달라진다" }
  표본분포: { label: "θ̂ 의 표본분포\n→ 표준오차·구간"; style.bold: true }

  F -> 표본들: "n 개를 뽑는다"
  표본들 -> 추정값들: "통계량 계산"
  추정값들 -> 표본분포
}

부트: {
  label: "부트스트랩 세계 (계산할 수 있다)"
  direction: down

  Fn: { label: "경험분포 F̂n\n(손에 든 표본, 각 값에 1/n)\nF 의 자리를 대신한다"; shape: oval }
  재표본: { label: "재표본 B 개\n표본에서 n 개를 복원추출" }
  재추정: { label: "θ̂* 가 B 개" }
  부트분포: { label: "θ̂* 의 분포\n→ 표준편차 = 부트스트랩 표준오차\n→ 2.5%·97.5% 분위수 = 백분위수 구간"; style.bold: true }

  Fn -> 재표본: "n 개를 복원으로"
  재표본 -> 재추정: "같은 통계량 계산"
  재추정 -> 부트분포
}

}


메모: {
  label: "플러그인 원리: 볼 수 없는 F 자리에 F̂n 을 놓고 같은 절차를 컴퓨터로 되풀이한다.\n오차가 두 겹이다. B 가 유한해서 생기는 몬테카를로 오차는 B 를 늘리면 줄고,\nF̂n 이 F 와 달라서 생기는 표본 오차는 자료를 더 모아야만 준다"
  shape: text
  style.font-size: 20
  near: bottom-center
}
