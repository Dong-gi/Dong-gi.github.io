# 통계학 10장 — 유의수준 논쟁의 네 입장.
#
# 무엇을 읽어야 하나: 네 입장이 각각 무엇을 바꾸자고 하는지
# (문턱의 값 / 문턱을 정하는 근거 / 유의·비유의라는 보고 방식 / 분석의 중심).
# 입장 사이에 화살표를 두지 않는다 — 우열을 매기지 않는다는 뜻이다. 아래 칸은 넷이 모두 받아들이는 것.
direction: down

입장: {
  label: "유의수준 논쟁의 네 입장 — 무엇을 바꾸자고 하는가"
  grid-rows: 2
  grid-columns: 2
  grid-gap: 20

  가: {
    label: "[가] 문턱을 낮추자\n벤저민 외 (2018)\n\n바꾸는 것: 문턱의 값\n새 발견을 주장하는 기준을 0.05 에서 0.005 로.\n그 사이의 결과는 ‘시사적’ 이라 부른다"
  }
  나: {
    label: "[나] 문턱을 근거로 고르자\n레이컨스 외 (2018)\n\n바꾸는 것: 문턱을 정하는 근거\n모든 연구에 같은 값을 쓰지 말고 두 오류의 값과\n표본 크기로 정해 연구 전에 밝힌다"
  }
  다: {
    label: "[다] 유의·비유의 판정을 그만두자\n암라인 외 (2019), 맥셰인 외 (2019)\n\n바꾸는 것: 보고 방식\np값은 연속량 그대로 보고하고 설계·사전 근거·\n효과크기와 함께 판단한다"
  }
  라: {
    label: "[라] 검정 대신 추정하자\n커밍 (2014)\n\n바꾸는 것: 분석의 중심\n효과크기와 신뢰구간을 보고하고\n여러 연구는 메타분석으로 모은다"
  }
}

공통: {
  label: "넷이 모두 받아들이는 것 (ASA 2016 성명)\n\np값 하나로 결론을 내리지 않는다 · p값은 가설이 참일 확률이 아니다\np값은 효과의 크기가 아니다 · 무엇을 몇 번 분석했는지 모두 밝힌다"
  style.bold: true
}

입장 -> 공통: {
  style.opacity: 0
}
