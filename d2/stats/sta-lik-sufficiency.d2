# 충분통계량이 하는 일 — 통계학 6장 '충분통계량' 절.
#
# 무엇을 읽어야 하나: 자료를 충분통계량으로 줄일 때 버려지는 몫(순서·배치)은
# T 가 주어지면 분포에 θ 가 들어 있지 않다. 그래서 그 몫은 θ 에 대해 아무것도 말하지 않고,
# 가능도·최대가능도추정·사후분포는 모두 T 만으로 정해진다.
direction: down

자료: {
  label: "자료 x₁, x₂, …, xₙ\n예: 베르누이 열 번 1 0 0 1 1 0 0 0 1 0"
  style.bold: true
}

T: {
  label: "충분통계량 T(x)\n예: 합 ∑xᵢ = 4"
  style.bold: true
}

나머지: {
  label: "T 가 주어졌을 때의 나머지\n예: 1 이 열 자리 중 어느 네 자리인가"
}

추론: {
  label: "추론\n가능도 · 최대가능도추정 · 사후분포"
  style.bold: true
}

없음: {
  label: "θ 에 대해 아무것도 말하지 않는다\n배치 210 가지가 θ 와 무관하게 모두 1/210"
}

자료 -> T: "줄여서 남기는 것"
자료 -> 나머지: "버리는 것"
T -> 추론: "가능도가 T 로만 정해진다"
나머지 -> 없음: "조건부분포에 θ 가 없다"
