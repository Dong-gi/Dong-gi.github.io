# 무엇으로 지킬 것인가 — 15장(병행성과 동기화).
#
# 무엇을 읽어야 하나: 동기화 도구는 저마다 다른 문제를 푼다.
# 먼저 ‘정말 공유해야 하는가’ 를 묻고, 공유해야 한다면 무엇을 기다리는지에 따라 도구가 갈린다.
direction: down

시작: { label: "두 실행 흐름이 같은 것을 건드린다"; shape: oval; style.bold: true }

안공유: {
  label: "가장 좋은 답 — 공유하지 않는다\n각자의 사본을 갖거나 · 값을 바꾸지 않거나(불변) ·\n한 흐름만 그 자료를 맡게 하거나(메시지로 주고받기)"
  style.bold: true
}
시작 -> 안공유: "나눌 수 있는가"

읽기만: { label: "읽기만 하는가" }
시작 -> 읽기만: "나눌 수 없다"
읽기전용: { label: "아무것도 필요 없다\n아무도 쓰지 않으면 경쟁 상태가 없다" }
읽기만 -> 읽기전용: "쓰는 쪽이 아예 없다"

무엇: { label: "무엇을 기다리는가" }
읽기만 -> 무엇: "쓰는 쪽이 있다"

뮤텍스: {
  label: "뮤텍스 — 자리 하나\n‘지금은 내가 쓴다’ 를 표시한다\n잠근 스레드만 풀 수 있다"
  style.bold: true
}
세마포어: {
  label: "세마포어 — 자리 n 개\n개수를 센다. 자원 풀과 신호 보내기\n잠근 쪽과 푸는 쪽이 달라도 된다"
  style.bold: true
}
모니터: {
  label: "모니터 — 락과 조건 변수를 한 묶음으로\n‘들어가서, 조건이 안 맞으면 락을 놓고 잔다’\n생산자-소비자의 기본 모양"
  style.bold: true
}
읽기작가: {
  label: "독자-작가 락\n읽는 사람은 여럿이 동시에\n쓰는 사람은 혼자서"
}
원자: {
  label: "원자적 연산 · CAS\n한 변수를 세는 정도라면 락이 필요 없다\n경쟁이 심하면 오히려 느려진다"
}
무엇 -> 뮤텍스: "짧은 구간의 배타적 접근"
무엇 -> 세마포어: "정해진 개수의 자원"
무엇 -> 모니터: "‘조건이 맞을 때까지’ 를 기다린다"
무엇 -> 읽기작가: "읽기가 압도적으로 많다"
무엇 -> 원자: "변수 하나를 세거나 바꾼다"

교착주의: {
  label: "락을 둘 이상 잡게 되면 잠그는 순서를 하나로 정해 둔다.\n그것 하나로 순환 대기가 사라지고, 그러면 교착이 생길 수 없다"
  shape: text
}
뮤텍스 -> 교착주의
모니터 -> 교착주의

범위: {
  label: "임계 구역은 짧을수록 좋지만 너무 짧으면 틀린다.\n‘검사와 그 결과에 따른 행동’ 은 반드시 한 임계 구역 안에 함께 있어야 한다 — 그러지 않으면 TOCTOU 다"
  shape: text
}
