# NP-완전 문제를 만났을 때 — 13장(계산 복잡도).
#
# 무엇을 읽어야 하나: NP-완전이라는 것은 ‘포기하라’ 가 아니라
# ‘완벽한 답을 다항 시간에 얻으려는 시도를 그만두라’ 는 뜻이다. 무엇을 포기할지 고르면 된다.
direction: down

만남: { label: "이 문제가 NP-완전임을 알았다"; shape: oval; style.bold: true }

확인: { label: "정말 그 문제가 맞는가\n입력에 특별한 구조가 있지는 않은가" }
만남 -> 확인

특수: {
  label: "특수한 경우는 다항 시간일 수 있다\n이분 그래프의 정점 덮개 · 트리 위의 문제\n2SAT · DAG 최장 경로 (9장)"
  style.bold: true
}
확인 -> 특수: "구조가 있다"

크기: { label: "입력이 실제로 얼마나 큰가" }
확인 -> 크기: "일반적인 경우다"

완전탐색: {
  label: "그냥 다 훑는다\n가지치기 · 분기 한정으로\n실제 탐색량을 줄인다"
}
크기 -> 완전탐색: "작다 (수십 개)"

세갈래: { label: "무엇을 포기할 것인가" }
크기 -> 세갈래: "크다"

근사: {
  label: "① 정확함을 포기한다 — 근사 알고리즘\n최적의 몇 배 안이라는 보장을 증명한다\n정점 덮개 2-근사 · 삼각부등식 TSP 1.5-근사"
  style.bold: true
}
휴리스틱: {
  label: "② 보장을 포기한다 — 휴리스틱\n대개 잘 되지만 보장은 없다\n지역 탐색 · 담금질 · 유전 알고리즘 · SAT 해결기"
  style.bold: true
}
매개변수: {
  label: "③ 일반성을 포기한다 — 매개변수화\n어려움을 작은 값 k 에 몰아넣는다\n비용이 f(k) · n 꼴이면 k 가 작을 때 쓸 만하다"
  style.bold: true
}
세갈래 -> 근사
세갈래 -> 휴리스틱
세갈래 -> 매개변수

고르기: {
  label: "무엇을 고르는가:\n최악을 보장해야 하면 ①,\n평균이 좋으면 되는 실무라면 ②,\n어려움의 원인이 작은 값 하나에 몰려 있으면 ③"
  shape: text
}

주의: {
  label: "근사가 늘 가능한 것은 아니다.\n일반 TSP 는 어떤 상수 배 안으로도 근사할 수 없다\n(할 수 있다면 P = NP 가 된다)"
  shape: text
}
