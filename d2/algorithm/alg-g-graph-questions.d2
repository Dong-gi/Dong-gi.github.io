# 그래프 질문에 무엇을 쓰는가 — 8장(그래프: 표현과 탐색).
#
# 무엇을 읽어야 하나: 이 장의 알고리즘은 사실상 탐색 하나뿐이다.
# 질문이 달라지면 훑는 순서와 기록할 것이 달라질 뿐 비용은 모두 O(V+E) 다.
direction: down

질문: { label: "그래프에 무엇을 묻는가"; shape: oval; style.bold: true }

가중: { label: "간선에 가중치가 있는가" }
질문 -> 가중

구장: { label: "9장으로 — 다익스트라 · 벨만-포드\n프림 · 크루스칼"; style.bold: true }
가중 -> 구장: "있다"

무엇: { label: "가중치가 없다\n= 모든 간선이 똑같이 1 걸음"; style.bold: true }
가중 -> 무엇: "없다"

닿나: { label: "여기서 저기로 닿는가\n덩어리가 몇 개인가" }
거리: { label: "몇 걸음 만에 닿는가" }
순환: { label: "되돌아오는 길이 있는가" }
순서: { label: "선후관계를 지키는 순서가 있는가" }
이분: { label: "두 무리로 나눌 수 있는가" }

무엇 -> 닿나
무엇 -> 거리
무엇 -> 순환
무엇 -> 순서
무엇 -> 이분

dfs: { label: "DFS 또는 BFS\n방문 표시만 하면 된다\n탐색을 시작한 횟수 = 연결 요소 수" }
bfs: { label: "BFS 여야 한다\n큐가 거리 순서를 지키므로\n큐에 넣을 때 거리를 적는다"; style.bold: true }
back: { label: "DFS 여야 한다\n뒤 간선을 만나면 순환\n무방향이면 부모 간선을 빼고 센다"; style.bold: true }
topo: { label: "위상 정렬\n진입차수 0 부터 꺼내거나\nDFS 종료 순서를 뒤집는다\nDAG 에서만 된다" }
color: { label: "BFS 로 층을 매기고\n층의 홀짝으로 칠한다\n= 홀수 길이 순환이 없는가" }

닿나 -> dfs
거리 -> bfs
순환 -> back
순서 -> topo
이분 -> color

비용: {
  label: "다섯 가지 모두 O(V + E) 다 — 인접 리스트를 쓸 때.\n인접 행렬을 쓰면 이웃을 훑는 것만으로 O(V²) 가 된다.\n표현을 잘못 고르면 알고리즘을 아무리 잘 짜도 소용이 없다"
  shape: text
}
