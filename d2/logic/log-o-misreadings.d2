# 흔한 오해 넷과 무엇이 빠졌는가 — 논리학 17장.
#
# 무엇을 읽어야 하나: 왼쪽 네 문장이 모두 조건이나 한정사를 하나씩 빠뜨려서
# 틀렸다는 것. 오른쪽 칸이 빠진 조각을 되돌려 놓은 문장이고, 맨 아래가
# 그 조각을 전부 갖춘 정확한 진술이다.
direction: down

대조: {
  label: "떠도는 문장과 거기서 빠진 것 — 줄마다 가로로 읽는다"
  style.bold: true
  grid-rows: 5
  grid-columns: 2
  grid-gap: 8

  머리1: { label: "떠도는 문장"; style.bold: true }
  머리2: { label: "무엇이 빠졌나"; style.bold: true }

  x1: { label: "괴델이 수학을 무너뜨렸다.\n수학에 모순이 있다는 뜻이다" }
  y1: { label: "가정 (다) 일관성을 빠뜨렸다.\n정리는 일관성을 가정한 위에서 말한다" }

  x2: { label: "모든 것은 증명 불가능하다.\n무엇도 확실하지 않다" }
  y2: { label: "∃ 를 ∀ 로 바꿔치기했다.\n정리는 ‘그런 문장이 있다’ 고 말한다" }

  x3: { label: "인간은 기계보다 낫다는 것이\n수학적으로 증명되었다" }
  y3: { label: "‘T 가 일관적이면’ 이라는 전건을 지웠다.\n그 전건을 아는 것이 문제의 전부다" }

  x4: { label: "어떤 체계도 자기를 완전히 설명할 수 없다\n— 법도 사회도 마음도" }
  y4: { label: "가정 (가) 를 빠뜨렸다.\n산술을 담는 형식 언어에만 적용된다" }
}

정확: {
  label: "T 가 (가) 산술을 담을 만큼 강하고 (나) 재귀적으로 공리화되고 (다) 일관적이면,\nT ⊬ G 이고 T ⊬ ¬G 인 산술 문장 G 가 있다. 그 G 는 표준 모형 ℕ 에서 참이다"
  style.bold: true
}

대조 -> 정확: "빠진 조각을 전부 되돌려 놓으면"
