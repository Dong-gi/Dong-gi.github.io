# 연결자마다 규칙이 둘 — 도입과 제거 — 논리학 7장.
#
# 무엇을 읽어야 하나: 규칙 목록은 외울 것이 아니라 자리를 채운 표다.
# 연결자 하나마다 ‘어떻게 만드는가(도입)’ 와 ‘어떻게 쓰는가(제거)’ 가 하나씩 있고,
# ⊥ 만 자리가 비뚤다 — 도입 자리를 ¬E 가 대신 채운다.
direction: down

규칙표: {
  grid-rows: 7
  grid-columns: 3
  grid-gap: 8

  머리1: { label: "연결자"; style.bold: true }
  머리2: { label: "도입 — 이 연결자가 든 식을 얻는 길"; style.bold: true }
  머리3: { label: "제거 — 이 연결자가 든 식을 쓰는 길"; style.bold: true }

  기호곱: { label: "∧" }
  곱도입: { label: "∧I\nφ 와 ψ 에서 φ ∧ ψ" }
  곱제거: { label: "∧E\nφ ∧ ψ 에서 φ. ψ 도 된다" }

  기호합: { label: "∨" }
  합도입: { label: "∨I\nφ 에서 φ ∨ ψ. ψ ∨ φ 도 된다" }
  합제거: { label: "∨E — 경우 나누기\nφ ∨ ψ, 그리고 두 갈래에서 각각 χ 를 얻으면 χ" }

  기호함의: { label: "→" }
  함의도입: { label: "→I — 가정 방출\nφ 를 가정해 ψ 를 얻으면 φ → ψ" }
  함의제거: { label: "→E — 전건 긍정\nφ → ψ 와 φ 에서 ψ" }

  기호동치: { label: "↔" }
  동치도입: { label: "↔I\nφ → ψ 와 ψ → φ 에서 φ ↔ ψ" }
  동치제거: { label: "↔E\nφ ↔ ψ 와 φ 에서 ψ. 반대쪽도 된다" }

  기호부정: { label: "¬" }
  부정도입: { label: "¬I — 가정 방출\nφ 를 가정해 ⊥ 를 얻으면 ¬φ" }
  부정제거: { label: "¬E\nφ 와 ¬φ 에서 ⊥" }

  기호모순: { label: "⊥" }
  모순도입: { label: "도입 규칙이 없다\n⊥ 를 얻는 길은 ¬E 하나뿐이다" }
  모순제거: { label: "⊥E — 폭발률\n⊥ 에서 무엇이든" }
}

바깥: {
  label: "표에 들어가지 않는 규칙 둘"
  style.bold: true
  반복: { label: "R — 반복\n앞선 줄의 φ 를 그대로 다시 적는다.\n연결자와 아무 상관이 없어서 자리가 없다" }
  간접: { label: "IP — 간접증명\n¬φ 를 가정해 ⊥ 를 얻으면 φ.\n어느 연결자의 도입도 제거도 아니다" }
}

규칙표 -> 바깥
바깥 -> 읽는법
읽는법 -> 경고

읽는법: {
  label: "도입 규칙은 결론에 그 연결자가 있고, 제거 규칙은 전제에 그 연결자가 있다.\n그래서 규칙을 고를 때 볼 것은 5장의 주연결자다 — 얻으려는 식의 주연결자를 보면 도입 규칙이,\n손에 든 식의 주연결자를 보면 제거 규칙이 나온다. 8장의 전략이 이 관찰 위에 선다"
  shape: text
}

경고: {
  label: "IP 를 눈여겨보라. 나머지 열두 규칙은 연결자 하나의 뜻을 풀어 쓴 것이지만 IP 는 그렇지 않다.\n이 규칙 하나가 고전 논리를 만들고, 이것을 빼면 19장의 직관주의 논리가 된다"
  shape: text
  style.bold: true
}
