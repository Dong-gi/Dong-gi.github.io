# ⊢ 와 ⊨ — 두 기호는 서로 다른 정의를 가진다 — 논리학 7장.
#
# 무엇을 읽어야 하나: 두 상자 사이에 아직 화살표가 없다는 것.
# 정의가 서로를 한 글자도 참조하지 않으므로 둘이 일치할 까닭이 지금은 없다.
# 그 화살표를 놓는 것이 13장과 14장이다.
direction: down

문법: {
  label: "5장 — 문법. 두 층이 함께 딛고 선 바닥"
  적형식: { label: "적형식이 무엇인지만 정한다.\n여기까지는 참도 거짓도 도출도 없다" }
}

증명층: {
  label: "7장 — 증명 체계"
  style.bold: true
  정의: { label: "Γ ⊢ φ 의 정의\n열린 가정이 전부 Γ 안에 있고\n마지막 줄이 φ 인 도출이 있다" }
  재료: { label: "쓰는 것 — 규칙 열세 개, 줄, 가정의 범위" }
  확인: { label: "확인하는 법 — 도출 한 벌을 내놓는다.\n하나 내놓으면 끝난다" }
  정의 -> 재료
  정의 -> 확인
}

의미층: {
  label: "6장 — 의미론"
  style.bold: true
  정의: { label: "Γ ⊨ φ 의 정의\nΓ 를 모두 참으로 만드는 배당이\n전부 φ 도 참으로 만든다" }
  재료: { label: "쓰는 것 — 배당, 진리함수, 진리표" }
  확인: { label: "확인하는 법 — 배당 전부를 훑는다.\n아님을 보이려면 반례 하나면 끝난다" }
  정의 -> 재료
  정의 -> 확인
}

문법 -> 증명층
문법 -> 의미층

빈자리: {
  label: "여기에 화살표가 없다"
  style.bold: true
  건전: { label: "Γ ⊢ φ 이면 Γ ⊨ φ 인가 — 건전성. 13장" }
  완전: { label: "Γ ⊨ φ 이면 Γ ⊢ φ 인가 — 완전성. 14장" }
}

증명층 -> 빈자리
의미층 -> 빈자리

경고: {
  label: "그러므로 7장 안에서는 두 기호를 섞어 쓸 수 없다.\n‘⊢ 이니까 ⊨ 다’ 라고 적는 순간 아직 증명하지 않은 정리를 쓴 것이 된다.\n도출에서 진리표를 꺼내지 않고, 진리표에서 규칙 이름을 꺼내지 않는다"
  shape: text
  style.bold: true
}

셈: {
  label: "두 기호가 같은 것을 가리킨다는 것이 밝혀져도 두 기호를 하나로 합치지는 않는다.\n일치는 정리이지 정의가 아니고, 술어논리(9~11장)에서 같은 물음을 다시 물어야 하며,\n19장의 체계처럼 둘이 갈라지는 경우도 있기 때문이다"
  shape: text
}
