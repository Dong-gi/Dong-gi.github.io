# 표현 가능성 — 두 층이 만난다. 논리학 17장.
#
# 무엇을 읽어야 하나: 가로로 읽어라. 왼쪽 칸은 5장이 메타언어라고 못 박은
# 말들이고, 오른쪽 칸은 산술의 언어로 적힌 대상언어의 식이다. 줄 하나하나가
# 표현 가능성 정리가 해 주는 일이고, 이 장에서 우리가 인용만 하는 부분이다.
direction: down

층: {
  label: "메타언어의 말이 산술의 식으로 내려온다 — 줄마다 가로로 읽는다"
  style.bold: true
  grid-rows: 5
  grid-columns: 3
  grid-gap: 8

  머리1: { label: "① 메타언어\n우리가 체계에 대해 하는 말"; style.bold: true }
  머리2: { label: "② 산술화\n번호를 붙인다"; style.bold: true }
  머리3: { label: "③ 표현 가능성 정리\n0, S, +, × 만으로 적은 대상언어의 식"; style.bold: true }

  m1: { label: "이 기호열은 적형식이다" }
  n1: { label: "기호열 ↦ 수" }
  o1: { label: "Fml(x)" }

  m2: { label: "이 목록은 T 에서의 도출이다" }
  n2: { label: "도출(문장 목록) ↦ 수" }
  o2: { label: "Prf(y, x)   — 아래첨자 T 는 줄여 적는다" }

  m3: { label: "이 식에 이 이름을 대입한 결과는 저 식이다" }
  n3: { label: "대입 ↦ 수에서 수로 가는 계산" }
  o3: { label: "Sub(x, y, z)" }

  m4: { label: "φ 는 T 에서 도출된다" }
  n4: { label: "‘도출이 있다’ ↦ ‘그런 수가 있다’" }
  o4: { label: "Prov(x)  =  ∃y Prf(y, x)" }
}

힘든곳: {
  label: "왜 힘든가: 산술의 언어에는 수열도, 목록도, ‘i 번째 원소’ 도 없다.\n그런 것을 전부 0 과 S 와 + 와 × 만으로 만들어 내야 한다.\n괴델의 β 함수가 그 다리를 놓는다 — 이 장은 결과만 쓴다"
  shape: text
  style.bold: true
}
층 -> 힘든곳: "가장 힘든 기술적 부분"
