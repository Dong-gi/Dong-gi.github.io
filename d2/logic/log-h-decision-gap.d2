# 진리표가 있는 쪽과 없는 쪽 — 논리학 10장.
#
# 무엇을 읽어야 하나: 위 칸 왼쪽 기둥은 유한에서 끝나고 오른쪽 기둥은 어디서도
# 끝나지 않는다. 아래에서 빠져나갈 길 둘을 닫고 나면 남는 것은 물음 하나이고,
# 그 물음이 16장의 제목이다.
direction: down

비교: {
  label: "갈라지는 자리 — ‘상황 하나’ 를 무엇으로 잡는가"
  style.bold: true
  direction: right

  명제: {
    label: "명제논리 — 6장"
    style.bold: true
    direction: down

    상황1: { label: "상황 하나 = 배당 v\n문장문자마다 T 나 F" }
    개수1: { label: "문장문자가 n 개면\n배당은 2ⁿ 개. 유한하다" }
    판정1: { label: "전부 훑으면 끝난다 = 진리표\n명제논리는 결정 가능하다.\n대가는 시간뿐이라 n 이 열 늘면\n천 배 느려질 뿐이다" }

    상황1 -> 개수1 -> 판정1
  }

  술어: {
    label: "술어논리 — 10장"
    style.bold: true
    direction: down

    상황2: { label: "상황 하나 = 모형 ℳ = ⟨D, I⟩\n정의역 D 를 먼저 고르고\n그 위에서 상수와 술어를 해석한다" }
    개수2: { label: "D 의 크기에 상한이 없다.\n크기를 정해도 그 위의\n해석이 또 여럿이다" }
    판정2: {
      label: "전부 훑는다는 말이 뜻을 잃는다\n진리표에 해당하는 것이 없다"
      style.bold: true
    }

    상황2 -> 개수2 -> 판정2
  }
}

막다른: {
  label: "빠져나갈 길을 둘 찾아보고 둘 다 닫는다"
  style.bold: true
  direction: right

  길1: { label: "유한한 D 만 보면 되지 않는가\n안 된다. 유한 모형이 하나도 없고\n무한 모형만 갖는 식이 있다.\n유한만 훑으면 그런 식을\n만족가능하지 않다고 잘못 판정한다" }
  길2: { label: "크기 k 까지만 보면 되지 않는가\n안 된다. 어떤 k 를 정해도\n크기 k 이하에서는 모두 참인데\n더 큰 모형에서 거짓이 되는\n식을 만들 수 있다" }
}

남은물음: {
  label: "그래도 판정 절차가 있기는 한가\n모형을 훑는 것 말고 다른 방법으로, 어떤 식이\n논리적 참인지 유한 단계에 답하는 기계가 있는가"
  shape: oval
  style.bold: true
}

답: {
  label: "답은 16장에 있고, 없다는 쪽이다.\n다만 절반은 된다 — 논리적 참인 것은 언제나 유한 단계에 찾아낼 수 있다.\n그 절반을 만드는 것이 11장의 증명 체계이고, 그것이 정말 의미론과 맞는지가 13장과 14장이다"
  shape: text
}

비교 -> 막다른: "진리표를 잃었다"
막다른 -> 남은물음: "둘 다 막혔다"
남은물음 -> 답
