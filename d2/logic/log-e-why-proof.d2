# 같은 물음에 답하는 두 길 — 논리학 7장.
#
# 무엇을 읽어야 하나: 두 길이 답하는 물음은 같은데 값이 다르다.
# 왼쪽은 문장문자 개수에 끌려 커지고 오른쪽은 논증의 모양에만 끌려 커진다.
# 그리고 왼쪽 끝에는 남에게 건넬 것이 남지 않는다.
direction: right

물음: {
  label: "Γ 에서 φ 가 따라 나오는가"
  shape: oval
  style.bold: true
}

의미론길: {
  label: "6장의 길 — 배당을 전부 훑는다"
  style.bold: true
  훑기: { label: "문장문자가 n 개면\n배당이 2ⁿ 개" }
  확인: { label: "전제가 전부 T 인 줄마다\n결론도 T 인지 본다" }
  답: { label: "그런 줄이 없다 → 귀결이다" }
  훑기 -> 확인 -> 답
}

증명길: {
  label: "7장의 길 — 규칙을 이어 붙인다"
  style.bold: true
  시작: { label: "전제에서 출발한다" }
  규칙: { label: "규칙을 한 번 쓸 때마다\n줄이 하나 늘어난다" }
  끝: { label: "결론이 적힌 줄에 이르면 끝" }
  시작 -> 규칙 -> 끝
}

물음 -> 의미론길
물음 -> 증명길

의미론값: {
  label: "문자 20 개면 100 만 줄, 30 개면 10 억 줄.\n논증이 아무리 단순해도 줄 수는 줄지 않는다"
}
증명값: {
  label: "줄 수는 논증의 모양이 정한다.\n6장에서 열아홉 단계로 끝낸 그 논증은\n문자가 20 개여도 스무 줄쯤이다"
}

의미론길 -> 의미론값
증명길 -> 증명값

의미론남는것: {
  label: "손에 남는 것 — ‘어긋나는 줄이 없었다’\n확인 과정을 남에게 건넬 수 없다"
}
증명남는것: {
  label: "손에 남는 것 — 종이 한 장.\n줄마다 근거가 적혀 있어 남이 그대로 검사할 수 있다"
  style.bold: true
}

의미론값 -> 의미론남는것
증명값 -> 증명남는것

주의: {
  label: "두 길이 같은 답을 준다는 보장은 아직 없다.\n왼쪽이 인정하는 것을 오른쪽이 전부 잡아내는가, 오른쪽이 얻는 것이 왼쪽에서도 참인가 —\n이 두 물음이 13장(건전성)과 14장(완전성)이다. 7장은 오른쪽 길을 놓기만 한다"
  shape: text
}
