# 적형식을 만들어 가는 구성열 — 논리학 5장.
#
# 무엇을 읽어야 하나: 위에서 아래로 내려가는 여섯 줄이 정의의 조항을 여섯 번 적용한 이력이다.
# 재료는 반드시 위쪽 줄에서만 오고, 이 목록 자체가 ‘맨 아래 것이 적형식이다’ 의 증거다.
direction: down

기저1: { label: "① P\n기저 조항"; style.bold: true }
기저2: { label: "② Q\n기저 조항"; style.bold: true }
기저3: { label: "③ R\n기저 조항"; style.bold: true }

곱: { label: "④ (P ∧ Q)\n① 과 ② 에 ∧ 조항"; style.bold: true }
부정: { label: "⑤ ¬R\n③ 에 ¬ 조항"; style.bold: true }
전체: { label: "⑥ ((P ∧ Q) → ¬R)\n④ 와 ⑤ 에 → 조항"; style.bold: true }

기저1 -> 곱: "왼쪽 재료"
기저2 -> 곱: "오른쪽 재료"
기저3 -> 부정: "유일한 재료"
곱 -> 전체: "왼쪽 재료"
부정 -> 전체: "오른쪽 재료"

읽기: {
  label: "적형식임을 보이는 방법은 하나다 —\n기저에서 출발해 조항을 유한 번 적용한\n목록을 내놓는 것이다. 목록의 각 줄은\n문장문자이거나, 위쪽 줄들을 재료로\n조항 하나를 쓴 결과여야 한다"
  shape: text
}

괄호: {
  label: "괄호가 붙는 자리를 보라. ④ 와 ⑥ 은\n이항 조항이 만들었으므로 바깥에 괄호가\n한 쌍 있고, ⑤ 는 ¬ 조항이 만들었으므로\n없다. 폐포 조항은 이런 목록을 가진 것만이\n적형식이라고 말한다 — 배제의 근거다"
  shape: text
}
