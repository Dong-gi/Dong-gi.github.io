# 도출을 검사하는 절차 — 논리학 7장.
#
# 무엇을 읽어야 하나: 검사에는 진리값이 한 번도 나오지 않는다.
# 줄마다 묻는 것은 둘뿐이고 둘 다 모양만 보면 답이 나온다.
# 그래서 도출은 뜻을 모르는 사람도, 기계도 검사할 수 있다.
direction: down

줄: {
  label: "도출의 줄 하나"
  style.bold: true
  번호: { label: "줄 번호\n위에서부터 1, 2, 3 …" }
  식: { label: "논리식 하나\n5장의 적형식이어야 한다" }
  근거: { label: "근거 하나\n전제 / 가정 / 규칙 이름과 인용한 줄 번호" }
}

물음1: { label: "물음 하나 — 근거가 규칙의 모양과 맞는가"; style.bold: true }
물음2: { label: "물음 둘 — 인용한 줄이 지금 손닿는 범위에 있는가"; style.bold: true }

줄 -> 물음1
물음1 -> 물음2: "맞으면 다음 물음으로"

맞음1: {
  label: "예: 근거가 ‘3, 7 →E’ 라면\n7 번 줄이 3 번 줄의 전건과 같은 식인지,\n이 줄이 3 번 줄의 후건과 같은 식인지 본다"
}
맞음2: {
  label: "인용한 줄이 이미 닫힌 범위 안에 있으면 안 된다.\n닫힌 범위 안의 줄은 밖에서 없는 것과 같다"
}
물음1 -> 맞음1
물음2 -> 맞음2

통과: { label: "모든 줄이 두 물음을 통과하면\n그 도출은 옳은 도출이다"; style.bold: true }
물음2 -> 통과: "맞으면"

실패: { label: "한 줄이라도 걸리면 도출이 아니다.\n걸린 줄 하나를 짚어 보이면 반박이 끝난다" }
물음1 -> 실패: "어긋나면"
물음2 -> 실패: "어긋나면"

없는것: {
  label: "이 절차에 없는 것을 보라 — 진리값, 배당, 진리표.\n검사하는 사람은 P 가 무엇을 뜻하는지 몰라도 되고 알 필요도 없다.\n5장이 문법을 모양만으로 정한 것과 같은 규율이 여기서도 지켜진다"
  shape: text
}

값: {
  label: "이것이 6장과 갈리는 자리다. 진리표를 다 채운 사람은 ‘어긋나는 줄이 없었다’ 만 손에 쥐지만,\n도출을 적은 사람은 남이 줄 단위로 다시 검사할 수 있는 종이를 손에 쥔다.\n증명이 설득의 도구가 되는 것은 검사가 이렇게 값싸기 때문이다"
  shape: text
}
