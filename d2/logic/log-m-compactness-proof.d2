# 컴팩트성 증명은 왜 이렇게 짧은가 — 논리학 15장.
#
# 무엇을 읽어야 하나: 가운데 사슬의 네 걸음 가운데 새로 만든 것은 하나도 없다는 것.
# 완전성(14장), 도출의 유한성(7장), 건전성(13장)을 차례로 쓸 뿐이고, 정작 무한을
# 유한으로 바꾸는 일은 가운데 한 걸음이 혼자 한다.
direction: down

정리: {
  label: "컴팩트성 정리 — Γ 의 모든 유한 부분집합이 모형을 가지면 Γ 자체도 모형을 갖는다"
  style.bold: true
}

뒤집기: {
  label: "곧바로는 손댈 데가 없다. 대우로 뒤집는다"
  style.bold: true
  grid-rows: 1
  grid-columns: 2
  grid-gap: 8

  원래: { label: "원래 진술\n유한 부분집합이 모두 만족가능\n→ Γ 가 만족가능" }
  대우: { label: "대우\nΓ 가 만족가능하지 않다\n→ 만족가능하지 않은 유한 부분집합이 하나 있다"; style.bold: true }
}

사슬: {
  label: "네 걸음. 새로 만든 것은 하나도 없다"
  style.bold: true
  grid-rows: 4
  grid-columns: 3
  grid-gap: 8

  머리1: { label: "걸음"; style.bold: true }
  머리2: { label: "무엇을 쓰는가"; style.bold: true }
  머리3: { label: "얻는 것"; style.bold: true }

  일1: { label: "1"; style.bold: true }
  일2: { label: "Γ 에 모형이 없다 = Γ 를 참으로 만드는 모형이 하나도 없다.\n그러면 Γ ⊨ ⊥ 이 공허하게 성립한다" }
  일3: { label: "Γ ⊨ ⊥" }

  이1: { label: "2"; style.bold: true }
  이2: { label: "14장 완전성 — ⊨ 로 성립하는 것은 ⊢ 로도 얻어진다" }
  이3: { label: "Γ ⊢ ⊥" }

  삼1: { label: "3"; style.bold: true }
  삼2: { label: "7장 도출의 유한성 — 도출은 줄의 유한한 목록이므로\n전제로 인용된 것도 유한 개뿐이다. 그 유한 개를 Δ 라 한다"; style.bold: true }
  삼3: { label: "Δ ⊆ Γ 가 유한하고 Δ ⊢ ⊥"; style.bold: true }

  사1: { label: "4"; style.bold: true }
  사2: { label: "13장 건전성 — ⊢ 로 얻은 것은 ⊨ 로도 성립한다" }
  사3: { label: "Δ ⊨ ⊥ 이므로 Δ 에 모형이 없다" }
}

결론: {
  label: "모형 없는 유한 부분집합 Δ 를 실제로 찾았다. 대우가 증명되었으므로 정리도 증명되었다"
  style.bold: true
}

지목: {
  label: "일하는 걸음은 3 번 하나뿐이다.\n1 · 2 · 4 는 두 다리를 건너는 것이고, 무한한 Γ 를 유한한 Δ 로 줄이는 일은 ‘도출은 유한하다’ 가 혼자 한다.\n증명이 짧은 것은 요행이 아니라 앞의 세 장이 미리 값을 치러 두었기 때문이다"
  shape: text
  style.bold: true
}

정리 -> 뒤집기
뒤집기 -> 사슬: "Γ 가 만족가능하지 않다고 두고 시작한다"
사슬 -> 결론
결론 -> 지목
