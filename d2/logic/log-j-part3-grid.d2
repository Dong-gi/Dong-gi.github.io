# 3부가 끝나면 격자가 다 찬다 — 논리학 12장.
#
# 무엇을 읽어야 하나: 위 격자에 빈 칸이 없다는 것과, 격자의 세로줄 셋이
# 지금까지 서로 만난 적이 없다는 것. 13장부터 하는 일은 칸을 더 채우는 것이
# 아니라 세로줄 사이에 다리를 놓는 것이다.
direction: down

격자: {
  label: "3부가 끝나면 채워지는 격자 — 아홉 칸에 빈 곳이 없다"
  style.bold: true
  grid-rows: 4
  grid-columns: 4
  grid-gap: 8

  빈칸: { label: ""; style.opacity: 0 }
  머리1: { label: "문법 — 무엇을 적을 수 있는가"; style.bold: true }
  머리2: { label: "의미론 — 그것이 무엇을 말하는가"; style.bold: true }
  머리3: { label: "증명 체계 — 어떻게 이어 붙이는가"; style.bold: true }

  줄1: { label: "명제논리"; style.bold: true }
  칸11: { label: "5장 — 적형식 세 조항\n주연결자, 파스 트리" }
  칸12: { label: "6장 — 배당 v, 진리표\nv ⊨ φ,  Γ ⊨ φ" }
  칸13: { label: "7장 · 8장 — 규칙 열셋\nΓ ⊢ φ,  가정과 방출" }

  줄2: { label: "술어논리"; style.bold: true }
  칸21: { label: "9장 — 항 · 원자식 · 한정사\n자유와 속박, 대입 φ[a/x]" }
  칸22: { label: "10장 — 모형 ℳ = ⟨D, I⟩\n배정 g, 만족 조항 아홉" }
  칸23: { label: "11장 — 한정사 규칙 넷\n∀I ∀E ∃I ∃E 와 변수 조건" }

  줄3: { label: "동일성"; style.bold: true }
  칸31: { label: "12장 — 원자식 조항 하나\nt₁ = t₂" }
  칸32: { label: "12장 — 만족 조항 하나\n해석이 고정된다" }
  칸33: { label: "12장 — 규칙 둘\n=I 와 =E" }
}

관찰: {
  label: "빈 칸이 없다. 그리고 세로줄 셋은 아직 서로 만난 적이 없다 —\n⊢ 로 얻은 것이 ⊨ 로도 성립하는지, 그 반대는 어떤지 우리는 한 번도 묻지 않았다.\n지금까지 우리는 체계 안에서 일했다. 식을 적고, 모형을 만들고, 도출을 찾았다"
  shape: text
  style.bold: true
}

다음: {
  label: "13장부터는 체계 밖에 서서 체계를 대상으로 삼는다"
  style.bold: true
  grid-rows: 1
  grid-columns: 3
  grid-gap: 8

  건전: { label: "13장 건전성\nΓ ⊢ φ 이면 Γ ⊨ φ\n증명한 것은 참이다" }
  완전: { label: "14장 완전성\nΓ ⊨ φ 이면 Γ ⊢ φ\n참인 것은 증명된다" }
  한계: { label: "15 · 16 · 17장 — 두 다리가 놓이고 나서\n무엇을 잃었는지 센다.\n비표준 모형, 결정불가능성, 불완전성" }
}

격자 -> 관찰
관찰 -> 다음: "층이 바뀐다"
