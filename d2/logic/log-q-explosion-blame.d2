# 폭발은 어디서 오는가 — 루이스 논증과 그것을 막는 두 갈래 — 논리학 19장.
#
# 무엇을 읽어야 하나: 가운데 네 줄이 ⊥E 를 한 번도 쓰지 않고 폭발을 만든다는 것.
# 그러므로 ⊥E 만 빼서는 폭발이 멈추지 않는다. 어느 걸음을 버릴지 골라야 한다.
direction: down

불만: {
  label: "불만 — 결론이 전제와 상관이 없다"
  style.bold: true
  grid-rows: 1
  grid-columns: 2
  grid-gap: 10
  예: { label: "‘달은 치즈로 되어 있고 치즈로 되어 있지 않다.\n그러므로 오늘 비가 온다’\n\n고전 논리에서 이 논증은 타당하다.\n전제가 만족가능하지 않으므로 정의에 걸린다" }
  두층: { label: "6장 — 만족가능하지 않은 집합은\n무엇이든 귀결로 갖는다\n\n7장 — ⊥E, ⊥ 에서 무엇이든\n\n두 장 모두 ‘이상하게 느껴지는 것이 정상’ 이라고 적었다" }
}

루이스: {
  label: "루이스 논증 — ⊥ 를 한 번도 쓰지 않고 폭발이 나온다"
  style.bold: true
  grid-rows: 1
  grid-columns: 4
  grid-gap: 8
  s1: { label: "1. φ\n전제" }
  s2: { label: "2. ¬φ\n전제" }
  s3: { label: "3. φ ∨ ψ\n1 에 ∨I" }
  s4: { label: "4. ψ\n3, 2 에 선언 삼단논법"; style.bold: true }
}
불만 -> 루이스: "그래서 ⊥E 만 빼 보면"

주: {
  label: "네 줄 어디에도 ⊥ 가 없다. 쓴 것은 ∨I 와 선언 삼단논법 둘뿐이다.\n그러므로 규칙 목록에서 ⊥E 만 지운다고 폭발이 멈추지 않는다"
  shape: text
  style.bold: true
}
루이스 -> 주

선택: {
  label: "폭발을 막으려면 셋 가운데 적어도 하나를 버려야 한다"
  style.bold: true
  grid-rows: 1
  grid-columns: 3
  grid-gap: 8
  a: { label: "⊥E 를 버린다\n\n최소 논리가 된다.\n그러나 위의 루이스 논증이 남는다" }
  b: { label: "∨I 를 버린다\n\n택하기 어렵다.\n이것 없이는 ∨ 를 만들 방법이 없다"; style.stroke-dash: 4 }
  c: { label: "선언 삼단논법을 버린다\n\n대부분의 갈래가 이쪽이다.\nφ 하나로 만든 φ ∨ ψ 는\nψ 에 대해 아무 정보도 담지 않는다"; style.bold: true }
}
주 -> 선택

갈래: {
  label: "두 갈래 — 이름과 문제의식만"
  style.bold: true
  grid-rows: 1
  grid-columns: 2
  grid-gap: 10
  관련성: { label: "관련성 논리\n\n변수 공유 — φ → ψ 가 정리이려면\nφ 와 ψ 가 문장문자를 공유해야 한다.\n(P ∧ ¬P) → Q 도 P → (Q → P) 도 걸러진다" }
  준일관: { label: "준일관 논리\n\n비일관적인 집합에서도\n모든 것을 도출하지는 않는다.\n부딪히는 법 조항, 어긋난 데이터베이스,\n아직 정리되지 않은 과학 이론" }
}
선택 -> 갈래
