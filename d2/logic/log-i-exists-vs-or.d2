# ∃E 와 ∨E 는 같은 모양이다 — 논리학 11장.
#
# 무엇을 읽어야 하나: 두 기둥의 문장이 낱말만 다르고 짜임이 같다. ∨ 는 갈래가
# 둘이라 셀 수 있었고 ∃ 는 갈래가 D 의 원소 수만큼이라 셀 수 없다. 그 하나의
# 차이가 임시 이름과 변수 조건을 낳는다.
direction: down

나란히: {
  label: "같은 짜임을 두 번 — 낱말만 바꾼다"
  style.bold: true
  grid-columns: 2
  grid-gap: 12

  논리합: {
    label: "∨E — 7장"
    style.bold: true
    direction: down

    손: { label: "손에 든 것\nφ ∨ ψ\n어느 쪽인지는 모른다" }
    갈래: { label: "갈래를 연다\nφ 를 가정한 갈래 하나\nψ 를 가정한 갈래 하나" }
    같은결론: { label: "두 갈래가 같은 χ 에 이르면\nχ 를 적고 두 가정을 방출한다" }
    대가: { label: "갈래가 둘뿐이라 다 적을 수 있다\n조건이 붙지 않는다" }

    손 -> 갈래 -> 같은결론 -> 대가
  }

  존재: {
    label: "∃E — 11장"
    style.bold: true
    direction: down

    손2: { label: "손에 든 것\n∃x φ\n어느 것인지는 모른다" }
    갈래2: { label: "갈래를 연다 — 하나뿐이다\nφ[c/x] 를 가정한 갈래.\nc 는 ‘그 무엇인지 모르는 것’ 에\n임시로 붙인 이름이다" }
    같은결론2: { label: "그 갈래가 ψ 에 이르면\nψ 를 적고 가정을 방출한다" }
    대가2: {
      label: "갈래가 D 의 원소 수만큼이라 다 적을 수 없다.\n그래서 갈래 하나로 전부를 대신한다.\n대신하려면 그 갈래가 c 에 대해 특별한 것을\n하나도 쓰지 않았어야 하고, 그것이 변수 조건이다"
      style.bold: true
    }

    손2 -> 갈래2 -> 같은결론2 -> 대가2
  }
}

정리: {
  label: "∨ 도 ∃ 도 ‘있기는 한데 어느 것인지 모른다’ 를 말한다. 둘을 쓰는 방법은 하나뿐이다 —\n모르는 채로 경우를 나누고, 어느 경우든 같은 결론에 이르렀음을 보이는 것.\n∃ 는 경우가 유한하지 않아 이름 하나로 대표시키고, 그 대표가 진짜 대표인지 확인하는 절차가 변수 조건이다"
  shape: text
  style.bold: true
}

나란히 -> 정리
