# 한정사 규칙 넷 — 재료와 결과와 조건 — 논리학 11장.
#
# 무엇을 읽어야 하나: 7장의 표와 같은 자리 채우기다. 한정사마다 도입과 제거가
# 하나씩이고, 조건 칸이 비어 있는 둘과 차 있는 둘로 갈린다. 갈리는 기준은
# 규칙 이름이 아니라 ‘이름을 내가 고르는가, 아무 것이어도 되어야 하는가’ 다.
direction: down

규칙표: {
  grid-rows: 5
  grid-columns: 4
  grid-gap: 8

  머리1: { label: "규칙"; style.bold: true }
  머리2: { label: "재료"; style.bold: true }
  머리3: { label: "결과"; style.bold: true }
  머리4: { label: "변수 조건"; style.bold: true }

  전칭제거: { label: "∀E — 전칭 예화" }
  전칭제거재료: { label: "∀x φ" }
  전칭제거결과: { label: "φ[a/x]\na 는 아무 개체상수나" }
  전칭제거조건: { label: "없다" }

  존재도입: { label: "∃I — 존재 일반화" }
  존재도입재료: { label: "φ[a/x]" }
  존재도입결과: { label: "∃x φ" }
  존재도입조건: { label: "없다" }

  전칭도입: { label: "∀I — 전칭 일반화" }
  전칭도입재료: { label: "φ[c/x]" }
  전칭도입결과: { label: "∀x φ" }
  전칭도입조건: {
    label: "c 가 열린 가정에 없고\n결과 ∀x φ 에도 없다"
    style.bold: true
  }

  존재제거: { label: "∃E — 존재 예화" }
  존재제거재료: { label: "∃x φ, 그리고\nφ[c/x] 를 가정해\nψ 에 이르는 갈래" }
  존재제거결과: { label: "ψ\n가정 φ[c/x] 를 방출한다" }
  존재제거조건: {
    label: "c 가 열린 가정에 없고\n∃x φ 에도 ψ 에도 없다"
    style.bold: true
  }
}

가르는것: {
  label: "조건이 붙고 안 붙고를 가르는 것"
  style.bold: true
  grid-columns: 2
  grid-gap: 10

  내가고른다: {
    label: "위 둘 — 이름을 내가 고른다\n\n∀E 는 ‘모두에게 성립하니 이 이름에도’ 이고\n∃I 는 ‘이 이름에 성립하니 어떤 것이 있다’ 다.\n고른 이름에 대해 무엇을 알든 상관없다.\n그래서 살펴볼 곳이 없다"
  }
  아무것: {
    label: "아래 둘 — 이름이 아무 것이어도 되어야 한다\n\n∀I 는 ‘아무 것에 성립하니 모두에게’ 이고\n∃E 는 ‘무엇인지 모르는 하나를 임시로 c 라 부르자’ 다.\n둘 다 c 에 대해 우리가 따로 아는 것이 하나도 없어야 말이 된다.\n그 ‘아는 것이 없다’ 를 문법으로 옮긴 것이 변수 조건이다"
    style.bold: true
  }
}

요령: {
  label: "∀I 나 ∃E 를 쓸 때마다 도출 어디에도 없던 새 이름을 만들어 쓰면 조건이 저절로 통과된다.\n조건을 실제로 따지는 일은 남의 도출을 검사할 때 남는다"
  shape: text
}

규칙표 -> 가르는것
가르는것 -> 요령
