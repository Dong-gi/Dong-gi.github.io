# 막혔을 때 무엇을 먼저 확인하는가 — 논리학 8장.
#
# 무엇을 읽어야 하나: IP 는 맨 아래에 있다. 위의 네 관문을 다 지나기 전에는
# 꺼내지 않는다. 위쪽 수는 목표를 작게 만들지만 IP 는 목표를 ⊥ 으로 바꿔 놓기만
# 하고 무엇을 향해 갈지는 알려 주지 않기 때문이다.
direction: down

시작: {
  label: "막혔다 — 다음 줄에 무엇을 쓸지 모르겠다"
  style.bold: true
  shape: oval
}

관문1: { label: "1. 목표에 주연결자가 남아 있는가\n남아 있으면 그 도입 규칙으로 목표를 더 쪼갠다"; style.bold: true }
관문2: { label: "2. 전제에서 공짜로 꺼낼 것이 남았는가\n∧E 와 ↔E 는 언제나 안전하다. ¬¬ 는 벗겨 둔다" }
관문3: { label: "3. 전제 가운데 →  나 ↔ 의 앞부분을\n이미 손에 쥐고 있는가 — 있으면 →E" }
관문4: { label: "4. 전제에 ∨ 가 있는가\n있으면 ∨E 로 경우를 나눈다. 두 갈래 모두 지금 목표를 향한다" }
아이피: { label: "5. IP\n¬(목표) 를 가정하고 ⊥ 을 찾는다"; style.bold: true; style.stroke-width: 2 }

시작 -> 관문1
관문1 -> 관문2: "없다"
관문2 -> 관문3: "다 꺼냈다"
관문3 -> 관문4: "없다"
관문4 -> 아이피: "없다"

풀림1: { label: "목표가 작아졌다 — 처음으로 돌아간다"; shape: oval }
관문1 -> 풀림1: "있다"
관문2 -> 풀림1: "있다"
관문3 -> 풀림1: "있다"
관문4 -> 풀림1: "있다"

왜뒤: {
  label: "IP 가 마지막인 이유 — 앞의 네 수는 목표를 작게 만든다.\nIP 는 가정 하나를 얹고 목표를 ⊥ 으로 바꿀 뿐이라\n무엇과 무엇을 부딪쳐야 하는지는 여전히 스스로 찾아야 한다"
  shape: text
}
