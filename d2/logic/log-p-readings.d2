# □ 를 읽는 방식이 여럿이다. 논리학 18장.
#
# 무엇을 읽어야 하나: 줄마다 가로로 읽어라. 문법과 의미론은 다섯 줄이 전부 같다.
# 갈리는 것은 W 가 무엇의 모임인지, R 이 무슨 관계인지, 그리고 그 결과로
# 어느 공리를 받아들이는지뿐이다. 마지막 칸의 ‘버리는 것’ 이 이 표의 요점이다.
direction: down

읽기: {
  label: "같은 □, 같은 진리 조항 — 다른 W · R · 공리"
  style.bold: true
  grid-rows: 6
  grid-columns: 4
  grid-gap: 8

  h1: { label: "읽기"; style.bold: true }
  h2: { label: "□φ 를 어떻게 읽는가"; style.bold: true }
  h3: { label: "세계 W 와 접근관계 R"; style.bold: true }
  h4: { label: "받아들이는 공리 / 버리는 공리"; style.bold: true }

  a1: { label: "알레틱\n(양상 본래의 뜻)" }
  a2: { label: "필연적으로 φ\n◇φ 는 φ 일 수 있다" }
  a3: { label: "W = 있을 수 있는 상황 전체\nR = 저기서 보아 여기가 있을 법하다" }
  a4: { label: "보통 S5.\n필연이면 실제로 그렇다 — T 를 받는다" }

  b1: { label: "인식\n(안다 / 모른다)" }
  b2: { label: "그 사람은 φ 를 안다\n◇φ 는 φ 를 배제하지 못한다" }
  b3: { label: "W = 그 사람이 배제하지 못한 상황\nR = 그 상황과 지금이 구별되지 않는다" }
  b4: { label: "T 는 지식의 사실성.\n믿음으로 읽으면 T 를 버리고 D 만 남긴다" }

  c1: { label: "의무\n(해야 / 해도)"; style.bold: true }
  c2: { label: "φ 해야 한다\n◇φ 는 φ 해도 된다" }
  c3: { label: "W = 규범이 지켜진 상황\nR = 저 상황은 여기서 보아 이상적이다" }
  c4: { label: "T 를 반드시 버린다 — 해야 한다고 그런 것은 아니다.\n대신 D: 의무는 서로 모순되지 않는다"; style.bold: true }

  d1: { label: "시제\n(항상 / 언젠가)" }
  d2: { label: "앞으로 늘 φ 다\n◇φ 는 언젠가 φ 다" }
  d3: { label: "W = 시각\nR = 나중이다" }
  d4: { label: "4 를 받는다 — 나중의 나중은 나중이다.\nT 는 ‘지금 포함’ 으로 읽을 때만" }

  e1: { label: "증명 가능성\n(17장의 다리)"; style.bold: true }
  e2: { label: "T 에서 φ 가 증명된다\n= Prov(⌜φ⌝)" }
  e3: { label: "W = 이론의 세계들\nR = 증명력이 한 단계 줄어드는 방향" }
  e4: { label: "T 를 버린다 — 증명 가능하다고 참인 것을 T 가 증명하지는 못한다.\n대신 뢰브 공리 □(□φ → φ) → □φ. 이 체계를 GL 이라 한다"; style.bold: true }
}

요점: {
  label: "‘어느 것이 옳은 양상논리인가’ 는 잘못된 물음이다.\n무엇을 읽으려는가가 R 을 정하고, R 이 공리를 정한다.\n앞 그림의 대응표가 그 사이를 이어 주는 다리다"
  shape: text
  style.bold: true
}
읽기 -> 요점
