# 두 다리가 놓였다 — 그리고 놓이지 않은 것 — 논리학 14장.
#
# 무엇을 읽어야 하나: 위 상자 두 개 사이에 화살표가 양쪽으로 놓였다는 것과,
# 그런데도 아래 상자가 여전히 비어 있다는 것. ⊢ 와 ⊨ 가 같아져도
# 판정 절차는 생기지 않는다.
direction: down

만남: {
  label: "4부의 결론 — 두 층이 만난다"
  style.bold: true
  grid-rows: 1
  grid-columns: 3
  grid-gap: 10

  왼: { label: "Γ ⊢ φ\n도출이 하나 있다.\n확인 — 종이 한 장을 내놓는다" }
  다리: { label: "13장 건전성  ⊢ ⟹ ⊨\n14장 완전성  ⊨ ⟹ ⊢\n두 화살표가 다 놓였다"; style.bold: true }
  오: { label: "Γ ⊨ φ\n모든 모형이 그렇다.\n확인 — 모형 전부를 훑는다" }
}

따름: {
  label: "곧바로 따라 나오는 것 셋"
  grid-rows: 1
  grid-columns: 3
  grid-gap: 8

  하나: { label: "일관적 ⟺ 만족가능하다\n7장이 도출로 정의한 성질과\n6장이 배당으로 정의한 성질이\n같은 집합을 가려낸다" }
  둘: { label: "⊢ φ ⟺ ⊨ φ\n이 체계의 정리 전체가\n논리적 참 전체와 같다" }
  셋: { label: "컴팩트성\n모든 유한 부분집합이 모형을 가지면\n전체도 모형을 갖는다.\n15장이 여기서 시작한다" }
}

쓸모: {
  label: "쓸 수 있게 되는 것 — 7장과 11장이 남긴 구멍이 메워진다.\n‘ 도출이 없다 ’ 를 반례 모형 하나로 확정할 수 있고,\n‘ 귀결이다 ’ 를 도출 한 벌로 확정할 수 있다. 편한 쪽을 골라 쓴다"
  shape: text
}

빈칸: {
  label: "그런데 여기는 여전히 비어 있다"
  style.bold: true
  절차: { label: "판정 절차 — 아무 Γ 와 φ 를 받아\n언제나 유한한 시간에 예 또는 아니오를 내놓는 방법" }
  얻음: { label: "얻은 것 — 반열거. 도출을 전부 늘어놓고 하나씩 검사하면\nΓ ⊨ φ 인 경우 언젠가 반드시 찾는다" }
  못얻음: { label: "못 얻은 것 — Γ ⊭ φ 인 경우 그 절차는 영원히 멈추지 않는다.\n멈추지 않는 것과 아직 못 찾은 것을 구별할 방법이 없다" }
  절차 -> 얻음
  절차 -> 못얻음
}

예고: {
  label: "명제논리는 사정이 다르다 — 6장의 진리표가 유한한 판정 절차를 준다.\n술어논리에는 그런 절차가 없고, 없다는 것 자체가 정리다. 그것이 16장이다"
  shape: text
  style.bold: true
}

만남 -> 따름 -> 쓸모
쓸모 -> 빈칸
빈칸 -> 예고
