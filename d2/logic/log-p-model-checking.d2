# 모형 검사 — 이 장의 의미론이 그대로 도구가 되는 자리. 논리학 18장.
#
# 무엇을 읽어야 하나: 왼쪽 세로줄이 이 장에서 세운 것이고 오른쪽 세로줄이
# 실무의 이름이다. 줄마다 가로로 짝지어 읽어라. 아래 두 상자가 이 도구가
# 실제로 돌아가는 이유(결정 가능성)와 실제로 걸리는 벽(상태 폭발)이다.
direction: down

짝: {
  label: "이 장의 개념 ↔ 검증 도구의 이름"
  style.bold: true
  grid-rows: 5
  grid-columns: 2
  grid-gap: 8

  h1: { label: "18장에서 세운 것"; style.bold: true }
  h2: { label: "실무에서 부르는 이름"; style.bold: true }

  a1: { label: "세계 w ∈ W" }
  a2: { label: "시스템의 상태 — 변수 값들의 조합 하나" }

  b1: { label: "접근관계 wRu" }
  b2: { label: "한 걸음 실행하면 u 로 갈 수 있다 (전이)" }

  c1: { label: "배당 V(P) ⊆ W" }
  c2: { label: "각 상태에서 성립하는 원자 명제 (버퍼가 비었다 등)" }

  d1: { label: "ℳ, w ⊨ φ 판정"; style.bold: true }
  d2: { label: "모형 검사 — 초기 상태에서 요구사항이 성립하는가"; style.bold: true }
}

식: {
  label: "요구사항을 시제 논리 식으로 적는다"
  style.bold: true
  안전: { label: "안전성 — 나쁜 일이 결코 없다\n□(¬둘다임계구역)" }
  활성: { label: "활성 — 좋은 일이 언젠가 온다\n□(요청 → ◇허가)" }
  메모: { label: "실무의 LTL 은 □ 를 G, ◇ 를 F 로 적고\n다음 걸음 X 와 까지 U 를 더 둔다.\n기호가 다를 뿐 이 장의 □ · ◇ 와 같은 것이다"; shape: text }
}
짝 -> 식

판정: {
  label: "기계가 판정한다"
  style.bold: true
  왜됨: { label: "왜 되는가 — 결정 가능하기 때문이다.\n16장에서 술어논리는 결정 불가능했다.\n상태가 유한하면 그래프를 훑어 판정이 끝난다"; style.bold: true }
  결과: { label: "참이면 증명 끝.\n거짓이면 반례를 실행 경로로 내놓는다 —\n10장의 반례 모형이 여기서는 버그 재현 절차다" }
}
식 -> 판정

벽: {
  label: "실제로 걸리는 벽 — 상태 폭발\n변수 30개가 켜짐/꺼짐이면 상태가 2³⁰ 개다. 6장의 지수 폭발과 같은 뿌리다.\n기호적 표현과 부분 순서 축약 같은 기법이 이 벽을 미는 일을 한다"
  shape: text
  style.bold: true
}
판정 -> 벽
