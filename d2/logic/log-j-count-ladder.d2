# 수를 세는 세 가지 문장 — 논리학 12장.
#
# 무엇을 읽어야 하나: 가운데 칸의 세 줄이 각각 어느 한정사로 시작하는지 보라.
# ‘적어도’ 는 ∃ 를 쌓고 고른 것들이 서로 다르다고 요구하며, ‘많아야’ 는 ∀ 를
# 하나 더 쌓고 어딘가는 겹친다고 요구한다. ‘정확히’ 는 새 모양이 아니다.
direction: down

사다리: {
  label: "F 인 것을 세는 문장 셋"
  style.bold: true
  grid-rows: 4
  grid-columns: 3
  grid-gap: 8

  머리1: { label: "무엇을 말하려는가"; style.bold: true }
  머리2: { label: "그것을 적은 문장"; style.bold: true }
  머리3: { label: "모양의 규칙성"; style.bold: true }

  적어도이름: { label: "F 인 것이\n적어도 둘 있다"; style.bold: true }
  적어도식: { label: "∃x ∃y (Fx ∧ Fy ∧ x ≠ y)" }
  적어도규칙: { label: "세려는 만큼 ∃ 를 쌓고, 고른 것들이 서로\n다르다고 못 박는다. 적어도 n 개면 ≠ 가 n(n−1)/2 개" }

  많아야이름: { label: "F 인 것이\n많아야 둘 있다"; style.bold: true }
  많아야식: { label: "∀x ∀y ∀z ((Fx ∧ Fy ∧ Fz)\n→ (x = y ∨ x = z ∨ y = z))" }
  많아야규칙: { label: "하나 더 많게 ∀ 를 쌓아 셋을 집어 오고, 셋 중\n어딘가는 겹친다고 요구한다. 많아야 n 개면 ∀ 가 n+1 개" }

  정확히이름: { label: "F 인 것이\n정확히 둘 있다"; style.bold: true }
  정확히식: { label: "위의 두 문장을 ∧ 로 묶는다" }
  정확히규칙: { label: "새 모양이 아니다 — 적어도 n 개 ∧ 많아야 n 개" }
}

주의: {
  label: "≠ 와 = 가 하는 일이 서로 반대라는 것이 요점이다. ‘적어도’ 쪽에서 ≠ 를 빼면 두 ∃ 가 같은 점을 집을 수 있어 아무 수도 세지 못하고,\n‘많아야’ 쪽에서 = 를 빼면 후건에 넣을 것이 남지 않아 문장 자체를 적을 수 없다. 두 문장 다 동일성 없이는 쓸 수 없다"
  shape: text
  style.bold: true
}

정의역: {
  label: "F 를 지우면 정의역의 크기를 세는 문장이 된다"
  style.bold: true
  grid-rows: 1
  grid-columns: 3
  grid-gap: 8

  둘: { label: "λ₂ = ∃x ∃y  x ≠ y\n정의역에 원소가 적어도 둘 있다" }
  셋: { label: "λ₃ = ∃x ∃y ∃z (x ≠ y ∧ x ≠ z ∧ y ≠ z)\n적어도 셋 있다. ≠ 가 셋으로 늘었다" }
  일반: { label: "λₙ — 적어도 n 개.\n10장이 ‘크기 k 까지만 보면 되지 않는가’ 를 닫을 때\n쓴 문장이 이것이고, 15장이 무한 모형을 끌어내는 데\n쓰는 문장 무리도 이것이다" }
}

사다리 -> 주의
주의 -> 정의역: "F 를 지운다"
