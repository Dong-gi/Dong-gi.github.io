# ¬I 와 IP — 모양은 닮았고 성격은 다르다 — 논리학 7장.
#
# 무엇을 읽어야 하나: 두 규칙의 재료는 똑같다 — 가정 하나에서 ⊥ 를 얻는 것.
# 다른 것은 결론에 ¬ 가 붙는 자리 하나뿐인데, 그 하나가 논리 전체의 성격을 가른다.
direction: down

부정도입: {
  label: "¬I — 부정 도입"
  style.bold: true
  가정: { label: "φ 를 가정한다" }
  모순: { label: "그 범위 안에서 ⊥ 를 얻는다" }
  결론: { label: "가정을 방출하고 ¬φ 를 적는다" }
  가정 -> 모순 -> 결론
  뜻: { label: "읽기 — φ 를 놓았더니 모순이 났다.\n그러므로 φ 는 아니다"; shape: text }
}

간접증명: {
  label: "IP — 간접증명(귀류법)"
  style.bold: true
  가정: { label: "¬φ 를 가정한다" }
  모순: { label: "그 범위 안에서 ⊥ 를 얻는다" }
  결론: { label: "가정을 방출하고 φ 를 적는다" }
  가정 -> 모순 -> 결론
  뜻: { label: "읽기 — ¬φ 를 놓았더니 모순이 났다.\n그러므로 φ 다"; shape: text }
}

부정도입 -> 간접증명: "가정과 결론에서 ¬ 를 한 번씩 옮겼을 뿐"

차이: {
  label: "차이는 마지막 한 걸음이다"
  style.bold: true
  왼쪽: { label: "¬I 가 주는 것은 ¬φ 다.\n‘φ 는 성립하지 않는다’ 를 얻었을 뿐이고,\n그 말 자체가 결론이다" }
  오른쪽: { label: "IP 가 주는 것은 φ 다.\n얻은 것은 ‘¬φ 가 성립하지 않는다’ 인데\n거기서 φ 로 건너뛴다" }
  왼쪽 -> 오른쪽: "이 건너뜀이 IP 의 전부다"
}

부정도입 -> 차이
간접증명 -> 차이

성격: {
  label: "다른 열두 규칙은 연결자 하나의 뜻을 풀어 쓴 것이다. ∧I 는 ∧ 를 만드는 법, ∧E 는 쓰는 법.\nIP 는 어느 연결자에도 속하지 않는다. IP 가 말하는 것은 연결자의 뜻이 아니라 ‘참과 거짓 말고 다른 것은 없다’ 는 태도다.\n그래서 IP 를 빼도 남은 규칙들은 그대로 돌아간다 — 다만 증명되는 것이 줄어든다"
  shape: text
}

되돌아올자리: {
  label: "IP 없이는 얻지 못하는 대표적인 것이 배중률 φ ∨ ¬φ 다.\nIP 를 빼고 나머지 열두 규칙만 남긴 체계가 직관주의 논리이고, 19장이 그 체계를 다룬다.\n그때 이 그림으로 되돌아온다"
  shape: text
  style.bold: true
}
