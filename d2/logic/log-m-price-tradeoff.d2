# 완전성은 공짜가 아니었다 — 논리학 15장.
#
# 무엇을 읽어야 하나: 두 세로줄에 ○ 와 × 가 정확히 반대로 찍혀 있다는 것.
# 표현력을 늘리면 완전한 증명 체계가 사라지고, 완전한 증명 체계를 지키면
# 표현력이 깎인다. 고를 수는 있어도 둘 다 가질 수는 없다.
direction: down

물음: {
  label: "1차 논리는 왜 이런 대가를 치르는가 — 그 대가를 안 치르는 논리는 없는가"
  style.bold: true
}

표: {
  label: "같은 물음을 두 논리에 던져 본다"
  style.bold: true
  grid-rows: 7
  grid-columns: 3
  grid-gap: 8

  머리1: { label: "물음"; style.bold: true }
  머리2: { label: "1차 논리 — 이 문서가 세운 것"; style.bold: true }
  머리3: { label: "2차 논리 — 술어에도 ∀ 를 붙일 수 있게 한 것"; style.bold: true }

  질1: { label: "‘정의역이 유한하다’ 를\n문장 하나로 말할 수 있는가" }
  일1: { label: "× — 이 장에서 증명했다" }
  이1: { label: "○" }

  질2: { label: "ℕ 을 동형인 것들만\n남기고 붙잡을 수 있는가" }
  일2: { label: "× — 비표준 모형이 늘 따라 붙는다" }
  이2: { label: "○ — 귀납 공리를 집합 전체에 걸면 된다" }

  질3: { label: "컴팩트성이 성립하는가" }
  일3: { label: "○" }
  이3: { label: "×" }

  질4: { label: "뢰벤하임-스콜렘이 성립하는가" }
  일4: { label: "○ — 위아래로 미끄러진다" }
  이4: { label: "×" }

  질5: { label: "건전하고 완전한 증명 체계가 있는가" }
  일5: { label: "○ — 13장과 14장"; style.bold: true }
  이5: { label: "× — 어떤 규칙 목록으로도 안 된다"; style.bold: true }

  질6: { label: "규칙만 보고 도출을 검사할 수 있는가" }
  일6: { label: "○ — 7장의 검사 절차" }
  이6: { label: "규칙 목록 자체가 없으니 물음이 성립하지 않는다" }
}

거래: {
  label: "세로줄 둘에 찍힌 ○ 와 × 가 정확히 뒤집혀 있다.\n1차 논리의 표현력이 낮은 것은 설계 실패가 아니라 완전성을 사는 값이었다"
  shape: text
  style.bold: true
}

앞으로: {
  label: "이 대가는 아직 다 세지 않았다"
  style.bold: true
  grid-rows: 1
  grid-columns: 3
  grid-gap: 8

  십육: { label: "16장 — 도출이 있으면 언젠가 찾는다.\n그런데 없으면 영영 모른다" }
  십칠: { label: "17장 — 산술의 참을 공리로 붙잡으려 하면\n이 장의 비표준 모형이 다시 나온다" }
  이십: { label: "20장 — 2차 논리는 여기서 이름만 얹는다.\n무엇을 더 말할 수 있고 무엇을 잃는지는 거기서" }
}

물음 -> 표
표 -> 거래
거래 -> 앞으로
