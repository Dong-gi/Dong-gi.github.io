# 정지 문제 — 기계 H 가 있다고 하면 기계 D 를 만들 수 있고 D 가 자기에게서 터진다. 논리학 16장.
#
# 무엇을 읽어야 하나: 왼쪽 줄기는 ‘있다고 하자’ 에서 ‘만든다’ 로 내려가는 조립이고,
# 오른쪽 두 갈래는 조립한 것에 자기 코드를 먹였을 때의 두 경우다.
# 두 갈래가 모두 모순으로 끝난다는 것, 그래서 맨 위 가정이 무너진다는 것이 전부다.
direction: down

가정: {
  label: "가정 — 정지 판정 기계 H 가 있다"
  style.bold: true
  설명: { label: "H 는 ⟨M, w⟩ 를 입력으로 받는다.\n반드시 멈추고 예 또는 아니오를 낸다.\n예 = M 을 w 에 돌리면 멈춘다" }
}

조립: {
  label: "조립 — H 를 부품으로 새 기계 D 를 만든다"
  style.bold: true
  받기: { label: "D 는 기계 코드 ⟨M⟩ 하나를 받는다" }
  묻기: { label: "H 에게 ⟨M, ⟨M⟩⟩ 을 물어본다\n= ‘M 을 자기 코드에 돌리면 멈추는가’" }
  뒤집기: { label: "답이 예이면 → 일부러 영원히 돈다\n답이 아니오이면 → 곧바로 멈춘다"; style.bold: true }
  받기 -> 묻기 -> 뒤집기
}

가정 -> 조립: "H 가 있으면 D 도 있다"

먹이기: {
  label: "D 에 ⟨D⟩ 를 먹인다"
  style.bold: true
}

조립 -> 먹이기

갈래1: {
  label: "D 가 ⟨D⟩ 에서 멈춘다고 하자\n→ H 는 예라고 답한다\n→ D 는 영원히 돈다\n→ 멈추지 않는다"
}
갈래2: {
  label: "D 가 ⟨D⟩ 에서 안 멈춘다고 하자\n→ H 는 아니오라고 답한다\n→ D 는 곧바로 멈춘다\n→ 멈춘다"
}

먹이기 -> 갈래1
먹이기 -> 갈래2

모순: { label: "두 갈래 모두 자기가 말한 것과 반대로 끝난다"; style.bold: true }
갈래1 -> 모순
갈래2 -> 모순

결론: {
  label: "쓴 것은 ‘H 가 있다’ 뿐이므로 그것이 틀렸다.\n정지 판정 기계는 없다"
  style.bold: true
}
모순 -> 결론

대각선: {
  label: "대각선은 어디 있는가. 행이 기계이고 열이 입력인 표를 그리면,\n기계도 문자열이므로 두 축이 같은 집합이다. ⟨M, ⟨M⟩⟩ 은 그 표의 대각선 칸이고\nD 는 대각선을 자리마다 뒤집는다. 칸토어의 표에서 축 이름만 바꾼 것이다"
  shape: text
}

mcs: {
  label: "mcs 는 이 논증을 튜링 기계 없이, ‘문자열 프로시저’ 라는 비형식 모형으로 폈다.\n증명한 것도 조금 다르다 — 거기서는 ‘안멈춤 집합은 인식 가능하지 않다’ 였고\n여기서는 ‘정지 문제는 결정 가능하지 않다’ 다. 다음 절이 두 진술을 잇는다"
  shape: text
}
