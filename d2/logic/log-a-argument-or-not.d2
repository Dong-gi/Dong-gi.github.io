# 논증인가 아닌가 — 논리학 3장.
#
# 무엇을 읽어야 하나: 문장 묶음 하나를 놓고 세 번 물으면 서술·주장·설명·논증이 갈린다.
# 마지막 물음(듣는 사람이 그 문장을 이미 믿고 있는가)이 설명과 논증을 가르는 자리다.
direction: right

묶음: { label: "문장 몇 개가 나란히 있다"; shape: oval; style.bold: true }

q1: { label: "이 묶음이 받아들이게 하려는\n문장이 하나 있는가" }
q2: { label: "그 문장을 받아들일 이유로\n다른 문장을 대는가" }
q3: { label: "듣는 사람이 그 문장을\n이미 참이라고 여기는가" }

서술: { label: "서술\n무슨 일이 있었는지 늘어놓을 뿐이다\n결론이라 할 문장이 없다"; style.stroke-dash: 3 }
주장: { label: "주장\n결론만 있고 이유가 없다\n전제가 없다"; style.stroke-dash: 3 }
설명: { label: "설명\n왜 그렇게 되었는지를 말한다\n결론을 믿게 하려는 것이 아니다"; style.stroke-dash: 3 }
논증: { label: "논증(argument)\n전제가 결론을 받아들일 이유로 제시된다"; style.bold: true }

묶음 -> q1
q1 -> 서술: "아니오"
q1 -> q2: "예"
q2 -> 주장: "아니오"
q2 -> q3: "예"
q3 -> 설명: "예"
q3 -> 논증: "아니오"

메모: {
  label: "설명과 논증은 겉모양이 같다. 둘 다 ‘A 이므로 B 다’ 꼴이다.\n가르는 것은 B 의 지위다. B 를 이미 받아들였으면 설명이고,\nB 를 받아들이게 하려는 것이면 논증이다.\n같은 문장이 자리를 바꾸면 설명이 논증이 되기도 한다"
  shape: text
}

경계: {
  label: "논리학이 다루는 것은 실선으로 그린 상자 하나, 곧 논증뿐이다.\n점선 상자 셋이 나쁘다는 뜻이 아니다. 좋은 서술도 좋은 설명도 있다.\n다만 타당·부당이라는 잣대가 그것들에는 맞지 않는다"
  shape: text
}
