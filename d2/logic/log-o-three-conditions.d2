# 정리가 요구하는 세 조건 — 논리학 17장.
#
# 무엇을 읽어야 하나: 조건 하나를 뺄 때마다 실제로 반례가 하나씩 있다는 것.
# 위아래로 짝지어 읽어라. 조건을 빼먹은 진술이 왜 틀린 진술인지가 아래 줄에 있다.
direction: down

조건: {
  label: "세 조건을 다 만족하는 T 에만 정리가 적용된다"
  style.bold: true
  grid-rows: 1
  grid-columns: 3
  grid-gap: 8

  가: { label: "(가) 산술을 담을 만큼 강하다\n적어도 로빈슨 산술 Q 를 증명한다" }
  나: { label: "(나) 재귀적으로 공리화된다\n어떤 기호열이 공리인지 기계가 판정한다" }
  다: { label: "(다) 일관적이다\nφ 와 ¬φ 를 함께 도출하지 않는다" }
}

반례: {
  label: "하나를 빼면 — 실제로 완전한 이론이 있다"
  style.bold: true
  grid-rows: 1
  grid-columns: 3
  grid-gap: 8

  가없음: { label: "(가) 없음 — 프레스버거 산술\n덧셈만 있고 곱셈이 없다.\n완전하고 결정 가능하다" }
  나없음: { label: "(나) 없음 — 진 산술 Th(ℕ)\nℕ 에서 참인 문장을 전부 공리로 삼는다.\n완전하다. 그러나 공리 목록을\n기계가 알아볼 수 없다" }
  다없음: { label: "(다) 없음 — 비일관 이론\n⊥E 로 모든 문장을 도출한다.\n완전하다. 그리고 쓸모가 없다" }
}

조건 -> 반례: "위아래로 짝지어 읽는다"

경고: {
  label: "‘괴델은 어떤 체계도 완전할 수 없음을 보였다’ 는 문장이 틀린 이유가 아래 줄이다.\n조건 셋을 빼고 진술하면 저 세 이론이 전부 반례가 된다"
  shape: text
  style.bold: true
}
반례 -> 경고
