# ∨I 를 먼저 쓰면 왜 되돌아올 수 없는가 — 논리학 8장의 막다른 길.
#
# 무엇을 읽어야 하나: 목표가 ∨ 라고 해서 ∨I 가 늘 첫 수인 것은 아니다.
# ∨I 는 한쪽을 고르라고 요구하는데, 고른 쪽을 증명할 수 없으면
# 그 갈래는 통째로 버려진다. 왼쪽 두 갈래가 그 경우다.
direction: down

목표: { label: "목표: ¬P ∨ ¬Q\n손에 있는 것: ¬(P ∧ Q)"; style.bold: true }

왼쪽: { label: "∨I 로 왼쪽을 고른다\n먼저 ¬P 를 얻어야 한다" }
오른쪽: { label: "∨I 로 오른쪽을 고른다\n먼저 ¬Q 를 얻어야 한다" }
아이피: { label: "IP — ¬(¬P ∨ ¬Q) 를 가정하고\n⊥ 을 찾는다"; style.bold: true; style.stroke-width: 2 }

목표 -> 왼쪽
목표 -> 오른쪽
목표 -> 아이피

막힘1: {
  label: "막힌다\n¬(P ∧ Q) 는 둘 중 어느 쪽이 거짓인지\n말해 주지 않는다. P 가 거짓일 수도,\nQ 가 거짓일 수도 있다"
  style.stroke-dash: 3
}
막힘2: {
  label: "막힌다\n같은 이유다. 고를 근거가 없다"
  style.stroke-dash: 3
}
풀림: {
  label: "풀린다\n가정에서 ¬P 도 ¬Q 도 각각 ⊥ 을 부른다.\n한쪽을 고를 필요가 없어졌다"
  style.bold: true
}

왼쪽 -> 막힘1
오른쪽 -> 막힘2
아이피 -> 풀림

교훈: {
  label: "읽어낼 것 — 막힌 이유는 규칙을 잘못 쓴 것이 아니라\n손에 있는 전제가 ‘둘 중 하나’ 만 말하는데\n∨I 는 ‘어느 쪽’ 인지를 요구하기 때문이다.\n전제가 고를 근거를 주지 않으면 ∨I 는 첫 수가 될 수 없다"
  shape: text
}
