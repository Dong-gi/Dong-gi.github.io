# 완전성을 모형 만들기로 바꾼다 — 논리학 14장.
#
# 무엇을 읽어야 하나: 네 진술이 같은 것이라는 것. 그리고 첫 형태에는 손댈 곳이
# 없는데 마지막 형태는 ‘ 집합 하나를 받아 모형 하나를 지어라 ’ 라는 할 일을
# 준다는 것. 이 한 걸음이 증명 전체를 가능하게 한다.
direction: down

바꾸기: {
  label: "같은 주장을 네 번 고쳐 적는다 — 오른쪽 칸이 달라지는 것을 보라"
  style.bold: true
  grid-rows: 5
  grid-columns: 3
  grid-gap: 8

  머리0: { label: "형태"; style.bold: true }
  머리1: { label: "진술"; style.bold: true }
  머리2: { label: "그러면 할 일이 무엇이 되는가"; style.bold: true }

  이름1: { label: "① 원래 형태\n완전성"; style.bold: true }
  진술1: { label: "Γ ⊨ φ 이면 Γ ⊢ φ" }
  일1: { label: "모든 모형에서 참인 것을 받아 도출을 하나 만들어라.\n손에 쥔 것이 ‘ 반례가 없다 ’ 뿐이라 어디서 시작할지 알 수 없다" }

  이름2: { label: "② 대우"; style.bold: true }
  진술2: { label: "Γ ⊬ φ 이면 Γ ⊭ φ" }
  일2: { label: "도출이 없다는 것에서 반례 모형을 하나 만들어라.\n만들 것이 정해졌다 — 모형이다" }

  이름3: { label: "③ 짐을 왼쪽으로"; style.bold: true }
  진술3: { label: "Γ ∪ {¬φ} 가 일관적이면\n그 집합은 모형을 갖는다" }
  일3: { label: "Γ ⊬ φ 와 ‘ Γ ∪ {¬φ} 가 일관적 ’ 은 같은 말이다.\n한쪽에서 다른 쪽으로 건너가는 데 IP 와 ¬I 를 쓴다" }

  이름4: { label: "④ 모형 존재 정리\n증명할 것은 이것뿐"; style.bold: true }
  진술4: { label: "일관적인 집합은 모형을 갖는다" }
  일4: { label: "집합 하나를 받아 모형 하나를 지어라.\nφ 가 사라졌다. 남은 것은 Γ 하나다" }
}

되돌아: {
  label: "④ 를 증명하면 ① 로 되돌아온다"
  style.bold: true
  grid-rows: 1
  grid-columns: 4
  grid-gap: 8

  갑: { label: "Γ ⊨ φ 인데\nΓ ⊬ φ 라고 해 보자" }
  을: { label: "그러면 Γ ∪ {¬φ} 가\n일관적이다" }
  병: { label: "④ 가 그 집합에\n모형을 하나 준다" }
  정: { label: "그 모형은 Γ 를 만족시키면서\nφ 를 거짓으로 만든다.\nΓ ⊨ φ 에 어긋난다" }

  갑 -> 을 -> 병 -> 정
}

셈: {
  label: "바뀐 것은 증명해야 할 내용이 아니라 증명을 시작할 수 있는가다.\n‘ 없음을 보여라 ’ 가 ‘ 만들어라 ’ 로 바뀌었고, 만드는 일에는 절차가 있다"
  shape: text
  style.bold: true
}

바꾸기 -> 되돌아 -> 셈
