# 실질함의의 진리표는 왜 그 모양인가 — 논리학 6장.
#
# 무엇을 읽어야 하나: 진리함수로 쓰기로 정한 순간 고를 수 있는 자리는 두 줄뿐이고,
# 그 두 줄을 다르게 채우면 이미 이름이 있는 다른 연결자가 되어 버린다.
# 조건문 구실을 하는 채움은 맨 위 하나뿐이다.
direction: down

고정: {
  label: "다툼이 없는 두 줄"
  style.bold: true
  참참: { label: "T → T 는 T" }
  참거: { label: "T → F 는 F\n약속을 어긴 유일한 경우" }
}

자유: {
  label: "고를 수 있는 두 줄 — 전건이 F 인 자리"
  style.bold: true
  거참: { label: "F → T 는 ?" }
  거거: { label: "F → F 는 ?" }
}

고정 -> 자유: "나머지 두 줄을 어떻게 채울까"

둘다참: { label: "둘 다 T 로 채운다"; style.bold: true }
둘다거: { label: "둘 다 F 로 채운다" }
엇갈림1: { label: "F → T 는 F, F → F 는 T" }
엇갈림2: { label: "F → T 는 T, F → F 는 F" }

자유 -> 둘다참
자유 -> 둘다거
자유 -> 엇갈림1
자유 -> 엇갈림2

함의: {
  label: "φ → ψ\n새 연결자가 하나 생긴다.\n전건이 거짓인 조건문을 주장할 수 있다"
  style.bold: true
}
그리고: { label: "φ ∧ ψ 와 같아진다\n‘비는 안 오지만 오면 젖는다’ 를 말할 수 없다" }
동치: { label: "φ ↔ ψ 와 같아진다\n방향이 사라져 전건과 후건을 바꿔도 같다" }
후건만: { label: "ψ 와 같아진다\n전건이 아무 구실도 하지 않는다" }

둘다참 -> 함의
둘다거 -> 그리고
엇갈림1 -> 동치
엇갈림2 -> 후건만

결론: {
  label: "네 채움 가운데 셋은 이미 이름이 있는 연결자다.\n조건문에 쓸 만한 것은 맨 위 하나뿐이고, 그것이 실질함의다"
  shape: text
}

메모: {
  label: "여기서 쓴 전제는 하나다 — 함의를 진리함수로 쓰겠다는 것.\n즉 전건과 후건의 진리값만으로 전체 값이 정해져야 한다.\n인과나 관련성을 담고 싶으면 진리함수를 포기해야 하고,\n그 길이 18장(양상논리)과 19장(관련성 논리)이다"
  shape: text
}
