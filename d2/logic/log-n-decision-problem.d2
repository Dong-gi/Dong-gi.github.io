# 판정 문제와 판정 절차 — 논리학 16장.
#
# 무엇을 읽어야 하나: 조건이 셋인데 그중 하나만 어겨도 판정 절차가 아니라는 것.
# 오른쪽 세 상자가 각 조건을 어긴 모습이고, 맨 아래가 셋째 조건을 어긴 절차에
# 따로 이름을 붙여야 하는 이유다.
direction: down

문제: {
  label: "판정 문제 하나"
  style.bold: true
  입력: { label: "입력의 모임\n문자열로 적을 수 있는 것이면 무엇이든\n— 논리식, 논증, 기계, 자연수" }
  물음: { label: "입력마다 붙는 예 · 아니오 물음\n‘이 명제논리식은 항진명제인가’\n물음 하나가 아니라 물음의 무한한 가족이다" }
  입력 -> 물음: "각 입력에"
}

절차: {
  label: "판정 절차 — 세 조건을 다 지켜야 한다"
  style.bold: true
  기계적: { label: "1. 기계적이다\n유한하게 적힌 규칙만 따른다.\n통찰도 운도 쓰지 않는다" }
  전부: { label: "2. 모든 입력에 답한다\n입력 하나라도 빠지면 안 된다" }
  멈춘다: { label: "3. 반드시 멈춘다\n유한 걸음 안에 답을 낸다"; style.bold: true }
}

문제 -> 절차: "이 물음에 답하라"

어긴다: {
  label: "하나라도 어기면"
  a: { label: "‘적당히 감으로 고른다’\n— 1 을 어긴다. 절차가 아니다" }
  b: { label: "‘문자 열 개 이하인 식만 다룬다’\n— 2 를 어긴다. 다른 문제를 푼 것이다" }
  c: { label: "‘답이 예이면 멈추고 알려 준다.\n아니오이면 영원히 돌 수도 있다’\n— 3 만 어긴다"; style.bold: true }
}

절차 -> 어긴다

이름: {
  label: "셋째만 어긴 것에는 따로 이름이 있다 — 반결정 가능(semi-decidable).\n쓸모가 없지 않기 때문이다. 답이 예일 때는 확실히 알려 준다.\n이 장의 마지막 절이 술어논리의 논리적 참 문제가 정확히 그 자리에 있음을 보인다"
  shape: text
  style.bold: true
}

어긴다.c -> 이름

셈: {
  label: "판정 문제와 계산 문제를 섞지 않는다. ‘이 식의 파스 트리 높이는 얼마인가’ 는 값을 내놓으라는 문제이지\n예 · 아니오 물음이 아니다. 다만 ‘높이가 k 이상인가’ 처럼 물으면 판정 문제로 바꿔 놓을 수 있다"
  shape: text
}
