# 한국어 조건 표현이 화살표의 어느 쪽으로 가는가 — 논리학 4장.
#
# 무엇을 읽어야 하나: 표현이 열 가지여도 판단은 하나다. 어느 쪽이 없으면 안 되는가.
# 없으면 안 되는 쪽(필요조건)이 화살촉 자리이고, 그것만 있으면 되는 쪽(충분조건)이 꼬리 자리다.
direction: right

물음: {
  label: "A 와 B 가 든 조건 표현\n어느 쪽이 없으면 안 되는가"
  shape: oval
  style.bold: true
}

그대로: {
  label: "앞의 것이 전건 — A → B\n\nA 이면 B 다\nA 인 한 B 다\nA 하는 경우 B 다\nA 이기만 하면 B 다\nA 는 B 의 충분조건이다"
  style.bold: true
}

뒤집힘: {
  label: "앞의 것이 후건 — B → A\n\nA 일 때만 B 다\nA 이어야만 B 다\nA 가 아니면 B 가 아니다\nA 없이는 B 일 수 없다\nA 는 B 의 필요조건이다\nB 이려면 A 여야 한다"
  style.bold: true
}

양쪽: {
  label: "양쪽 다 — A ↔ B\n\nA 이면 그리고 그때만 B 다\nA 는 B 의 필요충분조건이다"
  style.bold: true
}

물음 -> 그대로: "B 가 없으면 안 된다"
물음 -> 뒤집힘: "A 가 없으면 안 된다"
물음 -> 양쪽: "서로 없으면 안 된다"

요령: {
  label: "요령: 화살표는 늘 충분조건에서 필요조건으로 간다.\n표현을 외우는 대신 ‘없으면 안 되는 쪽’ 을 찾아 화살촉 자리에 놓으면 된다"
  shape: text
}

함정: {
  label: "가장 흔한 잘못은 필요를 충분으로 뒤집어 읽는 것이다.\n‘비자가 없으면 입국할 수 없다’ 는 ‘비자가 있으면 입국할 수 있다’ 를 말하지 않는다.\n3장의 후건 긍정 오류와 같은 뿌리다"
  shape: text
}
