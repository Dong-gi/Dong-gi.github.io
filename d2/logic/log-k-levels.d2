# 층이 바뀐다 — 대상언어와 메타언어, 그리고 건전성 정리가 사는 자리 — 논리학 13장.
#
# 무엇을 읽어야 하나: 맨 위 문장 안에 아래 왼쪽 상자의 기호가 하나도 섞여 있지
# 않다는 것. 그리고 이 장의 증명 수단이 규칙 열일곱 개가 아니라 평범한 수학의
# 논법이라는 것. 12장까지는 왼쪽 상자 안에서 일했고 이제 오른쪽에서 일한다.
direction: down

정리: {
  label: "건전성 정리 — 이 장이 증명할 것\n\n‘모든 논리식 집합 Γ 와 모든 논리식 φ 에 대하여, Γ ⊢ φ 이면 Γ ⊨ φ 이다’"
  style.bold: true
}

성분: {
  label: "이 문장을 이루는 것 — 넷을 세어 보면 대상언어의 기호가 하나도 없다"
  grid-columns: 4
  grid-gap: 8

  메타변수: { label: "Γ, φ\n메타변수.\n어휘에 없는 글자다" }
  메타기호: { label: "⊢, ⊨\n메타언어의 기호.\n논리식 안에 들어가지 않는다" }
  한국어: { label: "‘모든 … 에 대하여’, ‘이면’\n한국어" }
  없는것: {
    label: "대상언어의 기호\n하나도 없다"
    style.bold: true
  }
}

두층: {
  label: "그래서 이 정리는 두 언어 가운데 오른쪽에 산다"
  grid-columns: 2
  grid-gap: 12

  대상: {
    label: "대상언어 — 연구 대상. 12장까지 이 안에서 일했다\n\n어휘가 전부다 — 문장문자 · 연결자 다섯 · 괄호 · ⊥ ·\n술어 · 항 · 변수 · 한정사 둘 · =\n\n이제 적형식과 도출이 우리가 말하는 대상이 된다"
  }
  메타: {
    label: "메타언어 — 한국어와 메타변수. 여기서 이 장의 일을 한다\n\n쓰는 수단은 경우 나누기 · 귀류법 · 귀납법.\n평범한 수학의 논법이다\n\n규칙 열일곱 개로는 위 문장을 적을 수조차 없다"
    style.bold: true
  }
}

셈: {
  label: "5장은 이런 주장을 메타정리라 불렀다.\n7장이 ‘두 기호를 섞지 마라’ 고 한 금지는 그대로 유효하다 —\n논증 중간에 몰래 갈아타는 것과 둘의 관계를 정리로 진술하는 것은 다른 일이다"
  shape: text
}

정리 -> 성분: 뜯어보면
성분 -> 두층
두층 -> 셈
