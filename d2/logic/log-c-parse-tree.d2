# 파스 트리 — 논리학 5장.
#
# 무엇을 읽어야 하나: 뿌리에 적힌 연결자가 주연결자이고, 마디마다 부분식이 하나씩이고,
# 잎은 반드시 문장문자다. 위에서 아래로 읽으면 분해, 아래에서 위로 읽으면 조립이다.
direction: down

뿌리: { label: "((P ∧ Q) → ¬R)\n주연결자 →"; style.bold: true }

왼: { label: "(P ∧ Q)\n주연결자 ∧"; style.bold: true }
오: { label: "¬R\n주연결자 ¬"; style.bold: true }

잎1: { label: "P\n문장문자" }
잎2: { label: "Q\n문장문자" }
잎3: { label: "R\n문장문자" }

뿌리 -> 왼: "→ 조항의 왼쪽 재료"
뿌리 -> 오: "→ 조항의 오른쪽 재료"
왼 -> 잎1
왼 -> 잎2
오 -> 잎3

부분식: {
  label: "부분식은 마디의 라벨을 모은 것이다 —\n((P ∧ Q) → ¬R), (P ∧ Q), ¬R, P, Q, R\n여섯 개. 식 자신도 자기의 부분식이고\n(뿌리도 마디다), 잎에 있는 것만이\n문장문자다"
  shape: text
}

유일: {
  label: "왜 나무가 하나로 정해지는가 — 이항 조항이\n붙여 둔 괄호 덕이다. 괄호를 빼고\nP ∧ Q → ¬R 이라고만 적으면 나무가 둘\n생길 수 있다. 적형식마다 나무가 정확히\n하나라는 것은 정리이고 13장의 도구가 든다"
  shape: text
}

찾기: {
  label: "주연결자를 손으로 찾는 법 — 맨 바깥\n괄호를 지운 뒤 왼쪽부터 깊이를 센다.\n여는 괄호에서 +1, 닫는 괄호에서 −1.\n깊이 0 에 이항 연결자가 있으면 그것이고,\n없으면서 맨 앞이 ¬ 이면 ¬ 가 주연결자다"
  shape: text
}
