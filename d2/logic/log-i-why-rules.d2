# 왜 술어논리에서 증명 체계가 더 절실한가 — 논리학 11장.
#
# 무엇을 읽어야 하나: 6장에서 7장으로 넘어올 때 진리표는 느릴 뿐 여전히 있었다.
# 10장에서 11장으로 넘어올 때는 진리표에 해당하는 것이 아예 없다. 왼쪽 두 칸의
# 아래 상자를 견주면 같은 걸음인데 절박함이 다르다는 것이 보인다.
direction: down

같은걸음: {
  label: "같은 걸음을 두 번 걷는다 — 의미론에서 증명 체계로"
  style.bold: true
  grid-columns: 2
  grid-gap: 12

  명제: {
    label: "명제논리 — 6장에서 7장으로"
    direction: down

    의미1: { label: "6장 의미론\n배당 v 를 훑는다.\n문장문자가 n 개면 2ⁿ 줄" }
    남은1: {
      label: "훑기가 끝나기는 한다\n느릴 뿐 판정은 나온다.\n증명 체계는 ‘빠르고 남에게\n건넬 수 있는 것’ 을 얻으려고 왔다"
    }
    증명1: { label: "7장 자연연역\n규칙 열셋" }

    의미1 -> 남은1 -> 증명1
  }

  술어: {
    label: "술어논리 — 10장에서 11장으로"
    direction: down

    의미2: { label: "10장 의미론\n모형 ℳ = ⟨D, I⟩ 를 훑는다.\nD 의 크기에 상한이 없다" }
    남은2: {
      label: "훑기가 끝나지 않는다\n모형이 무한히 많고 크기에 상한이 없다.\n진리표에 해당하는 표를 그릴 수 없다.\n증명 체계 말고 손에 쥘 것이 없다"
      style.bold: true
    }
    증명2: { label: "11장 자연연역\n규칙 열셋에 넷을 더한다" }

    의미2 -> 남은2 -> 증명2
  }
}

무엇을얻나: {
  label: "규칙 넷을 더해서 얻는 것"
  style.bold: true
  direction: right

  유한: { label: "도출은 유한한 줄의 목록이다\n모형이 무한히 많은 것과 상관없이\n종이 한 장에 다 적힌다" }
  검사: { label: "검사가 모양만 본다\nD 가 무엇인지, I 가 무엇을 골랐는지\n몰라도 줄마다 규칙과 맞는지 볼 수 있다" }
  절반: { label: "절반의 판정이 생긴다\n‘도출이 있다’ 는 유한 단계에 확정된다.\n‘없다’ 는 여전히 확정되지 않는다" }
}

값: {
  label: "다만 값을 치른다 — 규칙 넷 가운데 둘에 변수 조건이 붙는다.\n명제논리의 규칙 열셋에는 없던 종류의 조건이고, 이 장에서 가장 자주 틀리는 자리다"
  shape: text
  style.bold: true
}

같은걸음 -> 무엇을얻나: "규칙 넷을 더한다"
무엇을얻나 -> 값
