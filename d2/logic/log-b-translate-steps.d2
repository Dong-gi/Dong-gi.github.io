# 문장 하나를 기호로 옮기는 절차 — 논리학 4장.
#
# 무엇을 읽어야 하나: 옮기기는 감으로 하는 일이 아니라 여섯 단계다.
# 마지막 단계가 검사다. 되읽어 원문과 어긋나면 사전을 고치러 3단계로 돌아간다.
direction: down

s1: {
  label: "① 문장을 따로 떼어 적는다\n‘시험을 보지 않으면 학점을 받지 못한다’"
  shape: oval
  style.bold: true
}
s2: { label: "② 논리 상항을 찾아 표시한다\n‘-지 않-’ 두 번, ‘-으면’ 한 번" }
s3: { label: "③ 남은 조각을 원자로 잡고 사전을 적는다\nP: 시험을 본다     Q: 학점을 받는다\n긍정형으로, 완전한 문장으로" }
s4: { label: "④ 뼈대를 만든다 — 조각만 글자로 바꾸고 연결은 한국어로 둔다\n‘P 가 아니면 Q 가 아니다’" }
s5: { label: "⑤ 기호로 바꾸고 괄호를 넣는다\n¬P → ¬Q"; style.bold: true }
s6: { label: "⑥ 되읽어 원문과 견준다\n‘시험을 안 보면 학점을 못 받는다’"; shape: oval }

s1 -> s2 -> s3 -> s4 -> s5 -> s6
s6 -> s3: "어긋나면 사전부터 고친다"

사전: {
  label: "사전을 빼먹으면 ¬P → ¬Q 만 남는다.\n그것만으로는 참인지 거짓인지 물을 수도 없다.\n사전은 장식이 아니라 옮긴 결과의 절반이다"
  shape: text
}
애매: {
  label: "④ 에서 뼈대가 두 갈래로 읽히면 애매한 문장이다.\n하나를 몰래 고르지 말고 두 읽기를 다 적은 뒤\n문맥으로 고르고, 골랐다고 밝혀라"
  shape: text
}
s3 -> 사전: "이 단계를 빼면"
s4 -> 애매: "여기서 갈라지면"
