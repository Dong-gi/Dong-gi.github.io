# 완전성이 왜 놀라운 주장인가 — 논리학 14장.
#
# 무엇을 읽어야 하나: 왼쪽 기둥에 적힌 것은 유한하고 셀 수 있는데
# 오른쪽 기둥에 적힌 것은 끝이 없다. 완전성은 그 둘이 정확히 같은 것을
# 가려낸다고 주장한다. 먼저 그럴 리 없어 보이는 이유를 읽어야 한다.
direction: down

주장: {
  label: "완전성 — Γ ⊨ φ 이면 Γ ⊢ φ. 참인 것은 빠짐없이 증명된다"
  style.bold: true
}

비교: {
  label: "그런데 두 쪽이 쓰는 재료가 이렇게 다르다"
  grid-rows: 4
  grid-columns: 2
  grid-gap: 8

  왼머리: { label: "⊢ 쪽 — 증명 체계"; style.bold: true }
  오머리: { label: "⊨ 쪽 — 의미론"; style.bold: true }

  왼1: { label: "규칙이 열일곱 개다.\n7장에서 열셋, 11장에서 넷, 12장에서 =I · =E" }
  오1: { label: "모형은 무한히 많다.\n정의역 크기마다 있고 해석은 그보다 더 많다" }

  왼2: { label: "도출은 유한한 기호열이다.\n줄 수도 유한하고 각 줄도 유한하다" }
  오2: { label: "정의역이 무한한 모형도 있다.\n모형 하나를 다 적는 일조차 끝나지 않는다" }

  왼3: { label: "그래서 도출 전체에 번호를 붙일 수 있다.\n적형식이 가산인 것과 같은 논법 (5장)" }
  오3: { label: "모형 전체에는 번호를 붙일 수 없다.\n한 줄로 세울 수 있는 모임이 아니다" }
}

의심: {
  label: "그러니 의심하는 것이 옳다"
  style.bold: true
  세는말: { label: "셀 수 있는 것으로 셀 수 없는 것을 전부 따라잡는다는 말로 들린다" }
  일반말: { label: "규칙 하나하나는 연결자 한 개의 뜻만 본다.\n그런 조각들을 이어 붙여 모든 모형에 대한 주장에 닿는다는 말로 들린다" }
  없는말: { label: "그리고 ⊢ 은 있음의 주장이라 확인이 값싸고\n⊨ 는 전부에 대한 주장이라 확인이 비싸다. 값이 다른 둘이 같다는 말로 들린다" }
}

풀림: {
  label: "의심이 풀리는 자리를 미리 적어 둔다"
  shape: text
  style.bold: true
}

셈: {
  label: "세는 것이 어긋나 보이는 까닭은 ⊨ 가 모형 전부를 세라고 요구하기 때문인데,\n완전성 증명은 모형을 세지 않는다. 일관된 집합 하나에서 모형 하나를 지어 낸다.\n그 모형은 언제나 가산이다 — 셀 수 없는 것을 따라잡을 일이 애초에 없었다"
  shape: text
}

주장 -> 비교
비교 -> 의심
의심 -> 풀림
풀림 -> 셈
