# 대상언어와 메타언어 — 논리학 5장.
#
# 무엇을 읽어야 하나: 두 상자에 든 기호가 하나도 겹치지 않는다는 것이 요점이다.
# 아래 상자는 연구 대상이고 위 상자는 그것에 대해 말하는 도구다. φ 는 아래 상자에 절대 들어가지 않는다.
direction: down

메타: {
  label: "메타언어 — 우리가 말하는 데 쓰는 언어"
  style.bold: true
  direction: right

  변수: { label: "메타변수\nφ ψ χ — 적형식 하나를 가리킨다\nΓ Δ — 적형식 집합을 가리킨다" }
  낱말: { label: "한국어 낱말\n‘적형식이다’ ‘주연결자’\n‘부분식’ ‘도식’ ‘줄임말’" }
  문장: { label: "이 언어로 하는 말의 예\n‘((P ∧ Q) → ¬R) 은 적형식이다’\n‘φ 의 주연결자가 ∧ 이면\n φ 는 (ψ ∧ χ) 꼴이다’" }
}

대상: {
  label: "대상언어 — 우리가 연구 대상으로 삼는 언어"
  style.bold: true
  direction: right

  어휘: { label: "어휘가 전부다\n문장문자 P Q R P₁ P₂ …\n연결자 ¬ ∧ ∨ → ↔\n괄호 ( )" }
  식들: { label: "이 언어로 적을 수 있는 것\nP\n¬R\n(P ∧ Q)\n((P ∧ Q) → ¬R)" }
  없는것: { label: "여기 없는 것\nφ ψ Γ\n‘적형식’ 이라는 낱말\n— 자기 자신에 대해 말하지 못한다" }
}

메타 -> 대상: "…에 대해 말한다"

메모: {
  label: "왜 이 구분이 필요한가 — 13장부터 증명하는 것이\n전부 이 언어에 대한 주장이다. ‘증명할 수 있는 것은\n의미론이 인정하는 것이다’ 는 대상언어로 적을 수 없다.\n그래서 그 정리들을 메타정리라 부른다.\n\n17장이 특별한 이유 — 괴델은 대상언어가 위 상자의\n말을 흉내 내게 만든다. 두 상자가 원래 갈라져 있다는\n것을 지금 확실히 해 두면 그때 무슨 일이 벌어지는지\n보인다. 일상어에도 있는 구분이다 —\n‘서울’ 은 두 글자이고 서울은 도시다"
  shape: text
}
