# 스콜렘의 역설 — 논리학 15장.
#
# 무엇을 읽어야 하나: 두 칸이 같은 대상을 두고 서로 다른 말을 하는 것처럼 보이지만,
# 아래 칸의 ‘비가산이다’ 는 ℳ 안에서만 하는 말이라는 것. 모순은 ‘비가산’ 이 모형과
# 무관한 성질이라고 여길 때만 생긴다.
direction: down

출발: {
  label: "집합론의 공리를 전부 모은 집합 Γ. 이 안에는 ‘비가산 집합이 존재한다’ 가 정리로 들어 있다"
  style.bold: true
}

두관점: {
  label: "같은 모형 ℳ 을 두 자리에서 본다"
  style.bold: true
  grid-rows: 3
  grid-columns: 2
  grid-gap: 8

  머리1: { label: "밖에서 — 우리가 ℳ 을 대상으로 놓고 볼 때"; style.bold: true }
  머리2: { label: "안에서 — ℳ 이 자기 문장을 판정할 때"; style.bold: true }

  밖1: { label: "아래로 뢰벤하임-스콜렘에 따라 Γ 는 가산 모형 ℳ 을 갖는다.\n정의역 D 의 원소 전부에 1, 2, 3, … 을 붙일 수 있다" }
  안1: { label: "ℳ ⊨ ‘비가산 집합 a 가 존재한다’.\nℳ 안에서 a 는 셀 수 없는 집합이다" }

  밖2: { label: "a 가 가리키는 것도 D 의 원소이고,\nℳ 안에서 a 에 속하는 것들도 D 안에 있다.\n그러니 밖에서 세면 그것도 가산이다"; style.bold: true }
  안2: { label: "‘비가산이다’ 가 말하는 것은\n‘ℕ 에서 a 로 가는 전단사가 없다’ 이고,\n그 전단사도 D 의 원소여야 한다"; style.bold: true }
}

해소: {
  label: "어긋나는 자리는 한 곳뿐이다"
  style.bold: true
  grid-rows: 1
  grid-columns: 2
  grid-gap: 8

  있다: { label: "밖에는 그 전단사가 있다\n— 우리가 D 를 세면서 만든 것" }
  없다: { label: "안에는 그 전단사가 없다\n— D 안에 그런 원소가 들어 있지 않다"; style.bold: true }
}

결론: {
  label: "그래서 두 칸은 서로 모순되지 않는다. ‘가산이다’ 는 대상 혼자 지니는 성질이 아니라 어느 모형 안에서 보느냐에 딸린 성질이다.\n1차 논리의 문장이 붙잡는 것은 언제나 모형 안에서의 뜻뿐이고, 모형 밖에서 우리가 보는 것은 그 문장이 닿지 않는 곳이다"
  shape: text
  style.bold: true
}

출발 -> 두관점
두관점 -> 해소: "정말 부딪치는가"
해소 -> 결론
