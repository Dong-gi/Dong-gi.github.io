# 완전성과 불완전성은 다른 낱말이다 — 논리학 17장.
#
# 무엇을 읽어야 하나: 위 표의 첫 줄, 곧 두 주장의 주어가 다르다는 것. 왼쪽은
# 증명 체계에 대한 말이고 오른쪽은 이론에 대한 말이다. 아래 칸은 둘을 함께
# 놓았을 때 무슨 일이 일어나는지 보여 준다 — 모순이 아니라 협력이다.
direction: down

두낱말: {
  label: "‘완전하다’ 가 두 곳에서 서로 다른 뜻으로 쓰인다"
  style.bold: true
  grid-rows: 4
  grid-columns: 3
  grid-gap: 8

  빈칸: { label: ""; style.opacity: 0 }
  머리1: { label: "14장 — 증명 체계가 완전하다"; style.bold: true }
  머리2: { label: "17장 — 이론이 완전하다 · 불완전하다"; style.bold: true }

  줄1: { label: "주어"; style.bold: true }
  칸11: { label: "증명 체계\n7 · 11 · 12장의 규칙 전체" }
  칸12: { label: "이론 T\n공리로 고른 문장들" }

  줄2: { label: "무슨 주장인가"; style.bold: true }
  칸21: { label: "Γ ⊨ φ 이면 Γ ⊢ φ\n의미론이 인정하는 것을 규칙이 다 잡는다" }
  칸22: { label: "모든 문장 φ 에 대해\nT ⊢ φ 이거나 T ⊢ ¬φ 이다" }

  줄3: { label: "성립하는가"; style.bold: true }
  칸31: { label: "성립한다. 어떤 Γ 를 놓든\n1차 논리 전체에 대해" }
  칸32: { label: "산술을 담을 만큼 강한 T 는\n이 성질을 가질 수 없다" }
}

합치면: {
  label: "둘을 함께 놓으면 — 모순이 아니라 협력이다"
  style.bold: true
  grid-rows: 1
  grid-columns: 3
  grid-gap: 8

  a: { label: "① 17장이 주는 것\nT ⊬ G  그리고  T ⊬ ¬G" }
  b: { label: "② 여기에 14장을 대우로 쓰면\nT ⊭ G  그리고  T ⊭ ¬G" }
  c: { label: "③ 그러니 G 가 참인 T-모형도\nG 가 거짓인 T-모형도 있다.\n그중 하나가 15장의 비표준 모형이다" }
}

두낱말 -> 합치면: "주어가 다르므로 부딪치지 않는다"

메모: {
  label: "괴델이 둘 다 증명했다 — 완전성은 1929년 학위논문, 불완전성은 1931년.\n같은 사람이 두 해 사이에 증명한 정리가 서로 모순일 리 없다"
  shape: text
  style.bold: true
}
합치면 -> 메모
