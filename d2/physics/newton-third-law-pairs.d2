# 작용·반작용 쌍과 한 물체의 힘 평형은 완전히 다른 이야기다.
# 왼쪽: 두 물체가 서로 주고받는 한 쌍. 서로 다른 물체에 걸리므로 상쇄되지 않는다.
# 오른쪽: 한 물체에 걸린 두 힘. 같은 물체에 걸리므로 합이 0 이면 평형이다.
#
# 라벨에 아래첨자를 쓰지 않는다. D2 는 첨자를 지원하지 않는다.
direction: right

쌍: {
  label: "작용·반작용 — 서로 다른 두 물체"

  손: { label: "손" }
  상자: { label: "상자" }

  손 -> 상자: "손이 상자를 미는 힘"
  상자 -> 손: "상자가 손을 미는 힘 (크기 같음, 방향 반대)"

  주의: { label: "두 힘은 서로 다른 물체에 걸린다.\n같은 자유물체도에 함께 그릴 수 없고, 상쇄되지도 않는다." ; shape: rectangle }
}

평형: {
  label: "힘의 평형 — 한 물체에 걸린 힘들"

  책: { label: "책상 위의 책" ; shape: rectangle }
  무게: { label: "지구가 당기는 힘 (아래)" }
  항력: { label: "책상이 떠받치는 힘 (위)" }

  무게 -> 책
  항력 -> 책

  주의2: { label: "둘 다 책에 걸린다. 합이 0 이라 책이 가만히 있다.\n이 둘은 작용·반작용 쌍이 아니다." ; shape: rectangle }
}
