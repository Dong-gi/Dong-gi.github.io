# 열기관과 냉장고의 에너지 흐름.
# 제2법칙의 두 서술(켈빈-플랑크, 클라우지우스)이 무엇을 금지하는지 화살표 방향으로 대비한다.
#
# 라벨에 아래첨자를 쓰지 않는다. D2 는 첨자를 지원하지 않아 T_H 처럼 밑줄이 그대로 보인다.
# 본문 수식에서 기호를 이미 정의했으므로 그림에서는 우리말로 적는다.
direction: down

열기관: {
  label: "열기관 — 저절로 일어난다"

  고온: { label: "고온 열원" }
  기관: { label: "기관"; shape: circle }
  저온: { label: "저온 열원" }
  일:   { label: "일"; shape: hexagon }

  고온 -> 기관: "열을 흡수"
  기관 -> 저온: "남은 열을 버림"
  기관 -> 일:   "흡수한 열 − 버린 열"
}

냉장고: {
  label: "냉장고·열펌프 — 일을 넣어야 한다"

  저온2: { label: "저온 열원" }
  기관2: { label: "기관"; shape: circle }
  고온2: { label: "고온 열원" }
  일2:   { label: "일 투입"; shape: hexagon }

  저온2 -> 기관2: "열을 흡수"
  일2   -> 기관2: "일"
  기관2 -> 고온2: "흡수한 열 + 넣은 일"
}
