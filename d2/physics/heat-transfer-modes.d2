# 열이 옮겨 가는 세 가지 길 — 10장(열과 열역학).
#
# 무엇을 읽어야 하나: 세 길 모두 뜨거운 쪽에서 찬 쪽으로만 간다.
# 다른 점은 무엇이 실려 가느냐다. 전도는 물질이 제자리에 있고 흔들림만,
# 대류는 데워진 물질 자체가, 복사는 아무것도 없이 전자기파만 간다.
# 그래서 진공을 건너올 수 있는 것은 복사뿐이다.
#
# 라벨에 아래첨자를 쓰지 않는다. D2 는 첨자를 지원하지 않아 T_H 처럼 밑줄이 그대로 보인다.
# 본문 수식에서 기호를 이미 정의했으므로 그림에서는 우리말로 적는다.
direction: right

뜨거운쪽: {
  label: "뜨거운 쪽\n분자가 심하게 흔들린다"
  shape: circle
}

길: {
  label: "열이 가는 세 가지 길"

  전도: {
    label: "전도\n맞닿은 분자끼리 흔들림을 넘겨준다\n물질은 제자리에 있다\n금속 숟가락, 벽, 창유리"
  }
  대류: {
    label: "대류\n데워져 가벼워진 유체가 통째로 올라간다\n물질이 실려 간다\n끓는 물, 바람, 온수 난방"
  }
  복사: {
    label: "복사\n전자기파로 곧장 나간다\n중간에 물질이 없어도 된다\n햇빛, 난로 앞의 따뜻함"
  }
}

찬쪽: {
  label: "찬 쪽\n분자가 덜 흔들린다"
  shape: circle
}

뜨거운쪽 -> 길.전도 -> 찬쪽
뜨거운쪽 -> 길.대류 -> 찬쪽
뜨거운쪽 -> 길.복사 -> 찬쪽

진공: {
  label: "사이가 진공이라면"
  shape: hexagon
}
진공 -> 길.전도: "넘겨줄 분자가 없다 — 막힌다" { style.stroke-dash: 4 }
진공 -> 길.대류: "실려 갈 유체가 없다 — 막힌다" { style.stroke-dash: 4 }
진공 -> 길.복사: "그대로 통과한다"

메모: {
  label: "보온병이 이중벽 사이를 진공으로 만들고\n안쪽을 거울처럼 도금하는 이유가 이 그림에 다 있다"
  shape: text
}
