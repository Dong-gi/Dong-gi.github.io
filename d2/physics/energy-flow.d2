# 에너지가 오가는 길 — 6장(일·에너지·운동량).
#
# 무엇을 읽어야 하나: 보존력이 만드는 화살표는 양쪽으로 나 있고(되돌릴 수 있다),
# 마찰이 만드는 화살표는 한쪽으로만 나 있다(되돌릴 수 없다).
#
# 라벨에 아래첨자를 쓰지 않는다. D2 는 첨자를 지원하지 않아 U_g 처럼 밑줄이 그대로 보인다.
# 본문 수식에서 기호를 이미 정의했으므로 그림에서는 우리말로 적는다.
direction: right

바깥: {
  label: "계 바깥"
  손: { label: "사람·엔진이 해 준 일"; shape: hexagon }
}

역학: {
  label: "역학적 에너지 — 서로 오갈 수 있다"

  운동: { label: "운동에너지\n(빠르기)"; shape: circle }
  중력: { label: "중력 위치에너지\n(높이)" }
  탄성: { label: "탄성 위치에너지\n(용수철이 눌린 정도)" }

  운동 <-> 중력: "올라가면 느려지고\n내려오면 빨라진다"
  운동 <-> 탄성: "밀어내면 빨라지고\n부딪히면 눌린다"
}

내부: {
  label: "돌아오지 않는 쪽"
  열: { label: "접촉면의 내부에너지\n(온도가 올라간다)" }
}

바깥.손 -> 역학.운동: "양의 일"
역학.운동 -> 내부.열: "마찰·공기저항이 한 음의 일"
내부.열 -> 역학.운동: "저절로 되돌아오지는 않는다\n(어디까지 되찾을 수 있는지는 10장)" { style.stroke-dash: 4 }
