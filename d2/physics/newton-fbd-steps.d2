# 자유물체도를 그리고 운동방정식을 세우는 순서.
# 뉴턴 역학 문제는 거의 전부 이 다섯 단계로 풀린다.
#
# 라벨에 아래첨자를 쓰지 않는다. D2 는 첨자를 지원하지 않는다.
direction: down

고르기: {
  label: "1. 물체를 하나 고른다"
  설명: { label: "여러 물체가 얽혀 있으면 하나씩 따로 그린다" ; shape: rectangle }
}

그리기: {
  label: "2. 그 물체가 받는 힘만 화살표로 그린다"
  받는힘: { label: "받는 힘: 무게 · 수직항력 · 마찰력 · 장력 · 미는 힘" ; shape: rectangle }
  빼는힘: { label: "그리지 않는 것: 그 물체가 남에게 주는 힘, 구심력 같은 이름표" ; shape: rectangle }
}

축: {
  label: "3. 축을 고른다"
  설명2: { label: "가속도 방향에 축 하나를 맞추면 다른 축의 가속도가 0 이 된다" ; shape: rectangle }
}

식: {
  label: "4. 축마다 힘의 합 = 질량 × 가속도"
  설명3: { label: "가속도가 0 인 축에서는 힘의 합도 0" ; shape: rectangle }
}

풀기: {
  label: "5. 미지수만큼 식을 모아 연립한다"
  설명4: { label: "물체가 둘이면 식도 둘, 줄로 이어져 있으면 가속도가 같다는 조건이 하나 더" ; shape: rectangle }
}

고르기 -> 그리기 -> 축 -> 식 -> 풀기
