# 물리적 변화와 화학적 변화 — 3장(물질과 측정).
#
# 무엇을 읽어야 하나: 가르는 기준은 하나뿐이다.
# "새로운 물질이 생겼는가". 모양이 변했는지, 눈에 띄는지는 기준이 아니다.
# 헷갈리는 것들을 오른쪽에 모아 두었다.
direction: right

기준: {
  label: "변화가 일어났다\n새로운 물질이 생겼는가?"
  shape: diamond
}

물리: {
  label: "물리적 변화\n분자는 그대로이고 배치만 바뀐다\n되돌리기 쉽다"

  예1: { label: "얼음이 녹는다\nH2O 분자는 그대로" }
  예2: { label: "설탕이 물에 녹는다\n증발시키면 설탕이 돌아온다" }
  예3: { label: "철을 두드려 편다" }
}

화학: {
  label: "화학적 변화 (화학 반응)\n원자의 짝이 바뀌어 다른 물질이 된다\n되돌리려면 또 다른 반응이 필요하다"

  예4: { label: "철이 녹슨다\n철 + 산소 → 산화철" }
  예5: { label: "나무가 탄다\n이산화탄소와 물이 새로 생긴다" }
  예6: { label: "음식이 소화된다" }
}

헷갈림: {
  label: "헷갈리는 것들"
  style.stroke-dash: 3

  항목1: { label: "달걀을 삶는다 → 화학적 변화\n단백질의 구조가 바뀌어 되돌아오지 않는다" }
  항목2: { label: "드라이아이스가 사라진다 → 물리적 변화\n고체가 기체가 된 것뿐, 여전히 이산화탄소" }
  항목3: { label: "전구가 빛난다 → 물리적 변화\n텅스텐은 그대로다" }
}

기준 -> 물리: "아니오"
기준 -> 화학: "예"
기준 -> 헷갈림: "판정해 보기"
