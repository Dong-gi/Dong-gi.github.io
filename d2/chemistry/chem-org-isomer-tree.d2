# 이성질체 갈래 — 16장(유기화학 입문).
#
# 무엇을 읽어야 하나: 갈림길은 딱 하나다.
# "원자가 이어진 순서가 같은가" 를 묻고, 다르면 구조 이성질체,
# 같으면 입체 이성질체다. 입체 이성질체는 다시
# "거울상인가" 로 한 번 더 갈린다.
direction: right

시작: {
  label: "분자식은 같은 두 물질"
}

질문1: {
  label: "원자가 이어진 순서가 같은가"
  shape: diamond
}

구조: {
  label: "구조 이성질체 (다르다)"

  사슬: { label: "사슬 이성질체\n골격이 곧은가 가지가 있는가\n뷰테인 / 2-메틸프로페인" }
  위치: { label: "위치 이성질체\n작용기가 몇 번 탄소에 붙었는가\n1-프로판올 / 2-프로판올" }
  작용기: { label: "작용기 이성질체\n작용기 자체가 다르다\n에탄올 / 다이메틸에터" }
}

질문2: {
  label: "거울상 관계인가"
  shape: diamond
}

부분입체: {
  label: "부분 입체 이성질체\n시스 - 트랜스가 대표적이다\n녹는점 · 끓는점 · 쌍극자가 서로 다르다"
}

거울상: {
  label: "거울상 이성질체\n보통의 물리 성질은 같다\n편광을 돌리는 방향과\n생체 분자와의 결합이 다르다"
}

메모: {
  label: "구조 이성질체는 대개 아예 다른 물질처럼 행동하고,\n입체 이성질체는 성질이 가까워 갈라내기 어렵다.\n분자식만 같고 성질이 크게 다른 경우가 흔하다는 것이\n유기화학이 커지는 이유다"
  style.stroke-dash: 3
}

시작 -> 질문1
질문1 -> 구조: "다르다"
질문1 -> 질문2: "같다 (입체 이성질체)"
질문2 -> 거울상: "그렇다"
질문2 -> 부분입체: "아니다"
구조 -> 메모
