# 몰 다리 — 4장(원자의 구조)에서 세우고 8장(화학량론)에서 계속 쓴다.
#
# 무엇을 읽어야 하나: 화학 계산에서 서로 다른 네 가지 양을 오갈 때
# 반드시 가운데 "몰"을 거친다. 질량에서 개수로 곧장 가는 길은 없다.
# 화살표에 적힌 것이 곱하거나 나눌 값이다.
direction: right

질량: {
  label: "질량\n[g]\n저울로 잴 수 있는 유일한 양"
  shape: circle
}

몰: {
  label: "몰\nn [mol]\n모든 길이 여기를 지난다"
  shape: circle
  style.stroke-width: 3
}

개수: {
  label: "입자 수\nN [개]\n원자·분자·이온의 개수"
  shape: circle
}

부피기체: {
  label: "기체의 부피\nV [L]\n온도와 압력을 알아야 한다"
  shape: circle
}

부피용액: {
  label: "용액의 부피\nV [L]\n농도를 알아야 한다"
  shape: circle
}

질량 -> 몰: "몰질량 M [g/mol] 로 나눈다"
몰 -> 질량: "몰질량 M 을 곱한다"
몰 -> 개수: "아보가드로 수를 곱한다"
개수 -> 몰: "아보가드로 수로 나눈다"
몰 -> 부피기체: "PV = nRT 로 옮긴다"
부피기체 -> 몰: "PV = nRT 로 옮긴다"
몰 -> 부피용액: "농도 c [mol/L] 로 나눈다"
부피용액 -> 몰: "농도 c 를 곱한다"

메모: {
  label: "질량에서 개수로 바로 가는 화살표는 없다\n반드시 몰을 거쳐야 한다"
  style.stroke-dash: 3
}
