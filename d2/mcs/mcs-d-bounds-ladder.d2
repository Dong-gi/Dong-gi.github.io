# 편차 한계의 사다리 — mcs 22장.
#
# 무엇을 읽어야 하나: 한계의 세기는 <b>확률변수에 대해 무엇을 아는가</b>로 정해진다.
# 아래로 내려갈수록 아는 것이 늘고, 그만큼 꼬리를 좁게 잡는다.
# 오른쪽 열은 그 한계가 얼마나 빨리 떨어지는가다 — 다항식이냐 지수냐가 갈림길이다.
direction: right

아는것: {
  label: "확률변수 R 에 대해 아는 것"
  style.bold: true

  평균: { label: "① 기댓값 Ex[R] 과\nR ≥ 0" }
  분산: { label: "② 위에 더해\n분산 Var[R]" }
  독립합: { label: "③ 위에 더해\nR = T₁ + ⋯ + Tₙ 이고\n각 Tᵢ ∈ [0,1] 이며 상호 독립"; style.bold: true }

  평균 -> 분산: 더 안다
  분산 -> 독립합: 더 안다
}

한계: {
  label: "그래서 쓸 수 있는 한계"
  style.bold: true

  마르코프: { label: "마르코프\nPr[R ≥ x] ≤ Ex[R]/x\nPr[R ≥ c·Ex[R]] ≤ 1/c" }
  체비쇼프: { label: "체비쇼프\nPr[|R − μ| ≥ x] ≤ Var[R]/x²\nPr[|R − μ| ≥ cσ] ≤ 1/c²" }
  체르노프: { label: "체르노프\nPr[R ≥ c·Ex[R]] ≤ e^(−β(c)·Ex[R])\nβ(c) = c ln c − c + 1"; style.bold: true }

  마르코프 -> 체비쇼프: "|R − μ|² 에 마르코프를 쓴다"
  체비쇼프 -> 체르노프: "cᴿ 에 마르코프를 쓴다"
}

세기: {
  label: "떨어지는 속도"
  style.bold: true

  일차: { label: "1/c — 다항식" }
  이차: { label: "1/c² — 다항식" }
  지수: { label: "e^(−βμ) — 지수"; style.bold: true }
}

아는것.평균 -> 한계.마르코프
아는것.분산 -> 한계.체비쇼프
아는것.독립합 -> 한계.체르노프
한계.마르코프 -> 세기.일차
한계.체비쇼프 -> 세기.이차
한계.체르노프 -> 세기.지수

뿌리: {
  label: "세 한계가 모두 마르코프 하나에서 나온다. 요령은 R 에 함수를 씌우고 그 함수에 마르코프를 쓰는 것이다.\n제곱을 씌우면 체비쇼프가 되고 지수를 씌우면 체르노프가 된다. 지수를 씌울 수 있는 것은 곱의 기댓값을\n쪼갤 수 있을 때뿐이고, 그래서 체르노프만 상호 독립을 요구한다."
  shape: text
}
한계.체르노프 -> 뿌리

한쪽: {
  label: "마르코프와 체르노프는 위쪽 꼬리만 잡는다(체르노프는 n − R 에 다시 써서 아래쪽도 잡는다).\n체비쇼프는 절댓값이므로 양쪽을 함께 잡는다. 어느 쪽을 묻는지 확인하고 골라야 한다."
  shape: text
}
세기.지수 -> 한쪽
