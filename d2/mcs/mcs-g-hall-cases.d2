# 홀의 정리 증명의 두 경우 — mcs 14장.
#
# 무엇을 읽어야 하나: 강한 귀납법에서 왜 경우를 둘로 나누어야 하는지가 이 그림의 요점이다.
# 여유가 있으면 아무나 하나 짝지어 보내고, 여유가 없으면 꽉 찬 덩어리를 통째로 떼어낸다.
direction: down

가정: {
  label: "지원자 m+1 명. 어떤 부분집합 S 를 골라도 |N(S)| ≥ |S| 다\n(병목이 하나도 없다)"
  style.bold: true
}

갈림: {
  label: "크기 m 이하인 공집합 아닌 부분집합 중에\n원소 수와 이웃 수가 똑같은 것이 있는가"
  shape: diamond
  style.bold: true
}
가정 -> 갈림

경우1: {
  label: "경우 1 — 없다. 모든 부분집합이 자기보다 큰 이웃을 갖는다"
  style.bold: true

  가: { label: "지원자 아무나 한 명과\n그가 할 수 있는 일 하나를 짝지어\n둘을 함께 빼낸다" }
  나: { label: "남은 지원자 m 명에 대해\n어떤 부분집합의 이웃도 하나만 줄어드는데\n원래 여유가 하나 이상 있었으므로\n병목이 새로 생기지 않는다" }
  다: { label: "귀납 가정으로 m 명을 짝지운다" }
  가 -> 나 -> 다
}

경우2: {
  label: "경우 2 — 있다. 크기 k ≤ m 인 X 와 |N(X)| = k 인 Y = N(X)"
  style.bold: true

  가: { label: "X 안에서도 병목이 없으므로\n귀납 가정으로 X 를 Y 에 짝지운다" }
  나: { label: "남은 문제는 지원자 X 밖 사람들을\n일자리 Y 밖 것들에 짝짓는 것" }
  다: { label: "여기에도 병목이 없다 —\nX 밖의 M' 이 Y 밖에서 부족했다면\nM' ∪ X 가 원래 그래프에서 병목이 된다" }
  라: { label: "귀납 가정으로 나머지를 짝지운다" }
  가 -> 나 -> 다 -> 라
}

갈림 -> 경우1.가: "여유가 있다"
갈림 -> 경우2.가: "꽉 찬 덩어리가 있다"

결론: {
  label: "두 경우 모두 m+1 명의 매칭을 얻었다.\n경우 2 에서 크기가 k 와 m+1−k 인 두 문제로 쪼개지므로\n보통 귀납법이 아니라 강한 귀납법이 필요하다"
  shape: text
  style.bold: true
}
경우1.다 -> 결론
경우2.라 -> 결론
