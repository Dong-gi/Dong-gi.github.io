# 구조적 귀납법 — mcs 9장.
#
# 무엇을 읽어야 하나: 자료형의 정의와 증명의 모양과 함수의 정의가 셋 다 같은 두 줄을 갖는다는 것이 요점이다.
# 왼쪽 열을 정하면 가운데와 오른쪽 열이 따라 정해진다. 그래서 재귀적 정의를 잘 세우는 일이 반이다.
direction: right

자료형: {
  label: "자료형의 정의\n· 기저: 이것들은 R 에 속한다\n· 구성자: R 의 원소에서 새 원소를 만드는 방법"
  style.bold: true
}
증명: {
  label: "구조적 귀납법\n· 기저마다 P 가 참임을 보인다\n· 구성자마다, 재료가 P 를 만족하면\n  결과도 P 를 만족함을 보인다"
  style.bold: true
}
함수: {
  label: "재귀 함수의 정의\n· 기저에서의 값을 정한다\n· 구성자마다, 재료에서의 값으로\n  결과에서의 값을 정한다"
  style.bold: true
}

자료형 -> 증명: "같은 갈래를 따라간다"
자료형 -> 함수: "같은 갈래를 따라간다"

결론: { label: "R 의 모든 원소가 P 를 만족한다"; shape: oval; style.bold: true }
증명 -> 결론

특수: {
  label: "ℕ 도 재귀적 자료형이다 — 기저는 0, 구성자는 n ↦ n+1.\n그 위의 구조적 귀납법이 곧 7장의 보통 귀납법이다.\n문자열의 구조적 귀납법은 길이에 대한 귀납법과 같고, 나무에서는 그런 대응이 늘 있는 것은 아니다"
  shape: text
}

모호: {
  label: "함수를 정의하려면 정의가 모호하지 않아야 한다.\n같은 원소를 두 길로 만들 수 있으면 그 원소에서 함수값이 두 개 나올 수 있다.\n집합에 대한 귀납법은 모호한 정의로도 되지만, 함수 정의는 안 된다"
  shape: text
}
