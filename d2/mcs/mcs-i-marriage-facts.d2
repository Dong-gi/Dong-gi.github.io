# 안정 결혼 — 무엇을 어떤 도구로 증명하는가. mcs 8장.
#
# 무엇을 읽어야 하나: 네 가지 결론이 모두 두 불변량 P, Q 와 측도 하나에서 나온다.
# 어느 화살표가 어느 도구에서 나오는지 따라가면 이 절의 구조가 보인다.
direction: right

측도: { label: "측도\n목록에 남은 이름의 총 개수\n하루에 적어도 하나 줄고 늘지 않는다"; style.bold: true }
p: {
  label: "불변량 P\n여자 w 가 남자 m 의 목록에서 지워졌다면\nw 는 m 보다 좋은 구혼자를 갖고 있다"
  style.bold: true
}
q: {
  label: "불변량 Q\nw 가 m 의 목록에서 지워졌다면\nw 는 m 에게 가망 없는 상대다"
  style.bold: true
}

끝난다: { label: "결혼하는 날이 온다\nn² 일 안에" }
모두: { label: "모두 결혼한다\n짝 없이 남는 사람이 없다" }
안정: { label: "안정하다\n불량 짝이 없다"; style.bold: true }
남자: { label: "남자는 가망 있는 최선의 짝을 얻는다\n여자는 가망 있는 최악의 짝을 얻는다"; style.bold: true }

측도 -> 끝난다: "정렬성 원리"
p -> 모두: "짝 없는 남자의 목록은 비었다"
p -> 안정: "경우 1"
안정 -> 남자: { style.stroke-dash: 3 }
q -> 남자: "지워진 여자는 모두 가망 없었다"
모두 -> 안정: { style.stroke-dash: 3 }

가망: {
  label: "가망 있는 짝(feasible spouse): 어떤 안정한 짝짓기에서 그 사람과 결혼하는 상대.\n안정한 짝짓기가 적어도 하나 있다는 것(구혼 의식의 결과)을 먼저 알아야 이 말이 뜻을 갖는다.\n그래서 증명 순서를 바꿀 수 없다"
  shape: text
}

역설: {
  label: "직관과 반대되는 결론: 매일 고르고 거절하는 쪽은 여자인데도 유리한 쪽은 남자다.\n남자가 세레나데하는 상대는 나빠지기만 하고 여자의 최선 구혼자는 좋아지기만 하니\n여자가 유리해 보이지만, 여자가 고르는 것은 ‘온 사람 중에서’ 일 뿐이다"
  shape: text
}
