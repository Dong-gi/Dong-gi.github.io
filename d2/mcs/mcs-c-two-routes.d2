# 선형 점화식을 푸는 두 길 — mcs 18장(과 24장).
#
# 무엇을 읽어야 하나: 두 길은 같은 다항식(분모 vs 특성다항식)의 뿌리를 본다.
# 이 장은 왼쪽 길을 걷고, 24장이 오른쪽 길을 걷는다. 두 길이 만나는 자리가 아래 상자다.
direction: down

점화식: {
  label: "선형 점화식\nf(n) = c₁f(n−1) + ⋯ + c_d f(n−d) + h(n)"
  shape: oval
  style.bold: true
}

생성함수길: {
  label: "이 장의 길 — 생성함수"
  style.bold: true

  접기: { label: "① 수열을 F(x) 로 접는다" }
  방정식: { label: "② 이동 규칙으로 F 에 대한 일차방정식을 만든다" }
  분수: { label: "③ 풀면 F(x) = p(x) / q(x) 가 나온다\nq(x) = 1 − c₁x − ⋯ − c_d xᵈ"; style.bold: true }
  부분분수: { label: "④ 부분분수로 1/(1 − αx) 꼴의 합으로 쪼갠다" }
  계수: { label: "⑤ 각 조각의 계수를 읽어 더한다" }

  접기 -> 방정식 -> 분수 -> 부분분수 -> 계수
}

특성근길: {
  label: "24장의 길 — 특성근"
  style.bold: true

  대입: { label: "① f(n) = xⁿ 을 넣어 본다" }
  특성: { label: "② 특성다항식 xᵈ − c₁x^(d−1) − ⋯ − c_d = 0 의 뿌리를 구한다"; style.bold: true }
  일반해: { label: "③ 뿌리마다 항을 만들어 선형결합한다" }
  초기: { label: "④ 초기 조건으로 계수를 정한다" }

  대입 -> 특성 -> 일반해 -> 초기
}

점화식 -> 생성함수길.접기
점화식 -> 특성근길.대입

만남: {
  label: "두 길은 같은 다항식을 본다"
  style.bold: true
}
생성함수길.계수 -> 만남
특성근길.초기 -> 만남

같음: {
  label: "q(x) = 1 − c₁x − ⋯ − c_d xᵈ 의 뿌리 r 과 특성다항식의 뿌리 α 는 서로 역수다(α = 1/r).\n그래서 부분분수의 1/(1 − αx) 에서 나오는 αⁿ 이 곧 특성근의 거듭제곱이다.\n중복근이 있으면 두 길 모두 nᵏαⁿ 꼴의 항이 나온다 — 생성함수 쪽에서는 1/(1 − αx)ᵏ 의 계수가 그 모양이다"
  shape: text
}

어느쪽: {
  label: "어느 쪽이 편한가: 비동차항 h(n) 이 있으면 생성함수 쪽이 편하다.\nh 의 생성함수를 방정식에 그냥 더하면 되고 특별한 요령이 필요하지 않다(하노이 탑이 그 예다).\n반대로 뿌리만 알면 되는 상황 — 자라는 속도만 궁금할 때 — 은 특성근 쪽이 빠르다"
  shape: text
}
