# 함의와 동치를 증명하는 네 가지 길 — mcs 3장.
#
# 무엇을 읽어야 하나: 목표의 모양이 방법을 정한다. 왼쪽에서 목표를 읽고
# 오른쪽으로 가면 첫 문장까지 정해진다. 각 상자의 둘째 줄이 실제로 종이에 쓸 첫 문장이다.
direction: right

함의: { label: "P → Q 를 보여야 한다"; shape: oval; style.bold: true }
동치: { label: "P ↔ Q 를 보여야 한다"; shape: oval; style.bold: true }

직접: { label: "직접증명\n‘P 라고 가정하자.’\n그다음 Q 까지 밀고 간다" }
대우: { label: "대우증명\n‘대우를 증명한다: ¬Q → ¬P.’\n그다음 직접증명과 같다" }
귀류: { label: "귀류법\n‘모순을 이끌어 낸다. P 이고 ¬Q 라 하자.’\n어딘가에서 모순을 찾는다" }

양방향: { label: "양방향\n‘먼저 P → Q 를, 다음에 Q → P 를 보인다.’\n각각은 위의 세 방법 중 하나로" }
사슬: { label: "동치 사슬\n‘iff 사슬을 만든다.’\nP ↔ R₁ ↔ R₂ ↔ … ↔ Q" }

함의 -> 직접: "P 를 식으로 적을 수 있다"
함의 -> 대우: "¬Q 가 P 보다 다루기 쉽다"
함의 -> 귀류: "결론이 ‘그런 것은 없다’ 꼴이다"
동치 -> 양방향: "두 방향의 사정이 다르다"
동치 -> 사슬: "모든 단계를 동치로 이을 수 있다"

주의: {
  label: "대우증명과 귀류법은 형제다.\n대우증명은 ¬Q 하나만 가정하고, 귀류법은 P 와 ¬Q 를 함께 가정한다.\n¬(P → Q) ≡ P ∧ ¬Q 가 그 근거다"
  shape: text
}

밑작업: {
  label: "어느 길을 가든 밑작업(scratchwork)이 먼저다.\n종이 한 장에 막 계산해 보고, 왜 참인지 알아낸 다음에 증명을 쓴다.\n밑작업을 그대로 제출하면 읽는 사람이 길을 잃는다"
  shape: text
}
