# 선형 점화식 조리법 다섯 걸음 — mcs 24장.
#
# 무엇을 읽어야 하나: 다섯 걸음의 순서와, 각 걸음에서 <b>왜</b> 그렇게 하는지다.
# 오른쪽 열은 하노이 변형 f(n) = 2f(n−1) + n, f(1) = 1 을 실제로 따라간 것이다.
direction: right

걸음: {
  label: "다섯 걸음"
  style.bold: true

  일: { label: "① 비동차항 g(n) 을 0 으로 놓고\n특성방정식의 뿌리를 구한다\nxᵈ = a₁xᵈ⁻¹ + ⋯ + a_d"; style.bold: true }
  이: { label: "② 동차해를 적는다\n겹치지 않는 뿌리 r 은 c·rⁿ 을,\n중복도 k 인 뿌리는\nd₁rⁿ, d₂n rⁿ, ⋯, d_k n^(k−1) rⁿ 을 낳는다" }
  삼: { label: "③ 특수해 하나를 찾는다\n경계조건은 무시한다.\ng 가 다항식이면 같은 차수의 다항식부터,\ng 가 지수 cⁿ 이면 a·cⁿ 부터 시도한다"; style.bold: true }
  사: { label: "④ 일반해 = 동차해 + 특수해" }
  오: { label: "⑤ 경계조건을 넣어 상수를 정한다\n조건 하나가 일차방정식 하나를 준다" }

  일 -> 이 -> 삼 -> 사 -> 오
}

예: {
  label: "하노이 변형 — 원판 옮기기에 크기만큼 시간이 든다"
  style.bold: true

  예1: { label: "f(n) = 2f(n−1) 로 놓으면 x = 2" }
  예2: { label: "동차해 f(n) = c·2ⁿ" }
  예3: { label: "g(n) = n 이므로 f(n) = an + b 로 시도한다.\nan + b = 2(a(n−1) + b) + n 을 정리하면\n0 = (a + 1)n + (b − 2a) 이므로 a = −1, b = −2.\n특수해는 f(n) = −n − 2"; style.bold: true }
  예4: { label: "일반해 f(n) = c·2ⁿ − n − 2" }
  예5: { label: "f(1) = 1 이므로 2c − 3 = 1, c = 2.\n답은 f(n) = 2·2ⁿ − n − 2"; style.bold: true }

  예1 -> 예2 -> 예3 -> 예4 -> 예5
}

걸음.일 -> 예.예1
걸음.이 -> 예.예2
걸음.삼 -> 예.예3
걸음.사 -> 예.예4
걸음.오 -> 예.예5

왜더하나: {
  label: "왜 동차해를 더해도 되는가: 동차 선형 점화식의 해는 선형결합에 닫혀 있다.\ns·f(n) + t·h(n) 을 점화식에 넣고 항을 모으면 다시 같은 점화식이 나온다(장 본문에서 증명한다).\n그래서 특수해 하나에 동차해를 더한 것이 여전히 해이고, 경계조건을 맞출 자유가 상수만큼 생긴다."
  shape: text
}
걸음.사 -> 왜더하나

읽기: {
  label: "답을 읽는 법: 2·2ⁿ − n − 2 는 2ⁿ − 1 의 약 두 배다. 한 번의 추가 작업을 1 에서 n 으로 늘렸는데\n답은 두 배밖에 늘지 않았다 — 부분문제의 크기와 개수가 지배하고 추가 작업은 상수배만 바꾼다는 감각이다."
  shape: text
}
예.예5 -> 읽기
