# 옷 입기 DAG 와 병렬 일정 — mcs 12장.
#
# 무엇을 읽어야 하나: 상자 하나가 한 단계다. 한 단계 안의 작업들 사이에는 화살표가 없고
# (그래서 동시에 해도 된다) 화살표는 늘 왼쪽 상자에서 오른쪽 상자로만 간다.
# 셔츠 → 바지 → 벨트 → 재킷 이 크기 4 인 사슬이고, 그래서 4 단계보다 빨리 끝낼 수 없다.
direction: right

단계1: {
  label: "1단계 — 깊이 0\n먼저 할 일이 없는 것들"
  style.bold: true
  속옷
  셔츠: { style.bold: true }
  왼양말
  오른양말
}

단계2: {
  label: "2단계 — 깊이 1"
  style.bold: true
  바지: { style.bold: true }
  넥타이
}

단계3: {
  label: "3단계 — 깊이 2"
  style.bold: true
  벨트: { style.bold: true }
  왼구두
  오른구두
}

단계4: {
  label: "4단계 — 깊이 3"
  style.bold: true
  재킷: { style.bold: true }
}

단계1.속옷 -> 단계2.바지
단계1.셔츠 -> 단계2.바지
단계1.셔츠 -> 단계2.넥타이
단계2.바지 -> 단계3.벨트
단계2.바지 -> 단계3.왼구두
단계2.바지 -> 단계3.오른구두
단계1.왼양말 -> 단계3.왼구두
단계1.오른양말 -> 단계3.오른구두
단계3.벨트 -> 단계4.재킷
단계2.넥타이 -> 단계4.재킷

사슬: {
  label: "굵게 적은 셔츠 · 바지 · 벨트 · 재킷 이 임계 경로다.\n넷이 서로 견줄 수 있으므로 어떤 두 개도 같은 단계에 둘 수 없고,\n따라서 프로세서를 무한히 많이 주어도 4 단계가 최소다"
  shape: text
}

반사슬: {
  label: "상자 하나가 반사슬이다 — 상자 안의 어떤 두 작업 사이에도 길이 없다.\n상자 수가 곧 최대 사슬의 크기이고, 그것이 최소 병렬 시간이다"
  shape: text
}
