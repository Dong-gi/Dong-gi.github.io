# 망을 견주는 다섯 척도와 그 사이의 맞바꿈 — mcs 13장.
#
# 무엇을 읽어야 하나: 왼쪽 넷은 재는 것이고 오른쪽 하나(이분폭)는 하한을 주는 것이다.
# 화살표는 '이것이 저것을 제한한다'는 뜻이다. 어느 척도도 혼자서는 좋은 망을 고르지 못한다.
direction: right

재는것: {
  label: "무엇을 재는가"
  style.bold: true

  지름: { label: "지름\n입력에서 출력까지\n가장 먼 최단경로의 길이\n= 최악의 지연" }
  크기: { label: "스위치 크기\n한 스위치에 붙는\n들어오는 선과 나가는 선의 수\n= 부품 하나의 값" }
  개수: { label: "스위치 수\n망 전체가 쓰는\n스위치의 개수\n= 전체 값" }
  혼잡도: { label: "혼잡도\n가장 나쁜 순열에 대해\n가장 좋은 라우팅을 골랐을 때\n한 스위치에 몰리는 경로 수" }
}

이분폭: {
  label: "이분폭\n입력 절반과 출력 절반을\n떼어내려면 끊어야 하는\n최소 간선 수"
  style.bold: true
}

이분폭 -> 재는것.혼잡도: "혼잡도 ≥ (N/2) / 이분폭\n(비둘기집 원리)"

맞바꿈: {
  label: "맞바꿈이 일어나는 곳"
  style.bold: true

  하나: { label: "지름을 줄이려고 스위치를 크게 하면\n문제를 스위치 속에 숨긴 것이 된다" }
  둘: { label: "혼잡도를 1 로 낮추려면 이분폭이\nN/2 이상이어야 하고, 배선이 늘어난다" }
  셋: { label: "스위치를 아끼면 허리가 얇아지고,\n허리가 얇으면 혼잡도가 커진다" }
}

재는것.크기 -> 맞바꿈.하나
재는것.혼잡도 -> 맞바꿈.둘
재는것.개수 -> 맞바꿈.셋
재는것.지름 -> 맞바꿈.하나

결론: {
  label: "그래서 표 하나로 견주어야 한다.\n다섯 칸을 모두 좋게 만든 것이 베네시망이고,\n그 값은 스위치 수 2N log N 이다"
  shape: text
  style.bold: true
}
맞바꿈 -> 결론
