# 한정사를 부정하는 법 — mcs 5장.
#
# 무엇을 읽어야 하나: 부정 기호를 안으로 한 칸 밀 때마다 한정사가 뒤바뀐다.
# 위에서 아래로 한 줄씩 내려가면 마지막에 부정이 술어에만 붙는다.
direction: down

원식: { label: "¬ ∀x ∃y. P(x, y)"; style.bold: true }
한칸: { label: "∃x ¬ ∃y. P(x, y)\n∀ 를 지나며 ∃ 로 바뀌었다" }
두칸: { label: "∃x ∀y. ¬P(x, y)\n∃ 를 지나며 ∀ 로 바뀌었다"; style.bold: true }

원식 -> 한칸: "¬ 를 ∀ 안으로"
한칸 -> 두칸: "¬ 를 ∃ 안으로"

말로: {
  label: "말로 읽으면\n원식: ‘모든 x 마다 그런 y 가 있다’ 가 아니다\n결과: ‘어떤 x 에 대해서는 어떤 y 도 안 된다’"
  shape: text
}

드모르간: {
  label: "왜 그런가 — 드모르간 법칙을 무한히 늘린 것이다.\n∀x. P(x) 는 P(d₀) ∧ P(d₁) ∧ … 이고 ∃x. P(x) 는 P(d₀) ∨ P(d₁) ∨ … 이다.\n¬(A ∧ B) ≡ ¬A ∨ ¬B 를 무한 개에 적용하면 위의 규칙이 나온다"
  shape: text
}

쓸모: {
  label: "이 규칙이 반례의 근거다.\n전칭명제 ∀x. P(x) 를 부정하면 ∃x. ¬P(x) 이므로,\n반례 하나를 내놓는 것으로 전칭명제를 무너뜨릴 수 있다"
  shape: text
}
