# 정지 문제 증명의 흐름 — mcs 10장.
#
# 무엇을 읽어야 하나: 위에서 아래로 내려가는 줄기 하나가 증명 전부다.
# 오른쪽 갈래들은 ‘그래도 이렇게 하면 되지 않는가’ 라는 물음과 그 답이다.
direction: down

전제: {
  label: "프로그램은 문자열로 적힌다\n문자열 s 를 프로그램으로 읽은 것을 P(s) 라 하고,\n프로그램으로 읽을 수 없는 s 에 대해서는 아무것도 인식하지 않는 프로그램으로 정한다"
  style.bold: true
}

언어: { label: "lang(P) ::= { s : 프로그램 P 를 s 에 돌리면 멈춘다 }\n어떤 프로그램 P 에 대해 L = lang(P) 이면 L 을 인식 가능하다고 한다" }

집합: { label: "안멈춤 ::= { s : P(s) 를 s 에 돌리면 멈추지 않는다 }\n= { s : s ∉ lang(P(s)) }"; style.bold: true }

가정: { label: "모순을 노려, 어떤 프로그램이 안멈춤 을 인식한다고 하자.\n그 프로그램의 코드를 s₀ 라 하면 안멈춤 = lang(P(s₀)) 다" }

모순: {
  label: "정의에 s = s₀ 를 넣는다\ns₀ ∈ 안멈춤  ↔  s₀ ∉ lang(P(s₀))  =  s₀ ∉ 안멈춤\n모순이다"
  style.bold: true
}

결론: { label: "안멈춤 은 어떤 프로그램으로도 인식할 수 없다"; shape: oval; style.bold: true }

전제 -> 언어 -> 집합 -> 가정 -> 모순 -> 결론

물음1: { label: "그냥 돌려 보면 되지 않는가?\n멈추는 것은 그렇게 알 수 있다.\n어려운 것은 ‘멈추지 않는다’ 를\n유한한 시간에 판정하는 일이다" }
물음2: {
  label: "다른 언어로 쓰면 되지 않는가?\n한 언어의 해석기를 다른 언어로 쓸 수 있으므로\nC++ 로 자바의 안멈춤 을 인식할 수 있다면\n자바로도 할 수 있다. 그래서 언어를 바꿔도 안 된다"
}
물음3: {
  label: "실전에서는 되지 않는가?\n임의의 프로그램에 대해 완벽하게는 안 된다.\n그래서 어떤 타입 검사기도 문제없는 프로그램을\n어쩔 수 없이 몇 개는 거절한다"
}

결론 -> 물음1: { style.stroke-dash: 3 }
결론 -> 물음2: { style.stroke-dash: 3 }
결론 -> 물음3: { style.stroke-dash: 3 }

대각선: {
  label: "이 증명은 칸토어 정리의 증명과 같은 논증이다.\n칸토어 쪽에서 ‘a 가 g(a) 에 들어 있는가’ 를 뒤집었고,\n여기서는 ‘s 가 lang(P(s)) 에 들어 있는가’ 를 뒤집었다. 대각선 하나가 두 정리를 낳는다"
  shape: text
}
