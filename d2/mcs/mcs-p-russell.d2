# 러셀의 역설과 그 뒤처리 — mcs 6장.
#
# 무엇을 읽어야 하나: 왼쪽 줄기는 모순으로 끝난다. 그래서 오른쪽처럼 규칙을 고쳤다.
# 요점은 ‘조건이면 무엇이든 집합이 된다’ 를 버렸다는 것이다.
direction: down

소박: {
  label: "소박한 규칙\n어떤 조건이든 그 조건을 만족하는 것을 모으면 집합이다"
  style.bold: true
}

정의: { label: "S ::= { x | x ∉ x }\n자기 자신을 원소로 갖지 않는 것 전부" }
질문: { label: "S ∈ S 인가"; shape: diamond; style.bold: true }

예: { label: "S ∈ S 라 하자\n그러면 S 는 S 의 조건을 만족해야 하니 S ∉ S" }
아니오: { label: "S ∉ S 라 하자\n그러면 S 는 조건을 만족하므로 S ∈ S" }
모순: { label: "어느 쪽이든 모순이다"; style.bold: true; style.stroke-width: 3 }

소박 -> 정의 -> 질문
질문 -> 예: "그렇다"
질문 -> 아니오: "아니다"
예 -> 모순
아니오 -> 모순

고침: {
  label: "고친 규칙(ZFC 의 분리 공리)\n이미 있는 집합에서 조건으로 부분을 잘라내는 것만 허용한다\n{ x ∈ A | P(x) } 는 되지만 { x | P(x) } 는 안 된다"
  style.bold: true
}
모순 -> 고침: "규칙을 좁힌다"

결과: {
  label: "그러면 위의 S 는 애초에 만들어지지 않는다.\n무엇을 담을지 정하기 전에 어디에서 잘라낼지를 먼저 말해야 하기 때문이다"
  shape: text
}

주의: {
  label: "이 문서는 대체로 소박한 뜻의 집합을 쓴다.\n다만 ‘모든 집합의 집합’ 처럼 크기에 제한이 없는 모임을 만들면 위험하다는 것은 기억할 만하다.\n집합의 논리를 제대로 다루는 것은 10장이다"
  shape: text
}
