# 귀납 증명의 정형 — mcs 7장.
#
# 무엇을 읽어야 하나: 다섯 단계 중 넷은 문제가 바뀌어도 문장이 거의 같다.
# ④ 만 매번 다르고, 거기서 하는 일은 언제나 ‘가정한 식에 무언가를 더해 목표 식으로 만드는 것’ 이다.
# 4장 WOP 정형과 나란히 놓고 보면 ③ 이 대응하는 자리가 어디인지 보인다.
direction: down

목표: { label: "모든 n ∈ ℕ 에 대해 P(n) 이 참임을 보이려 한다"; shape: oval; style.bold: true }

선언: { label: "① 귀납법을 쓴다고 밝힌다\n독자가 증명의 뼈대를 미리 알게 된다" }
가설: {
  label: "② 귀납 가설 P(n) 을 명시한다\n증명하려는 명제에서 그대로 떼어 오는 것이 보통이지만,\n막히면 더 센 명제로 바꾼다"
  style.bold: true
}
기저: { label: "③ 기저 단계 — P(0) 을 증명한다\n한 걸음이 두 칸이면 P(0), P(1) 두 개를 확인해야 한다" }
귀납: {
  label: "④ 귀납 단계 — 모든 n 에 대해 P(n) → P(n+1) 을 증명한다\n여기만 문제마다 다르다. P(n) 을 가정하고 P(n+1) 을 얻는다"
  style.bold: true
}
결론: { label: "⑤ 귀납법에 의해 모든 n 에서 P(n) 이 참이다\n너무 표준적이라 생략하는 일이 많다" }

목표 -> 선언 -> 가설 -> 기저 -> 귀납 -> 결론

주의1: {
  label: "가장 자주 나는 잘못은 ② 를 적지 않는 것이다.\n무엇을 n 으로 삼았는지, 변수가 여럿이면 어느 것으로 귀납하는지 밝히지 않으면\n④ 에서 무엇을 가정했는지 스스로도 헷갈린다"
  shape: text
}

주의2: {
  label: "두 번째로 자주 나는 잘못은 ④ 의 논증이 작은 n 에서 통하지 않는 것이다.\n‘나머지 것들’ 이나 ‘가운데’ 같은 말을 쓰면 n 이 작을 때 그런 것이 없을 수 있다.\n말 색깔 가짜 증명이 정확히 이 자리에서 무너진다"
  shape: text
}
