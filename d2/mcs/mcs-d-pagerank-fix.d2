# 페이지랭크가 만들어진 순서 — mcs 23장.
#
# 무엇을 읽어야 하나: 순위 매기기의 두 시도가 각각 어떤 공격에 무너지고,
# 무작위 행보가 그 공격을 어떻게 막는지다. 마지막 상자(슈퍼 정점)는 수학적 필요에서 나왔다 —
# 정상분포가 유일하고 도달 가능하려면 그래프가 강하게 연결되어 있어야 한다.
direction: down

시도1: {
  label: "첫 시도 — 낱말만 센다"
  style.bold: true

  낱말: { label: "검색어가 문서에 몇 번 나오는가" }
  공격: { label: "무너지는 방식\n첫 화면에 ‘수학 수학 ⋯ 수학’ 을 200번 적으면 1등이 된다" }
  낱말 -> 공격
}

시도2: {
  label: "둘째 시도 — 진입 차수를 센다"
  style.bold: true

  차수: { label: "Rank(x) ::= indeg(x)\n나를 가리키는 링크가 곧 표다" }
  공격1: { label: "무너지는 방식 ①\n허수아비 페이지 1000개를 만들어\n내 페이지를 가리키게 한다" }
  공격2: { label: "무너지는 방식 ②\n한 페이지가 링크를 잔뜩 뿌려\n여러 페이지를 한꺼번에 밀어 준다" }
  차수 -> 공격1
  차수 -> 공격2
}

시도3: {
  label: "셋째 시도 — 무작위 행보"
  style.bold: true

  행보: { label: "페이지 x 에서 나가는 링크를\n각각 1/outdeg(x) 확률로 따른다"; style.bold: true }
  막기1: { label: "①이 막힌다\n허수아비를 아무도 가리키지 않으므로\n허수아비에 머물 확률이 거의 0 이고,\n0 을 나눠 주어도 0 이다"; style.bold: true }
  막기2: { label: "②가 막힌다\n한 표의 무게가 1/outdeg 로 쪼개진다.\n링크를 많이 뿌리면 한 표씩이 가벼워진다"; style.bold: true }
  행보 -> 막기1
  행보 -> 막기2
}

시도1.공격 -> 시도2.차수: 링크를 보자
시도2.공격1 -> 시도3.행보: 표에 무게를 주자
시도2.공격2 -> 시도3.행보

보수: {
  label: "남은 두 문제 — 수학이 요구하는 것"
  style.bold: true

  막다른: { label: "나가는 링크가 없는 페이지에 갇힌다" }
  안유일: { label: "정상분포가 여럿이거나\n출발점에 따라 수렴하지 않는다" }
  슈퍼: { label: "슈퍼 정점을 더한다\n모든 페이지에서 슈퍼 정점으로 가는 간선을 놓고(확률 0.15),\n슈퍼 정점에서 모든 페이지로 균등하게 나간다.\n원래 링크 n 개는 각각 0.85/n 이 된다"; style.bold: true }
  강연결: { label: "그래프가 강하게 연결된다\n→ 정상분포가 유일하고, 어디서 출발해도 그것에 가까워진다"; style.bold: true }

  막다른 -> 슈퍼
  안유일 -> 슈퍼
  슈퍼 -> 강연결
}

시도3.막기1 -> 보수.막다른
시도3.막기2 -> 보수.안유일

정의: {
  label: "페이지랭크의 정의 — 정상분포\nRank(x) = Σ Rank(y)/outdeg(y)   (y → x 인 간선마다)\nΣ Rank(x) = 1"
  style.bold: true
}
보수.강연결 -> 정의

계산: {
  label: "정점이 n 개면 미지수 n 개에 방정식 n + 1 개다. 마지막 줄이 없으면 모두 0 도 답이 되므로 반드시 넣는다.\n실제로는 방정식을 풀지 않고 균등분포에서 시작해 행보를 되풀이한다 — 강하게 연결되어 있으므로 수렴한다.\n선형대수의 말로는 Rank 가 전이행렬의 고윳값 1 에 대한 고유벡터다."
  shape: text
}
정의 -> 계산
