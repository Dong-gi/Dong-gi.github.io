# 평면 그래프의 5색 정리 — 증명의 경우 나누기. mcs 15장.
#
# 무엇을 읽어야 하나: 차수 5 이하인 정점이 반드시 있다는 것이 출발점이고,
# 차수가 정확히 5 일 때만 손이 더 간다. 그때 이웃 둘을 합쳐 색을 아껴 쓰는 것이 요령이다.
direction: down

출발: {
  label: "모든 평면 그래프에는 차수 5 이하인 정점이 있다\n(간선 수 상한 e ≤ 3v − 6 과 악수 보조정리에서 나온다)"
  style.bold: true
}

고르기: {
  label: "그런 정점 g 를 하나 고른다"
  style.bold: true
}
출발 -> 고르기

갈림: {
  label: "deg(g) 가 5 보다 작은가"
  shape: diamond
  style.bold: true
}
고르기 -> 갈림

경우1: {
  label: "경우 1 — deg(g) ≤ 4"
  style.bold: true

  가: { label: "g 를 지운다. 부분그래프도 평면이므로\n귀납 가정으로 5색 칠한다" }
  나: { label: "g 를 되붙인다. 이웃이 4 개 이하이므로\n쓰이지 않은 색이 반드시 남는다" }
  가 -> 나
}

경우2: {
  label: "경우 2 — deg(g) = 5"
  style.bold: true

  가: { label: "이웃 다섯이 서로 모두 인접하다면\n그 다섯이 K₅ 를 이루어 평면이 아니게 된다.\n그러므로 인접하지 않은 이웃 n₁, n₂ 가 있다" }
  나: { label: "g 와 n₁ 을 합치고, 그 결과를 다시 n₂ 와 합친다.\n인접한 정점끼리 합치므로 평면성이 유지되고\n정점이 하나 줄어든다" }
  다: { label: "귀납 가정으로 5색 칠한다.\n합쳐진 정점의 색을 n₁ 과 n₂ 에 똑같이 준다" }
  라: { label: "n₁ 과 n₂ 가 같은 색이므로\ng 의 이웃 다섯이 색을 4 가지만 쓴다.\n남은 색 하나를 g 에 준다" }
  가 -> 나 -> 다 -> 라
}

갈림 -> 경우1.가: "예"
갈림 -> 경우2.가: "아니오"

결론: {
  label: "두 경우 모두 5색 칠하기를 얻었다.\n4색으로 줄이는 것은 훨씬 어렵고, 1970년대에\n컴퓨터로 경우를 잔뜩 검사해서야 증명되었다"
  shape: text
  style.bold: true
}
경우1.나 -> 결론
경우2.라 -> 결론
