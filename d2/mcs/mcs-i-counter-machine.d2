# 99 유계 계수기의 전이도 — mcs 8장.
#
# 무엇을 읽어야 하나: 상태 기계는 상태 집합 하나, 시작 상태 하나, 그리고 전이 관계 하나가 전부다.
# 넘침 상태에서 나가는 화살표가 자기 자신으로만 간다는 것이 요점이다 —
# 한 번 들어가면 나올 수 없는 상태를 흡수 상태라 하고, 오류 처리가 대개 이 모양이다.
direction: right

시작: { label: "시작 상태"; shape: text }
s0: { label: "0"; shape: circle; style.bold: true }
s1: { label: "1"; shape: circle }
s2: { label: "2"; shape: circle }
dots: { label: "…"; shape: text }
s99: { label: "99"; shape: circle }
of: { label: "넘침"; shape: circle; style.bold: true }

시작 -> s0
s0 -> s1
s1 -> s2
s2 -> dots
dots -> s99
s99 -> of
of -> of: "자기 자신으로 돌아온다"

정의: {
  label: "상태 = {0, 1, …, 99, 넘침}\n시작 상태 = 0\n전이 = { n → n+1 | 0 ≤ n < 99 } ∪ { 99 → 넘침, 넘침 → 넘침 }"
  shape: text
}

결정: {
  label: "이 기계는 결정적이다 — 상태마다 나가는 화살표가 하나 이하다.\n한 상태에서 여러 곳으로 갈 수 있으면 비결정적이라 하고, 물통 기계가 그렇다.\n비결정적 기계에서는 ‘실행’ 이 여러 가지이고, 도달 가능한 상태도 그만큼 많아진다"
  shape: text
}

관계: {
  label: "상태 기계는 결국 한 집합 위의 이항관계다(6장). 새로운 것은 이름뿐이다 —\n집합의 원소를 상태, 관계를 전이 관계, 관계의 그래프를 상태 그래프라 부르고,\n시작 상태 하나를 따로 지정한다"
  shape: text
}
