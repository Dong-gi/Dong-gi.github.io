# RSA 가 되돌아오는 이유 — mcs 11장.
#
# 무엇을 읽어야 하나: 위쪽 넷은 열쇠를 만드는 절차이고 가운데 둘이 실제로 쓰는 모습이다.
# 아래 상자 하나가 이 장의 결론이다 — 되돌아오는 근거는 오일러 정리 한 줄뿐이다.
direction: down

만들기: {
  label: "열쇠 만들기 — 받는 사람이 혼자 한다"
  style.bold: true

  일: { label: "1. 큰 소수 둘 p, q 를 고른다\n(실무에서는 각각 300 자리를 넘는다)" }
  이: { label: "2. n = pq 와 φ(n) = (p−1)(q−1) 을 구한다" }
  삼: { label: "3. φ(n) 과 서로소인 e 를 고른다" }
  사: { label: "4. ed ≡ 1 (mod φ(n)) 인 d 를 분쇄기로 구한다\ne 는 φ(n) 과 서로소이므로 역원이 반드시 있다" }
  일 -> 이 -> 삼 -> 사
}

공개: {
  label: "공개키 (n, e) — 널리 뿌린다"
  style.bold: true
}
비밀: {
  label: "비밀키 d — 혼자만 갖는다. p, q 는 지운다"
  style.bold: true
}
만들기.사 -> 공개
만들기.사 -> 비밀

쓰기: {
  label: "쓰기 — 두 줄이 전부다"
  style.bold: true

  암호화: { label: "보내는 사람: C = M 의 e 제곱 (mod n)" }
  복호화: { label: "받는 사람: M = C 의 d 제곱 (mod n)" }
  암호화 -> 복호화: "둘 다 빠른 거듭제곱"
}
공개 -> 쓰기.암호화
비밀 -> 쓰기.복호화

이유: {
  label: "왜 되돌아오는가\ned ≡ 1 (mod φ(n)) 이므로 어떤 정수 k 에 대해 ed = 1 + kφ(n) 이다.\nC 의 d 제곱은 M 의 ed 제곱이고, ed = 1 + kφ(n) 이므로\nM × (M 의 φ(n) 제곱) 의 k 제곱 이다.\n오일러 정리가 M 의 φ(n) 제곱 = 1 (mod n) 을 주므로 M 만 남는다"
  style.bold: true
}
쓰기.복호화 -> 이유

안전: {
  label: "안전성이 기대는 것\nn 만 알고는 p 와 q 를 되찾기 어렵다는 것 — 되찾으면 φ(n) 이 나오고\nφ(n) 을 알면 d 가 나온다. 이것은 추측이고 증명된 적이 없다"
  shape: text
}
이유 -> 안전
