# SAT 과 그 이웃들 — mcs 5장.
#
# 무엇을 읽어야 하나: 이 장에서 다룬 판정 문제들이 실은 하나의 문제다.
# 화살표는 ‘이것을 빠르게 풀 수 있으면 저것도 빠르게 풀 수 있다’ 는 뜻이다.
direction: right

sat: { label: "SAT\n주어진 논리식을 참으로 만드는\n변수 배정이 있는가"; style.bold: true }

타당: { label: "타당성 판정\n이 식이 언제나 참인가" }
동치: { label: "동치 판정\n두 식의 진리표가 같은가" }
간단: { label: "식 간단히 하기\n이 식이 T 로 줄어드는가" }
회로: { label: "회로 SAT\n출력이 1 이 되는 입력이 있는가" }

타당 -> sat: "¬F 가 만족가능한지 물으면 된다"
동치 -> 타당: "(F ↔ G) 가 타당한지 물으면 된다"
간단 -> 타당
회로 -> sat: "배선마다 변수, 게이트마다 제약식"
sat -> 회로: "연산마다 게이트 하나"

방법: { label: "진리표로 푸는 방법\n변수 n 개면 2ⁿ 줄\nn = 30 이면 10억 줄이 넘는다" }
sat -> 방법: "가장 단순한 방법"

pnp: {
  label: "다항 시간에 푸는 방법이 있는가\n— 아무도 모른다. 이것이 P 대 NP 문제다"
  style.bold: true
}
방법 -> pnp: "지수를 다항으로 줄일 수 있을까"

실전: {
  label: "실전에서는 SAT 해결기(SAT solver)가 변수 수백만 개짜리 식도 곧잘 푼다.\n다만 어떤 식이 잘 풀릴지 예측하기 어렵고, 만족 불가능한 식에서는 훨씬 약하다"
  shape: text
}

여파: {
  label: "SAT 를 빠르게 푸는 방법이 나오면 일정 계획·자원 배분·회로 검증이 함께 풀린다.\n동시에 오늘날의 암호가 무너져 온라인 거래와 비밀 통신이 성립하지 않게 된다"
  shape: text
}
