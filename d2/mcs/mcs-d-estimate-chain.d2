# 무작위 표본으로 추정하는 사슬과 ‘신뢰도’ 라는 말의 정확한 뜻 — mcs 22장.
#
# 무엇을 읽어야 하나: 왼쪽 사슬은 계산이고 오른쪽 상자는 그 계산을 <b>말로 옮길 때</b>의 함정이다.
# 확률은 우리가 만든 뽑기 절차에 붙는 것이고, 알아내려는 실제 값에는 붙지 않는다.
direction: down

절차: {
  label: "추정 절차 — 계산"
  style.bold: true

  모수: { label: "알아내려는 값 p\n유권자 가운데 갑을 지지하는 비율.\n고정된 미지의 실수다 — 확률변수가 아니다"; style.bold: true }
  뽑기: { label: "무작위로 한 명을 뽑아 묻는다\nKᵢ = 1 (지지) 또는 0. Pr[Kᵢ = 1] = p" }
  합: { label: "n 번 되풀이해 더한다\nSₙ = K₁ + ⋯ + Kₙ,  추정값은 Sₙ/n" }
  기댓값: { label: "Ex[Sₙ/n] = p — 치우치지 않았다" }
  분산: { label: "Var[Sₙ/n] = pq/n ≤ 1/4n\n쌍마다 독립이면 분산이 더해지고,\n1/n² 을 곱하므로 1/n 로 줄어든다"; style.bold: true }
  체비쇼프: { label: "체비쇼프\nPr[|Sₙ/n − p| ≥ x] ≤ 1/(4nx²)" }
  표본수: { label: "x = 0.04, 오른쪽이 1/20 이하 → n ≥ 3125"; style.bold: true }

  모수 -> 뽑기 -> 합 -> 기댓값
  기댓값 -> 분산 -> 체비쇼프 -> 표본수
}

말하기: {
  label: "결과를 말로 옮기기"
  style.bold: true

  틀림: { label: "틀린 말\n‘확률 0.95 로 p 가 0.40 ± 0.04 안에 있다’\np 는 확률변수가 아니므로 이 문장은 뜻이 없다" }
  맞음1: { label: "맞는 말 ①\n‘이 절차가 p 에서 0.04 안쪽의 값을 내놓을 확률이 0.95 다’"; style.bold: true }
  맞음2: { label: "맞는 말 ②\n‘p 가 0.40 ± 0.04 안에 있거나, 확률 1/20 의 드문 일이 일어났다’"; style.bold: true }
  관례: { label: "관례적 표현\n‘신뢰수준 95%에서 0.40 ± 0.04 다’\n위 두 문장의 줄임말로만 쓴다" }

  틀림 -> 맞음1: 확률을 절차에 붙인다
  맞음1 -> 맞음2: 같은 뜻을 뒤집어 적은 것
  맞음2 -> 관례
}

절차.표본수 -> 말하기.틀림: 여기서 말을 조심해야 한다

모집단: {
  label: "모집단 크기가 식에 없다. 유권자가 만 명이든 10억 명이든 3125명을 물으면 된다.\n직관은 이렇다 — 국을 간 볼 때 한 숟갈이면 되고, 냄비가 크다고 두 숟갈이 필요하지 않다.\n잘 섞여 있기만 하면 한 숟갈에 담긴 정보는 냄비 크기와 무관하다."
  shape: text
}
절차.표본수 -> 모집단

큰수: {
  label: "n → ∞ 이면 Pr[|Sₙ/n − p| ≥ x] → 0 이다. 이것이 큰 수의 법칙(약한 형태)이고,\n위 사슬은 그 정량적 형태다 — ‘얼마나 큰 n 이면 얼마나 믿을 만한가’ 까지 답한다."
  shape: text
}
절차.체비쇼프 -> 큰수
