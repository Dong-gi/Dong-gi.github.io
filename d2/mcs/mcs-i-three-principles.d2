# 세 원리는 서로를 유도한다 — mcs 7장.
#
# 무엇을 읽어야 하나: 화살표가 삼각형을 이루며 한 바퀴 돈다는 것이 요점이다.
# 어느 하나를 공리로 잡아도 나머지 둘이 정리로 따라온다. 그래서 셋은 같은 사실의 세 가지 서식이다.
direction: right

귀납: { label: "보통 귀납법\nP(0) 그리고 ∀n. P(n) → P(n+1)"; style.bold: true }
강한: { label: "강한 귀납법\nP(0) 그리고 ∀n. (∀k ≤ n. P(k)) → P(n+1)"; style.bold: true }
wop: { label: "정렬성 원리\n공집합이 아닌 ℕ 의 부분집합에는 최소 원소가 있다"; style.bold: true }

귀납 -> 강한: "가설을 ∀k ≤ n. P(k) 로 바꿔 적는다"
강한 -> wop: "최소 원소가 없다고 하면\n모든 원소가 밖에 있음을 귀납으로 얻는다"
wop -> 귀납: "반례 집합의 최소 원소 c 를 잡으면\nP(c−1) 은 참이라 P(c) 도 참이 되어 모순"

특수: { label: "보통 귀납법은 강한 귀납법의 특수한 경우다\n(P(n) 만 쓰고 나머지 가정을 버리면 된다)"; shape: text }
강한 -> 특수: { style.stroke-dash: 3 }

고르기: {
  label: "그러면 어느 것으로 쓰는가.\n· 귀납법은 귀류법을 쓰지 않아 읽기 쉽고, 증명이 곧 재귀 절차가 된다\n· WOP 는 짧아지는 일이 많고, 걸음의 크기가 정해지지 않은 문제에 잘 맞는다\n· 정렬집합으로 넓히면 WOP 만 살아남는다 — 8장의 종료성 증명이 그 자리다"
  shape: text
}
