# 좋은 증명의 점검표 — mcs 3장(원서 1.9).
#
# 무엇을 읽어야 하나: 증명의 목적은 참을 보증하는 것과 남을 이해시키는 것 둘이다.
# 왼쪽 줄이 흔히 하는 일이고 오른쪽 줄이 그 대신 할 일이다.
direction: right

나쁨1: { label: "아무 말 없이 계산을 시작한다"; style.stroke-dash: 3 }
좋음1: { label: "계획을 먼저 밝힌다\n‘경우를 나눈다’, ‘모순을 이끈다’"; style.bold: true }
나쁨1 -> 좋음1

나쁨2: { label: "생각난 순서대로 조각을 흩뿌린다"; style.stroke-dash: 3 }
좋음2: { label: "한 줄기로 흐르게 쓴다\n앞 줄이 뒤 줄의 근거가 되도록"; style.bold: true }
나쁨2 -> 좋음2

나쁨3: { label: "기호와 식만 길게 늘어놓는다"; style.stroke-dash: 3 }
좋음3: { label: "글로 쓴다\n식이 섞인 짧은 글이지 계산이 아니다"; style.bold: true }
나쁨3 -> 좋음3

나쁨4: { label: "긴 증명을 한 덩어리로 둔다"; style.stroke-dash: 3 }
좋음4: { label: "보조정리로 잘라낸다\n같은 논증을 두 번 쓰면 일반 보조정리로"; style.bold: true }
나쁨4 -> 좋음4

나쁨5: { label: "‘자명하다’, ‘명백히’ 로 넘어간다"; style.stroke-dash: 3 }
좋음5: { label: "정말 자명한 것만 자명하다고 쓴다\n내게 자명한 것이 읽는 사람에게는 아니다"; style.bold: true }
나쁨5 -> 좋음5

나쁨6: { label: "결론은 독자가 알아서 내라고 둔다"; style.stroke-dash: 3 }
좋음6: { label: "끝맺는다\n원래 주장이 왜 따라오는지 직접 적는다"; style.bold: true }
나쁨6 -> 좋음6

메모: {
  label: "왼쪽 줄에 하나라도 걸리면 그 자리가 증명이 무너지기 쉬운 자리다.\n남의 증명에서 ‘자명하다’ 를 만나면 그 문장을 가장 먼저 의심하라"
  shape: text
}
