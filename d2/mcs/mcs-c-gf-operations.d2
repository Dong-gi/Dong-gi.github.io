# 수열의 연산과 생성함수의 연산이 어떻게 대응하는가 — mcs 18장.
#
# 무엇을 읽어야 하나: 왼쪽 칸의 일을 하고 싶으면 오른쪽 칸의 계산을 하면 된다.
# 이 표가 생성함수를 쓰는 이유 전부다 — 수열을 만지는 일이 다항식을 만지는 일로 바뀐다.
# 가장 값나가는 줄은 ‘이동’ 이다. 점화식이 곧 이동이므로 점화식이 방정식이 된다.
direction: right

수열쪽: {
  label: "수열에서 하는 일"
  style.bold: true

  더하기: { label: "항마다 더한다\n⟨fₙ + gₙ⟩" }
  상수배: { label: "항마다 c 를 곱한다\n⟨c·fₙ⟩" }
  합성곱: { label: "합성곱\n⟨f₀gₙ + f₁gₙ₋₁ + ⋯ + fₙg₀⟩" }
  이동: { label: "오른쪽으로 한 칸 밀기\n⟨0, f₀, f₁, …⟩"; style.bold: true }
  앞자르기: { label: "앞의 한 항 버리기\n⟨f₁, f₂, f₃, …⟩" }
  누적합: { label: "부분합\n⟨f₀ + f₁ + ⋯ + fₙ⟩" }
  n곱하기: { label: "항에 n 을 곱한다\n⟨n·fₙ⟩" }
}

함수쪽: {
  label: "생성함수에서 하는 계산"
  style.bold: true

  f더하기: { label: "F(x) + G(x)" }
  f상수배: { label: "c·F(x)" }
  f합성곱: { label: "F(x)·G(x)" }
  f이동: { label: "x·F(x)"; style.bold: true }
  f앞자르기: { label: "(F(x) − f₀) / x" }
  f누적합: { label: "F(x) / (1 − x)" }
  fn곱하기: { label: "x·F′(x)" }
}

수열쪽.더하기 -> 함수쪽.f더하기
수열쪽.상수배 -> 함수쪽.f상수배
수열쪽.합성곱 -> 함수쪽.f합성곱
수열쪽.이동 -> 함수쪽.f이동
수열쪽.앞자르기 -> 함수쪽.f앞자르기
수열쪽.누적합 -> 함수쪽.f누적합
수열쪽.n곱하기 -> 함수쪽.fn곱하기

기억: {
  label: "외울 것은 두 줄뿐이다.\n1/(1 − x) 의 계수는 모두 1 이고, 1/(1 − x)ᵏ 의 xⁿ 계수는 C(n + k − 1, n) 이다.\n나머지는 이 표를 타고 내려가면 나온다"
  shape: text
}

왜이동: {
  label: "왜 이동이 가장 값나가는가: fₙ = fₙ₋₁ + fₙ₋₂ 라는 점화식은\n‘수열이 자기 자신을 한 칸 · 두 칸 민 것의 합과 같다’ 는 말이다.\n표에 따라 F = xF + x²F + (초기항 보정) 이 되고, 이것은 F 에 대한 일차방정식이다.\n무한히 많은 등식이 방정식 하나로 접힌다"
  shape: text
}
