# 콰인의 존재론적 개입 기준 — 철학 10장.
#
# 무엇을 읽어야 하나: 가운데 줄이 절차다. 이론을 보자마자 개입을 읽어낼 수는 없고,
# 한정사가 드러나게 다시 적은 뒤라야 무엇을 훑는지가 보인다.
# 아래 갈래 둘이, 읽어낸 개입이 마음에 들지 않는 사람에게 남은 선택지 전부다.
direction: down

이론: {
  label: "받아들인 이론 한 벌\n‘소수는 무한히 많다’, ‘이 병의 원인이 되는 유전자가 있다’"
  style.bold: true
}

번역: {
  label: "한정사가 드러나게 다시 적는다\n∃x (x 는 소수이고 …), ∃x (x 는 유전자이고 …)"
}

정의역: {
  label: "그 ∃x 가 값으로 훑어야 하는 것들\n= 이 이론의 존재론적 개입"
  style.bold: true
}

이론 -> 번역: "논리적 형태를 드러낸다"
번역 -> 정의역: "변항이 무엇을 값으로 가져야 참이 되는가"

갈림: { label: "개입이 마음에 들지 않으면 길은 둘뿐이다"; shape: diamond }
정의역 -> 갈림

다시: {
  label: "다시 쓴다\n같은 일을 하면서 그것을 말하지 않는\n문장으로 바꿀 수 있는가"
}
인정: {
  label: "인정한다\n그런 것이 있다고 받아들이고,\n그 대가로 이론이 무엇을 해 주는지를 내세운다"
}
갈림 -> 다시: "바꿀 수 있다면"
갈림 -> 인정: "바꿀 수 없다면"

기호: {
  label: "여기 쓰인 ∃x 는 논리학 문서 9장이 세우는 기호다.\n이 그림은 그 기호를 빌려 쓸 뿐 술어논리를 하지 않는다"
  shape: text
}
번역 -> 기호: { style.stroke-dash: 3 }

주의: {
  label: "‘있다’ 를 여러 뜻으로 나눠 두는 길은 이 기준이 미리 막아 둔 길이다.\n콰인은 존재를 한 뜻으로 못 박고, 무엇이 있느냐는 물음만 이론에 맡긴다.\n그래서 이 기준은 무엇이 있는지를 말해 주지 않는다 — 무엇을 있다고 말하고 있는지를 말해 줄 뿐이다"
  shape: text
}
갈림 -> 주의: { style.opacity: 0 }
