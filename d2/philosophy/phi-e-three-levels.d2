# 윤리학의 세 층 — 철학 17장.
#
# 무엇을 읽어야 하나: 물음은 아래에서 위로 올라간다. 사례에서 막히면 이론을 묻고,
# 이론에서 막히면 그 이론이 하는 말이 어떤 종류의 말인지를 묻는다.
# 17장은 맨 위 층에 있고, 18장이 가운데, 19장이 맨 아래다.
direction: up

응용: {
  label: "응용윤리 — 이 경우에 무엇을 해야 하는가\n전차를 돌려야 하는가. 멀리 있는 사람을 도울 의무가 있는가\n19장"
  style.bold: true
}

규범: {
  label: "규범윤리 — 무엇이 옳은 행위를 옳게 만드는가\n결과인가. 규칙인가. 성품인가\n18장"
  style.bold: true
}

메타: {
  label: "메타윤리 — 그 말들은 도대체 무슨 일을 하는 말인가\n‘옳다’ 는 사실을 적는 말인가 태도를 드러내는 말인가.\n그 말을 참으로 만들 것이 세상에 있는가\n17장"
  style.bold: true
}

응용 -> 규범: "이 사례를 어떤 원리로 판정하나"
규범 -> 메타: "그 원리가 참인지 아닌지 물을 수는 있나"

되돌림: {
  label: "화살표는 한 방향만이 아니다.\n19장의 사례가 18장의 이론을 되치고, 18장에서 나온 판단이\n17장의 물음을 다시 세운다"
  shape: text
}

규범 -> 되돌림: "사례가 이론을 고친다"

주의: {
  label: "세 층은 물음이 다른 것이지 어려움의 순서가 아니다.\n메타윤리가 정해져야 규범윤리를 할 수 있는 것도 아니다 —\n17장 마지막 절이 그 이유를 적는다"
  shape: text
}
