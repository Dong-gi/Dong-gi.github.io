# 기능적 역할 — 철학 14장.
#
# 무엇을 읽어야 하나: 가운데 상자가 마음 상태이고, 그 정체는 세 방향의
# 화살표로만 정해진다. 상자를 무엇으로 채우는가는 이 그림이 정하지 않는다.
# 그것이 기능주의가 다수 실현을 반례가 아니라 예측으로 만드는 방식이다.
direction: right

입력: {
  label: "입력\n조직 손상, 뜨거운 것에 닿음,\n몸 어딘가가 눌림"
  style.bold: true
}

고통: {
  label: "고통\n이 자리를 차지하는 것"
  shape: rectangle
  style.bold: true
  style.stroke-width: 4
}

출력: {
  label: "출력\n회피 행동, 신음, ‘아프다’ 는 말,\n다친 곳을 감싸기"
  style.bold: true
}

다른상태: {
  label: "다른 마음 상태들"

  욕구: { label: "이 상태를 벗어나고 싶다는 욕구" }
  주의: { label: "그쪽으로 쏠리는 주의" }
  믿음: { label: "몸 어딘가가 상했다는 믿음" }
}

입력 -> 고통: "이 입력에서 생긴다"
고통 -> 출력: "이 출력을 내놓는다"
고통 -> 다른상태: "이 상태들을 낳는다"
다른상태 -> 고통: "이 상태들에서 되받는다"

정의: {
  label: "정의하는 방식\n마음 상태 하나를 따로 정의하지 않는다. 이론 전체를 하나의 긴 문장으로 적고,\n마음 상태 이름들을 변항으로 바꾼 뒤 ‘이 관계망의 그 자리를 차지하는 것’ 으로 각각을 정의한다.\n물리학이 질량과 힘을 법칙들의 묶음 안에서 함께 정의하는 것과 같은 방식이다"
  shape: text
}
고통 -> 정의: { style.stroke-dash: 3 }

실현: {
  label: "실현 — 이 그림이 정하지 않는 것\n이 자리를 무엇이 채우는가는 정해져 있지 않다.\n사람의 어떤 신경 상태여도 되고, 문어의 다른 상태여도 되고,\n신경계가 아닌 것으로 이루어진 상태여도 된다.\n어떤 물리 상태가 이 역할을 실제로 맡고 있을 때\n그 물리 상태가 이 마음 상태를 실현한다고 말한다"
  style.stroke-dash: 3
}
고통 -> 실현: "이 자리를 채우는 것"

주의사항: {
  label: "비유의 한계\n같은 프로그램이 다른 기계에서 돌 수 있다는 비유가 자주 쓰인다.\n다수 실현을 잡아내는 데는 좋지만 오도할 수 있다 —\n역할로 정의된다는 것과 계산으로 정의된다는 것은 다른 주장이고,\n뒤엣것은 기능주의의 한 갈래일 뿐이다"
  shape: text
}
실현 -> 주의사항: { style.stroke-dash: 3 }
