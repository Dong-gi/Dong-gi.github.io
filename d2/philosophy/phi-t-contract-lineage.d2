# 사회계약의 계보 — 철학 20장.
#
# 무엇을 읽어야 하나: 세 사람이 같은 장치(자연 상태 → 계약 → 국가)를 쓰면서
# 자연 상태를 다르게 그렸고, 그래서 정당화되는 국가가 서로 다르게 나왔다.
# 자연 상태를 어떻게 그리느냐가 결론을 거의 다 정한다는 것이 요점이다.
direction: right

물음: {
  label: "왜 국가에 복종해야 하는가\n총을 든 사람에게 지갑을 내주는 것과\n세금을 내는 것은 어떻게 다른가"
  shape: oval
  style.bold: true
}

장치: {
  label: "사회계약이라는 장치\n① 국가가 없는 상태를 그린다\n② 거기 있는 사람들이 무엇에 동의할지 묻는다\n③ 동의했을 것에서 국가의 권한을 끌어낸다"
  style.bold: true
}

물음 -> 장치: "표준 답의 뼈대"

홉스: {
  label: "홉스\n자연 상태 = 만인의 만인에 대한 투쟁.\n심판도 집행자도 없어 서로를 먼저 치는 것이 합리적이다"
}
로크: {
  label: "로크\n자연 상태에 이미 자연법과 권리가 있다.\n없는 것은 확립된 법 · 공평한 재판관 · 집행력 셋뿐이다"
}
루소: {
  label: "루소\n자연 상태 자체는 나쁘지 않았다.\n사람을 묶은 것은 사회가 만든 의존과 비교다"
}

장치 -> 홉스
장치 -> 로크
장치 -> 루소

절대: {
  label: "정당화되는 것 — 거스를 수 없는 주권\n각자 자기를 지킬 권리만 남기고\n판단할 권리를 통째로 넘긴다. 저항권은 없다"
  style.stroke-dash: 3
}
제한: {
  label: "정당화되는 것 — 제한된 정부\n권력은 신탁이다. 신탁을 어기면\n인민에게 저항할 권리가 돌아온다"
  style.stroke-dash: 3
}
일반의지: {
  label: "정당화되는 것 — 일반의지에 따르는 공화국\n각자가 전부를 내놓고 시민으로서 자신에게 복종한다.\n일반의지는 전체의 의지가 아니라 공동의 이익을 향한 의지다"
  style.stroke-dash: 3
}

홉스 -> 절대
로크 -> 제한
루소 -> 일반의지

동의: {
  label: "그런데 아무도 계약한 적이 없다\n명시적 동의를 한 사람은 사실상 없고,\n묵시적 동의는 떠날 수 없는 사람에게서도 읽어낸다"
  style.bold: true
}

절대 -> 동의
제한 -> 동의
일반의지 -> 동의

가설: {
  label: "계약이 가설적 장치로 바뀐다\n‘실제로 동의했다’ 가 아니라\n‘공정하게 놓인 사람이라면 동의할 원칙은 무엇인가’ 로\n물음이 옮겨 간다. 롤스의 원초적 입장이 그 자리다"
  style.bold: true
}

동의 -> 가설: "물음을 바꾼다"

메모: {
  label: "세 사람의 결론이 갈리는 이유는 논증의 짜임이 아니라 자연 상태를 그린 방식에 있다.\n무엇이 없어서 문제인지가 정해지면 무엇을 세워야 하는지도 거의 정해진다.\n그래서 자연 상태의 서술은 사실 보고가 아니라 ‘국가가 하는 일이 무엇인가’ 에 대한 주장이다"
  shape: text
}
