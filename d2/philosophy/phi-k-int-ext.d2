# 내재주의와 외재주의 — 철학 6장.
#
# 무엇을 읽어야 하나: 가르는 물음은 하나뿐이다.
# ‘정당화하는 것이 믿는 사람에게 접근 가능해야 하는가.’
# 이 물음의 답이 앞의 세 갈래(무한·토대·순환)와 서로 가로지른다.
direction: down

물음: {
  label: "무엇이 믿음을 정당화하는가.\n그것에 믿는 사람이 반성으로 접근할 수 있어야 하는가"
  shape: oval
  style.bold: true
}

내재: { label: "내재주의\n접근할 수 있어야 한다"; style.bold: true }
외재: { label: "외재주의\n그럴 필요는 없다"; style.bold: true }

물음 -> 내재: "그래야 한다"
물음 -> 외재: "아니다"

근거내: {
  label: "왜 그렇게 말하는가 —\n정당화는 인식적 책임의 문제다.\n내가 댈 수 없는 것으로 내 믿음이\n정당해진다는 말은 이상하다"
}
근거외: {
  label: "왜 그렇게 말하는가 —\n어린아이와 동물도 안다.\n자기 근거를 반성해 댈 수 없는데도\n앎을 인정해야 하는 자리가 있다"
}
내재 -> 근거내
외재 -> 근거외

값내: {
  label: "치르는 값 — 대부분의 지각과 기억에서\n우리가 실제로 댈 수 있는 근거는 빈약하다.\n아는 것이 크게 줄어든다"
  shape: text
}
값외: {
  label: "치르는 값 — 통 속의 뇌는 우리와 똑같이 신중한데도\n과정이 신빙성이 없으므로 정당화되지 않는다고 해야 한다.\n이것을 새로운 악령 문제라 부른다"
  shape: text
}
근거내 -> 값내
근거외 -> 값외

가로지름: {
  label: "이 갈림은 토대론·정합론과 가로지른다.\n내재주의 토대론도 외재주의 토대론도 있고,\n정합론은 대체로 내재주의 쪽이며 신빙론은 외재주의의 대표다"
  shape: text
}
물음 -> 가로지름: "주의"
