# 세 이론이 무엇을 먼저 놓는가 — 철학 18장.
#
# 무엇을 읽어야 하나: 세 이론은 같은 물음에 다른 답을 내놓는 것이 아니라,
# 어느 개념을 먼저 놓고 나머지를 그것으로 설명하는가에서 갈린다.
# 무엇이 기본인가가 다르면 논쟁의 자리도 달라진다.
direction: right

물음: {
  label: "규범윤리의 세 물음\n① 어떤 행위가 옳은가  ② 무엇이 좋은가  ③ 어떤 사람이어야 하는가"
  shape: oval
  style.bold: true
}

결과: {
  label: "결과주의 — ②가 먼저다\n먼저 무엇이 좋은지를 정하고,\n옳은 행위를 ‘좋음을 가장 많이 낳는 행위’ 로 정의한다"
  style.bold: true
}
의무: {
  label: "의무론 — ①이 먼저다\n옳음은 좋음으로 환원되지 않는다.\n결과가 더 좋아도 해서는 안 되는 일이 있다"
  style.bold: true
}
덕: {
  label: "덕 윤리 — ③이 먼저다\n먼저 어떤 성품이 좋은 성품인지를 말하고,\n옳은 행위를 ‘유덕한 사람이 그 상황에서 할 행위’ 로 잡는다"
  style.bold: true
}

물음 -> 결과
물음 -> 의무
물음 -> 덕

결과대가: { label: "그래서 무엇을 설명하나 — 공평성. 누구의 고통도 원래부터 더 가볍지 않다.\n대가 — 어떤 개인에게 아무리 큰 부담을 지워도 총합이 늘면 정당해진다"; style.stroke-dash: 3 }
의무대가: { label: "그래서 무엇을 설명하나 — 사람에게 값을 매길 수 없다는 것, 그리고 넘지 말아야 할 선이 있다는 것.\n대가 — 더 나쁜 결과를 알면서 택해야 하는 경우가 생긴다. 왜 그래야 하는지를 대야 한다"; style.stroke-dash: 3 }
덕대가: { label: "그래서 무엇을 설명하나 — 동기와 성품이 평가에 들어간다는 것, 그리고 규칙이 닿지 않는 판단.\n대가 — 지금 무엇을 하라는 지침을 주지 않는다는 반론을 받는다"; style.stroke-dash: 3 }

결과 -> 결과대가
의무 -> 의무대가
덕 -> 덕대가

미결: {
  label: "셋 다 살아 있다. 이 문서는 하나를 고르지 않는다.\n고르지 않는 것과 판단을 미루는 것은 다르다 — 각 이론이 무엇을 설명하려고 나왔고\n무엇을 대가로 치르는지는 적을 수 있고, 그 이상은 아직 아무도 확립하지 못했다"
  shape: text
}
