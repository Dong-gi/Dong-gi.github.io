# 두 사례를 갈라 주는 원리의 후보들과 각각의 반례 — 철학 19장.
#
# 무엇을 읽어야 하나: 후보마다 두 표준 사례는 맞힌다. 무너지는 자리는 변형이다.
# ‘그래서 답은 무엇인가’ 로 끝나지 않는다는 것이 이 그림의 요점이다.
direction: right

자료: {
  label: "자료 — 갈림길은 대체로 허용된다고, 육교는 대체로 안 된다고 판단한다.\n죽는 사람과 사는 사람의 수는 같다"
  shape: oval
  style.bold: true
}

후보A: { label: "후보 A — 이중효과\n갈림길에서 그의 죽음은 예견될 뿐이고\n육교에서는 의도된다"; style.bold: true }
후보B: { label: "후보 B — 수단으로 씀\n육교에서는 그의 몸이 있어야 계획이 성립한다.\n갈림길에서는 그가 없어도 계획이 성립한다"; style.bold: true }
후보C: { label: "후보 C — 위협의 방향 전환\n갈림길에서는 이미 있는 위협을 돌릴 뿐이고\n육교에서는 새 위협을 만든다"; style.bold: true }
후보D: { label: "후보 D — 함과 그냥 둠\n곧바로 탈락한다. 갈림길에서도 나는 무언가를 한다"; style.stroke-dash: 3 }

자료 -> 후보A
자료 -> 후보B
자료 -> 후보C
자료 -> 후보D

반례A: {
  label: "고리 궤도 — 옆 선로가 돌아서 본선으로 이어지고,\n그 한 사람의 몸이 전차를 멈춘다. 죽음이 수단이 된다.\n이중효과는 금지라고 예측하는데 판단은 대체로 허용 쪽이다.\n폐쇄 문제도 여기서 온다 — 의도한 것을 다시 적으면 답이 바뀐다"
  style.stroke-dash: 3
}
반례B: {
  label: "같은 고리 궤도가 여기도 걸린다.\n반대쪽 반례도 있다 — 그를 수단으로 쓰지 않는데도\n안 된다고 판단하는 경우를 만들 수 있다"
  style.stroke-dash: 3
}
반례C: {
  label: "방향 전환이라는 사실만으로는 허용이 나오지 않는다.\n양쪽 사람 수가 같으면 돌려도 된다고 하지 않는다.\n그리고 왜 방향 전환이 도덕적으로 중요한지가 설명되지 않는다.\n톰슨은 나중에 갈림길에서도 돌리면 안 된다는 쪽으로 생각을 바꾸었다"
  style.stroke-dash: 3
}

후보A -> 반례A
후보B -> 반례B
후보C -> 반례C

평형: {
  label: "여기서 3장의 반성적 평형이 실제로 돈다.\n판단에서 원리를 뽑고, 새 변형으로 원리를 시험하고, 어긋나면 원리를 고치거나\n판단을 의심한다. 어느 쪽도 고정점이 아니다"
  shape: text
}

결과주의: {
  label: "결과주의는 세 사례를 모두 같게 본다. 그래서 판단의 차이를 원리로 설명하는 대신\n편향으로 설명한다 — 손으로 미는 장면이 정서적 반응을 불러 판단을 굽힌다는 것이다.\n반론은 이렇다. 그 설명이 맞다 해도, 그것만으로 그 판단이 틀렸다는 결론은 나오지 않는다"
  shape: text
}
