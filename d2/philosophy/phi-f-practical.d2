# 인격 동일성이 움직이는 실천 세 자리 — 철학 13장.
#
# 무엇을 읽어야 하나: 왼쪽이 이 장에서 세운 것, 가운데가 그것이 흔드는 실천,
# 오른쪽이 그 물음을 이론으로 받는 장이다. 이 장은 물음을 세우는 데서 멈춘다.
direction: right

기준: {
  label: "이 장이 세운 것\n인격 동일성의 기준은 미결이고,\n심리 연속성은 정도의 문제다"
  shape: oval
  style.bold: true
}

처벌: {
  label: "처벌과 응보\n오래전 범죄를 저지른 사람과 지금의 그 사람 사이에\n심리 연결이 거의 남지 않았다면 무엇이 달라지는가"
}
배려: {
  label: "미래의 나에 대한 배려\n왜 남의 고통보다 내일의 내 고통을 더 걱정하는가.\n연속성이 정도의 문제라면 그 근거도 정도의 문제가 된다"
}
약속: {
  label: "약속과 책무\n어제의 내가 한 약속을 오늘의 내가 지고 있는 이유는 무엇인가"
}

기준 -> 처벌
기준 -> 배려
기준 -> 약속

주의: {
  label: "주의 — 여기서 나오는 것은 결론이 아니라 물음이다.\n연속성이 약하다는 사실에서 ‘처벌하지 말라’ 는 결론이 곧바로 나오지 않는다.\n사실에서 당위로 건너가는 데는 따로 논증이 필요하고, 그 논증을 다루는 것이 17장이다"
  shape: text
}

ch12: { label: "12장\n반응적 태도는 사람을 향한다.\n그 사람이 계속 그 사람인가를 이 장이 묻는다" }
ch18: { label: "18장\n무엇을 해야 하는가 — 세 이론.\n처벌과 배려를 이론으로 받는다" }
ch19: { label: "19장\n이론을 사례에 대어 보기" }
ch20: { label: "20장\n정의와 국가.\n분배를 누구들 사이에서 하는가" }

처벌 -> ch18
배려 -> ch18
약속 -> ch20
처벌 -> ch19
기준 -> ch12: "이어받는다"

경계: {
  label: "이 장은 윤리 이론의 이름을 정의하지 않는다.\n무엇이 옳은 처벌인지, 남의 고통을 얼마나 무겁게 볼 것인지는\n17·18장의 몫이고, 이 장은 그 물음이 인격 동일성에 걸려 있다는 것까지만 보인다"
  shape: text
}
