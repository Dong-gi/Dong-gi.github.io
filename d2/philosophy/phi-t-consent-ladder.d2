# 동의의 네 형태와 각각이 걸리는 자리 — 철학 20장.
#
# 무엇을 읽어야 하나: 동의로 권위를 정당화하려는 시도가 아래로 내려갈수록
# 약해진다. 위쪽 두 개는 동의이지만 해당하는 사람이 거의 없고, 아래쪽 두 개는
# 해당하는 사람은 많지만 점점 동의가 아니게 된다. 이 맞바꿈이 이 그림의 요점이다.
direction: down

명시: {
  label: "① 명시적 동의\n말이나 서명으로 실제로 동의했다\n귀화 선서, 공직 취임 선서"
  style.bold: true
}
묵시: {
  label: "② 묵시적 동의 — 로크\n떠나지 않고 머무르며 도로를 쓰고 재산을 누린다면\n그 자체가 동의로 읽힌다"
}
가설: {
  label: "③ 가설적 동의\n실제로 동의하지 않았어도, 합리적이라면 동의했을 것이다"
}
자연: {
  label: "④ 동의를 아예 쓰지 않는 길\n정의로운 제도를 지지할 자연적 의무,\n또는 이익을 받았으면 몫을 지라는 공정한 몫의 원리"
  style.bold: true
}

명시 -> 묵시: "해당자가 거의 없다"
묵시 -> 가설: "동의라고 부르기 어렵다"
가설 -> 자연: "동의가 하는 일이 없다"

반론1: {
  label: "걸리는 자리 — 사실 문제\n이 나라에서 동의를 말이나 서명으로 표한 사람이\n인구 중 몇이나 되는가. 그러면 나머지에게는 권위가 없는가"
  style.stroke-dash: 3
}
반론2: {
  label: "걸리는 자리 — 흄\n떠날 수 없는 사람의 머무름은 동의가 아니다.\n잠든 채 배에 실려 온 사람에게 뛰어내리든지\n선장을 따르든지 고르라는 것과 같다"
  style.stroke-dash: 3
}
반론3: {
  label: "걸리는 자리 — 가설적 계약은 계약이 아니다\n내가 동의했을 것이라는 사실은 나를 묶지 못한다.\n묶는 힘이 있다면 그것은 동의가 아니라\n동의했을 이유 쪽에서 온다"
  style.stroke-dash: 3
}
반론4: {
  label: "걸리는 자리 — 받은 적 없는 이익\n요청하지도 않은 이익을 받았다고 해서\n값을 물릴 수 있는가. 이 길은 동의를 버린 만큼\n국가만 특별히 대접할 이유도 함께 잃는다"
  style.stroke-dash: 3
}

명시 -> 반론1
묵시 -> 반론2
가설 -> 반론3
자연 -> 반론4

무정부: {
  label: "철학적 무정부주의\n네 길이 다 막힌다면 남는 결론이 이것이다.\n국가에 복종할 일반적 도덕적 의무는 없다.\n국가를 없애자는 주장이 아니라, 복종의 의무가\n따로 있지는 않다는 주장이다"
  style.bold: true
}

반론4 -> 무정부: "여기까지 오면"

메모: {
  label: "③에서 ④로 넘어가는 자리가 이 장의 갈림길이다. 계약을 실제 사건이 아니라 사고실험으로 다시 읽으면\n③은 ‘공정한 조건에 놓인 사람이 고를 원칙은 무엇인가’ 라는 다른 물음이 되고, 그 물음이 20장 뒷부분 전체를 끌고 간다.\n반대로 ④를 택하면 정당화는 동의가 아니라 제도의 정의로움 자체에 걸리게 된다"
  shape: text
}
