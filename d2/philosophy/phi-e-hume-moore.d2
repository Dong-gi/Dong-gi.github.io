# 흄의 논점과 무어의 논점은 다른 논증이다 — 철학 17장.
#
# 무엇을 읽어야 하나: 둘은 자주 한 덩어리로 뭉쳐지지만 겨누는 곳이 다르다.
# 흄은 추론의 형식을 겨누고, 무어는 개념 분석의 성공 여부를 겨눈다.
# 결론도 다르다. 흄에게서 도덕 실재론이 곧바로 무너지지는 않는다.
direction: right

흄: {
  label: "흄의 논점 — 추론의 형식\n전제가 모두 ‘…이다’ 뿐인데 결론에 ‘…해야 한다’ 가 나오면,\n그 건너감을 따로 설명해야 한다"
  style.bold: true
}

흄결: {
  label: "겨누는 것 — 논증의 짜임\n서술 전제만으로 규범 결론이 연역되지 않는다는 주장이다.\n어떤 자연적 성질이 좋음인가 하는 물음은 건드리지 않는다"
}

흄반: {
  label: "반론 두 갈래\n① 논리적 잔꾀 — 서술 전제에서 선언 도입만으로 규범 문장을 만들어 낼 수 있다\n② 제도적 사실 — 약속을 했다는 사실에서 지켜야 한다가 따라 나온다는 설의 논증\n어느 쪽도 논쟁을 끝내지 못했다"
  style.stroke-dash: 3
}

흄 -> 흄결
흄 -> 흄반: "여기를 친다"

무어: {
  label: "무어의 논점 — 개념 분석의 실패\n좋음을 어떤 자연적 성질로 정의해도\n‘그것은 그 성질을 갖는다. 그런데 좋은가’ 라는 물음이 열려 있다"
  style.bold: true
}

무어결: {
  label: "겨누는 것 — 정의\n좋음이 자연적 성질과 같은 것이 아니라는 주장이다.\n추론의 형식에 대해서는 아무 말도 하지 않는다"
}

무어반: {
  label: "오늘의 표준 평가 — 결정적이지 않다\n① 분석의 역설 — 옳은 분석이 말하는 사람에게 곧바로 보여야 한다는 보장이 없다\n② 후험적 필연 — 참인 동일성인데도 물음이 열려 보일 수 있다 (11장)\n그렇다고 자연주의가 이긴 것은 아니다. 물음이 왜 열려 보이는지는 남는다"
  style.stroke-dash: 3
}

무어 -> 무어결
무어 -> 무어반: "여기를 친다"

정리: {
  label: "자연주의적 오류라는 이름은 무어의 것이고 사실-당위 간극은 흄의 것이다.\n두 말을 바꿔 쓰면 논쟁이 헛돈다. 흄의 논점을 인정하면서 자연주의적 실재론자일 수 있다"
  shape: text
}
