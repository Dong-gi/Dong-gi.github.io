# 테세우스의 배가 실제로 묻는 것 — 철학 10장.
#
# 무엇을 읽어야 하나: 배 이야기는 물음이 아니라 장치다. 장치에서 물음 둘이
# 갈라져 나오고, 그 둘을 밀어붙이는 것은 같은 원리 하나 — 라이프니츠 법칙이다.
# 아래 세 줄이 답의 후보이고, 각 후보가 무엇을 포기하는지가 함께 적혀 있다.
direction: down

장치: { label: "테세우스의 배"; shape: oval; style.bold: true }

q1: {
  label: "물음 하나 — 시간을 통한 동일성\n어제의 그것과 오늘의 이것을 하나라고 부르는 근거는 무엇인가"
  style.bold: true
}
q2: {
  label: "물음 둘 — 구성이 곧 동일성인가\n널빤지들의 모임과 배는 같은 하나인가, 다른 둘인가"
  style.bold: true
}
장치 -> q1
장치 -> q2

법칙: {
  label: "밀어붙이는 원리 — 라이프니츠 법칙\n같은 것이라면 참인 것이 모두 같아야 한다.\n뒤집으면, 참인 것이 하나라도 다르면 같은 것이 아니다"
}
q1 -> 법칙
q2 -> 법칙

압박: {
  label: "배 A 와 배 B 는 놓인 자리가 다르다. 그러니 A 와 B 는 다르다.\n그런데 둘 다 그 배라면 A 는 그 배이고 B 도 그 배이므로 A 와 B 는 같아야 한다.\n같으면서 다를 수는 없다"
  shape: text
}
법칙 -> 압박

답1: {
  label: "하나만 그 배다\n기준을 하나 골라 다른 쪽을 버린다.\n포기하는 것 — 버린 쪽의 직관"
}
답2: {
  label: "시간적 부분으로 읽는다 (4차원주의)\n배는 시점마다의 부분들로 이루어진 하나의 전체이고,\n두 계보는 앞부분을 공유하는 서로 다른 전체다.\n포기하는 것 — 사물이 매 순간 통째로 있다는 생각"
}
답3: {
  label: "그 배 같은 것은 없다\n널빤지들이 이렇게 저렇게 놓여 있을 뿐이다.\n포기하는 것 — 배가 하나의 대상이라는 생각"
}
압박 -> 답1
압박 -> 답2
압박 -> 답3

예고: {
  label: "13장이 이 물음을 사람에 대해 되풀이한다. 거기서는 널빤지 대신 몸과 기억이 놓이고,\n‘어느 쪽도 버릴 수 없다’ 는 압박이 훨씬 세진다"
  shape: text
}
답2 -> 예고: { style.stroke-dash: 3 }
