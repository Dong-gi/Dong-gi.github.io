# 도덕적 지위의 근거로 나온 기준들 — 철학 19장.
#
# 무엇을 읽어야 하나: 기준마다 안에 들어오는 것과 밖에 남는 것이 다르다.
# 어느 기준도 우리 판단 전부와 맞아떨어지지 않는다.
direction: right

물음: {
  label: "무엇이 어떤 존재를 도덕적 고려의 대상으로 만드는가"
  shape: oval
  style.bold: true
}

이성: { label: "기준 ① 이성 · 언어 · 도덕적 행위 능력"; style.bold: true }
쾌고: { label: "기준 ② 쾌고 감수 능력 — 고통과 즐거움을 겪을 수 있음"; style.bold: true }
주체: { label: "기준 ③ 삶의 주체 — 믿음과 욕구와 미래에 대한 관심을 갖고\n자기 삶이 자기에게 잘되거나 잘못될 수 있는 존재"; style.bold: true }
소속: { label: "기준 ④ 종의 구성원임, 또는 관계와 소속"; style.bold: true }

물음 -> 이성
물음 -> 쾌고
물음 -> 주체
물음 -> 소속

이성문제: {
  label: "가장자리 사례 논증에 걸린다.\n이 능력을 갖추지 못한 사람들이 있는데 우리는 그들을 밖에 두지 않는다.\n그러면 이 능력이 지위의 근거일 수 없다"
  style.stroke-dash: 3
}
쾌고문제: {
  label: "벤담이 물음을 이렇게 옮겼다 — 그들이 따져 볼 수 있는가도, 말할 수 있는가도 아니고\n괴로워할 수 있는가다. 싱어의 이익 평등 고려는 여기서 나온다.\n부담 — 어디까지가 쾌고 감수 능력인지 경계가 흐리고,\n지위를 정도의 문제로 만들면 다시 선을 그어야 한다"
  style.stroke-dash: 3
}
주체문제: {
  label: "리건의 길이다. 지위를 총합으로 상쇄할 수 없는 내재적 가치로 잡는다.\n싱어와 결론은 자주 겹치지만 이유가 다르고, 갈리는 자리도 있다 —\n총합으로도 정당화되지 않는 것을 리건은 금지하고 싱어는 경우에 따라 허용한다.\n부담 — 이 조건에 미치지 못하는 동물을 어떻게 하는가"
  style.stroke-dash: 3
}
소속문제: {
  label: "가장자리 사례 논증을 정면으로 받는다.\n관계와 소속이 실제로 의무를 낳는다는 것은 다른 데서도 인정된다.\n부담 — 왜 하필 종이 그런 관계인지를 대야 한다.\n같은 논법이 다른 집단 경계에도 쓰일 수 있다는 것이 이 자리의 위험이다"
  style.stroke-dash: 3
}

이성 -> 이성문제
쾌고 -> 쾌고문제
주체 -> 주체문제
소속 -> 소속문제

다른길: {
  label: "지위를 묻지 않는 길도 있다. 덕 윤리는 잔인함이라는 악덕에서 시작한다 —\n동물을 함부로 대하는 사람에게 무엇이 잘못되었는가를 묻는다.\n반론 — 그러면 동물 자신을 위한 이유가 아니라 우리 자신에 관한 이유가 된다.\n계약주의는 합당한 거부를 할 수 없는 존재를 다루기 어려워 다른 근거를 찾아야 한다"
  shape: text
}

정리: {
  label: "폭넓게 받아들여지는 것 — 어떤 형태로든 동물의 이익이 도덕적으로 고려되어야 한다.\n갈리는 것 — 무엇이 근거이고 어디까지이며 어떤 무게인가. 이 자리는 미결이다"
  shape: text
}
