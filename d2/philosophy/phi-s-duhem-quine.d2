# 뒤엠-콰인 논제 — 철학 9장.
#
# 무엇을 읽어야 하나: 화살표 셋이 한 곳으로 모인다는 것이 요점이다.
# 예측을 내놓은 것이 가설 하나가 아니므로, 예측이 빗나가도 범인이 지목되지 않는다.
direction: right

가설: { label: "검사하려는 가설 H"; style.bold: true }
보조: { label: "보조 가정들\n계기가 제대로 잰다 / 시료가 오염되지 않았다 /\n배경 이론이 옳다 / 다른 원인이 끼어들지 않았다" }
초기: { label: "초기 조건\n실제로 이 값에서 시작했다" }
예측: { label: "관찰 예측 O" }
빗나감: { label: "관찰해 보니 O 가 아니다"; style.bold: true }

결과: {
  label: "논리가 말해 주는 것은\n‘H 와 보조 가정과 초기 조건이\n모두 참일 수는 없다’ 뿐이다.\n무엇을 버릴지는 논리가 정하지 않는다"
  style.bold: true
}

가설 -> 예측
보조 -> 예측
초기 -> 예측
예측 -> 빗나감
빗나감 -> 결과

사례: {
  label: "천왕성의 궤도가 예측과 어긋났을 때 천문학자들은 뉴턴 역학이 아니라 보조 가정을 고쳤다 —\n아직 보지 못한 행성이 있다고 놓았고, 해왕성이 그 자리에 있었다.\n같은 수를 수성의 궤도에 썼을 때는 그런 행성이 없었고, 이번에는 역학 쪽이 바뀌었다.\n같은 모양의 대응이 한 번은 맞고 한 번은 틀렸다는 것이 이 논제의 무게다"
  shape: text
}
