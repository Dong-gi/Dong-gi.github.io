# 얼룩말과 변장한 노새 — 철학 7장. 관련 대안.
#
# 무엇을 읽어야 하나: 두 물음에 대한 자연스러운 대답이 서로 어긋난다.
# 폐쇄 원리를 지키면 어긋나서는 안 되는데 어긋난다 —
# 그래서 드레츠키는 폐쇄 원리 쪽을 의심한다.
direction: down

장면: { label: "동물원 우리 앞. 줄무늬 짐승이 서 있고 팻말에 얼룩말이라 적혀 있다"; shape: oval; style.bold: true }

물음1: { label: "저것이 얼룩말임을 아는가" }
물음2: { label: "저것이 얼룩말로 정교하게 칠한 노새가 아님을 아는가" }

장면 -> 물음1
장면 -> 물음2

답1: { label: "안다\n동물원이고 팻말이 있고 생김새가 얼룩말이다"; style.bold: true }
답2: { label: "모른다\n칠한 노새와 얼룩말은 내가 서 있는 자리에서 똑같아 보인다"; style.bold: true }

물음1 -> 답1: "자연스러운 대답"
물음2 -> 답2: "자연스러운 대답"

충돌: {
  label: "그런데 얼룩말이라면 칠한 노새가 아니다.\n폐쇄 원리대로라면 앞을 알 때 뒤도 알아야 한다 —\n두 대답이 함께 참일 수 없다"
  shape: oval
  style.bold: true
}
답1 -> 충돌
답2 -> 충돌

길1: {
  label: "드레츠키 — 폐쇄 원리를 버린다.\n앎이 요구하는 것은 관련된 대안의 배제뿐이고\n칠한 노새는 이 자리에서 관련된 대안이 아니다"
}
길2: {
  label: "맥락주의 — 두 물음이 서로 다른 맥락을 만든다.\n둘째 물음을 던지는 순간 기준이 올라가고,\n그 올라간 맥락에서는 첫째 대답도 거짓이 된다"
}
길3: {
  label: "회의주의 — 첫째 대답이 그냥 틀렸다.\n우리는 저것이 얼룩말임을 알지 못한다"
}

충돌 -> 길1
충돌 -> 길2
충돌 -> 길3

남는것: {
  label: "어느 길을 가든 남는 물음 — 무엇이 관련된 대안인지를\n무엇이 정하는가. 이 물음에 합의된 답은 없다"
  shape: text
}
길1 -> 남는것
길2 -> 남는것
