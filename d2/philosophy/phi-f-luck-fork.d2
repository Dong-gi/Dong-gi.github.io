# 운 논증의 두 갈래 — 철학 12장.
#
# 무엇을 읽어야 하나: 비결정성만으로는 자유가 생기지 않는다. 결정되어 있으면
# 내 것이 아니고, 결정되어 있지 않으면 갈림을 정한 것이 없어 역시 내 것이 아니다.
# 자유지상론이 살아남으려면 오른쪽 갈래에 무언가를 더 넣어야 한다.
direction: right

행위: { label: "지금 내가 한 이 행위"; shape: oval; style.bold: true }

갈래1: { label: "선행 사건들이 이 행위를 못 박았다" }
갈래2: { label: "선행 사건들이 이 행위를 못 박지 않았다" }

행위 -> 갈래1
행위 -> 갈래2

결과1: {
  label: "그 선행 사건들은 내가 정한 것이 아니다.\n결과 논증이 여기를 파고든다"
  style.stroke-dash: 3
}
결과2: {
  label: "같은 조건에서 다른 일이 일어날 수 있었다.\n그러면 어느 쪽이 일어날지를 정한 것이 없다.\n무작위는 통제가 아니다"
  style.stroke-dash: 3
}

갈래1 -> 결과1
갈래2 -> 결과2

수렴: {
  label: "어느 쪽이든 이 행위가 내 통제 아래 있었다고 말하기 어렵다\n이것이 운 논증이다"
  shape: oval
  style.bold: true
}

결과1 -> 수렴
결과2 -> 수렴

응답: {
  label: "자유지상론의 응답 — 오른쪽 갈래에 사건이 아닌 것을 하나 더 넣는다.\n행위자 인과. 갈림을 정한 것은 앞선 사건이 아니라 행위자 자신이라는 것이다.\n반론 — 그 말이 무엇을 뜻하는지가 분명하지 않다. 반론에 대한 답 — 인과를 사건 사이의 관계로만\n보는 것이 오히려 특별한 가정이다"
  shape: text
}

물리: {
  label: "양자역학을 근거로 들지 않는 이유가 이 그림에 있다.\n미시 세계가 비결정적이라 해도 그것은 오른쪽 갈래를 지지할 뿐이고,\n오른쪽 갈래는 그 자체로 자유를 주지 않는다. 물리학은 첫째 물음에 관계하지 둘째 물음에 관계하지 않는다"
  shape: text
}
