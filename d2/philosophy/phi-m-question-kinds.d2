# 물음의 갈래 — 철학 3장.
#
# 무엇을 읽어야 하나: 물음 하나를 놓고 세 번 물으면 어떤 도구로 답할 물음인지가 갈린다.
# 철학적 물음은 ‘답이 없는 물음’ 이 아니라 ‘앞의 세 도구로는 결판나지 않는 물음’ 이다.
# 배치: 두 칸 격자 — 왼쪽 칸이 세 물음의 사슬, 오른쪽 칸이 ‘예’ 일 때의 갈래.
# 빈칸1·2 는 칸을 맞추려고 넣은 보이지 않는 상자다. 선언 순서대로 한 줄에 두 칸씩 채운다.
grid-rows: 5
grid-columns: 2
horizontal-gap: 140
vertical-gap: 70

물음: { label: "물음 하나"; shape: oval; style.bold: true }
빈칸1: { label: " "; style.opacity: 0 }

q1: { label: "관찰·측정·실험을 하면\n어느 쪽인지 정해지는가" }
경험: { label: "경험적 물음\n물이 몇 도에서 끓는가\n→ 과학이 답한다"; style.stroke-dash: 3 }

q2: { label: "계산이나 증명으로\n결판나는가" }
형식: { label: "형식적 물음\n소수가 무한히 많은가\n→ 수학·논리가 답한다"; style.stroke-dash: 3 }

q3: { label: "낱말의 뜻을 정하기로 약속하면\n물음 자체가 사라지는가" }
말: { label: "말의 문제\n‘야채’ 에 버섯이 들어가는가\n→ 정의를 정하면 끝난다"; style.stroke-dash: 3 }

철학: { label: "철학적 물음\n안다는 것은 무엇인가 /\n무엇을 해야 하는가\n왜 그 관찰이 그 이론을 지지하는가"; style.bold: true }
빈칸2: { label: " "; style.opacity: 0 }

물음 -> q1
q1 -> 경험: "예"
q1 -> q2: "아니오"
q2 -> 형식: "예"
q2 -> q3: "아니오"
q3 -> 말: "예"
q3 -> 철학: "아니오"

메모: {
  shape: text
  near: bottom-center
  label: "이 갈래는 고정되어 있지 않다. 물리학·심리학·언어학은 모두 철학에서 갈라져 나갔다.\n어떤 물음에 대해 재는 방법이 생기면 그 물음은 경험적 물음 쪽으로 옮겨 간다.\n철학에 남는 것은 ‘아직 재는 방법이 없는 것’ 과 ‘무엇을 재야 하는지를 정하는 일’ 이다\n\n실제 물음은 대개 섞여 있다. ‘사형은 범죄를 줄이는가’ 는 경험적 물음이고\n‘범죄를 줄인다면 사형이 정당한가’ 는 철학적 물음이다.\n둘을 갈라 놓지 않으면 서로 다른 물음에 대고 서로 다른 증거를 내밀게 된다"
}
