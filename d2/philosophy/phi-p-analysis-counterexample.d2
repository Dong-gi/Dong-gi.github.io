# 같은 고리가 두 번 돈다 — 철학 11장.
#
# 무엇을 읽어야 하나: 고리 자체는 3장이 개념 분석의 순환으로 이미 세웠다.
# 이 그림은 그 고리가 두 장에서 실제로 도는 모습을 나란히 놓은 것이고,
# 칸이 하나하나 대응한다는 것이 전부다. 아래 줄을 읽고 나면 11장의 반례들이
# 인과에만 생기는 사고가 아니라 분석이라는 작업의 정상 진행이라는 것이 보인다.
direction: right

고리: {
  label: "3장의 분석 고리\n분석안 → 반례 → 수선 → 다시 분석안"
  shape: oval
  style.bold: true
}

사례1: {
  label: "5장 — ‘안다’ 를 분석한다"
  style.bold: true

  a1: { label: "분석안\n정당화된 참인 믿음" }
  b1: { label: "반례\n게티어 사례 — 조건 셋을 다 갖췄는데\n안다고 하기 어렵다" }
  c1: { label: "수선\n무효화 요인 없음, 인과 조건,\n신빙성 조건 …" }
  a1 -> b1 -> c1
  c1 -> a1: "다시"
}

사례2: {
  label: "11장 — ‘원인’ 을 분석한다"
  style.bold: true

  a2: { label: "분석안\nc 가 없었다면 e 도 없었을 것이다" }
  b2: { label: "반례\n선점과 과잉결정 — 원인인데\n그 조건을 못 갖춘다" }
  c2: { label: "수선\n의존의 사슬, 사건을 더 잘게 나누기,\n개입으로 다시 적기 …" }
  a2 -> b2 -> c2
  c2 -> a2: "다시"
}

고리 -> 사례1: "한 번"
고리 -> 사례2: "또 한 번"

대응: {
  label: "두 줄의 칸이 하나하나 대응한다. 다른 것은 반례가 오는 방향뿐이다 —\n게티어 사례는 조건을 다 갖추고도 아닌 경우고, 선점은 맞는데 조건을 못 갖춘 경우다"
  shape: text
}
사례1 -> 대응: { style.stroke-dash: 3 }
사례2 -> 대응: { style.stroke-dash: 3 }

포기: {
  label: "3장이 적어 둔 세 번째 길 — 분석 자체를 포기하는 길 — 도 여기서 실제로 쓰인다.\n인과를 더 단순한 것으로 분석되지 않는 원초적 개념으로 두는 입장이 그것이다.\n값은 설명력이다. 인과가 무엇인지를 더는 말해 주지 않게 된다"
  shape: text
}
사례2 -> 포기: { style.stroke-dash: 3 }
