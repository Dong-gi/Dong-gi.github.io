# 사고실험의 구조 — 철학 3장.
#
# 무엇을 읽어야 하나: 사고실험은 이야기가 아니라 논증의 부품이다.
# 상황에서 곧바로 결론이 나오지 않는다. 판단을 한 번 거치고, 그 판단이 전제가 된다.
# 반론이 들어올 수 있는 자리가 셋으로 정해진다는 것이 이 그림의 요점이다.
# 배치: 다섯 줄 두 칸 격자 — 왼쪽 칸이 ①~⑤ 단계, 오른쪽 칸이 그 단계를 치는 반론.
# 빈칸1·2 는 칸을 맞추려고 넣은 보이지 않는 상자다. 선언 순서대로 한 줄에 두 칸씩 채운다.
grid-rows: 5
grid-columns: 2
horizontal-gap: 130
vertical-gap: 70

상황: { label: "① 상황을 설정한다\n실제로 일어날 필요는 없다.\n앞뒤가 맞기만 하면 된다"; style.bold: true }
반론1: { label: "반론 A — 그 상황은 불가능하다\n설정에 숨은 모순이 있거나,\n우리가 상상했다고 여긴 것을\n사실은 상상하지 못한 것이다"; style.stroke-dash: 3 }

물음: { label: "② 그 상황에 대해 묻는다\n‘이 경우 그는 아는 것인가’,\n‘이 경우 그렇게 해도 되는가’" }
빈칸1: { label: " "; style.opacity: 0 }

판단: { label: "③ 읽는 사람에게서 판단이 나온다\n이것이 직관이다.\n논증도 관찰도 아니고,\n그냥 그렇게 보이는 것이다"; style.bold: true }
반론2: { label: "반론 B — 판단이 갈린다\n다른 사람은 다르게 본다.\n물음을 다르게 꾸미면 답이 바뀐다.\n그러면 그 판단을 전제로 쓸 수 없다"; style.stroke-dash: 3 }

전제: { label: "④ 그 판단을 전제로 삼는다\n‘이 경우 그는 알지 못한다’ 를\n참으로 놓고 논증을 짠다" }
빈칸2: { label: " "; style.opacity: 0 }

결론: { label: "⑤ 일반 주장을 지지하거나 무너뜨린다\n예를 들어 ‘정당화된 참인 믿음이면\n앎이다’ 를 무너뜨린다"; style.bold: true }
반론3: { label: "반론 C — 판단이 그 결론을\n지지하지 않는다\n판단은 인정하되, 그 판단이 나온\n이유가 다른 데 있다고 본다"; style.stroke-dash: 3 }

상황 -> 물음 -> 판단 -> 전제 -> 결론

상황 -> 반론1: "여기를 친다"
판단 -> 반론2: "여기를 친다"
결론 -> 반론3: "여기를 친다"

메모: {
  label: "사고실험을 소개할 때 줄거리만 옮기면 ③부터가 사라진다.\n무엇을 묻는지, 어떤 판단이 나오는지, 그 판단이 무엇을 지지하는지까지 적어야\n사고실험이 논증 안에서 제 일을 한다"
  shape: text
  near: bottom-center
}
