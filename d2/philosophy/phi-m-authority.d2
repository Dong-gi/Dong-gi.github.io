# 권위 호소는 언제 정당한가 — 철학 4장.
#
# 무엇을 읽어야 하나: 권위 호소는 기본값이 오류가 아니다. 네 관문을 지나면 좋은 귀납 논증이고,
# 어느 관문에서 걸리는지에 따라 어떻게 반박해야 하는지가 달라진다.
direction: right

호소: { label: "‘전문가 A 가 그렇다고 했다\n그러므로 그렇다’"; shape: oval; style.bold: true }

q1: { label: "A 가 이 분야의 전문가인가" }
q2: { label: "A 가 지금 자기 분야 안에서\n말하고 있는가" }
q3: { label: "그 분야 전문가들 사이에\n대체로 합의가 있는가" }
q4: { label: "A 가 이 결론으로\n이익을 보지 않는가" }

정당: { label: "정당한 권위 호소\n결론을 보증하지는 않지만 믿을 좋은 이유가 된다.\n우리가 아는 것의 대부분이 이런 경로로 들어온다"; style.bold: true }

f1: { label: "분야 밖의 권위\n이름값을 근거로 쓴 것이다"; style.stroke-dash: 3 }
f2: { label: "월경한 권위\n한 분야의 성취가 다른 분야의 발언권을 주지 않는다"; style.stroke-dash: 3 }
f3: { label: "합의 없는 분야에서 한 사람만 인용\n반대편에도 같은 급의 전문가가 있다.\n철학의 많은 물음이 여기 해당한다"; style.stroke-dash: 3 }
f4: { label: "이해가 걸린 권위\n결론이 거짓이라는 뜻은 아니다.\n증거로서의 무게가 줄어든다는 뜻이다"; style.stroke-dash: 3 }

호소 -> q1
q1 -> f1: "아니오"
q1 -> q2: "예"
q2 -> f2: "아니오"
q2 -> q3: "예"
q3 -> f3: "아니오"
q3 -> q4: "예"
q4 -> f4: "아니오"
q4 -> 정당: "예"

세등급: {
  label: "세 번째 관문이 이 문서와 곧바로 이어진다. 철학의 많은 물음에서는 전문가들 사이에 합의가 없다.\n그래서 이 문서는 ‘어느 철학자가 그렇게 말했다’ 를 근거로 쓰지 않고,\n3장의 세 등급으로 무게를 표시하고 논증 자체를 보여 준다"
  shape: text
}

주의: {
  label: "네 관문을 다 지나도 결론은 보증되지 않는다. 전문가도 틀린다.\n권위 호소는 연역이 아니라 귀납이고, 새 증거가 오면 무너질 수 있다"
  shape: text
}
