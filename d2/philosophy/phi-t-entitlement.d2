# 노직의 자격 이론과 반론이 들어오는 세 자리 — 철학 20장.
#
# 무엇을 읽어야 하나: 자격 이론은 분배의 모양을 보지 않고 오직 경로만 본다.
# 그래서 이 이론의 힘도 약점도 전부 ‘어떻게 여기까지 왔는가’ 에 걸린다.
# 오른쪽 점선 상자가 표준적인 반론이 들어오는 자리다.
direction: right

물음: {
  label: "이 분배가 정의로운지를\n무엇을 보고 판정하는가"
  shape: oval
  style.bold: true
}

결과: {
  label: "결과 상태 · 정형 원리\n지금 이 순간의 분배 모양을 본다.\n‘각자에게 필요에 따라’, ‘각자에게 기여에 따라’,\n‘가장 불리한 처지에 가장 큰 이익이 되게’"
}
역사: {
  label: "역사적 원리 — 노직\n지금의 모양이 아니라 여기까지 온 경로를 본다.\n같은 모양이라도 경로가 다르면 판정이 다르다"
  style.bold: true
}

물음 -> 결과
물음 -> 역사

취득: { label: "① 취득에서의 정의\n임자 없던 것을 처음 갖는 일이\n어떻게 정당해지는가"; style.bold: true }
이전: { label: "② 이전에서의 정의\n정당한 보유자에게서 자발적으로 넘겨받은 것은 정당하다\n증여 · 교환 · 유증" }
교정: { label: "③ 교정의 원리\n①과 ②가 어겨졌을 때 무엇을 되돌려야 하는가" }

역사 -> 취득
역사 -> 이전
역사 -> 교정

판정: {
  label: "판정 규칙\n①과 ②를 밟아 지금에 이르렀다면 지금의 분배는 정의롭다.\n그 분배가 어떤 모양이든 상관없다"
  shape: oval
  style.bold: true
}
취득 -> 판정
이전 -> 판정

체임벌린: {
  label: "윌트 체임벌린 논증\n정형 원리가 정의롭다고 판정한 D1 에서\n자발적 이전만 거쳐 D2 로 갔다.\n그러면 정형 원리는 자기가 인정한 출발점에서\n나온 결과를 부정의하다고 말하게 된다"
  style.bold: true
}
판정 -> 체임벌린: "정형 원리를 겨눈다"
체임벌린 -> 결과: "자유는 정형을 흐트러뜨린다"

반론1: {
  label: "반론 A — 최초 취득\n이론 전체가 ①에 걸려 있는데 ①이 가장 덜 채워져 있다.\n로크의 단서를 어떻게 재는지도 정해지지 않았다.\n실제 역사의 취득이 대부분 정당하지 않았다면\n③이 요구하는 교정의 규모는 매우 커진다"
  style.stroke-dash: 3
}
반론2: {
  label: "반론 B — 무엇을 자유의 침해로 셀 것인가\n재산권 자체가 남을 막는 강제를 포함한다.\n그러므로 ‘재분배는 자유를 침해한다’ 와\n‘재산권은 자유를 침해한다’ 는 같은 종류의 문장이고,\n어느 쪽이 더 무거운지는 논증이 더 필요하다"
  style.stroke-dash: 3
}
반론3: {
  label: "반론 C — 되풀이와 배경\n한 번의 이전은 무해해도 같은 이전이 되풀이되면\n다음 세대의 출발선이 달라진다.\n그래서 롤스는 판정 대상을 낱개 거래가 아니라\n기본 구조로 잡는다 — D1 을 한 시점의 분배로 읽는 것 자체를 거부한다"
  style.stroke-dash: 3
}

취득 -> 반론1
체임벌린 -> 반론2
체임벌린 -> 반론3

메모: {
  label: "이 그림에서 확인할 것 하나. 자격 이론은 부자 편을 드는 이론이 아니라 경로만 보는 이론이다.\n③ 교정의 원리를 진지하게 적용하면 과거의 강탈 때문에 대규모 이전이 요구될 수 있고, 노직 자신이 그 가능성을 적었다.\n어떤 이론이 어떤 정책을 낳는지는 이론만으로 정해지지 않고 그 사회의 역사적 사실이 함께 있어야 정해진다"
  shape: text
}
