# 좀비 논증의 걸음 — 철학 15장.
#
# 무엇을 읽어야 하나: 세 걸음 가운데 다투어지는 것은 가운데 걸음 하나다.
# 굵게 칠해진 전제 2 가 그것이고, 생각할 수 있음에서 형이상학적으로 가능함으로
# 건너가는 자리가 이 논쟁의 전부라고 해도 지나치지 않다.
direction: down

좀비: {
  label: "철학적 좀비란 무엇인가\n나와 물리적으로 낱낱까지 똑같으면서 아무것도 겪지 않는 존재.\n같은 뇌, 같은 신경 발화, 같은 행동, 같은 말.\n아프면 ‘아프다’ 고 말하고 감각질에 대해 강의도 한다. 그런데 안쪽이 캄캄하다.\n영화의 좀비가 아니다 — 겉으로는 아무 차이도 없다"
  shape: oval
  style.bold: true
}

전제1: {
  label: "걸음 1 (P1) — 생각할 수 있다\n좀비 세계가 모순 없이 정합적으로 그려진다"
}
전제2: {
  label: "걸음 2 (P2) — 여기가 다투어진다\n생각할 수 있는 것은 형이상학적으로 가능하다.\n즉 그런 가능세계가 실제로 있다"
  style.bold: true
  style.stroke-width: 4
}
전제3: {
  label: "걸음 3 (P3) — 다툴 것이 적다\n물리적 사실이 우리 세계와 똑같은데 의식의 사실이 다른 세계가 있다면,\n의식은 물리적인 것에 수반하지 않는다"
}
결론: {
  label: "결론\n14장이 적은 형태의 물리주의는 거짓이다"
  shape: oval
  style.bold: true
}

좀비 -> 전제1
전제1 -> 전제2: "여기를 건넌다"
전제2 -> 전제3
전제3 -> 결론

막는사례: {
  label: "11장이 이 걸음을 막는 사례를 이미 다루었다\n물이 H₂O 가 아닌 상황을 생각할 수 있다고 여겼던 사람은\n실은 물처럼 보이는 다른 것이 있는 상황을 생각한 것이었다.\n겉모습과 실체를 갈라 놓자 상상 가능성이 가능성으로 건너가지 못했다"
  style.stroke-dash: 3
}
전제2 -> 막는사례: "물리주의 쪽"

차머스대응: {
  label: "차머스의 대응 — 의식에는 그 갈라 놓기가 되지 않는다\n물의 경우 우리는 물을 겉모습으로 붙잡고 있었으므로 재서술의 여지가 있었다.\n의식의 경우에는 겪어짐 자체가 우리가 붙잡는 것이므로\n‘겪어지는 것처럼 보이지만 겪어지지 않는 것’ 이라는 재서술이 없다.\n이 논지를 정밀하게 세우는 장치가 2차원 의미론인데 이 문서는 거기로 들어가지 않는다"
  style.stroke-dash: 3
}
막는사례 -> 차머스대응: "되받음"

반박: {
  label: "물리주의 쪽 반박 둘\n① (P1) 을 겨눈다 — 좀비를 정합적으로 그렸다고 여기는 것 자체가 착각일 수 있다.\n물리적 세부를 실제로는 하나도 채우지 않은 채 ‘나와 물리적으로 똑같은데’ 라는 문구만 붙였을 뿐이다.\n② (P2) 를 겨눈다 — 상상 가능성은 우리 개념의 성질이고 가능성은 세계의 성질이다.\n크립키 이후 우리는 그 다리가 언제나 놓이지는 않는다는 것을 알고 있다"
  shape: text
}
전제1 -> 반박: { style.stroke-dash: 3 }

부수현상: {
  label: "논증이 성공하면 되돌아오는 것\n의식이 수반하지 않는데 인과적 폐쇄를 지키려면 의식은 물리적 결과를 낳지 못한다 — 부수현상론이다.\n그러면 나의 좀비 쌍둥이도 지금 나와 똑같이 감각질에 대해 말하고 있다.\n내가 감각질에 대해 말하는 원인이 감각질이 아니게 된다"
  shape: text
}
결론 -> 부수현상: { style.stroke-dash: 3 }
