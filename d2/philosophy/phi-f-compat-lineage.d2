# 양립가능론이 고쳐 온 자리 — 철학 12장.
#
# 무엇을 읽어야 하나: 양립가능론은 하나의 주장이 아니라, 반례를 맞을 때마다
# 자유의 조건을 안쪽으로 옮겨 온 계보다. 옮길 때마다 무엇을 얻고 무엇이 새로 걸리는지가
# 오른쪽 상자에 적혀 있다.
direction: down

고전: {
  label: "고전적 양립가능론 — 홉스·흄\n자유는 하고자 하는 대로 할 수 있음이다.\n자유의 반대는 결정이 아니라 강제다"
  style.bold: true
}
반례1: {
  label: "반례 — 강박과 중독\n손발이 묶이지 않았는데도 자유로워 보이지 않는 사람이 있다.\n방해가 밖이 아니라 안에 있는 경우다"
  style.stroke-dash: 3
}

계층: {
  label: "계층 이론 — 프랭크퍼트\n하고 싶은 것(일차 욕구)과, 그 욕구를 갖고 싶은가(이차 욕구)를 나눈다.\n둘이 맞으면 그 의지는 내 것이다"
  style.bold: true
}
반례2: {
  label: "반례 — 조작\n이차 욕구까지 누가 심어 놓았다면 어떤가.\n층을 하나 더 얹어도 같은 물음이 다시 올라온다"
  style.stroke-dash: 3
}

이유: {
  label: "이유 반응성 — 피셔·라비자\n그 행위를 낳은 절차가 이유를 알아듣는가를 본다.\n다른 이유가 주어졌으면 다르게 움직였을 절차인가"
  style.bold: true
}
반례3: {
  label: "반례 — 역사\n이유를 잘 알아듣게끔 세뇌된 사람도 조건을 채운다.\n그래서 절차가 어떻게 생겨났는지까지 조건에 넣게 된다"
  style.stroke-dash: 3
}

고전 -> 반례1
반례1 -> 계층: "안쪽으로 옮긴다"
계층 -> 반례2
반례2 -> 이유: "절차로 옮긴다"
이유 -> 반례3

메모: {
  label: "이 계보를 조작 논증이라 부르는 반론 하나가 통째로 겨눈다.\n세뇌된 사람과 보통 사람 사이에 양립가능론이 댈 수 있는 차이가 없고,\n세뇌된 사람이 자유롭지 않다면 보통 사람도 자유롭지 않다는 논증이다"
  shape: text
}

응답: {
  label: "양립가능론의 응답 — 차이는 있다. 조작된 사람의 절차는 그 사람의 이력에서\n자라난 것이 아니라 밖에서 통째로 끼워 넣어진 것이다.\n그 차이가 조건으로 적힐 만큼 또렷한가가 지금 다투는 자리다"
  shape: text
}
