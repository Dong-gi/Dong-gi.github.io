# 흄의 갈림길 — 철학 8장.
#
# 무엇을 읽어야 하나: 두 갈래가 모두 막힌다는 것이 논증의 뼈대다.
# 오른쪽 아래 상자의 ‘이 논증 자체가 귀납이다’ 가 순환이 생기는 자리다.
direction: down

물음: { label: "귀납을 정당화하는 논증이 있다면\n그 논증은 어느 종류인가"; shape: oval; style.bold: true }

연역: { label: "연역 논증이다" }
귀납: { label: "귀납 논증이다" }

연역실패: {
  label: "전제가 참이면 결론이 반드시 참이어야 한다.\n그런데 ‘지금까지 그랬다’ 가 참이면서\n‘앞으로도 그렇다’ 가 거짓인 상황을 모순 없이 상상할 수 있다.\n반례가 있으니 부당하다"
  style.bold: true
}
귀납실패: {
  label: "‘귀납은 지금까지 잘 통했다.\n그러므로 앞으로도 통할 것이다’ 가 된다.\n그런데 이 논증 자체가 귀납이다.\n보이려던 것을 이미 쓴 셈이다"
  style.bold: true
}

결론: { label: "귀납을 정당화하는 순환 없는 논증은 없다"; shape: hexagon; style.bold: true }

물음 -> 연역
물음 -> 귀납
연역 -> 연역실패: "그러면"
귀납 -> 귀납실패: "그러면"
연역실패 -> 결론
귀납실패 -> 결론
