# 고유명에 대한 입장 지도 — 크립키 이후 어디까지 왔는가. 철학 16장.
#
# 무엇을 읽어야 하나: 왼쪽에서 무너진 것은 소박한 기술 이론 하나뿐이고 오른쪽 세 갈래는
# 모두 살아 있다. 기술 이론 일반이 사라진 것이 아니다. 갈래마다 남은 빚을 함께 적어 두었다 —
# 빚이 없는 갈래가 하나도 없다는 것이 이 사안이 미결인 까닭이다.
direction: right

소박: {
  label: "소박한 기술 이론 · 기술 다발\n이름의 뜻은 결부된 기술의 뜻이고\n그 기술이 지시체를 정한다"
  style.stroke-dash: 4
}
논증: {
  label: "크립키의 세 논증\n양상 · 인식 · 의미론"
  shape: oval
  style.bold: true
}
소박 -> 논증: "여기서 무너진다"

직접: {
  label: "갈래 1. 직접지시 — 다수설\n이름이 문장에 보태는 것은 대상 자체다.\n이름은 고정지시어이고, 지시체는 기술이 아니라\n화자가 놓인 인과 · 역사적 관계가 정한다"
  style.bold: true
}
개량: {
  label: "갈래 2. 개량된 기술 이론 — 소수설\n고정화된 기술 — ‘실제로 알렉산더를 가르친 사람’ 은\n확정 기술이면서 고정지시어다. 양상 논증이 막힌다.\n사슬을 기술 안에 넣기 — ‘내가 이 이름을 물려받은\n바로 그 사람’ 도 하나의 기술이다. 의미론 논증까지 막힌다"
}
이차원: {
  label: "갈래 3. 이차원 의미론 — 소수설\n표현에 두 종류의 뜻을 준다. 하나로는 후험적 필연을,\n다른 하나로는 우리가 그 표현을 이해하는 방식을 설명한다.\n크립키의 사례를 부정하지 않고 오히려 설명하려는 시도다"
}

논증 -> 직접: "살아 있다"
논증 -> 개량: "살아 있다"
논증 -> 이차원: "살아 있다"

그림: {
  label: "인과 · 역사적 그림 — 다수설이 지시체를 설명하는 방식"
  direction: down
  명명: { label: "최초의 명명\n어떤 대상에 이름을 처음 붙이는 자리" }
  사슬: { label: "전달의 사슬\n앞 사람이 가리키던 것을 그대로\n가리키려는 의도로 물려받아 쓴다" }
  지금: { label: "지금의 사용\n‘괴델’ 에 대해 아무것도 모르는 사람도\n그 이름으로 괴델을 가리킨다.\n그를 붙들고 있는 것은 그가 아는 기술이 아니라\n그가 이어받은 사슬이다" }
  명명 -> 사슬 -> 지금
}
직접 -> 그림

빚1: {
  label: "남은 빚 — 프레게의 세 수수께끼가 다시 열린다.\n특히 대체 실패가 그렇다. 이름이 보태는 것이\n대상뿐이라면 믿음 문맥에서 값이 갈리는 일을\n설명할 길이 없다. 크립키는 대체를 쓰지 않고도\n같은 수수께끼가 생긴다는 것을 보였지만,\n문제가 더 넓다는 것을 보인 것이 푼 것은 아니다"
  shape: text
}
빚2: {
  label: "남은 빚 — 크립키는 사슬을 기술 안에 넣는 수를\n예상하고 순환이라고 답했다.\n순환인지에 대해서는 다툼이 있다.\n고정화된 기술 쪽은 인식 논증과 의미론 논증을\n그대로 안고 간다"
  shape: text
}
빚3: {
  label: "남은 빚 — 두 종류의 뜻이 각각 무슨 일을 하는지,\n둘째 뜻이 결국 기술로 되돌아가는 것은 아닌지가\n다투어진다"
  shape: text
}
직접 -> 빚1
개량 -> 빚2
이차원 -> 빚3

반례: {
  label: "이론이 아니라 그림이라고 크립키 자신이 불렀다.\n필요충분조건을 준 것이 아니기 때문이다.\n‘마다가스카르’ 는 본래 아프리카 본토의 어느 지역을\n가리키던 말인데 전달 과정의 착오로 섬을 가리키게 되었고,\n지금 이 이름이 가리키는 것은 섬이지 사슬 끝의 그 지역이 아니다.\n사슬을 어떻게 하나로 셀 것인지, ‘이어받으려는 의도’ 를 적을 때\n기술이 몰래 들어오지는 않는지도 열린 물음이다"
  shape: text
}

살아남음: {
  label: "러셀의 확정 기술 분석은 이 다툼에서 살아남는다.\n크립키가 무너뜨린 것은 이름이 기술이라는 주장이지\n기술이 한정사 뭉치라는 분석이 아니다"
  shape: text
}
