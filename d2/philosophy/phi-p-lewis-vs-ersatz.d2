# 가능세계는 무엇인가 — 철학 11장.
#
# 무엇을 읽어야 하나: 이 물음은 논리학 문서가 묻지 않는 물음이다. 거기서 세계는
# 이름 붙은 점이면 충분하다. 여기서 묻는 것은 그 점이 무엇을 대신하느냐다.
# 두 답이 각각 무엇을 사고 무엇을 치르는지가 왼쪽 오른쪽에 나란히 적혀 있다.
direction: down

경계: {
  label: "논리학 문서 18장 — 세계는 이름 붙은 점이고, 점 사이의 접근관계가\n어떤 공리를 참으로 만드는지를 정리로 세운다. 점이 무엇인지는 묻지 않는다"
  shape: text
}

물음: {
  label: "그 점들은 정말 있는가. 있다면 무엇인가"
  shape: oval
  style.bold: true
}
경계 -> 물음: "여기서 갈라진다"

루이스: {
  label: "양상 실재론 (데이비드 루이스)\n다른 가능세계는 이 세계와 똑같은 뜻으로 있다.\n덜 실재하는 것이 아니라, 우리와 시공간으로도\n인과로도 이어져 있지 않을 뿐이다.\n‘현실’ 은 ‘여기’ 처럼 말하는 자리를 가리키는 말이다"
  style.bold: true
}
대리: {
  label: "대리주의\n가능세계는 이 세계 안의 무언가다.\n최대로 일관된 명제들의 집합, 또는 세계 전체를\n하나로 적은 추상적 대상 같은 것.\n세계는 있지만 우리 세계 하나만 구체적이다"
  style.bold: true
}
물음 -> 루이스
물음 -> 대리

산것1: {
  label: "사는 것 — 양상을 양상 아닌 말로 환원한다.\n‘가능하다’ 가 ‘그런 세계가 있다’ 가 되어,\n필연과 가능이 더 이상 원초적 개념이 아니게 된다"
}
값1: {
  label: "치르는 값 — 목록이 엄청나게 늘어난다.\n그리고 우리와 아무 인과 관계도 없는 것들을\n어떻게 아느냐는 물음이 남는다"
}
루이스 -> 산것1
루이스 -> 값1

산것2: {
  label: "사는 것 — 목록이 절약된다.\n추상적 대상 말고 새로 들일 것이 없다"
}
값2: {
  label: "치르는 값 — 환원이 되지 않는다.\n어느 명제 집합이 ‘일관된’ 집합인지를 정하려면\n결국 가능이라는 양상 개념을 다시 써야 한다"
}
대리 -> 산것2
대리 -> 값2

정리: {
  label: "고르는 기준이 같다는 데 주목하라 — 목록의 절약과 설명의 힘을 맞바꾸는 것이다.\n10장에서 보편자를 두고 다투던 그 저울이 여기서 다시 나온다"
  shape: text
}
값1 -> 정리: { style.opacity: 0 }
값2 -> 정리: { style.opacity: 0 }
