# 결과주의를 세 부품으로 뜯는다 — 철학 18장.
#
# 무엇을 읽어야 하나: 결과주의는 한 이론이 아니라 부품 조합이다.
# 반론이 들어오면 부품 하나를 갈아 끼워 대응한다. 그 유연함이 강점이자 약점이다.
direction: right

핵: {
  label: "결과주의의 뼈대\n행위의 옳고 그름은 그 행위가 낳는 결과가 정한다"
  shape: oval
  style.bold: true
}

부품1: { label: "부품 ① 무엇이 좋은 결과인가\n쾌락인가 · 선호의 만족인가 · 객관적 목록인가"; style.bold: true }
부품2: { label: "부품 ② 누구의 좋음을 어떻게 세는가\n모두를 하나로 세고 더한다 — 총합과 공평성"; style.bold: true }
부품3: { label: "부품 ③ 무엇을 결과로 평가하는가\n개별 행위인가 · 따를 규칙인가 · 성품이나 제도인가"; style.bold: true }

핵 -> 부품1
핵 -> 부품2
핵 -> 부품3

변1: {
  label: "①을 갈면\n고전 공리주의는 쾌락을 넣는다. 경험 기계 사고실험이 그것을 흔든다 —\n기계 안의 삶이 더 즐거워도 우리는 그 삶을 고르지 않는다.\n그래서 선호 만족설이나 객관적 목록설로 옮겨 간다"
}
변2: {
  label: "②를 갈면\n총합 대신 가장 나쁜 처지의 사람을 먼저 보는 셈법도 있다.\n다만 총합을 버리면 결과주의의 단순함도 함께 빠진다"
}
변3: {
  label: "③을 갈면\n행위 공리주의에서 규칙 공리주의로 간다.\n규칙 공리주의는 붕괴 반론을 받는다 — 예외를 인정하면 행위 공리주의가 되고,\n인정하지 않으면 더 나쁜 결과를 알면서 택하게 된다"
}

부품1 -> 변1
부품2 -> 변2
부품3 -> 변3

평가: {
  label: "유연함의 값 — 부품을 갈아 끼울수록 반론은 피하지만 내용이 옅어진다.\n좋음이 무엇이든 상관없다면 ‘좋음을 늘려라’ 는 말은 거의 아무것도 배제하지 않는다"
  shape: text
}
