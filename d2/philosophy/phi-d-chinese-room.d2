# 중국어 방 — 철학 15장.
#
# 무엇을 읽어야 하나: 가운데가 설의 논증이고 둘레가 응답들이다.
# 응답마다 설의 재반박이 붙고 그 재반박에 다시 되받음이 붙는다.
# 어느 화살표도 끝나 있지 않다.
direction: down

방: {
  label: "방 안의 배치"
  style.bold: true

  들어옴: { label: "들어오는 것\n중국어 문장이 적힌 종이" }
  사람: { label: "방 안의 사람\n중국어를 한 마디도 모른다.\n기호의 모양만 본다"; style.bold: true }
  규칙집: { label: "규칙집\n들어온 기호의 모양만 보고\n어떤 기호를 내보낼지 적혀 있다" }
  나감: { label: "나가는 것\n중국어 문장이 적힌 종이" }

  들어옴 -> 사람
  규칙집 -> 사람: "모양만 보고 고른다"
  사람 -> 나감
}

바깥: {
  label: "바깥에서 보면\n방은 중국어로 유창하게 대화한다"
  shape: oval
}
방.나감 -> 바깥

논증: {
  label: "설의 논증 — 이 그림의 가운데\n(P1) 프로그램은 형식적이다. 기호를 모양으로만 다룬다.\n(P2) 마음에는 내용이 있다. 마음 상태는 무언가에 관한다.\n(P3) 모양을 다루는 것만으로는 내용이 생기지 않는다. 방 안의 사람이 그것을 보인다.\n(C) 그러므로 프로그램을 돌리는 것만으로는 마음이 생기지 않는다"
  shape: oval
  style.bold: true
  style.stroke-width: 4
}
방.사람 -> 논증: "그런데 이 사람은 이해하지 못한다"
바깥 -> 논증

겨냥: {
  label: "겨냥하는 것과 겨냥하지 않는 것\n겨냥하는 것 — ‘알맞게 프로그램된 컴퓨터는 문자 그대로 마음을 갖는다’.\n설은 이것을 강한 인공지능이라 불렀다. 다르게 적으면 계산이 이해에 충분한가이고, 그의 답은 아니라는 것이다.\n겨냥하지 않는 것 — 기계가 생각할 수 있는가. 설은 이 물음에 그렇다고 답한다. 뇌는 하나의 기계이고 생각하기 때문이다.\n이 두 물음을 섞으면 논쟁 전체가 헛돈다"
  shape: text
}
논증 -> 겨냥: { style.stroke-dash: 3 }

체계응답: {
  label: "체계 응답\n이해하는 것은 방 안의 사람이 아니라\n사람 · 규칙집 · 종이를 합친 체계 전체다"
  style.bold: true
}
로봇응답: {
  label: "로봇 응답\n방을 로봇에 넣어 감각기와 팔다리를 붙이면\n기호가 세상에 이어진다"
  style.bold: true
}
뇌응답: {
  label: "뇌 시뮬레이터 응답\n중국어 화자의 뇌에서 일어나는 일을\n뉴런 하나하나까지 흉내 내는 프로그램이면 어떤가"
  style.bold: true
}

논증 -> 체계응답: "응답 ①"
논증 -> 로봇응답: "응답 ②"
논증 -> 뇌응답: "응답 ③"

체계가리킴: {
  label: "체계 응답이 가리키는 곳\n방 안의 사람 하나가 아니라 방 전체다.\n사람은 그 체계의 한 부품일 뿐이라는 것이다"
  shape: text
}
체계응답 -> 체계가리킴: { style.stroke-dash: 3 }
체계가리킴 -> 방: { style.stroke-dash: 3 }

재반박1: {
  label: "설의 재반박\n규칙집을 다 외우고 밖으로 나오면\n체계가 곧 그 사람인데, 그래도 이해하지 못한다"
  style.stroke-dash: 3
}
재반박2: {
  label: "설의 재반박\n로봇의 카메라에서 오는 것도 결국 기호일 뿐이라\n방 안 사람에게는 달라지는 것이 없다"
  style.stroke-dash: 3
}
재반박3: {
  label: "설의 재반박\n수도관과 밸브로 같은 구조를 만들어도\n물이 흐를 뿐 이해는 없다"
  style.stroke-dash: 3
}

체계응답 -> 재반박1
로봇응답 -> 재반박2
뇌응답 -> 재반박3

되받음1: {
  label: "되받음\n외운 규칙을 돌리는 그 사람 안에 별개의 체계가 구현된 것이고,\n그 체계에 대해 사람의 보고는 권위를 갖지 않는다"
  shape: text
}
되받음2: {
  label: "되받음\n이어짐이 문제라는 것을 설도 인정한 셈이므로,\n남은 물음은 어떤 이어짐이 원초적 지향성을 낳는가이다.\n그것이 앞 절의 자연화 계획이다"
  shape: text
}
되받음3: {
  label: "되받음\n뉴런과 수도관을 나누는 기준을 대야 하는데,\n그 기준을 물리적 재료로 적으면\n14장의 유형 동일론으로 되돌아간다"
  shape: text
}

재반박1 -> 되받음1
재반박2 -> 되받음2
재반박3 -> 되받음3

열림: {
  label: "어느 화살표도 끝나 있지 않다\n방법론적 비판도 있다 — 이 사고실험은 방을 느리고 작게 그려 놓는다.\n종이 한 장, 사람 하나, 규칙집 한 권. 그 그림에서 ‘이해가 없다’ 는 판단이 쉽게 나오는 것이\n규모의 낯섦 때문이라면, 14장의 중국 인민 논증에 대한 응답이 여기에도 그대로 온다.\n설의 논증이 결정적이라고 보는 쪽과 체계 응답이 이미 답했다고 보는 쪽이 모두 살아 있다"
  shape: text
}
되받음1 -> 열림: { style.stroke-dash: 3 }
되받음2 -> 열림: { style.stroke-dash: 3 }
되받음3 -> 열림: { style.stroke-dash: 3 }
