# 튜링 검사의 배치와 그것이 검사하는 것 — 철학 15장.
#
# 무엇을 읽어야 하나: 심문자는 글자만 주고받는다. 몸도 목소리도 지워 놓은 것이
# 이 설계의 핵심이다. 그래서 이 검사는 생각의 정의가 아니라
# 물음을 바꾸자는 제안이다.
direction: right

심문자: {
  label: "심문자\n어느 쪽이 기계인지 가려내야 한다"
  shape: person
  style.bold: true
}

가림막: {
  label: "가림막 — 글자만 지나간다\n몸도 목소리도 얼굴도 지워져 있다"
  style.bold: true

  사람: { label: "상대 A — 사람" }
  기계: { label: "상대 B — 기계" }
}

심문자 -> 가림막.사람: "글로만 묻는다"
심문자 -> 가림막.기계: "글로만 묻는다"
가림막.사람 -> 심문자: "글로만 답한다"
가림막.기계 -> 심문자: "글로만 답한다"

판정: {
  label: "판정\n심문자가 어느 쪽이 기계인지 믿을 만하게 가려내지 못하면\n그때 기계가 검사를 통과한 것이다"
  shape: oval
  style.bold: true
}
심문자 -> 판정

바꾼물음: {
  label: "튜링이 실제로 한 일\n그는 ‘기계가 생각할 수 있는가’ 에 답하지 않았다. 그 물음을 다른 물음으로 바꾸자고 제안했다.\n원래 물음은 ‘생각한다’ 와 ‘기계’ 의 뜻을 어떻게 정하느냐에 따라 답이 달라지는,\n결판낼 수 없는 물음이라고 보았기 때문이다.\n바꾼 물음이 흉내 놀이다 — 글자만으로 가려낼 수 있는가"
  shape: text
}
판정 -> 바꾼물음: { style.stroke-dash: 3 }

반론1: {
  label: "반론 ① 행동만 잰다\n14장에서 논리적 행동주의가 걸린 자리가 그대로 온다.\n완벽한 배우가 아픈 사람의 행동을 다 할 수 있다면\n완벽한 흉내꾼도 생각하는 자의 대화를 다 할 수 있다"
  style.stroke-dash: 3
}
반론2: {
  label: "반론 ② 사람 흉내를 요구한다\n통과하려면 사람처럼 굴어야 한다. 그래서 정말로 생각하지만\n사람과 다르게 생각하는 기계는 떨어지고,\n생각하지 않지만 사람 말투를 잘 흉내 내는 기계는 붙는다.\n재는 것과 재려던 것이 어긋나 있다"
  style.stroke-dash: 3
}
반론3: {
  label: "반론 ③ 충분조건이지 필요조건이 아니다\n튜링 자신이 검사 통과를 생각의 정의로 삼지 않았다.\n통과하면 생각한다고 볼 좋은 이유가 생긴다는 것이\n그가 말한 전부다"
  style.stroke-dash: 3
}

판정 -> 반론1
판정 -> 반론2
판정 -> 반론3

남는힘: {
  label: "그래도 남는 힘\n우리가 다른 사람에게 마음이 있다고 여기는 근거도 결국 행동과 말이다.\n기계에게만 더 엄한 것을 요구한다면 그 이유를 대야 한다"
  shape: text
}
반론1 -> 남는힘: { style.stroke-dash: 3 }
