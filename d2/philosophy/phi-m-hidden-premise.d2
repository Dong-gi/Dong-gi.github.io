# 숨은 전제를 채우는 두 관문 — 철학 4장.
#
# 무엇을 읽어야 하나: 후보 문장 하나가 숨은 전제로 인정되려면 두 관문을 다 지나야 한다.
# 한쪽만 지난 경우가 각각 어떤 실패인지가 이 그림의 요점이다.
direction: right

후보: { label: "채워 넣을 후보 문장"; shape: oval; style.bold: true }

관문1: { label: "관문 1 — 이것을 넣으면\n전제에서 결론으로 건너뛰는 자리가 메워지는가" }
관문2: { label: "관문 2 — 글쓴이가 이것을\n실제로 받아들일 만한가" }

떠안김: { label: "떠안기기\n논증은 메워졌지만 글쓴이는 그런 말을 한 적이 없다.\n이대로 공격하면 허수아비가 된다"; style.stroke-dash: 3 }
헛수고: { label: "빈 보탬\n글쓴이가 동의할 문장이기는 하지만\n논증의 벌어진 자리는 그대로다"; style.stroke-dash: 3 }
탈락: { label: "후보에서 뺀다"; style.stroke-dash: 3 }
채택: { label: "숨은 전제로 채택한다\n번호를 붙이되 ‘글에 없음’ 이라고 표시한다"; style.bold: true }

후보 -> 관문1
관문1 -> 헛수고: "아니오"
관문1 -> 관문2: "예"
관문2 -> 떠안김: "아니오"
관문2 -> 채택: "예"
헛수고 -> 탈락
떠안김 -> 탈락

고르기: {
  label: "관문을 지나는 후보가 여럿이면 가장 약한 것을 고른다.\n‘모든 거짓말은 나쁘다’ 와 ‘이런 상황의 거짓말은 나쁘다’ 가 둘 다 자리를 메운다면 뒤의 것을 쓴다.\n강한 전제를 골라 놓고 그 전제를 공격하는 것은 상대의 논증을 대신 약하게 만드는 일이다"
  shape: text
}

수확: {
  label: "숨은 전제를 찾는 것이 왜 남는 일인가. 논쟁이 풀리지 않을 때 어긋난 자리가\n대개 여기이기 때문이다. 서로 다른 숨은 전제를 깔고 있으면 겉으로 오간 문장은 아무리 따져도 결론이 나지 않는다"
  shape: text
}
