# 지향성은 어디서 오는가 — 철학 15장.
#
# 무엇을 읽어야 하나: 위쪽 갈래가 지향성을 어디서 얻는가로 나뉜다 —
# 원초적이냐 파생적이냐. 아래쪽이 그 원초적 지향성을 자연에서 끌어내려는
# 두 시도다. 오표상을 다룰 수 있는가가 두 시도의 시험대다.
direction: down

지향성: {
  label: "지향성 — 무언가에 관함\n브렌타노가 오늘의 뜻으로 되살린 말이다.\n물리주의에 부담이 되는 성질 둘 — 없는 것에 관할 수 있고, 관점 아래에서 관한다"
  shape: oval
  style.bold: true
}

원초적: {
  label: "원초적 지향성\n남이 그렇게 읽어 주어서 관하는 것이 아니다.\n보기 — 비가 온다는 나의 믿음, 물 한 잔에 대한 나의 욕구"
  style.bold: true
}
파생적: {
  label: "파생적 지향성\n그 자체로는 잉크 자국이고 눈금이다.\n우리가 그렇게 읽기 때문에 관한다.\n보기 — 책에 적힌 ‘고양이’, 지도의 선, 온도계의 눈금, 표지판"
  style.bold: true
}

지향성 -> 원초적: "어디서 얻는가 ①"
지향성 -> 파생적: "어디서 얻는가 ②"

가르는법: {
  label: "가르는 요령 — 해석자를 지우면 관함이 사라지는가.\n사라지면 파생적이고 남으면 원초적이다"
  shape: text
}
파생적 -> 가르는법: { style.stroke-dash: 3 }

순환: {
  label: "왜 이 구별이 필요한가\n파생적 지향성만 갖는 것에 마음을 돌리면 순환이 된다.\n종이가 관하는 것은 우리가 관하기 때문이므로\n종이의 관함으로 우리의 관함을 설명할 수 없다.\n이 구별이 중국어 방 논증에서 곧바로 쓰인다"
  shape: text
}
파생적 -> 순환: { style.stroke-dash: 3 }

자연화: {
  label: "자연화 계획\n물리주의자는 원초적 지향성을 자연적인 것으로 설명해야 한다"
  shape: oval
  style.bold: true
}
원초적 -> 자연화: "설명해야 할 것"

정보: {
  label: "① 정보와 인과\n연기는 불에 대한 정보를 나른다 — 불이 없으면 연기가 나지 않기 때문이다.\n마음의 상태가 무언가에 관한다는 것은,\n그 상태가 그것에 대한 정보를 나르도록 알맞게 이어져 있다는 것이다.\n드레츠키가 이 착상을 다듬었다"
  style.bold: true
}
목적론: {
  label: "② 기능과 목적\n개구리의 어떤 신경 상태는 지나가는 작은 검은 점에 반응한다.\n그 상태가 파리에 관한 것이라 말할 수 있는 이유는\n그 장치가 파리를 잡는 일을 하도록 자연선택이 다듬어 놓았기 때문이다.\n밀리컨이 이 방향을 목적론적 의미론으로 세웠다"
  style.bold: true
}

자연화 -> 정보
자연화 -> 목적론

시험대: {
  label: "시험대 — 오표상 문제\n지향적 상태는 틀릴 수 있어야 한다. 참일 수도 거짓일 수도 없는 것은 믿음이 아니다.\n개구리가 던져진 작은 돌에 혀를 뻗었다면 그 상태는 파리에 관한 것이면서 틀린 것인가,\n아니면 애초에 ‘파리 또는 작은 검은 점’ 에 관한 것이라 틀리지 않은 것인가"
  shape: oval
  style.bold: true
}
정보 -> 시험대: "틀림을 담기 어렵다"
목적론 -> 시험대: "‘원래 하도록 되어 있던 일’ 로 담으려 한다"

부담1: {
  label: "내용을 정보로만 정하면 내용이 넓게 잡히고,\n그러면 개구리는 틀린 적이 없게 된다.\n오표상이 원리적으로 일어나지 않으면\n관함의 핵심 성질 하나가 사라진다"
  shape: text
}
부담2: {
  label: "그 ‘원래’ 를 자연적 사실로 정확히 적는 것이 부담이다.\n자연선택의 역사로 적는 것이 표준 시도인데,\n그러면 같은 물리 구조를 가졌지만 역사가 없는 존재의\n내용이 정해지지 않는다는 문제가 따라온다"
  shape: text
}
시험대 -> 부담1: { style.stroke-dash: 3 }
시험대 -> 부담2: { style.stroke-dash: 3 }

판정: {
  label: "이 문제는 열려 있다. 지향성을 자연화하는 어떤 안도 아직 널리 받아들여지지 않았다"
  shape: text
}
시험대 -> 판정: { style.stroke-dash: 3 }
