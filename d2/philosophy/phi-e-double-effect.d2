# 이중효과 원리의 네 조건 — 철학 18장.
#
# 무엇을 읽어야 하나: 나쁜 결과를 예견하는 것과 의도하는 것을 가르고,
# 앞엣것만 허용한다. 네 조건을 모두 통과해야 한다.
# 걸리는 자리도 함께 적었다 — 19장의 트롤리가 이 원리를 시험한다.
direction: down

조건1: { label: "① 행위 자체가 나쁘지 않을 것\n진통제를 놓는 일 자체는 나쁘지 않다"; style.bold: true }
조건2: { label: "② 나쁜 결과를 의도하지 않을 것\n예견은 하되 노리지는 않는다"; style.bold: true }
조건3: { label: "③ 좋은 결과가 나쁜 결과를 거쳐 나오지 않을 것\n나쁜 결과가 수단이면 안 된다"; style.bold: true }
조건4: { label: "④ 비례할 것\n좋은 결과가 나쁜 결과를 감당할 만큼 클 것"; style.bold: true }

조건1 -> 조건2 -> 조건3 -> 조건4

허용: { label: "네 조건을 모두 통과하면 허용된다"; shape: oval; style.bold: true }
조건4 -> 허용

보기: {
  label: "표준 보기 — 통증을 없애려고 약을 늘리는데 그것이 죽음을 앞당길 것을 예견한다.\n의도한 것은 통증의 제거이고 죽음은 예견된 부작용이다.\n죽음을 수단으로 쓰지 않았으므로 ③도 통과한다"
}
허용 -> 보기

반론1: {
  label: "반론 A — 폐쇄 문제\n무엇을 의도했는지는 다시 적을 수 있다.\n‘그의 죽음’ 이 아니라 ‘그의 몸이 전차를 막는 것’ 을 의도했다고 적으면\n③을 통과해 버린다. 기술을 바꿔 답이 바뀌면 원리가 아니다"
  style.stroke-dash: 3
}
반론2: {
  label: "반론 B — 의도가 행위의 허용성을 정하는가\n같은 일을 같은 방식으로 하는 두 사람이 마음속 의도만 다를 때,\n한 사람만 허용된다고 말해야 한다.\n의도는 행위자를 평가할 뿐 행위를 평가하지 않는다는 것이 톰슨의 지적이다"
  style.stroke-dash: 3
}

조건3 -> 반론1: "여기를 친다"
조건2 -> 반론2: "여기를 친다"

메모: {
  label: "이 원리는 의무론이 결과의 무게를 아주 무시하지는 않으면서\n제약을 지키려는 장치다. 19장에서 트롤리 변형들이 이 장치를 시험한다"
  shape: text
}
