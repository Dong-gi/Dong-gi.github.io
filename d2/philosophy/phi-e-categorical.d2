# 보편 법칙의 정식을 적용하는 절차 — 철학 18장.
#
# 무엇을 읽어야 하나: 정언명령은 규칙 목록이 아니라 검사다. 준칙을 세우고
# 보편화한 뒤 무엇이 무너지는지를 본다. 무너지는 방식이 두 가지라는 것이 요점이다.
direction: down

준칙: { label: "① 준칙을 적는다\n‘나는 곤란할 때 갚을 뜻 없이 갚겠다고 약속한다’\n행위 · 상황 · 목적이 다 들어가야 한다"; style.bold: true }
보편: { label: "② 그 준칙이 모두가 따르는 법칙이라고 상상한다"; style.bold: true }
검사: { label: "③ 무엇이 무너지는지 본다"; style.bold: true }

준칙 -> 보편 -> 검사

모순1: {
  label: "개념에서의 모순\n모두가 그렇게 하면 약속이라는 것이 성립하지 않는다.\n그러면 준칙 자체를 생각할 수 없게 된다.\n완전한 의무 — 예외를 두지 않는다"
}
모순2: {
  label: "의욕에서의 모순\n모두가 남을 돕지 않는 세상은 상상할 수 있다.\n다만 내가 그런 세상을 의욕할 수는 없다.\n불완전한 의무 — 언제 어떻게 할지는 내게 남는다"
}
통과: {
  label: "아무것도 무너지지 않는다\n그 준칙은 허용된다"
}

검사 -> 모순1
검사 -> 모순2
검사 -> 통과

인간성: {
  label: "두 번째 정식 — 인간성의 정식\n너 자신과 다른 사람 안의 인간성을 언제나 목적으로도 대하고\n결코 수단으로만 대하지 마라.\n‘수단으로만’ 이 중요하다. 사람을 수단으로 쓰는 것 자체는 금지되지 않는다"
  style.bold: true
}

약점: {
  label: "약점 — 준칙을 어떻게 적느냐로 결과가 바뀐다.\n같은 행위를 좁게 적으면 통과하고 넓게 적으면 걸린다.\n칸트 쪽의 응답은 준칙에 진짜 목적을 정직하게 적어야 한다는 것인데,\n무엇이 진짜 목적인지를 다시 판단해야 한다"
  style.stroke-dash: 3
}
검사 -> 약점: "여기가 새어 나간다"

충돌: {
  label: "또 하나 — 완전한 의무끼리 부딪히는 경우를 어떻게 하는가.\n거짓말하지 말라와 무고한 사람을 넘기지 말라가 한 자리에서 부딪힐 수 있다.\n로스의 조건부 의무는 이 문제를 정면으로 받으려는 다른 길이다"
  shape: text
}
