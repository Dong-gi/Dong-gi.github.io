# 도덕적 불일치 논증과 그것을 끊는 자리들 — 철학 17장.
#
# 무엇을 읽어야 하나: 이 논증은 세 전제로 서 있고, 실재론자는 전제마다
# 다른 방식으로 끊는다. 어느 끊기도 결정적이지 않다는 것이 이 그림의 요점이다.
vars: { d2-config: { layout-engine: elk } }
direction: down

P1: { label: "(P1) 도덕에는\n깊고 오래가는\n불일치가 있다"; style.bold: true }
P2: { label: "(P2) 그 불일치는\n사실에 대한 무지나\n오류나 비합리로\n다 설명되지 않는다"; style.bold: true }
P3: { label: "(P3) 객관적 사실이 있는\n영역이라면 이런 불일치가\n이렇게까지 남아 있지\n않을 것이다"; style.bold: true }
C: { label: "(C) 그러므로 객관적 도덕 사실은 없다"; style.bold: true }

P1 -> C
P2 -> C
P3 -> C

응답2: {
  label: "(P2)를 끊는다\n불일치의 상당 부분이\n도덕 아닌 사실에 대한 불일치에서 온다.\n무엇이 실제로 일어나는지,\n누가 무엇을 겪는지가 갈리면\n판정도 갈린다.\n이해관계와 이념이 판단을 굽히는 것도\n설명이 된다"
}
응답3: {
  label: "(P3)을 끊는다\n오래가는 불일치는 다른 곳에도 있다.\n수학의 기초와 형이상학이 그렇다.\n그런데 거기서 반실재론을\n끌어내는 사람은 드물다.\n또 도덕에는 실제로\n수렴한 자리도 있다"
}
P2 -> 응답2: "여기를 친다"
P3 -> 응답3: "여기를 친다"

재반론: {
  label: "반실재론 쪽의 재반론\n그 설명들을 다 걷어내도 남는 불일치가 있고,\n그것이 문제다.\n그리고 수렴은 도덕적 수렴이 아니라\n힘과 제도의 수렴일 수 있다"
  style.stroke-dash: 3
}
응답2 -> 재반론
응답3 -> 재반론

판정: {
  label: "판정 — 미결. 이 논증은 반실재론 쪽의 가장 강한 무기이지만 결정적이지 않고,\n실재론 쪽의 응답도 불일치를 다 해소하지 못한다.\n같은 사실이 오류 이론의 상대성 논증에도 쓰인다"
  shape: text
  near: bottom-center
}
