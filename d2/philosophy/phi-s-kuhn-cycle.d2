# 쿤의 순환 — 철학 9장.
#
# 무엇을 읽어야 하나: 화살표에 붙은 조건들이다. 변칙 하나가 곧바로 위기가 되지 않고,
# 위기가 곧바로 혁명이 되지도 않는다. 그 조건들이 포퍼와 갈리는 지점이다.
direction: down

전과학: { label: "전과학\n학파들이 무엇을 사실로 칠지부터 다툰다" }
정상: { label: "정상과학\n하나의 패러다임 안에서 퍼즐을 푼다.\n패러다임 자체는 검사 대상이 아니다"; style.bold: true }
변칙: { label: "변칙 사례\n패러다임이 예상한 대로 풀리지 않는 문제" }
위기: { label: "위기\n기초를 다시 묻기 시작한다" }
혁명: { label: "과학혁명\n패러다임이 바뀐다"; style.bold: true }

전과학 -> 정상: "패러다임 하나가 자리를 잡으면"
정상 -> 변칙: "변칙은 늘 있다. 처음에는 풀 퍼즐로 다룬다"
변칙 -> 위기: "쌓이고, 끈질기고, 중요한 것일 때만"
위기 -> 혁명: "쓸 만한 대안 패러다임이 나와 있을 때만"
혁명 -> 정상: "새 패러다임 아래 다시 퍼즐 풀기"

대비: {
  label: "포퍼라면 변칙 하나가 이론을 반증한다고 말할 자리에서\n쿤은 그런 일이 실제로 일어나지 않는다고 말한다.\n대안 없이 패러다임을 버리는 일은 없다는 것이다"
  shape: text
  style.bold: true
}
