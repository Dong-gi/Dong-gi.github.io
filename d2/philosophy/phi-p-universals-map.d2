# 보편자 논쟁의 입장 지도 — 철학 10장.
#
# 무엇을 읽어야 하나: 위에서 아래로 갈수록 인정하는 목록이 줄고, 대신 갚아야 할
# 설명의 빚이 는다. 어느 줄에도 정답 표시가 없다는 것이 이 그림의 요점이다.
direction: right

물음: {
  label: "빨간 것 둘이 정말 무언가를 공유하는가"
  shape: oval
  style.bold: true
}

실재론: { label: "실재론 — 공유한다.\n그 하나가 보편자다"; style.bold: true }
개념론: { label: "개념론 — 공유하는 것은\n우리가 만든 개념이다" }
유명론: { label: "유명론 — 개별자 말고는 없다"; style.bold: true }

물음 -> 실재론
물음 -> 개념론
물음 -> 유명론

초월: {
  label: "초월적 보편자 (플라톤)\n사례가 하나도 없어도 그 보편자는 있다.\n아직 아무도 못 만든 색도 있다"
}
내재: {
  label: "내재적 보편자 (아리스토텔레스)\n사례 안에만, 사례가 있는 동안만 있다.\n사례가 없는 보편자는 없다"
}
실재론 -> 초월
실재론 -> 내재

술어: {
  label: "술어 유명론\n둘 다 ‘빨갛다’ 가 참인 것들일 뿐이다"
}
유사: {
  label: "유사성 유명론\n둘이 서로 닮았을 뿐이다"
}
트롭: {
  label: "트롭 이론\n사과마다 제 빨감이 따로 있고,\n그 빨감들이 서로 닮았다"
}
유명론 -> 술어
유명론 -> 유사
유명론 -> 트롭

빚1: {
  label: "실재론이 갚을 빚 — 보편자가 어디에 어떻게 있는가.\n하나가 여러 자리에 통째로 있다는 것은 무슨 뜻인가"
  shape: text
}
빚2: {
  label: "유명론이 갚을 빚 — 왜 하필 그 낱말이 그것들에 걸치는가.\n‘닮았다’ 자체가 다시 여럿에 걸친 하나가 아닌가"
  shape: text
}
실재론 -> 빚1: { style.stroke-dash: 3 }
유명론 -> 빚2: { style.stroke-dash: 3 }

판정: {
  label: "이 다툼은 미결이다. 어느 줄도 정답이 아니고,\n각 줄이 무엇을 설명하고 무엇을 대가로 치르는지가\n이 절이 보여야 할 전부다"
  shape: text
}
빚1 -> 판정: { style.opacity: 0 }
빚2 -> 판정: { style.opacity: 0 }
