# 게티어 사례를 만드는 조리법 — 철학 5장.
#
# 무엇을 읽어야 하나: 네 단계가 모두 있어야 게티어 사례가 된다.
# 특히 2단계(그 근거가 사실은 거짓)와 4단계(다른 경로로 참이 됨)가 함께 있어야 한다.
# 하나만 빠지면 그냥 ‘틀린 믿음’ 이거나 그냥 ‘앎’ 이 된다.
direction: down

일: {
  label: "1. 정당화는 튼튼한데 사실은 거짓인 믿음을 하나 만든다\n예 — 동료의 인사 담당자 말과 눈으로 센 동전"
  style.bold: true
}
이: {
  label: "2. 그 거짓 믿음에서 타당한 추론으로 다른 명제를 끌어낸다\n타당하므로 정당화가 그대로 옮겨 간다"
}
삼: {
  label: "3. 끌어낸 명제가 우연히 참이 되도록 세계를 맞춘다\n참이 되는 경로는 믿는 사람이 모르는 다른 경로여야 한다"
}
사: {
  label: "4. 정당화된 참인 믿음이 완성된다 — 그런데 앎이 아니다"
  shape: oval
  style.bold: true
}

일 -> 이 -> 삼 -> 사

빠지면1: {
  label: "2 를 빼면 — 근거가 참이므로 그냥 앎이 된다"
  shape: text
}
빠지면2: {
  label: "3 을 빼면 — 결론도 거짓이므로 그냥 틀린 믿음이다"
  shape: text
}
빠지면3: {
  label: "3 에서 참이 되는 경로가 내 근거와 이어져 있으면 — 다시 그냥 앎이 된다"
  shape: text
}
사 -> 빠지면1: "확인"
사 -> 빠지면2: "확인"
사 -> 빠지면3: "확인"

요점: {
  label: "조리법의 핵심은 ‘정당화가 거짓을 통과할 수 있다’ 는 것이다.\n정당화가 진리를 보증하지 않기 때문에 이 틈이 생긴다"
  shape: text
}
