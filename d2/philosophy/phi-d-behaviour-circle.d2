# 논리적 행동주의가 벗어나지 못하는 순환 — 철학 14장.
#
# 무엇을 읽어야 하나: 가운데 고리가 닫혀 있다는 것. 믿음을 행동으로 옮기려면
# 욕구가 필요하고 욕구를 옮기려면 믿음이 필요하다. 원이 닫히므로 마음 상태를
# 뺀 어휘만으로는 번역이 끝나지 않는다.
# 어떤 마음 상태도 혼자서는 행동을 정하지 않기 때문이다.
direction: down

시도: {
  label: "옮겨 쓰기의 목표와 첫 시도\n‘그는 목이 마르다’ 를 마음 상태를 가리키는 말이 하나도 없는 문장으로 남김없이 바꾸어 적는다.\n첫 시도 — ‘물이 있으면 그가 마실 것이다’.\n그런데 독이 들었다고 믿으면 마시지 않고, 예의를 지켜야 한다고 여기면 참는다"
  shape: oval
  style.bold: true
}

고리: {
  label: "고리가 닫힌다"
  style.bold: true
  direction: right

  욕구: { label: "욕구\n목이 마르다"; style.bold: true }
  믿음: { label: "믿음\n이 액체가 물이다"; style.bold: true }
  행동: { label: "행동\n마신다" }

  욕구 -> 행동: "이것만으로는 행동이 정해지지 않는다"
  행동 -> 믿음: "조건을 채우려면 믿음을 끌어와야 한다"
  믿음 -> 욕구: "그 믿음을 옮기려면 또 다른 욕구가 필요하다"
  욕구 -> 믿음: "그리고 그 역도 마찬가지다"
}
시도 -> 고리: "조건을 채우려고 하면"

결론: {
  label: "그러므로 번역이 끝나지 않는다\n어떤 마음 상태도 혼자서는 행동을 정하지 않는다.\n마음 상태를 뺀 어휘만으로 옮겨 쓰려는 계획이 여기서 막힌다"
  shape: oval
  style.bold: true
}
고리 -> 결론

기능주의: {
  label: "　\n기능주의가 이 고리를 어떻게 다루는가\n행동주의는 마음 상태를 다른 마음 상태로 설명하면 순환이라 여겨 그것을 금지했고, 그 금지 때문에 번역이 끝나지 않았다.\n기능주의는 금지를 푼다 — 마음 상태들을 하나씩 정의하지 않고 관계망 안에서 한꺼번에 정의한다.\n그러면 이 고리는 결함이 아니라 정의의 방식이 된다"
  shape: text
}
결론 -> 기능주의: { style.stroke-dash: 3 }

다른실패: {
  label: "　\n행동주의가 걸린 자리는 이 순환만이 아니다\n둘째 — 슈퍼 스파르타인. 마음 상태는 있는데 행동 성향이 하나도 없는 경우가 생각될 수 있다.\n셋째 — 안에서 아는 방식이 통째로 빠진다. 나는 내 행동을 미리 살펴보고 나서 아프다고 판단하지 않는다"
  shape: text
}
결론 -> 다른실패: { style.stroke-dash: 3 }
