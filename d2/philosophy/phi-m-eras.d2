# 시대 지도 — 철학 3장.
#
# 무엇을 읽어야 하나: 이 문서에 나오는 사람들이 어느 시대 어느 자리에 있는지.
# 이 문서는 철학사를 다루지 않으므로 이 그림 하나가 독자의 유일한 방향 감각이다.
# 괄호 안의 숫자는 그 사람이 주로 나오는 장이다.
direction: down

고대: {
  label: "고대 그리스 — 기원전 6~4세기"
  direction: right
  style.bold: true
  소크라테스: { label: "소크라테스\n‘X 란 무엇인가’ 라고 묻는 방식\n(3장 개념 분석의 원형)" }
  플라톤: { label: "플라톤\n형상 — 보편자 실재론의 뿌리\n(10장)" }
  아리스토텔레스: { label: "아리스토텔레스\n논리학과 형이상학의 어휘, 덕\n(18장)" }
}

헬레니즘: {
  label: "헬레니즘·로마 — 기원전 4세기 ~ 기원후 3세기"
  direction: right
  퓌론: { label: "퓌론과 회의주의 전통\n판단을 미루는 기술\n(7장의 먼 조상)" }
  스토아: { label: "스토아 학파 · 에피쿠로스\n어떻게 살 것인가에 답을 건 학파들" }
}

중세: {
  label: "중세 — 5~15세기"
  direction: right
  아우구스티누스: { label: "아우구스티누스 · 아퀴나스\n신학 안에서 다듬은 형이상학과 윤리" }
  보편자논쟁: { label: "보편자 논쟁\n실재론과 유명론이 여기서 갈린다\n(10장)" }
}

근대: {
  label: "근대 — 17~18세기. 두 흐름이 갈린다"
  direction: right
  합리론: { label: "대륙 합리론\n데카르트 · 스피노자 · 라이프니츠\n지식의 뿌리를 이성에 둔다\n(7장 꿈 논증, 11장 가능세계, 14장 실체 이원론)" }
  경험론: { label: "영국 경험론\n로크 · 버클리 · 흄\n지식의 뿌리를 경험에 둔다\n(8장 귀납, 11장 인과, 13장 기억 기준)" }
}

칸트: {
  label: "칸트 — 18세기 말"
  direction: right
  선험: { label: "이마누엘 칸트\n두 흐름을 한데 놓으려 한 시도.\n선험적/후험적 구분과 의무론이 이 문서에 남았다\n(11장, 18장)" }
}

십구세기: {
  label: "19세기"
  direction: right
  공리주의: { label: "벤담 · 밀\n공리주의를 이론으로 세운다\n(18·19장)" }
  프레게: { label: "프레게\n현대 논리학과 언어철학의 출발\n(16장 뜻과 지시체)" }
  대륙: { label: "헤겔 · 마르크스 · 니체\n이 문서가 다루지 않는 큰 흐름"; style.stroke-dash: 3 }
}

이십세기: {
  label: "20세기 — 분석철학. 이 문서 본문의 대부분이 여기 있다"
  direction: right
  style.bold: true
  출발: { label: "러셀 · 비트겐슈타인 · 카르납\n언어와 논리를 통해 문제를 다시 세운다\n(16장)" }
  인식: { label: "인식론 · 과학철학\n게티어 · 굿맨 · 포퍼 · 쿤\n(5·8·9장)" }
  형이상: { label: "형이상학 · 언어\n콰인 · 크립키 · 퍼트넘 · 그라이스\n(10·11·16장)" }
  마음: { label: "심리철학 · 인격\n설 · 파핏 · 차머스\n(13·14·15장)" }
  윤리: { label: "윤리 · 정치\n앤스컴 · 풋 · 톰슨 · 싱어 · 롤스 · 노직 · 벌린\n(18·19·20장)" }
}

현상학: {
  label: "20세기 — 현상학과 그 이후"
  direction: right
  후설: { label: "후설 · 하이데거 · 메를로퐁티 · 사르트르\n의식에 나타나는 그대로를 기술하는 데서 시작한다.\n이 문서는 이 흐름을 본격적으로 다루지 않는다"; style.stroke-dash: 3 }
}

고대 -> 헬레니즘 -> 중세 -> 근대 -> 칸트 -> 십구세기
십구세기 -> 이십세기
십구세기 -> 현상학

범위: {
  label: "이 지도는 서양 철학만 담고 있다.\n이 문서가 다루는 논쟁과 어휘가\n그 전통에서 나왔기 때문이고,\n그 전통이 더 낫기 때문이 아니다.\n동아시아 철학(유가·도가·불교)과\n인도 철학은 앎·자아·인과·규범에 대해\n독자적인 논의를 오래 쌓아 왔다.\n이 문서는 그것을 다루지 않는다.\n21장이 갈 길을 안내한다"
  shape: text
}

쓰는법: {
  label: "외우라고 있는 그림이 아니다.\n뒤에서 낯선 이름이 나오면\n여기로 돌아와 자리를 확인하면 된다.\n선은 영향 관계가 아니라 시간 순서다.\n실제 계보는 이보다 훨씬 얽혀 있다"
  shape: text
}
