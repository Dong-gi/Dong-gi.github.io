# 프랭크퍼트 사례 — 철학 12장.
#
# 무엇을 읽어야 하나: 실제로 일어난 계열(왼쪽)과 일어나지 않은 계열(오른쪽)을
# 갈라 보면, 개입자는 실제 계열에 아무 일도 하지 않았는데 대안만 없앴다는 것이 보인다.
# 이 사례가 겨누는 것은 결정론이 아니라 ‘달리 할 수 있었음’ 이라는 조건 하나다.
direction: down

무대: {
  label: "무대\n존스는 투표를 하려 한다. 블랙은 존스가 A 를 찍기를 바란다.\n블랙은 존스의 머리에 장치를 심어 두고 지켜본다"
  shape: oval
  style.bold: true
}

갈림: { label: "존스가 마음을 정하는 순간\n블랙은 그 징후를 읽고 개입할지 정한다"; shape: diamond }

실제: {
  label: "실제로 일어난 일\n존스가 스스로 A 를 찍기로 한다.\n블랙은 아무것도 하지 않는다"
  style.bold: true
}
가상: {
  label: "일어나지 않은 일\n존스가 B 쪽으로 기울었다면\n블랙이 장치를 켜 A 를 찍게 만들었을 것이다"
  style.stroke-dash: 3
}

무대 -> 갈림
갈림 -> 실제: "A 쪽 징후"
갈림 -> 가상: "B 쪽 징후"

판정1: { label: "존스는 A 를 찍은 데 대해 책임이 있어 보인다\n그가 한 일은 개입 없는 자기 결정이었다" }
판정2: { label: "그런데 존스는 달리 할 수 없었다\n어느 쪽으로 기울었든 결과는 A 였다" }

실제 -> 판정1
가상 -> 판정2

결론: {
  label: "겨냥하는 것 — 대안 가능성 원리\n‘책임이 있으려면 달리 할 수 있었어야 한다’ 는 원리가 반례를 맞는다.\n결정론이 참이라는 결론은 여기서 나오지 않는다"
  shape: oval
  style.bold: true
}

판정1 -> 결론
판정2 -> 결론

다툼: {
  label: "사례가 성공했는지도 다툼거리다 — 딜레마 반론.\n블랙이 읽은 징후가 존스의 선택을 이미 못 박는 것이라면, 사례는 결정론을 몰래 깔고 들어간 것이다.\n못 박지 않는 것이라면, 블랙은 제때 개입할 수 없으므로 대안이 정말로 사라진 것이 아니다"
  shape: text
}

번쩍임: {
  label: "또 하나의 응답 — 번쩍임.\n존스에게 남은 대안이 아주 작게라도 있다(B 쪽으로 기울어 개입을 부르는 일).\n프랭크퍼트 쪽 답 — 그 남은 대안은 책임을 떠받칠 만큼의 것이 못 된다"
  shape: text
}
