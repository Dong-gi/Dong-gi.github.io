# 인격 동일성의 세 기준과 각 기준을 흔드는 사례 — 철학 13장.
#
# 무엇을 읽어야 하나: 기준마다 지키려는 것이 다르다. 왼쪽 열이 기준,
# 가운데가 그 기준이 지키려는 직관, 오른쪽이 그 기준을 흔드는 사례다.
# 어느 줄도 아직 지워지지 않았다 — 그래서 이 물음이 미결이다.
direction: right

물음: {
  label: "지금의 내가 과거의 그 사람과\n같은 사람이라는 것은\n무엇이 성립한다는 말인가"
  shape: oval
  style.bold: true
}

신체: { label: "신체 기준\n같은 몸이 이어지면 같은 사람이다"; style.bold: true }
동물: { label: "동물주의\n사람은 하나의 동물이고,\n동물이 살아 있는 동안 그 사람이 있다" }
기억: { label: "기억 기준 — 로크\n과거의 그 일을 안에서 기억하면\n그 사람이 나다"; style.bold: true }
심리: { label: "심리 연속성 기준\n기억·의도·성격이 겹치는 사슬로\n이어지면 같은 사람이다"; style.bold: true }

물음 -> 신체
물음 -> 기억
신체 -> 동물: "다듬으면"
기억 -> 심리: "순환과 연쇄를 고치면"

사례1: {
  label: "왕자와 구두장이\n기억이 통째로 옮겨 가면\n우리는 사람이 따라갔다고 말하고 싶어진다"
  style.stroke-dash: 3
}
사례2: {
  label: "생각하는 동물 논증\n내 의자에는 사람도 앉아 있고 동물도 앉아 있다.\n둘이 다른 것이라면 생각하는 것이 둘인가"
  style.stroke-dash: 3
}
사례3: {
  label: "순환 반론 — 버틀러\n‘내가 겪은 일을 기억한다’ 가\n이미 동일성을 쓰고 있다"
  style.stroke-dash: 3
}
사례4: {
  label: "분열\n같은 관계가 두 사람에게 한꺼번에 성립한다.\n동일성은 하나에 하나만 성립한다"
  style.stroke-dash: 3
}

신체 -> 사례1: "흔든다"
동물 -> 사례2: "되받아친다"
기억 -> 사례3: "흔든다"
심리 -> 사례4: "흔든다"

메모: {
  label: "오른쪽 위의 생각하는 동물 논증은 동물주의가 심리 쪽 기준을 되받아치는 논증이다.\n분열 사례가 심리 연속성 기준 하나를 흔든다면, 이 논증은 심리 쪽 전체를 흔든다.\n소수설이라고 해서 약한 것이 아니다"
  shape: text
}
