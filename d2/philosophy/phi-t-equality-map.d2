# 평등 논쟁의 지도 — 철학 20장.
#
# 무엇을 읽어야 하나: ‘평등해야 한다’ 는 한 문장이 아니라 세 물음이 겹쳐 있는
# 자리다. 무엇을 고르게 할 것인가, 어떤 불평등이 부정의한가, 그리고 애초에
# 평등 자체가 목표인가. 아래로 내려갈수록 평등주의 안쪽에서 갈리는 물음이다.
direction: down

물음1: {
  label: "물음 하나 — 무엇의 평등인가\n평등을 말하려면 무엇의 눈금으로 잴지부터 정해야 한다"
  shape: oval
  style.bold: true
}

후생: { label: "후생의 평등\n각자가 얼마나 만족하는가로 잰다.\n값비싼 취향을 가진 사람에게 더 주어야 한다는 결과가 나온다" }
자원: { label: "자원의 평등 — 드워킨\n각자가 무엇을 쥐고 출발하는가로 잰다.\n남의 몫을 부러워하지 않는 상태를 기준으로 삼는다" }
역량: { label: "역량의 평등 — 센\n무엇을 가졌는가가 아니라 그것으로 무엇을 할 수 있는가로 잰다.\n같은 곡식이라도 병든 사람에게는 다른 값이다" }

물음1 -> 후생
물음1 -> 자원
물음1 -> 역량

물음2: {
  label: "물음 둘 — 어떤 불평등이 부정의한가"
  shape: oval
  style.bold: true
}
자원 -> 물음2
역량 -> 물음2

운평등: {
  label: "운 평등주의\n선택에서 온 불평등은 정당할 수 있고,\n선택하지 않은 사정에서 온 불평등은 부정의하다.\n12장의 도덕적 운을 분배에 적용한 것이다"
  style.bold: true
}
물음2 -> 운평등

반론1: {
  label: "반론 A — 가혹함\n자기 선택으로 망가진 사람은 도울 이유가 없다는 결론이 나온다.\n보험 없이 몰다 사고 난 사람을 길에 두는 것이 정의인가"
  style.stroke-dash: 3
}
반론2: {
  label: "반론 B — 모욕적인 판정\n누가 무능력하고 누가 자기 잘못인지를 국가가 가려야 한다.\n그 심사 자체가 평등한 시민 대접과 충돌한다"
  style.stroke-dash: 3
}
반론3: {
  label: "반론 C — 선택의 칸이 비어 있다\n선택은 성격에서 나오고 성격은 선택한 것이 아니다.\n통제 조건을 끝까지 밀면 ‘선택에서 온 것’ 이 거의 남지 않는다.\n12장이 도덕적 운에서 만난 어려움이 그대로 되풀이된다"
  style.stroke-dash: 3
}
운평등 -> 반론1
운평등 -> 반론2
운평등 -> 반론3

관계: {
  label: "관계적 평등 — 앤더슨\n평등의 요점은 몫을 고르게 하는 것이 아니라\n서로가 서로를 지배하지 않는 관계를 세우는 것이다.\n물어야 할 것은 ‘누가 얼마나 갖는가’ 가 아니라\n‘누가 누구 앞에 굽실거려야 하는가’ 다"
  style.bold: true
}
반론2 -> 관계: "여기서 갈라진다"

물음3: {
  label: "물음 셋 — 평등 자체가 좋은 것인가"
  shape: oval
  style.bold: true
}
운평등 -> 물음3
관계 -> 물음3

수평화: {
  label: "수평화 반론 — 파핏\n평등 자체가 좋다면, 잘 사는 쪽을 끌어내려\n아무도 나아지지 않는데도 어떤 면에서 더 나아졌다고 해야 한다.\n그 결론을 받아들일 수 있는가"
  style.stroke-dash: 3
}
물음3 -> 수평화

우선: {
  label: "우선주의 — 파핏\n중요한 것은 격차가 아니라 절대적 수준이다.\n못한 처지에 있는 사람의 같은 크기 이익이 더 무겁다.\n끌어내리기는 아무에게도 좋지 않으므로 좋을 수 없다"
}
충분: {
  label: "충분주의 — 프랭크퍼트\n중요한 것은 모두가 충분히 갖는 것이다.\n그 선을 넘은 뒤의 격차는 그 자체로 문제가 아니다.\n12장의 프랭크퍼트 사례와 같은 사람이다"
}
수평화 -> 우선
수평화 -> 충분

메모: {
  label: "이 지도의 어느 갈래도 지워지지 않았다. 운 평등주의는 ‘왜 어떤 불평등은 참을 만하고 어떤 것은 아닌가’ 를 설명하는 힘이 크고,\n관계적 평등은 평등 요구가 원래 무엇에 대한 항의였는지를 설명하는 힘이 크다.\n둘을 합치려는 시도도 여럿 있다. 이 문서는 어느 쪽도 고르지 않는다"
  shape: text
}
