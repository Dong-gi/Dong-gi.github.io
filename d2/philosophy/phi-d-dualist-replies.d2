# 이원론이 인과 문제에 답하는 세 길과 각각의 대가 — 철학 14장.
#
# 무엇을 읽어야 하나: 오른쪽 칸이 비어 있는 줄이 하나도 없다.
# 셋 다 살아 있는 선택지이되 셋 다 값을 치른다. 어느 길로 가든
# 마음이 세상을 움직인다는 상식 가운데 무언가를 내놓아야 한다.
direction: right

문제: {
  label: "인과적 상호작용 문제\n엘리자베스의 물음 — 넓이 없는 것이 어떻게 미는가.\n오늘의 형태 — 인과적 폐쇄 —\n원인을 가진 물리적 사건의 원인은 물리적 사건이다"
  shape: oval
  style.bold: true
}

상호작용론: {
  label: "상호작용론\n마음과 몸이 정말로 서로를 움직인다.\n인과적 폐쇄가 참이 아니거나,\n물리 법칙이 열어 둔 틈에서 마음이 일한다"
  style.bold: true
}
병행론: {
  label: "병행론\n마음과 몸은 서로를 움직이지 않는다.\n두 계열이 나란히 흐르도록\n처음부터 맞춰져 있다"
  style.bold: true
}
부수현상론: {
  label: "부수현상론\n몸이 마음을 낳지만 마음은 아무것도 낳지 않는다.\n마음은 기계에서 나는 소리 같은 것이다"
  style.bold: true
}

문제 -> 상호작용론: "폐쇄를 부인한다"
문제 -> 병행론: "인과 자체를 부인한다"
문제 -> 부수현상론: "한 방향만 남긴다"

값1: {
  label: "물리학과 부딪친다.\n그 틈이 어디인지,\n왜 아직 아무도 못 봤는지\n말해야 한다.\n가장 강한 형태 — 인과적 폐쇄는\n물리학의 정리가 아니라\n지금까지의 탐구에서 뽑아낸\n열거적 귀납의 결론이므로\n반례가 나올 수 있는 명제다"
  style.stroke-dash: 3
}
값2: {
  label: "왜 맞춰져 있는지를 설명하려면\n큰 것을 끌어와야 한다.\n설명의 값이 문제보다 커진다"
  style.stroke-dash: 3
}
값3: {
  label: "아파서 소리쳤다는 말이 거짓이 된다.\n더 아픈 값 — 아픔에 대해 말하는 일조차\n아픔이 원인이 아니게 된다.\n부수현상론이 참이면 내가 지금 감각질에\n대해 말하고 있다는 사실을\n감각질이 설명하지 못한다.\n이 곤란은 이 장에서 끝나지 않는다 —\n속성 이원론에도, 배제 논증에도,\n15장의 좀비 논증에도 되돌아온다"
  style.stroke-dash: 3
}

상호작용론 -> 값1: "치르는 값"
병행론 -> 값2: "치르는 값"
부수현상론 -> 값3: "치르는 값"
