# 파핏이 가는 길 — 철학 13장.
#
# 무엇을 읽어야 하나: 분열 사례에서 답을 고르지 않고 물음 자체를 다시 보는 길이다.
# 오른쪽 끝의 두 상자가 이 장의 미결 지점이다. 저자는 그중 하나를 고르지 않는다.
direction: right

분열: {
  label: "분열 사례\n어느 답도 대가를 치르지 않고는 고를 수 없다"
  shape: oval
  style.bold: true
}

물음: { label: "‘둘 중 누가 나인가’ 라는 물음이\n답을 가지고 있기는 한가" }

사실: {
  label: "환원 견해\n사람이 시간을 지나 존속한다는 것은\n몸과 뇌가 이어지고 심리가 이어진다는 것이 전부다.\n그 밑에 더 깊은 사실은 없다"
  style.bold: true
}

빈물음: {
  label: "그렇다면 사실을 다 알고도 남는 물음은\n빈 물음이다. 답이 숨어 있는 것이 아니라\n물을 것이 없는 것이다"
}

관계R: {
  label: "중요한 것은 동일성이 아니라 관계 R\n심리적 연결성과 연속성, 그리고 그것이\n올바른 방식으로 생겨났다는 것"
  style.bold: true
}

분열 -> 물음
물음 -> 사실
사실 -> 빈물음
빈물음 -> 관계R: "그러면 남는 것"

받아들임: {
  label: "받아들이는 쪽\n분열은 죽음이 아니다. 관계 R 이 두 갈래로\n이어지는 것은 끊기는 것보다 낫다.\n동일성에 걸어 두었던 무게를 옮기면 된다"
}
거부: {
  label: "거부하는 쪽\n환원 견해가 틀렸다. 사람은 몸과 심리의 사실로\n환원되지 않는 무언가다 — 단순 견해.\n또는 사람은 하나의 동물이므로 물음에 답이 있다 — 동물주의"
}

관계R -> 받아들임
관계R -> 거부

미결: {
  label: "여기가 미결이다. 파핏의 결론은 널리 읽히고 널리 논박된다.\n받아들이는 쪽과 거부하는 쪽 모두 살아 있는 견해이고,\n이 문서는 둘 중 하나를 고르지 않는다"
  shape: text
}

주의: {
  label: "거부하는 쪽에도 이유가 있다.\n‘사람은 몸과 심리의 사실로 환원되지 않는다’ 고 말하는 근거는 이렇다 —\n분열 사례에서 우리가 느끼는 당혹 자체가 무언가 빠졌다는 신호일 수 있다는 것이다"
  shape: text
}
