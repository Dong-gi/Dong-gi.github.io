# 클론 선택과 자기반응 클론의 제거 — 16장(동물의 구조와 생리).
#
# 무엇을 읽어야 하나: 항원은 수용체를 만들라고 지시하지 않는다. 이미 있는 것
# 중에서 고를 뿐이다. 다양성은 항원을 만나기 전에 V(D)J 재조합으로 미리
# 만들어지고, 무작위로 만든 대가로 자기 분자에 반응하는 클론이 섞여 나오므로
# 그것을 걸러 내는 관문이 반드시 필요하다.
direction: down

재조합: {
  label: "① 다양성을 미리 만든다 — V(D)J 재조합\nV, D, J 조각 무리에서 하나씩 골라 이어 붙인다\n조각 수의 곱에 이음매의 부정확성이 더해져\n열 자릿수 규모의 특이성이 나온다"
  style.bold: true
}

후보: {
  label: "② 특이성이 하나뿐인 림프구가 잔뜩 준비된다 (항원을 만나기 전이다)"
  클론A: { label: "클론 A\n항원 A 에만 반응" }
  클론B: { label: "클론 B\n항원 B 에만 반응" }
  클론기타: { label: "…\n한 번도 만난 적 없는\n항원용 클론까지 포함해서" }
  클론S: {
    label: "클론 S\n자기 분자에 반응한다\n무작위로 만들었으니 섞여 나온다"
    style.stroke-dash: 3
  }
}

관문: {
  label: "③ 제거 관문\n자기 분자에 반응하는가"
  shape: diamond
}

탈락: {
  label: "죽거나 반응하지 못하게 잠긴다\n이 관문이 깨진 것이 자가면역질환이다"
  style.stroke-dash: 3
}

만남: {
  label: "④ 항원 A 가 들어온다"
  style.bold: true
}

증식: {
  label: "⑤ 맞는 클론만 증식한다\n항원이 새 수용체를 만들라고 지시하는 것이 아니다"
  style.bold: true
}

형질: { label: "형질세포\n항체를 대량으로 낸다\n지금의 감염을 끝내는 쪽" }
기억: { label: "기억세포\n오래 살아남는다\n다음번을 위한 쪽" }

재조합 -> 후보
후보.클론S -> 관문
관문 -> 탈락: "그렇다"
만남 -> 후보.클론A: "맞는 것과 붙는다"
후보.클론A -> 증식
증식 -> 형질
증식 -> 기억

비교: {
  label: "13장의 자연선택과 논리 구조가 같다\n변이가 먼저 있고 환경이 그중에서 고른다\n여기서는 클론이 먼저 있고 항원이 그중에서 고른다\n둘 다 '쓰는 쪽이 만들라고 시킨다'가 아니다"
  style.stroke-dash: 3
}
