# 세포 주기의 검문지점 — 8장(세포 주기와 분열).
#
# 무엇을 읽어야 하나: 검문지점은 "브레이크"이지 "액셀"이 아니다.
# 조건이 맞아야 통과가 허락되고, 맞지 않으면 그 자리에서 멈춘다.
# 멈춘 뒤의 선택지가 세 갈래(수리, 대기, 자살)라는 것도 함께 보라.
direction: right

G1: {
  label: "G1기"
}

검문1: {
  label: "G1/S 검문지점 (제한점)\n확인: 세포가 충분히 컸는가\n영양과 성장 신호가 있는가\nDNA 에 손상은 없는가"
  shape: diamond
}

S: {
  label: "S기\nDNA 복제"
}

G2: {
  label: "G2기"
}

검문2: {
  label: "G2/M 검문지점\n확인: 복제가 끝났는가\n복제 중 생긴 손상을 고쳤는가"
  shape: diamond
}

M전반: {
  label: "M기 전기 ~ 중기\n염색체 응축과 정렬"
}

검문3: {
  label: "방추사 부착 검문지점\n확인: 모든 동원체가 양극에\n제대로 붙었는가"
  shape: diamond
}

M후반: {
  label: "M기 후기 ~ 세포질분열\n자매염색분체 분리, 세포가 둘로"
}

멈춤: {
  label: "통과 실패 — 진행이 멈춘다"

  수리: { label: "손상을 고치고 다시 도전" }
  G0: { label: "G0 로 빠져 대기하거나\n영구히 분열을 그만둔다 (노화)" }
  자멸: { label: "고칠 수 없으면 세포자멸사" }
}

암: {
  label: "검문 장치가 망가지면\n손상을 안은 채로 계속 분열한다\n= 암으로 가는 첫 걸음"
  style.stroke-dash: 3
}

G1 -> 검문1
검문1 -> S: "통과"
S -> G2
G2 -> 검문2
검문2 -> M전반: "통과"
M전반 -> 검문3
검문3 -> M후반: "통과"
M후반 -> G1: "딸세포는 다시 G1 로"

검문1 -> 멈춤: "불합격"
검문2 -> 멈춤: "불합격"
검문3 -> 멈춤: "불합격"

멈춤 -> 암: "검문 자체가 고장 나면\n이 경로가 작동하지 않는다"
