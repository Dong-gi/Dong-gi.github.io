# 초기 발생의 단계와 세 배엽 — 16장(동물의 구조와 생리).
#
# 무엇을 읽어야 하나: 난할과 낭배 형성이 하는 일이 서로 다르다는 것.
# 난할은 부피를 그대로 두고 세포 수만 늘리고, 낭배 형성은 세포 수를 크게
# 늘리는 대신 자리를 바꾼다. '배엽'이라는 말이 뜻을 갖기 시작하는 시점도
# 포배가 아니라 낭배 형성부터다.
direction: right

수정: {
  label: "수정\n반수체 둘이 만나 이배체 접합자가 된다"
  style.bold: true
}

난할: {
  label: "난할\n성장 없이 분열만 한다\n배 전체의 부피는 거의 그대로이고 세포 수만 는다\n그래서 세포 하나는 분열할수록 작아진다"
}

포배: {
  label: "포배\n속이 빈 세포 공\n아직 배엽은 없다"
}

낭배: {
  label: "낭배 형성\n세포가 대규모로 이동한다\n여기서 몸의 기본 배치가 정해진다"
  style.bold: true
}

기관: {
  label: "기관 형성\n배엽마다 자기 몫의 기관을 만든다"
}

수정 -> 난할 -> 포배 -> 낭배 -> 기관

배엽: {
  label: "낭배 형성이 만드는 세 배엽 — 무엇이 되는가"
  외배엽: { label: "외배엽\n표피 · 신경계 · 감각기관" }
  중배엽: { label: "중배엽\n근육 · 뼈 · 순환계 · 신장 · 생식샘 · 진피" }
  내배엽: { label: "내배엽\n소화관 상피 · 간 · 이자 · 폐 상피 · 갑상샘" }
}

낭배 -> 배엽.외배엽
낭배 -> 배엽.중배엽
낭배 -> 배엽.내배엽

검산: {
  label: "헷갈리면 이 두 줄로 검산한다\n난할은 수를 늘리고, 낭배 형성은 자리를 바꾼다\n배엽으로 갈리기 전까지는 어느 세포가 무엇이 될지 정해져 있지 않다"
  style.stroke-dash: 3
}

세포수: {
  label: "세포 하나의 크기로도 단계를 가릴 수 있다\n난할기에는 분열할수록 작아지고, 기관 형성기에는 성장이 다시 시작된다"
  style.stroke-dash: 3
}
