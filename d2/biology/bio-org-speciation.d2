# 종분화가 완성되기까지 — 13장(진화).
#
# 무엇을 읽어야 하나: 종분화의 핵심 조건은 하나뿐이다. "유전자 흐름이 끊기는가."
# 지리적 분리는 그 조건을 만드는 가장 흔한 방법일 뿐 필수 조건이 아니다.
# 아래 세 경로가 모두 같은 목적지(생식적 격리)에 닿는다는 점을 보라.
vars: { d2-config: { layout-engine: elk } }
direction: down

시작: {
  label: "하나의 집단\n구성원끼리 자유롭게 교배한다"
  style.bold: true
}

이소: {
  label: "이소적 종분화 (allopatric)"

  이소1: { label: "강, 산맥, 바다, 빙하가\n집단을 물리적으로 가른다" }
  이소2: { label: "두 집단이 각자\n부동과 선택을 겪는다\n환경이 다르면 다른 방향으로 간다" }
  이소3: { label: "차이가 쌓여\n다시 만나도 교배하지 않거나\n교배해도 자손이 살지 못한다" }
  이소1 -> 이소2 -> 이소3
}

동소: {
  label: "동소적 종분화 (sympatric)"

  동소1: { label: "같은 지역에 있으면서\n유전자 흐름을 이겨야 한다" }
  동소2: { label: "배수체화 —\n유전체가 배가되어\n한 세대에 부모 종과\n교배 불가가 된다\n식물에서 흔하다" }
  동소3: { label: "숙주나 서식 층위 전환 —\n짝을 만나는 자리가 갈린다" }
  동소1 -> 동소2
  동소1 -> 동소3
}

인접: {
  label: "인접분포적 종분화 (parapatric)"
  인접1: { label: "분포가 맞닿아 있고\n접촉면에서만 잡종이 생긴다" }
  인접2: { label: "환경 기울기를 따라\n다른 방향의 선택이 걸린다\n선택이 유전자 흐름보다\n강해야 성립한다" }
  인접1 -> 인접2
}

강화: {
  label: "강화 (reinforcement)\n잡종의 적응도가 낮으면\n'잘못된 짝을 고르지 않는 형질'이 선택된다\n→ 접합 전 격리가 나중에 더 단단해진다"
}

완성: {
  label: "생식적 격리 완성\n= 두 종\n서로의 유전자 풀이 독립적으로 진화한다"
  style.bold: true
}

시작 -> 이소
시작 -> 동소
시작 -> 인접
이소 -> 강화: "다시 만났을 때"
동소 -> 완성
인접 -> 강화
강화 -> 완성
