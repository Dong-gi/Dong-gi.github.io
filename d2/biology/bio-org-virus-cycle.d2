# 바이러스가 세포 안에서 하는 일과 두 갈래 경로 — 14장(생물의 다양성).
#
# 무엇을 읽어야 하나: 가운데 세로줄이 모든 바이러스에 공통인 다섯 단계다.
# 갈라지는 곳은 '유전체를 곧바로 읽어 새 입자를 만들 것인가'와
# '숙주 유전체 안에 들어가 잠자코 함께 복제될 것인가' 하나뿐이다.
direction: down

부착: { label: "부착\n캡시드나 외피의 단백질이\n숙주 표면의 특정 분자에 붙는다\n→ 숙주 범위가 여기서 정해진다" }
침입: { label: "침입\n유전체가 세포 안으로 들어간다" }
갈림: { label: "갈림길"; style.bold: true }

용균: {
  label: "용균 경로 (lytic)"
  복제1: { label: "유전체를 곧바로 복제하고\n숙주 리보솜으로 단백질을 만든다" }
  조립1: { label: "새 입자를 조립한다" }
  방출1: { label: "세포를 터뜨리거나 싸여 나간다\n→ 증상이 곧바로 나타난다" }
  복제1 -> 조립1 -> 방출1
}

용원: {
  label: "용원 경로 (lysogenic)"
  통합: { label: "숙주 유전체에 끼어 들어가거나\n플라스미드처럼 따로 유지된다" }
  잠복: { label: "숙주가 분열할 때 함께 복제된다\n겉으로는 아무 일도 없다" }
  전환: { label: "잠복 중에도 숙주에 형질을 줄 수 있다\n(용원 전환 — 일부 세균 독소 유전자가 여기서 온다)" }
  유도: { label: "손상이나 스트레스를 받으면 빠져나와\n용균 경로로 넘어간다" }
  통합 -> 잠복 -> 유도
  잠복 -> 전환
}

부착 -> 침입 -> 갈림
갈림 -> 용균.복제1: "즉시 증식"
갈림 -> 용원.통합: "잠복"
용원.유도 -> 용균.복제1: "깨어난다"

읽는법: {
  label: "이 그림에 없는 것이 요점이다\n바이러스에는 리보솜도, ATP 를 만드는 장치도, 스스로 도는 대사도 없다\n그래서 세포 밖에서는 아무 일도 하지 못하고, 항생제의 표적도 없다"
  style.stroke-dash: 3
}
