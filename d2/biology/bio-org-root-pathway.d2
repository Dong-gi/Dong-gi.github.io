# 토양의 물이 물관부에 닿기까지의 세 경로 — 15장(식물의 구조와 생리).
#
# 무엇을 읽어야 하나: 세 경로 가운데 둘은 도중에 막을 지나고, 하나(세포벽 경로)는
# 막을 한 번도 지나지 않는다. 내피의 카스파리대가 그 하나를 끊어 놓아
# 모든 물이 적어도 한 번은 막을 지나게 만든다. 검문소를 한 곳에 몰아 놓은 설계다.
direction: right

토양: { label: "토양 용액\n물 + 무기 이온"; style.bold: true }
뿌리털: { label: "뿌리털\n표면적을 몇 배로 늘린다" }

경로: {
  label: "피층을 지나는 세 경로"
  세포벽: { label: "세포벽 경로 (아포플라스트)\n세포벽 사이의 틈으로만 흐른다\n막을 한 번도 지나지 않는다 → 선택이 없다" }
  세포질: { label: "세포질 경로 (심플라스트)\n원형질연락사로 이어진 세포질을 따라 간다\n들어올 때 한 번 막을 지났다" }
  가로지름: { label: "가로지름 경로\n세포막을 여러 번 드나든다\n아쿠아포린이 통과 속도를 조절한다" }
}

내피: {
  label: "내피 — 카스파리대"
  차단: { label: "세포벽에 소수성 띠가 둘러져 있어\n세포벽 경로가 여기서 끊긴다" }
  통과: { label: "그래서 모든 물과 이온이\n적어도 한 번은 세포막을 지나야 한다" }
}

물관부: { label: "물관부\n위로 한 방향 수송"; style.bold: true }

토양 -> 뿌리털 -> 경로
경로.세포벽 -> 내피.차단: "막힌다"
경로.세포질 -> 내피.통과
경로.가로지름 -> 내피.통과
내피.차단 -> 내피.통과: "막을 지나는 경로로 갈아탄다"
내피.통과 -> 물관부

의미: {
  label: "왜 이렇게 만들었나\n· 무엇을 들일지 고르려면 막이 필요하다. 세포벽 틈에는 고를 장치가 없다\n· 검문소를 한 겹에 몰아 두면 그 한 겹만 관리하면 된다\n· 물관부 안의 농도를 뿌리보다 높게 유지할 수 있어 뿌리압도 여기서 생긴다"
  style.stroke-dash: 3
}
