# 생물학의 계층 구조 — 3장(생명의 특징과 연구 방법).
#
# 무엇을 읽어야 하나: 한 칸 올라갈 때마다 아래 칸에는 없던 성질이 새로 나타난다.
# 부품 목록이 같아도 배선이 다르면 다른 기계가 된다는 것이 요점이다.
# 이 문서가 다루는 범위(3~7장은 분자에서 세포까지)도 함께 확인하라.
direction: right

분자층: {
  label: "분자 수준 — 4장에서 다룬다"
  style.stroke-dash: 3

  원자: { label: "원자\n탄소, 수소, 산소, 질소" }
  분자: { label: "분자\n물, 포도당, 아미노산" }
  거대분자: { label: "거대분자\n단백질, 핵산, 다당류" }
  복합체: { label: "복합체\n리보솜, 세포막, 방추사" }

  원자 -> 분자
  분자 -> 거대분자
  거대분자 -> 복합체
}

세포층: {
  label: "세포 수준 — 5~7장에서 다룬다"
  style.stroke-dash: 3

  소기관: { label: "소기관\n핵, 미토콘드리아, 엽록체" }
  세포: { label: "세포\n스스로 살아가는 가장 작은 단위" }

  소기관 -> 세포
}

개체층: {
  label: "개체 수준 — 15, 16장에서 다룬다"
  style.stroke-dash: 3

  조직: { label: "조직\n같은 일을 하는 세포의 모임" }
  기관: { label: "기관\n여러 조직이 모인 것" }
  기관계: { label: "기관계\n소화계, 순환계" }
  개체: { label: "개체" }

  조직 -> 기관
  기관 -> 기관계
  기관계 -> 개체
}

집단층: {
  label: "집단 수준 — 17장에서 다룬다"
  style.stroke-dash: 3

  개체군: { label: "개체군\n같은 종의 무리" }
  군집: { label: "군집\n여러 종이 함께 사는 곳" }
  생태계: { label: "생태계\n군집 + 환경" }
  생물권: { label: "생물권\n지구 전체" }

  개체군 -> 군집
  군집 -> 생태계
  생태계 -> 생물권
}

분자층.복합체 -> 세포층.소기관: "인지질 한 분자에는\n반투과성이 없지만\n이중층에는 있다"
세포층.세포 -> 개체층.조직: "유전체가 같은 세포가\n서로 다른 조직이 된다"
개체층.개체 -> 집단층.개체군: "개체 하나에는 없던\n출생률·사망률이 생긴다"
