# 면역의 두 층과 반응의 시간 경과 — 16장(동물의 구조와 생리).
#
# 무엇을 읽어야 하나: 두 층이 서로 다른 것을 알아보고, 다른 속도로 작동하며,
# 한쪽에만 기억이 남는다는 것. 2차 반응이 빠르고 강한 이유가 아래쪽의
# 기억세포 상자 하나에서 나온다. 선천 면역을 '약한 면역'으로 읽으면 안 된다.
direction: down

침입: {
  label: "병원체가 들어온다"
  style.bold: true
}

선천: {
  label: "선천 면역"
  style.bold: true
  무엇: { label: "무엇을 알아보나\n병원체 무리가 공통으로 가진 패턴\n(세균 세포벽 성분, 이중가닥 RNA 등)" }
  언제: { label: "언제 작동하나\n수 분에서 수 시간" }
  기억: { label: "기억\n없다. 두 번째도 첫 번째와 똑같다" }
  무엇 -> 언제 -> 기억
}

적응: {
  label: "적응 면역"
  style.bold: true
  무엇: { label: "무엇을 알아보나\n특정 항원의 특정 부위 하나" }
  언제: { label: "언제 작동하나\n1차 감염에서는 며칠" }
  기억: { label: "기억\n남는다. 기억세포가 오래 살아남는다" }
  무엇 -> 언제 -> 기억
}

침입 -> 선천.무엇: "먼저 만난다"
침입 -> 적응.무엇: "동시에 시작하지만 느리다"
선천 -> 적응: "항원을 제시해 적응 면역을 켠다"

재감염: {
  label: "같은 병원체가 다시 들어온다"
  style.bold: true
}

이차: {
  label: "2차 반응\n며칠이 아니라 하루 이틀 안에 시작하고\n항체의 양도 결합력도 1차보다 위다\n예방접종이 노리는 것이 바로 이 상태다"
  style.bold: true
}

적응.기억 -> 재감염: "이 상태로 기다린다" {
  style.stroke-dash: 3
}
재감염 -> 이차

주의: {
  label: "선천 면역을 '약한 면역'으로 읽지 말 것\n감염의 대부분은 적응 면역이 켜지기도 전에 여기서 끝난다\n적응 면역까지 간 감염은 선천 면역이 막지 못한 소수다"
  style.stroke-dash: 3
}
