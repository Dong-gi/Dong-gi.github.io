# 압류설: 설탕은 어떻게 공급원에서 수용부로 흐르는가 — 15장(식물의 구조와 생리).
#
# 무엇을 읽어야 하나: 흐름을 만드는 것은 설탕 자체가 아니라 압력 차다.
# 설탕은 삼투로 물을 끌어들여 압력을 만드는 역할만 한다.
# 그래서 적재와 하역만 능동이고 가운데 구간은 그냥 밀려 흐른다.
direction: right

공급원: {
  label: "공급원 (source) — 성숙한 잎"
  적재: { label: "1. 설탕을 체관으로 능동 적재\nATP 로 만든 양성자 기울기를 쓴다" }
  물유입: { label: "2. Ψs 가 낮아져 물관부에서 물이 들어온다" }
  고압: { label: "3. 팽압이 올라간다 (높은 압력)" }
  적재 -> 물유입 -> 고압
}

체관: { label: "체관요소\n살아 있으나 핵과 액포가 없다\n동반세포가 그 기능을 대신 맡는다"; style.bold: true }

수용부: {
  label: "수용부 (sink) — 뿌리, 열매, 어린 잎"
  하역: { label: "4. 설탕을 내려 쓰거나 저장한다" }
  물유출: { label: "5. Ψs 가 올라가 물이 빠져나간다" }
  저압: { label: "6. 팽압이 내려간다 (낮은 압력)" }
  하역 -> 물유출 -> 저압
}

공급원.고압 -> 체관: "압력이 높은 쪽"
체관 -> 수용부.하역: "대량 흐름 (bulk flow)"
수용부.저압 -> 공급원.적재: "물은 물관부를 통해 돌아간다"

방향: {
  label: "방향이 고정되어 있지 않다는 점이 물관부와 다르다\n어린 잎은 수용부였다가 자라면 공급원이 되고,\n뿌리는 여름에 수용부, 봄에 저장물을 내보내는 공급원이 된다\n같은 체관에서 계절에 따라 흐름의 방향이 바뀐다"
  style.stroke-dash: 3
}
