# 결합분포에서 갈라져 나오는 것들 — 6장(결합분포와 독립).
#
# 무엇을 읽어야 하나: 두 변수를 함께 적은 결합분포 하나에서 주변·조건부·독립·
# 공분산이 모두 나온다. 화살표의 방향은 정보가 줄어드는 방향이다.
direction: right

결합: { label: "결합분포 f(x, y)\n두 변수를 함께 적은 것"; shape: oval; style.bold: true }

주변X: { label: "주변분포 g(x)\ny 를 더하거나 적분해 지운다" }
주변Y: { label: "주변분포 h(y)\nx 를 더하거나 적분해 지운다" }

조건부: { label: "조건부분포 f(y|x) = f(x,y)/g(x)\n한 값을 알았을 때의 분포" }
조건부기댓값: { label: "조건부 기댓값 E[X|Y]\n그 자체가 확률변수다\nE[E[X|Y]] = E[X]" }

독립: { label: "독립\nf(x,y) = g(x)h(y) 가\n모든 (x,y) 에서 성립" }
공분산: { label: "공분산 Cov(X,Y) = E[XY] − E[X]E[Y]\n상관계수 ρ = 공분산 ÷ 두 표준편차의 곱" }
선형결합: { label: "V(aX+bY)\n= a²V(X) + b²V(Y) + 2ab Cov(X,Y)" }

결합 -> 주변X: "y 를 지운다"
결합 -> 주변Y: "x 를 지운다"
결합 -> 조건부: "x 를 고정한다"
조건부 -> 조건부기댓값
결합 -> 독립: "곱으로 쪼개지는가"
결합 -> 공분산
공분산 -> 선형결합
독립 -> 공분산: "독립이면 Cov = 0"

메모: {
  label: "화살표는 한쪽으로만 간다.\n주변분포 둘을 안다고 결합분포를 복원할 수는 없다.\n독립이라는 조건이 붙어야만 곱해서 되돌릴 수 있다"
  shape: text
}

주의: {
  label: "Cov = 0 은 독립을 뜻하지 않는다.\n상관은 직선 관계만 잡기 때문이다"
  shape: text
}
