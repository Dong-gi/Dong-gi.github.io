# 회귀분석의 순서 — 12장 전체의 지도.
#
# 무엇을 읽어야 하나: 계수를 구하는 것은 다섯 단계 가운데 두 번째일 뿐이다.
# 진단을 건너뛰고 곧장 검정과 예측으로 가는 것이 가장 흔한 잘못이며,
# 그림 가운데의 되돌아가는 화살표가 그 점을 말한다.
direction: down

그림: { label: "1. 산점도를 그린다"; shape: rectangle; style.bold: true }
그림설명: {
  label: "직선으로 볼 만한가, 이상점이 있는가.\n이 단계를 건너뛰면 뒤가 다 헛일이 된다"
  shape: text
}
그림 -> 그림설명: { style.stroke-dash: 3 }

추정: { label: "2. 최소제곱으로 b~0, b~1 을 구한다"; style.bold: true }
추정식: {
  label: "b~1 = S~{xy}/S~{xx},   b~0 = ȳ − b~1x̄\n편미분 두 개를 0 으로 놓은 결과다"
  shape: text
}
추정 -> 추정식: { style.stroke-dash: 3 }

진단: { label: "3. 잔차 그림으로 가정을 확인한다"; style.bold: true }
진단항목: {
  label: "직선성 · 등분산 · 독립 · 정규성\n네 가지를 잔차 그림 하나로 본다"
  shape: text
}
진단 -> 진단항목: { style.stroke-dash: 3 }

고침: { label: "변수를 바꾸거나 항을 더한다"; shape: rectangle }

추론: { label: "4. 기울기를 검정하고 구간을 만든다"; style.bold: true }
추론식: {
  label: "s² = SSE/(n−2),   SE(b~1) = s/√S~{xx}\nt = b~1/SE(b~1),  자유도 n − 2"
  shape: text
}
추론 -> 추론식: { style.stroke-dash: 3 }

예측: { label: "5. 예측한다"; style.bold: true }
예측구분: {
  label: "평균을 물으면 신뢰구간, 개체 하나를 물으면 예측구간.\n자료 범위 밖은 예측하지 않는다"
  shape: text
}
예측 -> 예측구분: { style.stroke-dash: 3 }

그림 -> 추정
추정 -> 진단
진단 -> 추론: "가정이 그럴듯하다"
진단 -> 고침: "패턴이 보인다"
고침 -> 추정: "다시 적합한다"
추론 -> 예측

경고: {
  label: "R² 은 3단계를 대신하지 못한다.\nR² 이 커도 잔차에 패턴이 있으면 4·5단계의 수는 모두 못 믿는다"
  shape: text
}

인과: {
  label: "관측자료에 회귀를 돌린 것은 관계를 요약한 것이지 원인을 찾은 것이 아니다.\n인과를 말하려면 무작위 배정이나 교란변수 통제가 있어야 한다"
  shape: text
}
