# 어떤 신뢰구간 공식을 고르는가 — 10장 구간추정 절의 판별 흐름.
#
# 무엇을 읽어야 하나: 신뢰구간 공식이 여러 개인 것은 상황이 여러 개이기 때문이다.
# 외울 것은 공식이 아니라 질문의 순서다. 무엇을 추정하는가, 모분산을 아는가,
# 표본이 하나인가 둘인가. 셋에 답하면 공식은 저절로 정해진다.
# 어느 칸이든 뼈대는 같다 — 점추정값 ± (임곗값) × (표준오차).
vars: { d2-config: { layout-engine: elk } }
direction: down

시작: { label: "구간추정을 하려 한다\n무엇을 추정하는가"; shape: oval; style.bold: true }

평균: { label: "모평균 μ"; style.bold: true }
비율: { label: "모비율 p"; style.bold: true }
분산: { label: "모분산 σ²"; style.bold: true }
차이: { label: "두 모집단의 차"; style.bold: true }

시작 -> 평균
시작 -> 비율
시작 -> 분산
시작 -> 차이

시그마: { label: "모표준편차 σ 를\n아는가"; shape: diamond }
평균 -> 시그마

z구간: { label: "x̄ ± z × σ/√n\n표준정규 임곗값"; style.bold: true }
t구간: { label: "x̄ ± t(n−1) × s/√n\n실전에서는 거의 이쪽"; style.bold: true }
시그마 -> z구간: "안다 (드물다)"
시그마 -> t구간: "모른다"

큰표본: { label: "np̂ ≥ 10 이고\nn(1−p̂) ≥ 10 인가"; shape: diamond }
비율 -> 큰표본
p구간: { label: "p̂ ± z × √(p̂(1−p̂)/n)"; style.bold: true }
정확: { label: "정규근사를 쓰지 않는\n정확구간이 필요하다" }
큰표본 -> p구간: "그렇다"
큰표본 -> 정확: "아니다"

chi구간: {
  label: "((n−1)s²/큰 임곗값, (n−1)s²/작은 임곗값)\n좌우가 대칭이 아니다"
  style.bold: true
}
분산 -> chi구간

짝: { label: "두 표본이\n짝지어져 있는가"; shape: diamond }
차이 -> 짝
대응: { label: "차이 d 를 만들어\n한 표본 t 구간을 쓴다"; style.bold: true }
등분산: { label: "두 모분산이\n비슷한가"; shape: diamond }
짝 -> 대응: "짝지어져 있다"
짝 -> 등분산: "독립이다"

합동: { label: "합동분산을 만들고\n자유도 n₁ + n₂ − 2 인 t"; style.bold: true }
웰치: { label: "√(s₁²/n₁ + s₂²/n₂) 를 쓰고\n자유도는 근사식으로" }
등분산 -> 합동: "비슷하다"
등분산 -> 웰치: "많이 다르다"

# 보이지 않는 화살표: 분산·차이 갈래를 평균·비율 갈래 아래 단으로 내린다
# (네 갈래가 한 줄로 퍼지면 폭이 두 배가 된다).
z구간 -> 분산: { style.opacity: 0 }
t구간 -> 차이: { style.opacity: 0 }

# 글상자는 그림 아래에 차례로 쌓는다(옆에 두면 폭이 몇 배가 된다).
주석: {
  label: ""
  near: bottom-center
  grid-columns: 1
  grid-gap: 24
  style.stroke: transparent
  style.fill: transparent

  뼈대: {
    label: "어느 칸으로 가든 꼴은 하나다\n점추정값 ± 임곗값 × 표준오차\n분산만 예외 — 좌우가 대칭이 아니다"
    shape: text
  }

  주의: {
    label: "정규성 가정을 어디서 쓰는지 보라.\n큰 표본에서는 중심극한정리가 대신 받쳐 주지만\n분산의 구간은 끝까지 정규성에 기댄다"
    shape: text
  }
}
