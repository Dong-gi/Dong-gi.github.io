# 수 체계는 왜 넓어졌나 — 6장(수 체계).
#
# 무엇을 읽어야 하나: 화살표에 적힌 것이 "앞 단계에서는 풀 수 없는 방정식"이다.
# 새 수는 취향으로 만든 것이 아니라 그 방정식을 풀려고 만든 것이다.
# 넓히기만 하지 잃는 것도 있다. 오른쪽 점선 상자에 적어 두었다.
direction: down

N: {
  label: "ℕ  자연수\n1, 2, 3, …\n세는 데 쓴다"
}

Z: {
  label: "ℤ  정수\n…, −2, −1, 0, 1, 2, …\n뺄셈이 언제나 된다"
}

Q: {
  label: "ℚ  유리수\n두 정수의 비 p/q (q ≠ 0)\n0 아닌 수로 나누기가 언제나 된다"
}

R: {
  label: "ℝ  실수\n수직선을 빈틈없이 채운 수\n유리수 + 무리수"
}

C: {
  label: "ℂ  복소수\na + bi (i² = −1)\n모든 다항방정식이 근을 갖는다"
}

N -> Z: "x + 3 = 1\n자연수 안에는 답이 없다"
Z -> Q: "3x = 2\n정수 안에는 답이 없다"
Q -> R: "x² = 2\n유리수 안에는 답이 없다 (귀류법으로 증명)"
R -> C: "x² = −1\n실수 안에는 답이 없다"

잃는것: {
  label: "넓힐 때마다 잃는 것도 있다\nℕ → ℤ : ‘가장 작은 수’가 사라진다\nℚ → ℝ : 낱낱이 셀 수 없게 된다\nℝ → ℂ : 대소 관계가 사라진다"
  style.stroke-dash: 3
}

C -> 잃는것: {
  style.stroke-dash: 3
  style.opacity: 0.6
}
