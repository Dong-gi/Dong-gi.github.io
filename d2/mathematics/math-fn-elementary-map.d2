# 이 장에서 다루는 함수들의 지도 — 7장(함수).
#
# 무엇을 읽어야 하나: 왼쪽 줄기는 사칙연산으로 만드는 함수, 오른쪽 두 쌍은
# 서로 역함수인 짝이다. 역함수 관계인 두 함수의 그래프는 y = x 에 대해 대칭이다.
direction: right

다항: {
  label: "다항함수\ny = aₙxⁿ + … + a₁x + a₀\n끊긴 곳이 없다"
}

유리: {
  label: "유리함수\n다항식 나누기 다항식\n분모가 0 인 곳에 점근선"
}

지수: {
  label: "지수함수\ny = aˣ (a > 0, a ≠ 1)\n같은 비율로 늘거나 준다"
}

로그: {
  label: "로그함수\ny = logₐ x\n‘몇 번 곱했나’를 센다"
}

삼각: {
  label: "삼각함수\nsin, cos, tan\n되풀이되는 것을 나타낸다"
}

역삼각: {
  label: "역삼각함수\narcsin, arccos, arctan\n비에서 각을 되찾는다"
}

다항 -> 유리: "나눗셈을 허용한다"
지수 -> 로그: "y = x 에 대해 뒤집는다 (역함수)"
로그 -> 지수: "다시 뒤집는다"
삼각 -> 역삼각: "구간을 잘라 일대일로 만든 뒤 뒤집는다"

쓰임: {
  label: "어디서 다시 만나나\n지수·로그 : 반감기, pH, 데시벨, 개체수\n삼각 : 파동, 진동, 회전, 교류"
  style.stroke-dash: 3
}
