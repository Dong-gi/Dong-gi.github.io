# 삼각형에서 무엇이 주어졌을 때 어느 법칙을 쓰는가 — 5장(유클리드 기하학).
#
# 무엇을 읽어야 하나: 왼쪽 네 상자는 삼각형을 결정하는 조건이고,
# 그 옆의 화살표가 곧 합동 조건이다. SSA 만 화살표가 둘이라는 것이 요점이다.
#
# 라벨에 아래첨자를 쓰지 않는다. 변은 a, b, c, 대각은 A, B, C 로 본문과 같게 적는다.
direction: right

주어진것: {
  label: "무엇이 주어졌는가"

  SSS: { label: "세 변\n(SSS)" }
  SAS: { label: "두 변과 그 사잇각\n(SAS)" }
  ASA: { label: "한 변과 두 각\n(ASA)" }
  SSA: { label: "두 변과 끼지 않은 각\n(SSA)"; style.stroke-dash: 3 }
}

도구: {
  label: "무엇으로 푸는가"

  코사인: { label: "코사인법칙\na² = b² + c² − 2bc cos A" }
  사인:   { label: "사인법칙\na ÷ sin A = b ÷ sin B = 2R" }
  내각합: { label: "내각의 합 180°\n남은 한 각을 먼저 구한다" }
}

결과: {
  label: "삼각형이 하나로 정해지는가"

  하나: { label: "하나로 정해진다"; style.bold: true }
  애매: { label: "두 개가 나올 수 있다\n— 답을 둘 다 검토해야 한다"; style.stroke-dash: 3 }
}

주어진것.SSS -> 도구.코사인: "각을 구한다"
주어진것.SAS -> 도구.코사인: "남은 변을 구한다"
주어진것.ASA -> 도구.내각합: "세 각을 모두 안다"
도구.내각합 -> 도구.사인: "남은 두 변을 구한다"
주어진것.SSA -> 도구.사인: "sin 값이 같은 각이 둘이다"

도구.코사인 -> 결과.하나
도구.사인 -> 결과.하나
도구.사인 -> 결과.애매: "SSA 에서만"

메모: {
  label: "코사인법칙은 변만으로 각을 얻고, 사인법칙은 각에서 변을 얻는다.\n어느 쪽이 부족한지를 보면 고를 법칙이 정해진다"
  shape: text
}
