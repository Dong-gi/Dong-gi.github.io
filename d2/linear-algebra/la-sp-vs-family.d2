# 서로 달라 보이는 것들이 같은 규칙을 따른다 — 선형대수 6장.
#
# 무엇을 읽어야 하나: 화살표의 나열, 다항식, 행렬, 함수는 생김새가 전혀 다르지만
# ‘더하기’와 ‘수 곱하기’가 정의되어 있고 그 둘이 열 개의 공리를 지킨다는 점이 같다.
# 그래서 한 번 증명한 정리가 네 곳 모두에서 통한다. 그것이 공리로 올라가는 이유다.
direction: down

공리: {
  label: "벡터공간의 열 개 공리\n덧셈 다섯, 스칼라배 다섯"
  shape: hexagon
  style.bold: true
}

rn: { label: "Rⁿ\n수 n 개의 나열\n(1, 3, −2)" }
다항식: { label: "차수 n 이하 다항식 P_n\n1 + 3x − 2x²" }
행렬: { label: "m × n 행렬 M_mn\n성분끼리 더하고 수를 곱한다" }
함수: { label: "구간 위의 함수 F(a, b)\n(f + g)(x) = f(x) + g(x)" }

공리 -> rn
공리 -> 다항식
공리 -> 행렬
공리 -> 함수

결론: {
  label: "한 번 증명하면 네 곳 모두에서 성립한다\n일차독립·기저·차원·계수 정리가 그대로 옮겨 간다"
  style.bold: true
}

rn -> 결론
다항식 -> 결론
행렬 -> 결론
함수 -> 결론

메모: {
  label: "이 표에 없는 것도 조건만 맞으면 벡터공간이다.\n반대로 ‘양수만 모은 집합’처럼 −1 배가 밖으로 나가면 벡터공간이 아니다"
  shape: text
}
