# 특이값 분해가 네 부분공간을 한꺼번에 준다 — 선형대수 10장.
#
# 무엇을 읽어야 하나: 9장에서는 네 부분공간이 직교로 갈린다는 것만 알았다.
# SVD 는 그 네 공간의 정규직교기저를 실제로 손에 쥐여 준다. V 의 앞쪽 r 개가
# 행공간, 뒤쪽이 영공간, U 의 앞쪽 r 개가 열공간, 뒤쪽이 왼쪽 영공간이다.
direction: right

정의역: {
  label: "정의역 R^n — x 가 사는 곳"
  style.bold: true
  행공간: { label: "행공간 Row(A)\n기저 v_1 … v_r\n차원 r" }
  영공간: { label: "영공간 N(A)\n기저 v_{r+1} … v_n\n차원 n − r" }
}

공역: {
  label: "공역 R^m — Ax 와 b 가 사는 곳"
  style.bold: true
  열공간: { label: "열공간 Col(A)\n기저 u_1 … u_r\n차원 r" }
  영벡터: { label: "0"; shape: circle; style.bold: true }
  왼영: { label: "왼쪽 영공간\n기저 u_{r+1} … u_m\n차원 m − r\nAx 로는 절대 닿지 못하는 방향" }
}

정의역.행공간 -> 공역.열공간: "A v_i = σ_i u_i  — 방향은 그대로, 길이만 σ_i 배"
정의역.영공간 -> 공역.영벡터: "A v_i = 0  — 납작하게 눌린다"

읽기: {
  label: "계수 r = 0 이 아닌 특이값의 개수다.\n네 기저가 모두 정규직교라서 사영도 최소제곱도 낮은 계수 근사도 여기서 곧바로 나온다.\nb 를 열공간에 사영하려면 u_1 … u_r 과의 내적만 남기면 되고, 왼쪽 영공간 성분이 잔차다"
  shape: text
}
