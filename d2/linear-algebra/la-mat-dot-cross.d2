# 두 벡터를 곱하는 두 가지 방법 — 선형대수 5장.
#
# 무엇을 읽어야 하나: 벡터끼리의 곱은 하나가 아니다. 결과가 수인 곱과 벡터인
# 곱이 따로 있고, 재는 것이 다르다. 내적은 두 벡터가 얼마나 같은 방향인가를,
# 외적은 얼마나 다른 방향인가를 잰다.
direction: right

두벡터: { label: "벡터 u 와 v"; shape: oval; style.bold: true }

내적: { label: "내적 u · v\n결과는 수(스칼라)"; style.bold: true }
외적: { label: "외적 u × v\n결과는 벡터"; style.bold: true }

내뜻: { label: "‖u‖‖v‖ cos θ = Σ u_i v_i\nv 의 그림자 길이에 u 의 길이를 곱한 것" }
외뜻: { label: "크기는 ‖u‖‖v‖ sin θ\n두 벡터가 만드는 평행사변형의 넓이\n방향은 그 평면에 수직" }

내쓸: { label: "각을 잰다\n수직인지 판정한다\n길이와 거리를 잰다\n정사영을 만든다" }
외쓸: { label: "평면의 법선을 구한다\n넓이를 잰다\n삼중곱으로 부피를 잰다" }

두벡터 -> 내적: "차원 제한 없음"
두벡터 -> 외적: "R³ 에서만"
내적 -> 내뜻 -> 내쓸
외적 -> 외뜻 -> 외쓸

메모: {
  label: "내적이 0 이면 두 벡터가 수직이고, 외적이 영벡터면 두 벡터가 나란하다.\ncos 과 sin 이 0 이 되는 자리가 정반대이기 때문이다"
  shape: text
}
